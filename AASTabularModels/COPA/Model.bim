          },
          {
            "type": "calculated",
            "name": "Region",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "IF(AND('Profit Center'[Level 2 A] = \"Americas\", 'Profit Center'[Level 4 A] =\"NA\"), \"NA\",",
              "IF(AND('Profit Center'[Level 2 A]=\"Americas\", 'Profit Center'[Level 4 A]=\"LATAM\"), \"LATAM\",",
              "IF('Profit Center'[Level 2 A] = \"NA DDTC\", \"NA\",",
              "IF('Profit Center'[Level 2 A] = \"Dummy Profit Center\", \"NA\",",
              "IF('Profit Center'[Level 2 A] = \"Corp\", \"NA\",",
              "'Profit Center'[Level 2 A])))))"
            ]
          },
          {
            "type": "calculated",
            "name": "Region Seperate NA DDTC",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "IF(AND('Profit Center'[Level 2 A] = \"Americas\", 'Profit Center'[Level 4 A]=\"NA\"), \"NA\",",
              "IF(AND('Profit Center'[Level 2 A]=\"Americas\",'Profit Center'[Level 4 A]=\"LATAM\"), \"LATAM\",",
              "IF('Profit Center'[Level 2 A] = \"Dummy Profit Center\", \"NA\",",
              "IF('Profit Center'[Level 2 A] = \"Corp\", \"NA\",",
              "'Profit Center'[Level 2 A]))))"
            ]
          }
        ],
