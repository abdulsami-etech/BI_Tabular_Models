        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"SQL/stgalignbisql database windows net;stgalignbidw\",",
                "    DWSAP_FACT = Source{[Schema=\"DWSAP\",Item=\"FACT_COPA\"]}[Data]",
                "in",
                "    DWSAP_FACT"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Revenue",
            "expression": "SUM(Revenue[COPA Revenue])"
          },
          {
            "name": "ASP",
            "expression": "  ([Total Revenue]/[Shipment])"
          },
          {
            "name": "Discount",
            "expression": " CALCULATE(SUM(Revenue[COPA Revenue]), FILTER('Cost Element', 'Cost Element'[Level 4]=\"Sales Discounts and Rebates\"))"
          },
          {
            "name": "Discount%",
            "expression": " ([Discount]*-1/[Total Revenue])*100"
          },
          {
            "name": "Clear Aligner Revenue",
            "expression": [
              " ",
              "CALCULATE([Total Revenue], FILTER(Revenue, Revenue[Product Hierarchy] IN { \"A1A1T1C101\",\"A1A1T1C102\",\"A1A1T1C10301\",\"A1A1T1C104\",\"A1A1T1C105\",\"A1A1T1C106\",",
              "\"A1A1T1C107\",\"A1A1T1C2E101\",\"A1A1T1C2E102\",\"A1A1T1C2E103\",\"A1A1T1C2G1\",\"A1A1T1C2G2\"",
              ",\"A1A1T1C2G3\",\"A1A1T1C2L1\",\"A1A1T1C2L101\",\"A1A1T1C2L102\",\"A1A1T1C2L104\",\"A1A1T1C2M1\",\"A1A1T1C2M101\",",
              "\"A1A1T1C2N1\",\"A1A1T1C2S1\",\"A1A1T1C2S201\",\"A1A1T1C2S202\",\"A1A1T1C2S301\"}  ))"
            ]
          },
          {
            "name": "Clear Aligner ASP",
            "expression": " [Clear Aligner Revenue]/[Clear Aligner Shipments]"
          },
          {
            "name": "Scanner Revenue",
            "expression": " CALCULATE([Total Revenue],FILTER('Product','Product'[Level 3] = \"Scanner and Scanner Services\"))"
          },
          {
            "name": "Scanner ASP",
            "expression": " [Scanner Revenue]/[Scanner Shipments]"
          },
          {
            "name": "Revenue YTD",
            "expression": [
              "CALCULATE(SUM(Revenue[COPA Revenue]),FILTER('Time','Time'[KeyDate]>=DATE(YEAR(TODAY()),1,1) && 'Time'[KeyDate]<= TODAY()))",
              ""
            ]
          }
        ]
      },
