            "sourceColumn": "Profit Center"
          },
          {
            "name": "Material Number",
            "dataType": "string",
            "sourceColumn": "Material Number"
          },
          {
            "name": "Cost Element",
            "dataType": "string",
            "sourceColumn": "Cost Element"
          },
          {
            "name": "Sales Order Number",
            "dataType": "string",
            "sourceColumn": "Sales Order Number"
          },
          {
            "name": "Delivery",
            "dataType": "string",
            "sourceColumn": "Delivery"
          },
          {
            "name": "PROFIT_CENTER_KEY",
            "dataType": "string",
            "sourceColumn": "PROFIT_CENTER_KEY"
          },
          {
            "name": "Item Category",
            "dataType": "string",
            "sourceColumn": "Item Category"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"SQL/stgalignbisql database windows net;stgalignbidw\",",
                "    #\"DWSAP_FACT Delivery\" = Source{[Schema=\"DWSAP\",Item=\"FACT Delivery\"]}[Data]",
                "in",
                "    #\"DWSAP_FACT Delivery\""
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Customer",
            "expression": " COUNT(Delivery[Sold-to party])"
          },
          {
            "name": "CurrentShipmentYr",
            "expression": " CALCULATE([Shipment], FILTER('Time', 'Time'[Fiscal Year]=(YEAR(TODAY()))))"
          },
          {
            "name": "PreviousShipmentYr",
            "expression": " CALCULATE([Shipment], FILTER('Time', 'Time'[Fiscal Year]=(YEAR(TODAY())-1)))"
          },
          {
            "name": "ShipmentYr%",
            "expression": " ([CurrentShipmentYr]-[PreviousShipmentYr])/[PreviousShipmentYr] * 100"
          },
          {
            "name": "Clear Aligner Shipments",
            "expression": [
              " CALCULATE([Shipment],FILTER(Delivery, Delivery[Product Hierarchy] IN { \"A1A1T1C101\",\"A1A1T1C102\",\"A1A1T1C10301\",\"A1A1T1C104\",\"A1A1T1C105\",\"A1A1T1C106\",",
              "\"A1A1T1C107\",\"A1A1T1C2E101\",\"A1A1T1C2E102\",\"A1A1T1C2E103\",\"A1A1T1C2G1\",\"A1A1T1C2G2\"",
              ",\"A1A1T1C2G3\",\"A1A1T1C2L1\",\"A1A1T1C2L101\",\"A1A1T1C2L102\",\"A1A1T1C2L104\",\"A1A1T1C2M1\",\"A1A1T1C2M101\",",
              "\"A1A1T1C2N1\",\"A1A1T1C2S1\",\"A1A1T1C2S201\",\"A1A1T1C2S202\",\"A1A1T1C2S301\"}  ))"
            ]
          },
          {
            "name": "Scanner Shipments",
            "expression": " CALCULATE([Shipment],FILTER('Product','Product'[Level 3]=\"Scanner and Scanner Services\"),FILTER('Sales Order','Sales Order'[Treatment Category]=\"Primary\"))"
          },
          {
            "name": "Shipment YTD",
            "expression": [
              "CALCULATE(COUNT(Delivery[Delivery]),FILTER('Time','Time'[KeyDate]>=DATE(YEAR(TODAY()),1,1) && 'Time'[KeyDate]<= TODAY()))",
              ""
            ]
          }
        ]
      },
