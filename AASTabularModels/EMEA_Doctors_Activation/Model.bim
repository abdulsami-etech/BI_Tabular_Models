        "name": "Online Modules",
        "columns": [
          {
            "name": "ModuleDate",
            "dataType": "dateTime",
            "sourceColumn": "ModuleDate",
            "formatString": "dd.MM.yyyy",
            "sourceProviderType": "Date",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"DateTimeCustom\"><DateTimes><DateTime LCID=\"1049\" Group=\"ShortDate\" FormatString=\"dd.MM.yyyy\" /></DateTimes></Format>"
              }
            ]
          },
          {
            "name": "AccountDID",
            "dataType": "string",
            "sourceColumn": "AccountDID",
            "sourceProviderType": "VarChar"
          },
          {
            "name": "ModuleIdentifier",
            "dataType": "string",
            "sourceColumn": "ModuleIdentifier",
            "sourceProviderType": "VarChar"
          }
        ],
        "partitions": [
          {
            "name": "Online Modules",
            "dataView": "full",
            "source": {
              "type": "query",
              "query": [
                "select ",
                "\tconvert(date,[DateCreated]) as ModuleDate,",
                "\tAccountDID,",
                "\tModuleIdentifier",
                "from ",
                "[AlignSalesData].[dbo].[vwModuleComplete]",
                "where ModuleIdentifier Like 'Module_%'"
              ],
              "dataSource": "EUDB1"
            },
            "annotations": [
              {
                "name": "QueryEditorSerialization",
                "value": [
                  "<?xml version=\"1.0\" encoding=\"UTF-16\"?><Gemini xmlns=\"QueryEditorSerialization\"><AnnotationContent><![CDATA[<RSQueryCommandText>select ",
                  "\tconvert(date,[DateCreated]) as ModuleDate,",
                  "\tAccountDID,",
                  "\tModuleIdentifier",
                  "from ",
                  "[AlignSalesData].[dbo].[vwModuleComplete]",
                  "where ModuleIdentifier Like 'Module_%'</RSQueryCommandText><RSQueryCommandType>Text</RSQueryCommandType><RSQueryDesignState></RSQueryDesignState>]]></AnnotationContent></Gemini>"
                ]
              }
            ]
          }
        ],
        "measures": [
          {
            "name": "Completed Modules Count",
            "expression": [
              "",
              "SUMX(",
              "'Mentoring Event',",
              "IF(",
              "    NOT(ISBLANK([ContactKey])), ",
              "    CALCULATE(COUNTROWS('Online Modules')),",
              "    BLANK()",
              "  )",
              ")"
            ]
          },
          {
            "name": "Completed Modules %",
            "expression": [
              "",
              "",
              "VAR DocCountFull=CALCULATE(COUNTROWS('Mentoring Event'), FILTER('Mentoring Event',[Portfolio]=\"Full Portfolio\"))",
              "VAR DocCountiGO=CALCULATE(COUNTROWS('Mentoring Event'), FILTER('Mentoring Event',[Portfolio]=\"GP Invisalign Go\"))",
              "",
              "VAR ModulesCount=[Completed Modules Count]",
              "",
              "RETURN ",
              "DIVIDE(",
              "    [Completed Modules Count],",
              "    DocCountFull*6+DocCountiGO*4)"
            ],
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "Module 1 Completion Date",
            "expression": [
              "",
              "MAXX(",
              "    'Mentoring Event',",
