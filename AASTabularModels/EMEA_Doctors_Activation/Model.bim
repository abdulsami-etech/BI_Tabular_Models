{
  "name": "Doctors Activation Tabular",
  "compatibilityLevel": 1200,
  "model": {
    "culture": "ru-RU",
    "dataSources": [
      {
        "name": "OTCDM",
        "connectionString": "Provider=SQLOLEDB;Data Source=prdus2bidbasql;Persist Security Info=false;Integrated Security=SSPI;Initial Catalog=OTCDM",
        "impersonationMode": "impersonateServiceAccount",
        "annotations": [
          {
            "name": "ConnectionEditUISource",
            "value": "SqlServer"
          }
        ]
      },
      {
        "name": "EUDB1",
        "connectionString": "Provider=SQLNCLI11.1;Data Source=EUDB1.CWXFBSLUSFR3.EU-CENTRAL-1.RDS.AMAZONAWS.COM;Persist Security Info=True;User ID=eudbadmin;Initial Catalog=AlignSalesData",
        "impersonationMode": "impersonateServiceAccount",
        "annotations": [
          {
            "name": "ConnectionEditUISource",
            "value": "SqlServer"
          }
        ]
      }
    ],
    "tables": [
      {
        "name": "Mentoring Event",
        "columns": [
          {
            "name": "Campaign ID",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "Campaign ID",
            "sourceProviderType": "VarChar"
          },
          {
            "name": "Event Name",
            "dataType": "string",
            "sourceColumn": "Event Name",
            "sourceProviderType": "VarChar",
            "displayFolder": "Mentoring Event Data"
          },
          {
            "name": "Event Date",
            "dataType": "dateTime",
            "isHidden": true,
            "sourceColumn": "Event Date",
            "formatString": "Short Date",
            "sourceProviderType": "Date",
            "displayFolder": "Mentoring Event Data",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"DateTimeShortDatePattern\" />"
              }
            ]
          },
          {
            "name": "Event Status",
            "dataType": "string",
            "sourceColumn": "Event Status",
            "sourceProviderType": "VarChar",
            "displayFolder": "Mentoring Event Data"
          },
          {
            "name": "Event City",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "Event City",
            "sourceProviderType": "VarChar",
            "displayFolder": "Mentoring Event Data",
            "dataCategory": "City"
          },
          {
            "name": "Event Doctor Type",
            "dataType": "string",
            "sourceColumn": "Event Doctor Type",
            "sourceProviderType": "VarChar",
            "displayFolder": "Mentoring Event Data"
          },
          {
            "name": "Event Speaker",
            "dataType": "string",
            "sourceColumn": "Event Speaker",
            "sourceProviderType": "VarChar",
            "displayFolder": "Mentoring Event Data"
          },
          {
            "name": "MemberID",
            "dataType": "string",
            "isHidden": true,
            "isUnique": true,
            "isKey": true,
            "sourceColumn": "MemberID"
          },
          {
            "name": "Doctor Name",
            "dataType": "string",
            "sourceColumn": "Doctor Name",
            "displayFolder": "Doctor Data"
          },
          {
            "name": "Is Retraining",
            "dataType": "string",
            "sourceColumn": "Is Retraining",
            "displayFolder": "Doctor Data"
          },
          {
            "name": "Registration Status",
            "dataType": "string",
            "sourceColumn": "Registration Status",
            "displayFolder": "Doctor Data"
          },
          {
            "name": "Lead Source",
            "dataType": "string",
            "sourceColumn": "Lead Source",
            "displayFolder": "Doctor Data"
          },
          {
            "name": "IsAttended",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "IsAttended"
          },
          {
            "name": "Registration Date",
            "dataType": "dateTime",
            "sourceColumn": "Registration Date",
            "displayFolder": "Doctor Data"
          },
          {
            "name": "Account Number",
            "dataType": "string",
            "sourceColumn": "Account Number",
            "displayFolder": "Doctor Data"
          },
          {
            "name": "Clin ID",
            "dataType": "string",
            "sourceColumn": "Clin ID",
            "displayFolder": "Doctor Data"
          },
          {
            "name": "LeadOrContactId",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "LeadOrContactId"
          },
          {
            "name": "Owner User Name",
            "dataType": "string",
            "sourceColumn": "Owner User Name",
            "displayFolder": "Doctor Data"
          },
          {
            "name": "Event Region",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "Event Region"
          },
          {
            "type": "calculated",
            "name": "Is Event Over",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "IF(",
              "    [Event Date]=TODAY(), \"Today Event\",",
              "        IF([Event Date]<TODAY(), \"Event is Over\",\"Event is Pending\"))",
              "",
              ""
            ],
            "displayFolder": "Mentoring Event Data"
          },
          {
            "type": "calculated",
            "name": "City-Date Caption",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": "CONCATENATE(CONCATENATE([Event City],\" - \"),[Event Date])",
            "sortByColumn": "Event Date",
            "displayFolder": "Mentoring Event Data"
          },
          {
            "type": "calculated",
            "name": "Days After Event",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": [
              "",
              "IF([Event Date]<TODAY(),",
              "    DateDiff(",
              "        [Event Date]",
              "        ,TODAY()",
              "        ,DAY)-1",
              "    ,BLANK()",
              ")"
            ],
            "displayFolder": "Mentoring Event Data",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Days Before Event",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": [
              "",
              "IF([Event Date]>=TODAY(),",
              "    DateDiff(",
              "        TODAY()",
              "        ,[Event Date]",
              "        ,DAY)+1",
              "    ,BLANK()",
              ")"
            ],
            "displayFolder": "Mentoring Event Data",
            "summarizeBy": "none"
          },
          {
            "name": "ContactKey",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "ContactKey"
          },
          {
            "type": "calculated",
            "name": "CCA30",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "isHidden": true,
            "expression": [
              "",
              "VAR day30=[Event Date]+30",
              "",
              "RETURN",
              "",
              "IF(",
              "    NOT ISBLANK([ContactKey]),",
              "",
              "    IF(",
              "        [Days After Event]>=30,",
              "        CALCULATE(",
              "                    SUM('Sales Data'[CCA]),",
              "                    ALL('Sales Data'[StatusDate]),",
              "                    'Sales Data'[StatusDate]>=EARLIER([Event Date]) && 'Sales Data'[StatusDate]<day30",
              "                ),",
              "        BLANK()",
              "    )",
              "    ,BLANK()",
              ")",
              ""
            ]
          },
          {
            "type": "calculated",
            "name": "CCA60",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "isHidden": true,
            "expression": [
              "",
              "VAR day60=[Event Date]+60",
              "",
              "RETURN",
              "",
              "IF(",
              "    NOT ISBLANK([ContactKey]),",
              "",
              "    IF(",
              "        [Days After Event]>=60,",
              "        CALCULATE(",
              "                    SUM('Sales Data'[CCA]),",
              "                    ALL('Sales Data'[StatusDate]),",
              "                    'Sales Data'[StatusDate]>=EARLIER([Event Date]) && 'Sales Data'[StatusDate]<day60",
              "                ),",
              "        BLANK()",
              "    )",
              "    ,BLANK()",
              ")",
              ""
            ]
          },
          {
            "type": "calculated",
            "name": "CCA90",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "isHidden": true,
            "expression": [
              "",
              "VAR day90=[Event Date]+90",
              "",
              "RETURN",
              "IF(",
              "    NOT ISBLANK([ContactKey]),",
              "    ",
              "    IF(",
              "        [Days After Event]>=90,",
              "        CALCULATE(",
              "                    SUM('Sales Data'[CCA]),",
              "                    ALL('Sales Data'[StatusDate]),",
              "                    'Sales Data'[StatusDate]>=EARLIER([Event Date]) && 'Sales Data'[StatusDate]<day90",
              "                ),",
              "        BLANK()",
              "    )",
              "    ,BLANK()",
              ")",
              ""
            ]
          },
          {
            "type": "calculated",
            "name": "CCA120",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "isHidden": true,
            "expression": [
              "",
              "VAR day120=[Event Date]+120",
              "",
              "RETURN",
              "IF(",
              "    NOT ISBLANK([ContactKey]),",
              "",
              "    IF(",
              "        [Days After Event]>=120,",
              "        CALCULATE(",
              "                    SUM('Sales Data'[CCA]),",
              "                    ALL('Sales Data'[StatusDate]),",
              "                    'Sales Data'[StatusDate]>=EARLIER([Event Date]) && 'Sales Data'[StatusDate]<day120",
              "                ),",
              "        BLANK()",
              "    )",
              "    ,BLANK()",
              ")",
              ""
            ]
          },
          {
            "type": "calculated",
            "name": "CCA180",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "isHidden": true,
            "expression": [
              "",
              "VAR day180=[Event Date]+180",
              "",
              "RETURN",
              "IF(",
              "    NOT ISBLANK([ContactKey]),",
              "",
              "    IF(",
              "        [Days After Event]>=180,",
              "        CALCULATE(",
              "                    SUM('Sales Data'[CCA]),",
              "                    ALL('Sales Data'[StatusDate]),",
              "                    'Sales Data'[StatusDate]>=EARLIER([Event Date]) && 'Sales Data'[StatusDate]<day180",
              "                ),",
              "        BLANK()",
              "    )",
              "    ,BLANK()",
              ")"
            ]
          },
          {
            "type": "calculated",
            "name": "CCAToDate",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "isHidden": true,
            "expression": [
              "",
              "IF(",
              "    NOT ISBLANK([ContactKey]),",
              "    ",
              "            CALCULATE(",
              "                        SUM('Sales Data'[CCA]),",
              "                        ALL('Sales Data'[StatusDate]),",
              "                        'Sales Data'[StatusDate]>=EARLIER([Event Date])",
              "                    )",
              "            ,BLANK()",
              ")"
            ]
          },
          {
            "type": "calculated",
            "name": "NRBeforeEvent",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "isHidden": true,
            "expression": [
              "",
              "VAR regDay=[Registration Date]",
              "",
              "RETURN",
              "SWITCH (",
              "'Mentoring Event'[Is Retraining],",
              "",
              "\"New Doctor\",",
              "    IF(",
              "        NOT ISBLANK([ContactKey]),",
              "        CALCULATE(",
              "                    SUM('Sales Data'[NR]),",
              "                    ALL('Sales Data'[StatusDate]),",
              "                    'Sales Data'[StatusDate]<=EARLIER([Event Date]) --&& 'Sales Data'[StatusDate]>=regDay",
              "                )",
              "        ,BLANK()",
              "    ),",
              "",
              " IF(",
              "    NOT ISBLANK([ContactKey]),",
              "    CALCULATE(",
              "                    SUM('Sales Data'[NR]),",
              "                    ALL('Sales Data'[StatusDate]),",
              "                    'Sales Data'[StatusDate]<=EARLIER([Event Date]) && 'Sales Data'[StatusDate]>=regDay",
              "                )",
              "    ,BLANK()",
              "    )    ",
              ")",
              ""
            ]
          },
          {
            "type": "calculated",
            "name": "NRAfterEvent",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "isHidden": true,
            "expression": [
              "",
              "IF(",
              "    NOT ISBLANK([ContactKey]),",
              "    CALCULATE(",
              "                SUM('Sales Data'[NR]),",
              "                ALL('Sales Data'[StatusDate]),",
              "                'Sales Data'[StatusDate]>EARLIER([Event Date])",
              "            )",
              "    ,BLANK()",
              ")"
            ]
          },
          {
            "type": "calculated",
            "name": "JTG30",
            "dataType": "double",
            "isDataTypeInferred": true,
            "isHidden": true,
            "expression": [
              "",
              "VAR accJTG=LOOKUPVALUE('JTG'[Accumulated],'JTG'[Month],1)",
              "",
              "RETURN",
              "IF(",
              "    [Event Status]=\"Completed\" && [Days After Event]>=30",
              "    ,[CCA30]-accJTG",
              "    ,BLANK()",
              ")"
            ]
          },
          {
            "type": "calculated",
            "name": "JTG60",
            "dataType": "double",
            "isDataTypeInferred": true,
            "isHidden": true,
            "expression": [
              "",
              "VAR accJTG=LOOKUPVALUE('JTG'[Accumulated],'JTG'[Month],2)",
              "",
              "RETURN",
              "IF(",
              "    [Event Status]=\"Completed\" && [Days After Event]>=60",
              "    ,[CCA60]-accJTG",
              "    ,BLANK()",
              ")"
            ]
          },
          {
            "type": "calculated",
            "name": "JTG90",
            "dataType": "double",
            "isDataTypeInferred": true,
            "isHidden": true,
            "expression": [
              "",
              "VAR accJTG=LOOKUPVALUE('JTG'[Accumulated],'JTG'[Month],3)",
              "",
              "RETURN",
              "IF(",
              "    [Event Status]=\"Completed\" && [Days After Event]>=90",
              "    ,[CCA90]-accJTG",
              "    ,BLANK()",
              ")"
            ]
          },
          {
            "type": "calculated",
            "name": "JTG120",
            "dataType": "double",
            "isDataTypeInferred": true,
            "isHidden": true,
            "expression": [
              "",
              "VAR accJTG=LOOKUPVALUE('JTG'[Accumulated],'JTG'[Month],4)",
              "",
              "RETURN",
              "IF(",
              "    [Event Status]=\"Completed\" && [Days After Event]>=120",
              "    ,[CCA120]-accJTG",
              "    ,BLANK()",
              ")"
            ]
          },
          {
            "type": "calculated",
            "name": "JTG180",
            "dataType": "double",
            "isDataTypeInferred": true,
            "isHidden": true,
            "expression": [
              "",
              "VAR accJTG=LOOKUPVALUE('JTG'[Accumulated],'JTG'[Month],6)",
              "",
              "RETURN",
              "IF(",
              "    [Event Status]=\"Completed\" && [Days After Event]>=180",
              "    ,[CCA180]-accJTG",
              "    ,BLANK()",
              ")"
            ]
          },
          {
            "name": "SalesCountryGroupPerson",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "SalesCountryGroupPerson"
          },
          {
            "name": "SalesRegionalVPPerson",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "SalesRegionalVPPerson"
          },
          {
            "name": "SalesAreaPerson",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "SalesAreaPerson"
          },
          {
            "name": "SalesRegionPerson",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "SalesRegionPerson"
          },
          {
            "name": "SalesTerritoryPerson",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "SalesTerritoryPerson"
          },
          {
            "name": "LeadId",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "LeadId"
          },
          {
            "name": "ContactID",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "ContactID"
          },
          {
            "type": "calculated",
            "name": "JTG Doctor Status",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "",
              "IF([CCAToDate]>0,",
              "    IF( ISBLANK([JTG365]),",
              "      IF( ISBLANK([JTG270]),",
              "        IF( ISBLANK([JTG180])",
              "            ,IF( ISBLANK([JTG120])",
              "                 ,IF( ISBLANK([JTG90])",
              "                      ,IF( ISBLANK([JTG60])",
              "                           ,IF( NOT ISBLANK([JTG30])",
              "                                ,IF([JTG30]>0,\"Above track\",IF([JTG30]<0,\"Below track\",\"On track\"))",
              "                                ,\"<30 Days\"",
              "                              )",
              "                           ,IF([JTG60]>0,\"Above track\",IF([JTG60]<0,\"Below track\",\"On track\"))",
              "                         )",
              "                      ,IF([JTG90]>0,\"Above track\",IF([JTG90]<0,\"Below track\",\"On track\"))",
              "                    )",
              "                 ,IF([JTG120]>0,\"Above track\",IF([JTG120]<0,\"Below track\",\"On track\"))",
              "               )",
              "            ,IF([JTG180]>0,\"Above track\",IF([JTG180]<0,\"Below track\",\"On track\"))",
              "          )",
              "        ,IF([JTG270]>0,\"Above track\",IF([JTG270]<0,\"Below track\",\"On track\"))",
              "       )",
              "      ,IF([JTG365]>0,\"Above track\",IF([JTG365]<0,\"Below track\",\"On track\"))",
              "    )",
              "    ",
              "    ,\"No Activity\"",
              ")    ",
              "    ",
              "    "
            ],
            "displayFolder": "Doctor Data"
          },
          {
            "type": "calculated",
            "name": "CCA365",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "isHidden": true,
            "expression": [
              "",
              "VAR day365=[Event Date]+365",
              "",
              "RETURN",
              "IF(",
              "    NOT ISBLANK([ContactKey]),",
              "",
              "    IF(",
              "        [Days After Event]>=365,",
              "        CALCULATE(",
              "                    SUM('Sales Data'[CCA]),",
              "                    ALL('Sales Data'[StatusDate]),",
              "                    'Sales Data'[StatusDate]>=EARLIER([Event Date]) && 'Sales Data'[StatusDate]<day365",
              "                ),",
              "        BLANK()",
              "    )",
              "    ,BLANK()",
              ")"
            ]
          },
          {
            "name": "SalesCountryGroupIdentifier",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "SalesCountryGroupIdentifier"
          },
          {
            "name": "SalesRegionalVPIdentifier",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "SalesRegionalVPIdentifier"
          },
          {
            "name": "SalesAreaIdentifier",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "SalesAreaIdentifier"
          },
          {
            "name": "SalesRegionIdentifier",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "SalesRegionIdentifier"
          },
          {
            "name": "SalesTerritoryIdentifier",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "SalesTerritoryIdentifier"
          },
          {
            "name": "Event SubType",
            "dataType": "string",
            "sourceColumn": "Event SubType",
            "displayFolder": "Mentoring Event Data"
          },
          {
            "name": "Event Type",
            "dataType": "string",
            "sourceColumn": "Event Type",
            "displayFolder": "Mentoring Event Data"
          },
          {
            "type": "calculated",
            "name": "NR30",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "isHidden": true,
            "expression": [
              "",
              "VAR day30=[Event Date]+30",
              "",
              "RETURN",
              "",
              "IF(",
              "    NOT ISBLANK([ContactKey]),",
              "",
              "    IF(",
              "        [Days After Event]>=30,",
              "        CALCULATE(",
              "                    SUM('Sales Data'[NR]),",
              "                    ALL('Sales Data'[StatusDate]),",
              "                    'Sales Data'[StatusDate]>=EARLIER([Event Date]) && 'Sales Data'[StatusDate]<day30",
              "                ),",
              "        BLANK()",
              "    )",
              "    ,BLANK()",
              ")"
            ]
          },
          {
            "type": "calculated",
            "name": "NR60",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "isHidden": true,
            "expression": [
              "",
              "VAR day60=[Event Date]+60",
              "",
              "RETURN",
              "",
              "IF(",
              "    NOT ISBLANK([ContactKey]),",
              "",
              "    IF(",
              "        [Days After Event]>=60,",
              "        CALCULATE(",
              "                    SUM('Sales Data'[NR]),",
              "                    ALL('Sales Data'[StatusDate]),",
              "                    'Sales Data'[StatusDate]>=EARLIER([Event Date]) && 'Sales Data'[StatusDate]<day60",
              "                ),",
              "        BLANK()",
              "    )",
              "    ,BLANK()",
              ")",
              ""
            ]
          },
          {
            "type": "calculated",
            "name": "NR90",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "isHidden": true,
            "expression": [
              "",
              "VAR day90=[Event Date]+90",
              "",
              "RETURN",
              "IF(",
              "    NOT ISBLANK([ContactKey]),",
              "    ",
              "    IF(",
              "        [Days After Event]>=90,",
              "        CALCULATE(",
              "                    SUM('Sales Data'[NR]),",
              "                    ALL('Sales Data'[StatusDate]),",
              "                    'Sales Data'[StatusDate]>=EARLIER([Event Date]) && 'Sales Data'[StatusDate]<day90",
              "                ),",
              "        BLANK()",
              "    )",
              "    ,BLANK()",
              ")",
              ""
            ]
          },
          {
            "type": "calculated",
            "name": "NR120",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "isHidden": true,
            "expression": [
              "",
              "VAR day120=[Event Date]+120",
              "",
              "RETURN",
              "IF(",
              "    NOT ISBLANK([ContactKey]),",
              "",
              "    IF(",
              "        [Days After Event]>=120,",
              "        CALCULATE(",
              "                    SUM('Sales Data'[CCA]),",
              "                    ALL('Sales Data'[StatusDate]),",
              "                    'Sales Data'[StatusDate]>=EARLIER([Event Date]) && 'Sales Data'[StatusDate]<day120",
              "                ),",
              "        BLANK()",
              "    )",
              "    ,BLANK()",
              ")",
              ""
            ]
          },
          {
            "type": "calculated",
            "name": "NR180",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "isHidden": true,
            "expression": [
              "",
              "VAR day180=[Event Date]+180",
              "",
              "RETURN",
              "IF(",
              "    NOT ISBLANK([ContactKey]),",
              "",
              "    IF(",
              "        [Days After Event]>=180,",
              "        CALCULATE(",
              "                    SUM('Sales Data'[NR]),",
              "                    ALL('Sales Data'[StatusDate]),",
              "                    'Sales Data'[StatusDate]>=EARLIER([Event Date]) && 'Sales Data'[StatusDate]<day180",
              "                ),",
              "        BLANK()",
              "    )",
              "    ,BLANK()",
              ")"
            ]
          },
          {
            "type": "calculated",
            "name": "NRToDate",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "isHidden": true,
            "expression": [
              "",
              "IF(",
              "    NOT ISBLANK([ContactKey]),",
              "    ",
              "            CALCULATE(",
              "                        SUM('Sales Data'[NR]),",
              "                        ALL('Sales Data'[StatusDate]),",
              "                        'Sales Data'[StatusDate]>=EARLIER([Event Date])",
              "                    )",
              "            ,BLANK()",
              ")"
            ]
          },
          {
            "type": "calculated",
            "name": "NR365",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "isHidden": true,
            "expression": [
              "",
              "VAR day365=[Event Date]+365",
              "",
              "RETURN",
              "IF(",
              "    NOT ISBLANK([ContactKey]),",
              "",
              "    IF(",
              "        [Days After Event]>=365,",
              "        CALCULATE(",
              "                    SUM('Sales Data'[NR]),",
              "                    ALL('Sales Data'[StatusDate]),",
              "                    'Sales Data'[StatusDate]>=EARLIER([Event Date]) && 'Sales Data'[StatusDate]<day365",
              "                ),",
              "        BLANK()",
              "    )",
              "    ,BLANK()",
              ")"
            ]
          },
          {
            "name": "Event Type Descr",
            "dataType": "string",
            "sourceColumn": "Event Type Descr"
          },
          {
            "name": "ContactLineofBusiness",
            "dataType": "string",
            "sourceColumn": "ContactLineofBusiness"
          },
          {
            "name": "ContactProfessionalCategory",
            "dataType": "string",
            "sourceColumn": "ContactProfessionalCategory"
          },
          {
            "type": "calculated",
            "name": "Portfolio",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "",
              "IF ",
              "([ContactProfessionalCategory]=\"GP\" && SEARCH(\"Invisalign Go\",[ContactLineofBusiness],1,0)>0, ",
              "\"GP Invisalign Go\",\"Full Portfolio\")"
            ]
          },
          {
            "name": "Event Country Code",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "Event Country",
            "sourceProviderType": "VarChar",
            "displayFolder": "Mentoring Event Data",
            "dataCategory": "Country"
          },
          {
            "type": "calculated",
            "name": "Event Country Name",
            "dataType": "string",
            "isDataTypeInferred": true,
            "isHidden": true,
            "expression": "LOOKUPVALUE('Custom Geography'[Country],'Custom Geography'[CountryCode],[Event Country Code])"
          },
          {
            "type": "calculated",
            "name": "Curr CCAA",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": [
              "IF (NOT ISBLANK([ContactKey]),",
              "        CALCULATE(",
              "            COUNT('Orders Pipeline'[OrderKey]),",
              "            'Orders Pipeline'[OrderStatusKey]=90 || 'Orders Pipeline'[OrderStatusKey]=81)",
              "        ,BLANK()",
              "    )",
              "",
              ""
            ]
          },
          {
            "type": "calculated",
            "name": "Curr Pipeline",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": [
              "",
              "IF( NOT ISBLANK([ContactKey]),",
              "    CALCULATE(",
              "        COUNT('Orders Pipeline'[OrderKey]),",
              "        'Orders Pipeline'[OrderStatusKey]>=80 && 'Orders Pipeline'[OrderStatusKey]<100",
              "             )",
              "    ,BLANK()         ",
              ") ",
              ""
            ]
          },
          {
            "name": "ContactEmail",
            "dataType": "string",
            "sourceColumn": "ContactEmail"
          },
          {
            "name": "ContactPhone",
            "dataType": "string",
            "sourceColumn": "ContactPhone"
          },
          {
            "name": "ContactMobile",
            "dataType": "string",
            "sourceColumn": "ContactMobile"
          },
          {
            "name": "ContactCountry",
            "dataType": "string",
            "sourceColumn": "ContactCountry"
          },
          {
            "name": "AccountCountry",
            "dataType": "string",
            "sourceColumn": "AccountCountry"
          },
          {
            "name": "AccountCity",
            "dataType": "string",
            "sourceColumn": "AccountCity"
          },
          {
            "type": "calculated",
            "name": "ContactSFLink",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": "CONCATENATE(\"https://aligntech.my.salesforce.com/\",'Mentoring Event'[ContactId])",
            "dataCategory": "WebUrl"
          },
          {
            "type": "calculated",
            "name": "CampaignSFLink",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": "CONCATENATE(\"https://aligntech.my.salesforce.com/\",'Mentoring Event'[Campaign ID])",
            "dataCategory": "WebUrl"
          },
          {
            "type": "calculated",
            "name": "JTP30",
            "dataType": "double",
            "isDataTypeInferred": true,
            "isHidden": true,
            "expression": [
              "",
              "VAR accJTP=LOOKUPVALUE('JTP'[Cases per Doctor],'JTP'[Month],1)",
              "",
              "RETURN",
              "IF(",
              "    [Event Status]=\"Completed\" && [Days After Event]>=30",
              "    ,[CCA30]-accJTP",
              "    ,BLANK()",
              ")"
            ]
          },
          {
            "type": "calculated",
            "name": "JTP60",
            "dataType": "double",
            "isDataTypeInferred": true,
            "isHidden": true,
            "expression": [
              "",
              "VAR accJTP=LOOKUPVALUE('JTP'[Cases per Doctor],'JTP'[Month],2)",
              "",
              "RETURN",
              "IF(",
              "    [Event Status]=\"Completed\" && [Days After Event]>=60",
              "    ,[CCA60]-accJTP",
              "    ,BLANK()",
              ")"
            ]
          },
          {
            "type": "calculated",
            "name": "JTP90",
            "dataType": "double",
            "isDataTypeInferred": true,
            "isHidden": true,
            "expression": [
              "",
              "VAR accJTP=LOOKUPVALUE('JTP'[Cases per Doctor],'JTP'[Month],3)",
              "",
              "RETURN",
              "IF(",
              "    [Event Status]=\"Completed\" && [Days After Event]>=90",
              "    ,[CCA90]-accJTP",
              "    ,BLANK()",
              ")"
            ]
          },
          {
            "type": "calculated",
            "name": "JTP120",
            "dataType": "double",
            "isDataTypeInferred": true,
            "isHidden": true,
            "expression": [
              "",
              "VAR accJTP=LOOKUPVALUE('JTP'[Cases per Doctor],'JTP'[Month],4)",
              "",
              "RETURN",
              "IF(",
              "    [Event Status]=\"Completed\" && [Days After Event]>=120",
              "    ,[CCA120]-accJTP",
              "    ,BLANK()",
              ")"
            ]
          },
          {
            "type": "calculated",
            "name": "JTP180",
            "dataType": "double",
            "isDataTypeInferred": true,
            "isHidden": true,
            "expression": [
              "",
              "VAR accJTP=LOOKUPVALUE('JTP'[Cases per Doctor],'JTP'[Month],6)",
              "",
              "RETURN",
              "IF(",
              "    [Event Status]=\"Completed\" && [Days After Event]>=180",
              "    ,[CCA180]-accJTP",
              "    ,BLANK()",
              ")"
            ]
          },
          {
            "type": "calculated",
            "name": "JTP Doctor Status",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "",
              "IF([CCAToDate]>0,",
              "    IF( ISBLANK([JTP365]),",
              "      IF( ISBLANK([JTP270]),",
              "        IF( ISBLANK([JTP180])",
              "            ,IF( ISBLANK([JTP120])",
              "                 ,IF( ISBLANK([JTP90])",
              "                      ,IF( ISBLANK([JTP60])",
              "                           ,IF( NOT ISBLANK([JTP30])",
              "                                ,IF([JTP30]>0,\"Above track\",IF([JTP30]<0,\"Below track\",\"On track\"))",
              "                                ,\"<30 Days\"",
              "                              )",
              "                           ,IF([JTP60]>0,\"Above track\",IF([JTP60]<0,\"Below track\",\"On track\"))",
              "                         )",
              "                      ,IF([JTP90]>0,\"Above track\",IF([JTP90]<0,\"Below track\",\"On track\"))",
              "                    )",
              "                 ,IF([JTP120]>0,\"Above track\",IF([JTP120]<0,\"Below track\",\"On track\"))",
              "               )",
              "            ,IF([JTP180]>0,\"Above track\",IF([JTP180]<0,\"Below track\",\"On track\"))",
              "           )",
              "         ,IF([JTP270]>0,\"Above track\",IF([JTP270]<0,\"Below track\",\"On track\"))",
              "        )",
              "       ,IF([JTP365]>0,\"Above track\",IF([JTP365]<0,\"Below track\",\"On track\"))",
              "     )",
              "    ,\"No Activity\"",
              ")    ",
              "    "
            ]
          },
          {
            "type": "calculated",
            "name": "Pre TouchPoints CL",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": [
              "",
              "",
              "VAR ed=[Event Date]",
              "VAR regd=[Registration Date]",
              "",
              "RETURN",
              "",
              "SWITCH(",
              "    [Is Retraining],",
              "",
              "    \"New Doctor\",",
              "        COUNTROWS(",
              "                    FILTER('SF Activities',",
              "                            'SF Activities'[Role Type]=\"CL\" ",
              "                                && 'SF Activities'[Activity Date]<=ed",
              "                                && 'SF Activities'[WhoID]=EARLIER([ContactID])",
              "                                && ",
              "                                    (",
              "                                        (   'SF Activities'[Call Type]=\"Customer Face-to-Face\" || ",
              "                                            'SF Activities'[Call Type]=\"Customer Digital\"      ||",
              "                                            'SF Activities'[Call Type]=\"DSAD\"",
              "                                        )",
              "",
              "                                        ||",
              "                                        ",
              "                                        (",
              "                                            ('SF Activities'[Activity Record Type]=\"IDS Customer Meeting\" || ",
              "                                             'SF Activities'[Activity Record Type]=\"Clinical Appointment\" || ",
              "                                             'SF Activities'[Activity Record Type]=\"Customer Facing Event\" ||",
              "                                             'SF Activities'[Activity Record Type]=\"Email\" ||",
              "                                             'SF Activities'[Activity Record Type]=\"Internal Meeting\" ||    ",
              "                                             'SF Activities'[Activity Record Type]=\"Phone call (Inbound)\" ||",
              "                                             'SF Activities'[Activity Record Type]=\"Phone call (Outbound)\" ||",
              "                                             'SF Activities'[Activity Record Type]=\"Online event\" ||",
              "                                             'SF Activities'[Activity Record Type]=\"Visit\" ||",
              "                                             'SF Activities'[Activity Record Type]=\"Calendar Meeting\" ||",
              "                                             'SF Activities'[Activity Record Type]=\"Digital Touchpoints\")      ",
              "                                        )",
              "                                    )",
              "                            )",
              "                    ),",
              "",
              "    \"Retrain\",",
              "        ",
              "        COUNTROWS(",
              "                    FILTER('SF Activities',",
              "                            'SF Activities'[Role Type]=\"CL\" ",
              "                                && 'SF Activities'[Activity Date]<=ed && 'SF Activities'[Activity Date]>=regd",
              "                                && 'SF Activities'[WhoID]=EARLIER([ContactID])",
              "                                && ",
              "                                    (",
              "                                        (   'SF Activities'[Call Type]=\"Customer Face-to-Face\" || ",
              "                                            'SF Activities'[Call Type]=\"Customer Digital\"      ||",
              "                                            'SF Activities'[Call Type]=\"DSAD\"",
              "                                        )",
              "",
              "                                        ||",
              "                                        ",
              "                                        (",
              "                                            ('SF Activities'[Activity Record Type]=\"IDS Customer Meeting\" || ",
              "                                             'SF Activities'[Activity Record Type]=\"Clinical Appointment\" || ",
              "                                             'SF Activities'[Activity Record Type]=\"Customer Facing Event\" ||",
              "                                             'SF Activities'[Activity Record Type]=\"Email\" ||",
              "                                             'SF Activities'[Activity Record Type]=\"Internal Meeting\" ||    ",
              "                                             'SF Activities'[Activity Record Type]=\"Phone call (Inbound)\" ||",
              "                                             'SF Activities'[Activity Record Type]=\"Phone call (Outbound)\" ||",
              "                                             'SF Activities'[Activity Record Type]=\"Online event\" ||",
              "                                             'SF Activities'[Activity Record Type]=\"Visit\" ||",
              "                                             'SF Activities'[Activity Record Type]=\"Calendar Meeting\" ||",
              "                                             'SF Activities'[Activity Record Type]=\"Digital Touchpoints\")      ",
              "                                        )",
              "                                    )",
              "                            )",
              "                    ),",
              "",
              "    BLANK()",
              ")"
            ]
          },
          {
            "type": "calculated",
            "name": "Pre TouchPoints CS",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": [
              "",
              "",
              "VAR ed=[Event Date]",
              "VAR regd=[Registration Date]",
              "",
              "RETURN",
              "",
              "SWITCH(",
              "    [Is Retraining],",
              "    ",
              "    \"New Doctor\",",
              "                COUNTROWS(",
              "                    FILTER('SF Activities',",
              "                            'SF Activities'[Role Type]=\"CS\" ",
              "                                && 'SF Activities'[Activity Date]<=ed",
              "                                && 'SF Activities'[WhoID]=EARLIER([ContactId])",
              "                                &&",
              "                                   (",
              "                                          (",
              "                                              'SF Activities'[Call Type]=\"Customer Face-to-Face\" || ",
              "                                              'SF Activities'[Call Type]=\"Customer Digital\"      ||",
              "                                              'SF Activities'[Call Type]=\"DSAD\"",
              "                                          )",
              "                                      ||",
              "                                          (",
              "                                                (",
              "                                                'SF Activities'[Activity Record Type]=\"IDS Customer Meeting\" || ",
              "                                                'SF Activities'[Activity Record Type]=\"Clinical Appointment\" || ",
              "                                                'SF Activities'[Activity Record Type]=\"Customer Facing Event\" ||",
              "                                                'SF Activities'[Activity Record Type]=\"Email\" ||",
              "                                                'SF Activities'[Activity Record Type]=\"Internal Meeting\" ||    ",
              "                                                'SF Activities'[Activity Record Type]=\"Phone call (Inbound)\" ||",
              "                                                'SF Activities'[Activity Record Type]=\"Phone call (Outbound)\" ||",
              "                                                'SF Activities'[Activity Record Type]=\"Online event\" ||",
              "                                                'SF Activities'[Activity Record Type]=\"Visit\" ||",
              "                                                'SF Activities'[Activity Record Type]=\"Calendar Meeting\" ||",
              "                                                'SF Activities'[Activity Record Type]=\"Digital Touchpoints\")",
              "                                          )",
              "                                    )",
              "                            )",
              "                   ),",
              "",
              "    \"Retrain\",",
              "                COUNTROWS(",
              "                    FILTER('SF Activities',",
              "                            'SF Activities'[Role Type]=\"CS\" ",
              "                                && 'SF Activities'[Activity Date]<=ed && 'SF Activities'[Activity Date]>=regd",
              "                                && 'SF Activities'[WhoID]=EARLIER([ContactId])",
              "                                &&",
              "                                   (",
              "                                          (",
              "                                              'SF Activities'[Call Type]=\"Customer Face-to-Face\" || ",
              "                                              'SF Activities'[Call Type]=\"Customer Digital\"      ||",
              "                                              'SF Activities'[Call Type]=\"DSAD\"",
              "                                          )",
              "                                      ||",
              "                                          (",
              "                                                (",
              "                                                'SF Activities'[Activity Record Type]=\"IDS Customer Meeting\" || ",
              "                                                'SF Activities'[Activity Record Type]=\"Clinical Appointment\" || ",
              "                                                'SF Activities'[Activity Record Type]=\"Customer Facing Event\" ||",
              "                                                'SF Activities'[Activity Record Type]=\"Email\" ||",
              "                                                'SF Activities'[Activity Record Type]=\"Internal Meeting\" ||    ",
              "                                                'SF Activities'[Activity Record Type]=\"Phone call (Inbound)\" ||",
              "                                                'SF Activities'[Activity Record Type]=\"Phone call (Outbound)\" ||",
              "                                                'SF Activities'[Activity Record Type]=\"Online event\" ||",
              "                                                'SF Activities'[Activity Record Type]=\"Visit\" ||",
              "                                                'SF Activities'[Activity Record Type]=\"Calendar Meeting\" ||",
              "                                                'SF Activities'[Activity Record Type]=\"Digital Touchpoints\")",
              "                                          )",
              "                                    )",
              "                            )",
              "                   ),",
              "",
              "    BLANK()",
              ")"
            ]
          },
          {
            "type": "calculated",
            "name": "Pre TouchPoints TM",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": [
              "",
              "    ",
              "    VAR ed='Mentoring Event'[Event Date]",
              "    VAR regd='Mentoring Event'[Registration Date]",
              "",
              "    RETURN",
              "    SWITCH(",
              "        [Is Retraining],",
              "",
              "        \"New Doctor\",",
              "                COUNTROWS(FILTER('SF Activities',",
              "                    'SF Activities'[Role Type]=\"SL\" ",
              "                    && 'SF Activities'[Activity Date]<=ed",
              "                    && 'SF Activities'[WhoID]=EARLIER([ContactId])",
              "                    &&",
              "                        (",
              "                            ('SF Activities'[Call Type]=\"Customer Face-to-Face\" || ",
              "                             'SF Activities'[Call Type]=\"Customer Digital\"      ||",
              "                             'SF Activities'[Call Type]=\"DSAD\"",
              "                            )",
              "",
              "                           ||",
              "                            (                                    ",
              "                                ('SF Activities'[Activity Record Type]=\"Visit\" || ",
              "                                 'SF Activities'[Activity Record Type]=\"iTero Practice Day\" || ",
              "                                 'SF Activities'[Activity Record Type]=\"iTero demo\" ||",
              "                                 'SF Activities'[Activity Record Type]=\"Digital Touchpoints\")        ",
              "                               ||",
              "                                  (",
              "                                    'SF Activities'[Activity Record Type]=\"Calendar Meeting\" &&",
              "                                    ('SF Activities'[Call Type]=\"Visit\" || ",
              "                                     'SF Activities'[Call Type]=\"Face-to-Face\" ||",
              "                                     'SF Activities'[Call Type]=\"Digital\" ||",
              "                                     'SF Activities'[Call Type]=\"Phone Call\" ||",
              "                                     ISBLANK('SF Activities'[Call Type]))",
              "                                   )",
              "                                    ",
              "                              )",
              "                          )",
              "        ",
              "                      )),",
              "            ",
              "",
              "        \"Retrain\",",
              "                COUNTROWS(FILTER('SF Activities',",
              "                    'SF Activities'[Role Type]=\"SL\" ",
              "                    && 'SF Activities'[Activity Date]<=ed && 'SF Activities'[Activity Date]>=regd",
              "                    && 'SF Activities'[WhoID]=EARLIER([ContactId])",
              "                    &&",
              "                        (",
              "                            ('SF Activities'[Call Type]=\"Customer Face-to-Face\" || ",
              "                             'SF Activities'[Call Type]=\"Customer Digital\"      ||",
              "                             'SF Activities'[Call Type]=\"DSAD\"",
              "                            )",
              "",
              "                           ||",
              "                            (                                    ",
              "                                ('SF Activities'[Activity Record Type]=\"Visit\" || ",
              "                                 'SF Activities'[Activity Record Type]=\"iTero Practice Day\" || ",
              "                                 'SF Activities'[Activity Record Type]=\"iTero demo\" ||",
              "                                 'SF Activities'[Activity Record Type]=\"Digital Touchpoints\")        ",
              "                               ||",
              "                                  (",
              "                                    'SF Activities'[Activity Record Type]=\"Calendar Meeting\" &&",
              "                                    ('SF Activities'[Call Type]=\"Visit\" || ",
              "                                     'SF Activities'[Call Type]=\"Face-to-Face\" ||",
              "                                     'SF Activities'[Call Type]=\"Digital\" ||",
              "                                     'SF Activities'[Call Type]=\"Phone Call\" ||",
              "                                     ISBLANK('SF Activities'[Call Type]))",
              "                                   )",
              "                                    ",
              "                              )",
              "                          )",
              "        ",
              "                      )),",
              "            ",
              "        BLANK()",
              "    )",
              "",
              ""
            ]
          },
          {
            "type": "calculated",
