      {
        "name": "Orders Status",
        "isHidden": true,
        "columns": [
          {
            "name": "OrderKey",
            "dataType": "int64",
            "sourceColumn": "OrderKey",
            "sourceProviderType": "BigInt"
          },
          {
            "name": "OrderStatusKey",
            "dataType": "int64",
            "sourceColumn": "OrderStatusKey",
            "sourceProviderType": "SmallInt"
          },
          {
            "name": "StatusDate",
            "dataType": "dateTime",
            "sourceColumn": "StatusDate",
            "formatString": "Short Date",
            "sourceProviderType": "VarChar",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"DateTimeShortDatePattern\" />"
              }
            ]
          },
          {
            "name": "CustomerKey",
            "dataType": "int64",
            "sourceColumn": "CustomerKey",
            "sourceProviderType": "Integer"
          },
          {
            "name": "NextStatusKey",
            "dataType": "int64",
            "sourceColumn": "NextStatusKey",
            "sourceProviderType": "SmallInt"
          },
          {
            "name": "DaysToNextStatus",
            "dataType": "int64",
            "sourceColumn": "DaysToNextStatus",
            "sourceProviderType": "Integer"
          },
          {
            "name": "Submit to AMR days",
            "dataType": "int64",
            "sourceColumn": "Submit to AMR days",
            "sourceProviderType": "Integer"
          },
          {
            "name": "CCUD Duration",
            "dataType": "int64",
            "sourceColumn": "CCUD Duration",
            "sourceProviderType": "Integer"
          },
          {
            "name": "CCMODS Count",
            "dataType": "int64",
            "sourceColumn": "CCMODS Count"
          },
          {
            "name": "AMR to CCA days",
            "dataType": "int64",
            "sourceColumn": "AMR to CCA days"
          }
        ],
        "partitions": [
          {
            "name": "Orders Status",
            "dataView": "full",
            "source": {
              "type": "query",
              "query": [
                "with fos as (",
                "\tselect ",
                "\t\tf.[OrderKey],",
                "\t\tf.[OrderStatusKey],",
                "\t\tf.[StatusDate],",
                "\t\to.CustomerKey,",
                "",
                "        LEAD(OrderStatusKey,1) over (partition by f.OrderKey order by f.StatusDate, f.OrderStatusKey, f.[LastStatusDatetime]) as  NextStatusKey,\t\t",
                "        DATEDIFF(day,StatusDate,LEAD(StatusDate,1) over (partition by f.OrderKey order by f.StatusDate, f.OrderStatusKey, f.[LastStatusDatetime])) as  DaysToNextStatus,",
                "",
                "\t\tCASE WHEN OrderStatusKey=80 THEN",
                "\t\t\t\tDATEDIFF(day,",
                "\t\t\t\t\tMIN( CASE f.OrderStatusKey WHEN 40 THEN f.StatusDate ELSE NULL END) over (partition by f.OrderKey order by f.StatusDate, f.OrderStatusKey, f.[LastStatusDatetime]), --First Submit",
                "\t\t\t\t\tMAX( CASE f.OrderStatusKey WHEN 80 THEN f.StatusDate ELSE NULL END) over (partition by f.OrderKey order by f.StatusDate, f.OrderStatusKey, f.[LastStatusDatetime]) --AMR",
                "\t\t\t\t\t)",
                "\t\tELSE NULL END as [Submit to AMR days],",
                "",
                "\t\tCASE WHEN OrderStatusKey=100 THEN",
                "\t\t\t\tDATEDIFF(day,",
                "\t\t\t\t\tMIN( CASE f.OrderStatusKey WHEN 80 THEN f.StatusDate ELSE NULL END) over (partition by f.OrderKey order by f.StatusDate, f.OrderStatusKey, f.[LastStatusDatetime]), --First AMR",
                "\t\t\t\t\tMAX( CASE f.OrderStatusKey WHEN 100 THEN f.StatusDate ELSE NULL END) over (partition by f.OrderKey order by f.StatusDate, f.OrderStatusKey, f.[LastStatusDatetime]) --Last CCA",
                "\t\t\t\t\t)",
                "\t\tELSE NULL END as [AMR to CCA days],",
                "",
                "\t\tCASE WHEN OrderStatusKey=100 THEN",
                "\t\t\t\tSUM(CASE f.OrderStatusKey WHEN 82 THEN 1 ELSE 0 END) over (partition by f.OrderKey order by f.StatusDate, f.OrderStatusKey, f.[LastStatusDatetime])",
                "\t\tELSE NULL END as [CCMODS Count]",
                "",
                "",
                "\tfrom [DM].[FactOrderStatusRecurring] f",
                "\t\tinner join [TABV].[PrimaryOrder_EMEA] o on f.OrderKey=o.OrderKey",
                "\twhere",
                "\t\t--c.[AccountCountry]='Russia'  ",
                "\t o.SubmitDate>='2018-01-01'",
                ")",
                "select ",
                "\tfos.*,  ",
                "\tcase when OrderStatusKey=85 and DaysToNextStatus IS NOT NULL THEN DaysToNextStatus ELSE NULL END as [CCUD Duration]",
                "from fos"
              ],
              "dataSource": "OTCDM"
            },
            "annotations": [
              {
                "name": "QueryEditorSerialization",
                "value": [
                  "<?xml version=\"1.0\" encoding=\"UTF-16\"?><Gemini xmlns=\"QueryEditorSerialization\"><AnnotationContent><![CDATA[<RSQueryCommandText>with fos as (",
                  "\tselect ",
                  "\t\tf.[OrderKey],",
                  "\t\tf.[OrderStatusKey],",
                  "\t\tf.[StatusDate],",
                  "\t\to.CustomerKey,",
                  "",
                  "        LEAD(OrderStatusKey,1) over (partition by f.OrderKey order by f.StatusDate, f.OrderStatusKey, f.[LastStatusDatetime]) as  NextStatusKey,\t\t",
                  "        DATEDIFF(day,StatusDate,LEAD(StatusDate,1) over (partition by f.OrderKey order by f.StatusDate, f.OrderStatusKey, f.[LastStatusDatetime])) as  DaysToNextStatus,",
                  "",
                  "\t\tCASE WHEN OrderStatusKey=80 THEN",
                  "\t\t\t\tDATEDIFF(day,",
                  "\t\t\t\t\tMIN( CASE f.OrderStatusKey WHEN 40 THEN f.StatusDate ELSE NULL END) over (partition by f.OrderKey order by f.StatusDate, f.OrderStatusKey, f.[LastStatusDatetime]), --First Submit",
                  "\t\t\t\t\tMAX( CASE f.OrderStatusKey WHEN 80 THEN f.StatusDate ELSE NULL END) over (partition by f.OrderKey order by f.StatusDate, f.OrderStatusKey, f.[LastStatusDatetime]) --AMR",
                  "\t\t\t\t\t)",
                  "\t\tELSE NULL END as [Submit to AMR days],",
                  "",
                  "\t\tCASE WHEN OrderStatusKey=100 THEN",
                  "\t\t\t\tDATEDIFF(day,",
                  "\t\t\t\t\tMIN( CASE f.OrderStatusKey WHEN 80 THEN f.StatusDate ELSE NULL END) over (partition by f.OrderKey order by f.StatusDate, f.OrderStatusKey, f.[LastStatusDatetime]), --First AMR",
                  "\t\t\t\t\tMAX( CASE f.OrderStatusKey WHEN 100 THEN f.StatusDate ELSE NULL END) over (partition by f.OrderKey order by f.StatusDate, f.OrderStatusKey, f.[LastStatusDatetime]) --Last CCA",
                  "\t\t\t\t\t)",
                  "\t\tELSE NULL END as [AMR to CCA days],",
                  "",
                  "\t\tCASE WHEN OrderStatusKey=100 THEN",
                  "\t\t\t\tSUM(CASE f.OrderStatusKey WHEN 82 THEN 1 ELSE 0 END) over (partition by f.OrderKey order by f.StatusDate, f.OrderStatusKey, f.[LastStatusDatetime])",
                  "\t\tELSE NULL END as [CCMODS Count]",
                  "",
                  "",
                  "\tfrom [DM].[FactOrderStatusRecurring] f",
                  "\t\tinner join [TABV].[PrimaryOrder_EMEA] o on f.OrderKey=o.OrderKey",
                  "\twhere",
                  "\t\t--c.[AccountCountry]='Russia'  ",
                  "\t o.SubmitDate>='2018-01-01'",
                  ")",
                  "select ",
                  "\tfos.*,  ",
                  "\tcase when OrderStatusKey=85 and DaysToNextStatus IS NOT NULL THEN DaysToNextStatus ELSE NULL END as [CCUD Duration]",
                  "from fos</RSQueryCommandText><RSQueryCommandType>Text</RSQueryCommandType><RSQueryDesignState></RSQueryDesignState>]]></AnnotationContent></Gemini>"
                ]
              }
            ]
          }
        ],
