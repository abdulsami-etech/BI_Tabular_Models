              "                                    ",
              "                              )",
              "                          )",
              "        ",
              "                      ))"
            ]
          },
          {
            "type": "calculated",
            "name": "CCA 270",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "isHidden": true,
            "expression": [
              "",
              "VAR day270=[Event Date]+270",
              "",
              "RETURN",
              "IF(",
              "    NOT ISBLANK([ContactKey]),",
              "",
              "    IF(",
              "        [Days After Event]>=270,",
              "        CALCULATE(",
              "                    SUM('Sales Data'[CCA]),",
              "                    ALL('Sales Data'[StatusDate]),",
              "                    'Sales Data'[StatusDate]>=EARLIER([Event Date]) && 'Sales Data'[StatusDate]<day270",
              "                ),",
              "        BLANK()",
              "    )",
              "    ,BLANK()",
              ")"
            ]
          },
          {
            "type": "calculated",
            "name": "NR 270",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "isHidden": true,
            "expression": [
              "",
              "VAR day270=[Event Date]+270",
              "",
              "RETURN",
              "IF(",
              "    NOT ISBLANK([ContactKey]),",
              "",
              "    IF(",
              "        [Days After Event]>=270,",
              "        CALCULATE(",
              "                    SUM('Sales Data'[NR]),",
              "                    ALL('Sales Data'[StatusDate]),",
              "                    'Sales Data'[StatusDate]>=EARLIER([Event Date]) && 'Sales Data'[StatusDate]<day270",
              "                ),",
              "        BLANK()",
              "    )",
              "    ,BLANK()",
              ")"
            ]
          },
          {
            "type": "calculated",
            "name": "JTG270",
            "dataType": "double",
            "isDataTypeInferred": true,
            "isHidden": true,
            "expression": [
              "",
              "VAR accJTG=LOOKUPVALUE('JTG'[Accumulated],'JTG'[Month],9)",
              "",
              "RETURN",
              "IF(",
              "    [Event Status]=\"Completed\" && [Days After Event]>=270",
              "    ,[CCA 270]-accJTG",
              "    ,BLANK()",
              ")"
            ]
          },
          {
            "type": "calculated",
            "name": "JTG365",
            "dataType": "double",
            "isDataTypeInferred": true,
            "isHidden": true,
            "expression": [
              "",
              "VAR accJTG=LOOKUPVALUE('JTG'[Accumulated],'JTG'[Month],12)",
              "",
              "RETURN",
              "IF(",
              "    [Event Status]=\"Completed\" && [Days After Event]>=365",
              "    ,[CCA365]-accJTG",
              "    ,BLANK()",
              ")"
            ]
          },
          {
            "type": "calculated",
            "name": "JTP270",
            "dataType": "double",
            "isDataTypeInferred": true,
            "isHidden": true,
            "expression": [
              "",
              "VAR accJTP=LOOKUPVALUE('JTP'[Cases per Doctor],'JTP'[Month],9)",
              "",
              "RETURN",
              "IF(",
              "    [Event Status]=\"Completed\" && [Days After Event]>=270",
              "    ,[CCA 270]-accJTP",
              "    ,BLANK()",
              ")"
            ]
          },
          {
            "type": "calculated",
            "name": "JTP365",
            "dataType": "double",
            "isDataTypeInferred": true,
            "isHidden": true,
            "expression": [
              "",
              "VAR accJTP=LOOKUPVALUE('JTP'[Cases per Doctor],'JTP'[Month],12)",
              "",
              "RETURN",
              "IF(",
              "    [Event Status]=\"Completed\" && [Days After Event]>=365",
              "    ,[CCA365]-accJTP",
              "    ,BLANK()",
              ")"
            ]
          },
          {
            "type": "calculated",
            "name": "CCA45",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "isHidden": true,
            "expression": [
              "",
              "VAR day45=[Event Date]+45",
              "",
              "RETURN",
              "",
              "IF(",
              "    NOT ISBLANK([ContactKey]),",
              "",
              "    IF(",
              "        [Days After Event]>=45,",
              "        CALCULATE(",
              "                    SUM('Sales Data'[CCA]),",
              "                    ALL('Sales Data'[StatusDate]),",
              "                    'Sales Data'[StatusDate]>=EARLIER([Event Date]) && 'Sales Data'[StatusDate]<day45",
              "                ),",
              "        BLANK()",
              "    )",
              "    ,BLANK()",
              ")",
              ""
            ]
          }
        ],
        "partitions": [
          {
            "name": "Mentoring Event",
            "dataView": "full",
            "source": {
              "type": "query",
              "query": [
                "SELECT ",
                "    c.[CampaignID]      as [Campaign ID],",
                "    c.CampaignName      as [Event Name],",
                "    c.EventDate         as [Event Date],",
                "    c.[Status]          as [Event Status],",
                "    CASE    WHEN c.EventCountry in ('GB', 'IE') THEN 'UKI' ",
                "            WHEN c.EventCountry in ('FR') THEN 'FRANCE' ",
                "            WHEN c.EventCountry in ('DE', 'AT', 'CH') THEN 'DACH' ",
                "            WHEN c.EventCountry in ('ES', 'PT') THEN 'IBERIA' ",
                "            WHEN c.EventCountry in ('IT', 'SM', 'MT') THEN 'ITALY' ",
                "            WHEN c.EventCountry in ('CZ', 'SK', 'LV', 'LT', 'EE', 'HU', 'RO', 'BG', 'GR', 'CY', 'SI', 'IL', 'HR', 'RS', 'GE') THEN 'CEBI' ",
                "            WHEN c.EventCountry in ('PL') THEN 'Poland'",
                "            WHEN c.EventCountry in ('NL', 'BE', 'LU') THEN 'BENELUX' ",
                "            WHEN c.EventCountry in ('DK', 'SE', 'NO', 'FI', 'IS') THEN 'NORDICS' ",
                "            WHEN c.EventCountry in ('TR') THEN 'TURKEY'",
                "            WHEN c.EventCountry in ('RU') THEN 'RUSSIA'",
                "            WHEN c.EventCountry in ('AE','KW','SA','BH','QA','MA','ZA','DZ','GH','KE','NG','TN') THEN 'MEA'",
                "    ELSE 'Unknown' END  as [Event Region],",
                "    c.EventCountry      as [Event Country],",
                "    c.EventCity         as [Event City],",
                "    c.DoctorType        as [Event Doctor Type],",
                "    c.EventTypePicklist as [Event Type],",
                "    CASE c.EventTypePicklist ",
                "        WHEN 'MD 1'     THEN 'Mentoring'",
                "        WHEN 'DSO MD1'  THEN 'DSO Mentoring'",
                "        WHEN 'ETC1'     THEN 'External Certification'",
                "        WHEN 'TCA'      THEN 'Go Activation Internal'",
                "        WHEN 'ETCA'     THEN 'Go Activation External'",
                "    END as [Event Type Descr],",
                "    c.EventSubType      as [Event SubType],",
                "    ",
                "    sp.[ContactName]    as [Event Speaker],",
                "",
                "    m.CampaignMemberID as MemberID,",
                "    m.LeadId as LeadId,",
                "    m.[LeadOrContactId],",
                "    m.[Name]           as [Doctor Name],",
                "    CASE WHEN m.LeadID IS NOT NULL THEN  'New Doctor' ELSE 'Retrain' END as [Is Retraining],",
                "    m.[Status]         as [Registration Status],",
                "    m.[IsAttended],",
                "    m.[LeadSource]     as [Lead Source],",
                "    m.[FirstRespondedDate] as [Registration Date],",
                "    ",
                "    m.DIDNumber as [Account Number],",
                "    cont.[ContactClinID] as [Clin ID],",
                "    cont.ContactKey,",
                "    cont.ContactID,",
                "    cont.ContactLineofBusiness,",
                "    cont.ContactProfessionalCategory,",
                "    cont.ContactEmail,",
                "    cont.ContactPhone,",
                "    cont.ContactMobile,",
                "    cont.ContactCountry,",
                "    acc.AccountCountry,",
                "    acc.AccountCity,",
                "",
                "    u.UserName as [Owner User Name],",
                "    ",
                "    sh.[SalesCountryGroupPerson],",
                "    sh.[SalesRegionalVPPerson],",
                "    sh.[SalesAreaPerson],",
                "    sh.[SalesRegionPerson],",
                "    sh.[SalesTerritoryPerson],",
                "",
                "    sh.[SalesCountryGroupIdentifier],",
                "    sh.[SalesRegionalVPIdentifier],",
                "    sh.[SalesAreaIdentifier],",
                "    sh.[SalesRegionIdentifier],",
                "    sh.[SalesTerritoryIdentifier]",
                "",
                "",
                "FROM [DM].[DimCampaign] c",
                "    INNER JOIN [DM].[DimCampaignMember] m on m.CampaignId=c.CampaignId",
                "    LEFT JOIN [DM].[DimCustContact] sp on sp.ContactID=c.Speaker1",
                "    LEFT JOIN [DM].[DimCustContact] cont on cont.ContactAccountNumber=m.DIDNumber and (cont.ContactRecordType='Doctor' or (cont.ContactClinID is not null) )",
                "    LEFT JOIN [DM].[DimLead] lead on lead.LeadID=m.LeadID",
                "    LEFT JOIN [DM].[DimUser] u on u.UserID=ISNULL(cont.ContactOwnerID,lead.OwnerID)",
                "    LEFT JOIN [DM].[DimCustAccount] acc on acc.AccountNumber=m.DIDNumber",
                "    LEFT JOIN [DSV].[SalesTerritoryHierarchy] sh on sh.AccountKey = acc.AccountKey and sh.ContactKey = cont.ContactKey and sh.TerritoryType = N'Invisalign'",
                "",
                "WHERE",
                "    (c.EventTypePicklist IN ('DSO MD1','MD 1','ETCA','ETC1','TCA'))",
                "",
                "    and c.IsDeleted='false'",
                "    and c.[Status] in ('Planned', 'Completed')",
                "    and m.IsDeleted='false'",
                "    and m.[Status] in ('Attended','Registered')",
                "    ",
                "    --TEMPORARY FIX",
                "    and m.CampaignMemberID not in ('00v0H00001XpPIuQAN','00v6S00001auRCoQAM')"
              ],
              "dataSource": "OTCDM"
            },
            "annotations": [
              {
                "name": "QueryEditorSerialization",
                "value": [
                  "<?xml version=\"1.0\" encoding=\"UTF-16\"?><Gemini xmlns=\"QueryEditorSerialization\"><AnnotationContent><![CDATA[<RSQueryCommandText>SELECT ",
                  "    c.[CampaignID]      as [Campaign ID],",
                  "    c.CampaignName      as [Event Name],",
                  "    c.EventDate\t        as [Event Date],",
                  "    c.[Status]          as [Event Status],",
                  "    CASE\tWHEN c.EventCountry in ('GB', 'IE') THEN 'UKI' ",
                  "\t\t\tWHEN c.EventCountry in ('FR') THEN 'FRANCE' ",
                  "\t\t\tWHEN c.EventCountry in ('DE', 'AT', 'CH') THEN 'DACH' ",
                  "\t\t\tWHEN c.EventCountry in ('ES', 'PT') THEN 'IBERIA' ",
                  "\t\t\tWHEN c.EventCountry in ('IT', 'SM', 'MT') THEN 'ITALY' ",
                  "\t\t\tWHEN c.EventCountry in ('PL', 'CZ', 'SK', 'LV', 'LT', 'EE', 'HU', 'RO', 'BG', 'GR', 'CY', 'SI', 'IL') THEN 'EE' ",
                  "\t\t\tWHEN c.EventCountry in ('NL', 'BE', 'LU') THEN 'BENELUX' ",
                  "\t\t\tWHEN c.EventCountry in ('DK', 'SE', 'NO', 'FI') THEN 'NORDICS' ",
                  "\t\t\tWHEN c.EventCountry in ('TR') THEN 'TURKEY'",
                  "\t\t\tWHEN c.EventCountry in ('RU') THEN 'RUSSIA'",
                  "\t\t\tWHEN c.EventCountry in ('AE', 'KW',  'SA', 'BH', 'QA') THEN 'MEA'",
                  "\tELSE 'Unknown' END  as [Event Region],",
                  "\tc.EventCountry      as [Event Country],",
                  "    c.EventCity         as [Event City],",
                  "\tc.DoctorType        as [Event Doctor Type],",
                  "\tc.EventTypePicklist as [Event Type],",
                  "\tCASE c.EventTypePicklist ",
                  "\t\tWHEN 'MD 1'\t\tTHEN 'Mentoring'",
                  "\t\tWHEN 'DSO MD1'\tTHEN 'DSO Mentoring'",
                  "\t\tWHEN 'ETC1'\t\tTHEN 'External Certification'",
                  "\t\tWHEN 'TCA'\t\tTHEN 'Go Activation Internal'",
                  "\t\tWHEN 'ETCA'\t\tTHEN 'Go Activation External'",
                  "\tEND as [Event Type Descr],",
                  "\tc.EventSubType\t\tas [Event SubType],",
                  "\t",
                  "\tsp.[ContactName]    as [Event Speaker],",
                  "",
                  "    m.CampaignMemberID as MemberID,",
                  "\tm.LeadId as LeadId,",
                  "\tm.[LeadOrContactId],",
                  "\tm.[Name]           as [Doctor Name],",
                  "\tCASE WHEN m.LeadID IS NOT NULL THEN  'New Doctor' ELSE 'Retrain' END as [Is Retraining],",
                  "\tm.[Status]         as [Registration Status],",
                  "\tm.[IsAttended],",
                  "\tm.[LeadSource]     as [Lead Source],",
                  "\tm.[FirstRespondedDate] as [Registration Date],",
                  "\t",
                  "\tm.DIDNumber as [Account Number],",
                  "\tcont.[ContactClinID] as [Clin ID],",
                  "\tcont.ContactKey,",
                  "\tcont.ContactID,",
                  "\tcont.ContactLineofBusiness,",
                  "\tcont.ContactProfessionalCategory,",
                  "\tcont.ContactEmail,",
                  "\tcont.ContactPhone,",
                  "\tcont.ContactMobile,",
                  "\tcont.ContactCountry,",
                  "\tacc.AccountCountry,",
                  "\tacc.AccountCity,",
                  "",
                  "\tu.UserName as [Owner User Name],",
                  "\t",
                  "\tsh.[SalesCountryGroupPerson],",
                  "\tsh.[SalesRegionalVPPerson],",
                  "\tsh.[SalesAreaPerson],",
                  "\tsh.[SalesRegionPerson],",
                  "\tsh.[SalesTerritoryPerson],",
                  "",
                  "\tsh.[SalesCountryGroupIdentifier],",
                  "\tsh.[SalesRegionalVPIdentifier],",
                  "\tsh.[SalesAreaIdentifier],",
                  "\tsh.[SalesRegionIdentifier],",
                  "\tsh.[SalesTerritoryIdentifier]",
                  "",
                  "",
                  "FROM [DM].[DimCampaign] c",
                  "\tINNER JOIN [DM].[DimCampaignMember] m on m.CampaignId=c.CampaignId",
                  "\tLEFT JOIN [DM].[DimCustContact] sp on sp.ContactID=c.Speaker1",
                  "\tLEFT JOIN [DM].[DimCustContact] cont on cont.ContactAccountNumber=m.DIDNumber and (cont.ContactRecordType='Doctor' or (cont.ContactClinID is not null) )",
                  "\tLEFT JOIN [DM].[DimLead] lead on lead.LeadID=m.LeadID",
                  "\tLEFT JOIN [DM].[DimUser] u on u.UserID=ISNULL(cont.ContactOwnerID,lead.OwnerID)",
                  "\tLEFT JOIN [DM].[DimCustAccount] acc on acc.AccountNumber=m.DIDNumber",
                  "\tLEFT JOIN [DSV].[SalesTerritoryHierarchy] sh on sh.AccountKey = acc.AccountKey and sh.ContactKey = cont.ContactKey and sh.TerritoryType = N'Invisalign'",
                  "",
                  "WHERE",
                  "    (c.EventTypePicklist IN ('DSO MD1','MD 1','ETCA','ETC1','TCA'))",
                  "",
                  "\tand c.IsDeleted='false'",
                  "\tand c.[Status] in ('Planned', 'Completed')",
                  "\tand m.IsDeleted='false'",
                  "\tand m.[Status] in ('Attended','Registered')</RSQueryCommandText><RSQueryCommandType>Text</RSQueryCommandType><RSQueryDesignState></RSQueryDesignState>]]></AnnotationContent></Gemini>"
                ]
              }
            ]
          }
        ],
        "measures": [
          {
            "name": "NR pre Cert",
            "expression": "SUM([NRBeforeEvent])",
            "displayFolder": "Activation Measures"
          },
          {
            "name": "NR post Cert",
            "expression": "SUM([NRAfterEvent])",
            "displayFolder": "Activation Measures"
          },
          {
            "name": "CCA +30",
            "expression": "SUM([CCA30])",
            "displayFolder": "Activation Measures"
          },
          {
            "name": "CCA +60",
            "expression": "SUM([CCA60])",
            "displayFolder": "Activation Measures"
          },
          {
            "name": "CCA +90",
            "expression": "SUM([CCA90])",
            "displayFolder": "Activation Measures"
          },
          {
            "name": "CCA +120",
            "expression": "SUM([CCA120])",
            "displayFolder": "Activation Measures"
          },
          {
            "name": "CCA +180",
            "expression": "SUM([CCA180])",
            "displayFolder": "Activation Measures"
          },
          {
            "name": "CCA To-Date",
            "expression": "SUM([CCAToDate])",
            "displayFolder": "Activation Measures"
          },
          {
            "name": "NR Avr. pre Cert",
            "expression": [
              "DIVIDE([NR pre Cert],DISTINCTCOUNT('Mentoring Event'[Clin ID]))",
              ""
            ],
            "displayFolder": "Activation Measures"
          },
          {
            "name": "NR Avr. post Cert",
            "expression": "DIVIDE([NR post Cert],DISTINCTCOUNT('Mentoring Event'[Clin ID]))",
            "displayFolder": "Activation Measures"
          },
          {
            "name": "Avr. CCA +30",
            "expression": [
              "",
              "CALCULATE(",
              "    DIVIDE([CCA +30],DISTINCTCOUNT('Mentoring Event'[Clin ID])),",
              "    FILTER('Mentoring Event', [Days After Event]>=30)",
              ")",
              ""
            ],
            "formatString": "0.0",
            "displayFolder": "Activation Measures"
          },
          {
            "name": "Avr. CCA +60",
            "expression": [
              "",
              "CALCULATE(",
              "    DIVIDE([CCA +60],DISTINCTCOUNT('Mentoring Event'[Clin ID])),",
              "    FILTER('Mentoring Event', [Days After Event]>=60)",
              ")",
              ""
            ],
            "formatString": "0.0",
            "displayFolder": "Activation Measures"
          },
          {
            "name": "Avr. CCA +90",
            "expression": [
              "",
              "CALCULATE(",
              "    DIVIDE([CCA +90],DISTINCTCOUNT('Mentoring Event'[Clin ID])),",
              "    FILTER('Mentoring Event', [Days After Event]>=90)",
              ")",
              ""
            ],
            "formatString": "0.0",
            "displayFolder": "Activation Measures"
          },
          {
            "name": "Avr. CCA +120",
            "expression": [
              "",
              "CALCULATE(",
              "    DIVIDE([CCA +120],DISTINCTCOUNT('Mentoring Event'[Clin ID])),",
              "    FILTER('Mentoring Event', [Days After Event]>=120)",
              ")",
              ""
            ],
            "formatString": "0.0",
            "displayFolder": "Activation Measures"
          },
          {
            "name": "Avr. CCA +180",
            "expression": [
              "",
              "CALCULATE(",
              "    DIVIDE([CCA +180],DISTINCTCOUNT('Mentoring Event'[Clin ID])),",
              "    FILTER('Mentoring Event', [Days After Event]>=180)",
              ")"
            ],
            "formatString": "0.0",
            "displayFolder": "Activation Measures"
          },
          {
            "name": "Avr. CCA To-Date",
            "expression": "DIVIDE([CCA To-Date],DISTINCTCOUNT('Mentoring Event'[Clin ID]))",
            "formatString": "0.0",
            "displayFolder": "Activation Measures"
          },
          {
            "name": "Doctors Count",
            "expression": [
              "DISTINCTCOUNT('Mentoring Event'[Clin ID])",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "Activation Measures"
          },
          {
            "name": "JTG 30",
            "expression": "SUM([JTG30])",
            "formatString": "0",
            "displayFolder": "Activation Measures"
          },
          {
            "name": "JTG 60",
            "expression": [
              "SUM([JTG60])",
              ""
            ],
            "formatString": "0",
            "displayFolder": "Activation Measures"
          },
          {
            "name": "JTG 90",
            "expression": [
              "SUM([JTG90])",
              ""
            ],
            "formatString": "0",
            "displayFolder": "Activation Measures"
          },
          {
            "name": "JTG 120",
            "expression": [
              "SUM([JTG120])",
              ""
            ],
            "formatString": "0",
            "displayFolder": "Activation Measures"
          },
          {
            "name": "JTG 180",
            "expression": [
              "SUM([JTG180])",
              ""
            ],
            "formatString": "0",
            "displayFolder": "Activation Measures"
          },
          {
            "name": "Pre Visits Avr.",
            "expression": "DIVIDE([Pre Cert Touch Points],[Doctors Count])",
            "formatString": "0.0",
            "displayFolder": "Activation Measures"
          },
          {
            "name": "Post Visits Avr.",
            "expression": "DIVIDE([Post Cert Touch Points],[Doctors Count])",
            "formatString": "0.0",
            "displayFolder": "Activation Measures"
          },
          {
            "name": "JTG/Doc 30",
            "expression": "DIVIDE(SUM([JTG30]),[Doctors Count])",
            "formatString": "0.0",
            "displayFolder": "Activation Measures"
          },
          {
            "name": "JTG/Doc 60",
            "expression": "DIVIDE(SUM([JTG60]),[Doctors Count])",
            "formatString": "0.0",
            "displayFolder": "Activation Measures"
          },
          {
            "name": "JTG/Doc 90",
            "expression": [
              "DIVIDE(SUM([JTG90]),[Doctors Count])",
              ""
            ],
            "formatString": "0.0",
            "displayFolder": "Activation Measures"
          },
          {
            "name": "JTG/Doc 120",
            "expression": [
              "DIVIDE(SUM([JTG120]),[Doctors Count])",
              ""
            ],
            "formatString": "0.0",
            "displayFolder": "Activation Measures"
          },
          {
            "name": "JTG/Doc 180",
            "expression": "DIVIDE(SUM([JTG180]),[Doctors Count])",
            "formatString": "0.0",
            "displayFolder": "Activation Measures"
          },
          {
            "name": "Stickness 90",
            "expression": [
              "",
              "",
              "",
              "CALCULATE(",
              "   ",
              "    VAR allCurrentDoctors=COUNTROWS(FILTER('Mentoring Event',[Days After Event]>=90))",
              "    VAR submitters=COUNTROWS(FILTER('Mentoring Event',[Days After Event]>=90 && [CCA90]>0))",
              "",
              "    RETURN DIVIDE(submitters,allCurrentDoctors)",
              ")"
            ],
            "formatString": "0%;-0%;0%",
            "displayFolder": "Activation Measures"
          },
          {
            "name": "Stickness 180",
            "expression": [
              "",
              "",
              "",
              "CALCULATE(",
              "   ",
              "    VAR allCurrentDoctors=COUNTROWS(FILTER('Mentoring Event',[Days After Event]>=180))",
              "    VAR submitters=COUNTROWS(FILTER('Mentoring Event',[Days After Event]>=180 && [CCA180]>0))",
              "",
              "    RETURN DIVIDE(submitters,allCurrentDoctors)",
              ")"
            ],
            "formatString": "0%;-0%;0%",
            "displayFolder": "Activation Measures"
          },
          {
            "name": "CCA +365",
            "expression": [
              "SUM([CCA365])",
              ""
            ],
            "displayFolder": "Activation Measures"
          },
          {
            "name": "Stickness 365",
            "expression": [
              "",
              "",
              "",
              "CALCULATE(",
              "   ",
              "    VAR allCurrentDoctors=COUNTROWS(FILTER('Mentoring Event',[Days After Event]>=365))",
              "    VAR submitters=COUNTROWS(FILTER('Mentoring Event',[Days After Event]>=365 && [CCA365]>0))",
              "",
              "    RETURN DIVIDE(submitters,allCurrentDoctors)",
              ")"
            ],
            "formatString": "0%;-0%;0%",
            "displayFolder": "Activation Measures"
          },
          {
            "name": "NR To-Date",
            "expression": "SUM([NRToDate])",
            "displayFolder": "Activation Measures"
          },
          {
            "name": "Stickness NR 90",
            "expression": [
              "",
              "",
              "CALCULATE(",
              "   ",
              "    VAR allCurrentDoctors=COUNTROWS(FILTER('Mentoring Event',[Days After Event]>=90))",
              "    VAR submitters=COUNTROWS(FILTER('Mentoring Event',[Days After Event]>=90 && [NR90]>0))",
              "",
              "    RETURN DIVIDE(submitters,allCurrentDoctors)",
              ")"
            ],
            "formatString": "0%;-0%;0%",
            "displayFolder": "Activation Measures"
          },
          {
            "name": "Stickness NR 180",
            "expression": [
              "",
              "",
              "",
              "CALCULATE(",
              "   ",
              "    VAR allCurrentDoctors=COUNTROWS(FILTER('Mentoring Event',[Days After Event]>=180))",
              "    VAR submitters=COUNTROWS(FILTER('Mentoring Event',[Days After Event]>=180 && [NR180]>0))",
              "",
              "    RETURN DIVIDE(submitters,allCurrentDoctors)",
              ")"
            ],
            "formatString": "0%;-0%;0%",
            "displayFolder": "Activation Measures"
          },
          {
            "name": "Stickness NR 365",
            "expression": [
              "",
              "",
              "",
              "CALCULATE(",
              "   ",
              "    VAR allCurrentDoctors=COUNTROWS(FILTER('Mentoring Event',[Days After Event]>=365))",
              "    VAR submitters=COUNTROWS(FILTER('Mentoring Event',[Days After Event]>=365 && [NR365]>0))",
              "",
              "    RETURN DIVIDE(submitters,allCurrentDoctors)",
              ")"
            ],
            "formatString": "0%;-0%;0%",
            "displayFolder": "Activation Measures"
          },
