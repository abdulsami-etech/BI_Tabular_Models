      {
        "name": "Orders Pipeline",
        "isHidden": true,
        "columns": [
          {
            "name": "DateKey",
            "dataType": "string",
            "sourceColumn": "DateKey",
            "sourceProviderType": "VarChar"
          },
          {
            "name": "OrderKey",
            "dataType": "int64",
            "sourceColumn": "OrderKey",
            "sourceProviderType": "BigInt"
          },
          {
            "name": "ProductKey",
            "dataType": "int64",
            "sourceColumn": "ProductKey",
            "sourceProviderType": "Integer"
          },
          {
            "name": "CustomerKey",
            "dataType": "int64",
            "sourceColumn": "CustomerKey",
            "sourceProviderType": "Integer"
          },
          {
            "name": "OrderStatusKey",
            "dataType": "int64",
            "sourceColumn": "OrderStatusKey",
            "sourceProviderType": "SmallInt"
          },
          {
            "name": "OrderStatusName",
            "dataType": "string",
            "sourceColumn": "OrderStatusName",
            "sourceProviderType": "VarChar"
          }
        ],
        "partitions": [
          {
            "name": "Orders Pipeline",
            "dataView": "full",
            "source": {
              "type": "query",
              "query": [
                "declare @ld as date",
                "select @ld=DATEADD(day,-1,max(DateKey)) from [DM].[FactPipeline];",
                "",
                "with d as (",
                "select",
                "    f.DateKey,  ",
                "    f.OrderKey,",
                "    isnull(nullif(o.AlignerProdHierKey,-1), o.CaseSetupProdHierKey) as ProductKey,",
                "    o.CustomerKey,",
                "    f.OrderStatusKey,",
                "    s.OrderStatusName",
                "from [DM].[FactPipeline] f",
                "    inner join DM.DimOrder o on o.OrderKey=f.OrderKey",
                "    inner join DM.DimOrderStatus s on f.OrderStatusKey=s.OrderStatusKey",
                "    inner join DM.DimProduct p on isnull(nullif(o.AlignerProdHierKey,-1), o.CaseSetupProdHierKey)=p.ProductKey",
                "where ",
                "    DateKey=@ld",
                "    and o.TreatmentCategory='Primary'",
                "    and p.Level3Name='Treatment'",
                "    and f.OrderStatusKey>=40 and f.OrderStatusKey<=100",
                ")",
                "",
                "select *  from d"
              ],
              "dataSource": "OTCDM"
            },
            "annotations": [
              {
                "name": "QueryEditorSerialization",
                "value": [
                  "<?xml version=\"1.0\" encoding=\"UTF-16\"?><Gemini xmlns=\"QueryEditorSerialization\"><AnnotationContent><![CDATA[<RSQueryCommandText>declare @ld as date",
                  "select @ld=DATEADD(day,-1,max(DateKey)) from [DM].[FactPipeline];",
                  "",
                  "with d as (",
                  "select",
                  "\tf.DateKey,\t",
                  "\tf.OrderKey,",
                  "\to.ProductKey,",
                  "\to.CustomerKey,",
                  "\tf.OrderStatusKey,",
                  "\ts.OrderStatusName",
                  "from [DM].[FactPipeline] f",
                  "\tinner join TABV.PrimaryOrder o on o.OrderKey=f.OrderKey",
                  "\tinner join DM.DimOrderStatus s on f.OrderStatusKey=s.OrderStatusKey",
                  "\tinner join DM.DimProduct p on o.ProductKey=p.ProductKey",
                  "where ",
                  "\tDateKey=@ld",
                  "\tand p.Level3Name='Treatment'",
                  "\tand f.OrderStatusKey>=40 and f.OrderStatusKey<=100",
                  ")",
                  "",
                  "select * from d</RSQueryCommandText><RSQueryCommandType>Text</RSQueryCommandType><RSQueryDesignState></RSQueryDesignState>]]></AnnotationContent></Gemini>"
                ]
              }
            ]
          }
        ],
        "annotations": [
          {
            "name": "_TM_ExtProp_QueryDefinition",
            "value": [
              "declare @ld as date",
              "select @ld=DATEADD(day,-1,max(DateKey)) from [DM].[FactPipeline];",
              "",
              "with d as (",
              "select",
              "\tf.DateKey,\t",
              "\tf.OrderKey,",
              "\to.ProductKey,",
              "\to.CustomerKey,",
              "\tf.OrderStatusKey,",
              "\ts.OrderStatusName",
              "from [DM].[FactPipeline] f",
              "\tinner join TABV.PrimaryOrder o on o.OrderKey=f.OrderKey",
              "\tinner join DM.DimOrderStatus s on f.OrderStatusKey=s.OrderStatusKey",
              "\tinner join DM.DimProduct p on o.ProductKey=p.ProductKey",
              "where ",
              "\tDateKey=@ld",
              "\tand p.Level3Name='Treatment'",
              "\tand f.OrderStatusKey>=40 and f.OrderStatusKey<=100",
              ")",
              "",
              "select * from d"
            ]
          },
          {
            "name": "_TM_ExtProp_DbTableName",
            "value": "Orders Pipeline"
          },
          {
            "name": "QueryEditorSerialization",
            "value": [
              "<?xml version=\"1.0\" encoding=\"UTF-16\"?><Gemini xmlns=\"QueryEditorSerialization\"><AnnotationContent><![CDATA[<RSQueryCommandText>declare @ld as date",
              "select @ld=DATEADD(day,-1,max(DateKey)) from [DM].[FactPipeline];",
              "",
              "with d as (",
              "select",
              "\tf.DateKey,\t",
              "\tf.OrderKey,",
              "\to.ProductKey,",
              "\to.CustomerKey,",
              "\tf.OrderStatusKey,",
              "\ts.OrderStatusName",
              "from [DM].[FactPipeline] f",
              "\tinner join TABV.PrimaryOrder o on o.OrderKey=f.OrderKey",
              "\tinner join DM.DimOrderStatus s on f.OrderStatusKey=s.OrderStatusKey",
              "\tinner join DM.DimProduct p on o.ProductKey=p.ProductKey",
              "where ",
              "\tDateKey=@ld",
              "\tand p.Level3Name='Treatment'",
              "\tand f.OrderStatusKey>=40 and f.OrderStatusKey<=100",
              ")",
              "",
              "select * from d</RSQueryCommandText><RSQueryCommandType>Text</RSQueryCommandType><RSQueryDesignState></RSQueryDesignState>]]></AnnotationContent></Gemini>"
            ]
          }
        ]
      },
