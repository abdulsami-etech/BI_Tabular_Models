      {
        "name": "Sales Date",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Date",
            "dataType": "dateTime",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Date]"
          },
          {
            "type": "calculated",
            "name": "Month Number",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": "MONTH([Date])"
          },
          {
            "type": "calculated",
            "name": "Month Name",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "SWITCH(",
              "[Month Number],",
              "1,\"January\",",
              "2,\"February\",",
              "3,\"March\",",
              "4,\"April\",",
              "5,\"May\",",
              "6,\"June\",",
              "7,\"July\",",
              "8,\"August\",",
              "9,\"September\",",
              "10,\"October\",",
              "11,\"November\",",
              "12,\"December\")"
            ]
          },
          {
            "type": "calculated",
            "name": "Month-Year Name",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "SWITCH(",
              "[Month Number],",
              "1,CONCATENATE(\"Jan \",[Year]),",
              "2,CONCATENATE(\"Feb \",[Year]),",
              "3,CONCATENATE(\"Mar \",[Year]),",
              "4,CONCATENATE(\"Apr \",[Year]),",
              "5,CONCATENATE(\"May \",[Year]),",
              "6,CONCATENATE(\"Jun \",[Year]),",
              "7,CONCATENATE(\"Jul \",[Year]),",
              "8,CONCATENATE(\"Aug \",[Year]),",
              "9,CONCATENATE(\"Sep \",[Year]),",
              "10,CONCATENATE(\"Oct \",[Year]),",
              "11,CONCATENATE(\"Nov \",[Year]),",
              "12,CONCATENATE(\"Dec \",[Year])",
              ")"
            ],
            "sortByColumn": "Month Code"
          },
          {
            "type": "calculated",
            "name": "Year",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": "YEAR([Date])"
          },
          {
            "type": "calculated",
            "name": "Month Code",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": "[Year]*100+[Month Number]"
          }
        ],
        "partitions": [
          {
            "name": "CalculatedTable 1",
            "source": {
              "type": "calculated",
              "expression": [
                "",
                "CALENDAR( MIN('Sales Data'[StatusDate]), MAX('Sales Data'[StatusDate]))"
              ]
            }
          }
        ]
      },
