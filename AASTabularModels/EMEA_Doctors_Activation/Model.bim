          {
            "name": "CCMOD Rate",
            "expression": [
              "",
              "",
              "AVERAGEX(",
              "    'Mentoring Event',",
              "",
              "    VAR eventDate='Mentoring Event'[Event Date]",
              "    ",
              "    RETURN ",
              "    CALCULATE( AVERAGE('Orders Status'[CCMODS Count]), 'Orders Status'[StatusDate]>=eventDate, 'Orders Status'[CCMODS Count]>0)",
              "",
              ")",
              ""
            ],
            "formatString": "0.00",
            "displayFolder": "Activation Measures"
          },
