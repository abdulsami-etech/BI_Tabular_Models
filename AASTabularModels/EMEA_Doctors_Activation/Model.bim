          },
          {
            "type": "calculated",
            "name": "Is Post TouchPoint TM",
            "dataType": "int64",
            "isDataTypeInferred": true
          }
        ],
        "partitions": [
          {
            "name": "SF Activities",
            "dataView": "full",
            "source": {
              "type": "query",
              "query": [
                "SELECT",
                "    e.WhoID,",
                "    e.ActivityDate as [Activity Date],",
                "    e.RecordTypeName as [Activity Record Type],",
                "    e.[Event] as [Activity Event],",
                "    e.[EventType] as [Activity Type],",
                "    e.[CallType] as [Call Type],",
                "    e.[Subject] as [Activity Subject],",
                "    e.[Description] as [Activity Description],",
                "    e.DurationInMinutes as [Activity Duration min.],",
                "",
                "    u.UserID,",
                "    u.UserName as [User Name],",
                "    u.UserRoleName as [Role Name],",
                "    CASE    WHEN (u.UserRoleName like '%clinical%') or (u.UserRoleName like '% CL %')  THEN 'CL'",
                "        WHEN (u.UserRoleName like '%customer%') or (u.UserRoleName like '% CS %') THEN 'CS'",
                "        WHEN u.UserRoleName like '%sales%' THEN 'SL'",
                "        ELSE 'Other' END as [Role Type]",
                "    ",
                "",
                "FROM [DM].[DimSalesEvent] e",
                "    LEFT JOIN DM.DimUser u on e.OwnerID=u.UserID",
                "WHERE",
                "    achieved='true'",
                "    AND IsDeleted='false'",
                "    AND WhoID in ",
                "    (",
                "        SELECT DISTINCT cont.ContactID ",
                "        FROM DM.DimCampaignMember m ",
                "        LEFT JOIN [DM].[DimCustContact] cont on cont.ContactAccountNumber=m.DIDNumber and (cont.ContactRecordType='Doctor' or (cont.ContactClinID is not null)) ",
                "    )"
              ],
              "dataSource": "OTCDM"
            },
            "annotations": [
              {
                "name": "QueryEditorSerialization",
                "value": [
                  "<?xml version=\"1.0\" encoding=\"UTF-16\"?><Gemini xmlns=\"QueryEditorSerialization\"><AnnotationContent><![CDATA[<RSQueryCommandText>SELECT",
                  "\te.WhoID,",
                  "\te.ActivityDate as [Activity Date],",
                  "\te.RecordTypeName as [Activity Record Type],",
                  "\te.[Event] as [Activity Event],",
                  "\te.[EventType] as [Activity Type],",
                  "\te.[CallType] as [Call Type],",
                  "\te.[Subject] as [Activity Subject],",
                  "\te.[Description] as [Activity Description],",
                  "\te.DurationInMinutes as [Activity Duration min.],",
                  "",
                  "\tu.UserID,",
                  "\tu.UserName as [User Name],",
                  "\tu.UserRoleName as [Role Name],",
                  "\tCASE \tWHEN u.UserRoleName like '%clinical%' THEN 'CL'",
                  "\t\tWHEN u.UserRoleName like '%customer%' THEN 'CS'",
                  "\t\tWHEN u.UserRoleName like '%sales%' THEN 'SL'",
                  "\t\tELSE 'Other' END as [Role Type]",
                  "\t",
                  "",
                  "FROM [DM].[DimSalesEvent] e",
                  "\tLEFT JOIN DM.DimUser u on e.OwnerID=u.UserID",
                  "WHERE",
                  "\tachieved='true'",
                  "\tAND IsDeleted='false'",
                  "\tAND WhoID in ",
                  "\t(",
                  "\t\tSELECT DISTINCT cont.ContactID ",
                  "\t\tFROM DM.DimCampaignMember m ",
                  "\t\tLEFT JOIN [DM].[DimCustContact] cont on cont.ContactAccountNumber=m.DIDNumber and (cont.ContactRecordType='Doctor' or (cont.ContactClinID is not null)) ",
                  "\t)</RSQueryCommandText><RSQueryCommandType>Text</RSQueryCommandType><RSQueryDesignState></RSQueryDesignState>]]></AnnotationContent></Gemini>"
                ]
              }
            ]
          }
        ],
        "annotations": [
          {
            "name": "_TM_ExtProp_QueryDefinition",
            "value": [
              "SELECT",
              "\te.WhoID,",
              "\te.ActivityDate as [Activity Date],",
              "\te.RecordTypeName as [Activity Record Type],",
              "\te.[Event] as [Activity Event],",
              "\te.[EventType] as [Activity Type],",
              "\te.[CallType] as [Call Type],",
              "\te.[Subject] as [Activity Subject],",
              "\te.[Description] as [Activity Description],",
              "\te.DurationInMinutes as [Activity Duration min.],",
              "",
              "\tu.UserID,",
              "\tu.UserName as [User Name],",
              "\tu.UserRoleName as [Role Name],",
              "\tCASE \tWHEN u.UserRoleName like '%clinical%' THEN 'CL'",
              "\t\tWHEN u.UserRoleName like '%customer%' THEN 'CS'",
              "\t\tWHEN u.UserRoleName like '%sales%' THEN 'SL'",
              "\t\tELSE 'Other' END as [Role Type]",
              "\t",
              "",
              "FROM [DM].[DimSalesEvent] e",
              "\tLEFT JOIN DM.DimUser u on e.OwnerID=u.UserID",
              "WHERE",
              "\tachieved='true'",
              "\tAND IsDeleted='false'",
              "\tAND WhoID in ",
              "\t(",
              "\t\tSELECT DISTINCT cont.ContactID ",
              "\t\tFROM DM.DimCampaignMember m ",
              "\t\tLEFT JOIN [DM].[DimCustContact] cont on cont.ContactAccountNumber=m.DIDNumber and (cont.ContactRecordType='Doctor' or (cont.ContactClinID is not null)) ",
              "\t)"
            ]
          },
          {
            "name": "_TM_ExtProp_DbTableName",
