      {
        "name": "MemberEventLink",
        "isHidden": true,
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "ContactID",
            "dataType": "string",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "Mentoring Event[ContactID]"
          }
        ],
        "partitions": [
          {
            "name": "CalculatedTable 1",
            "source": {
              "type": "calculated",
              "expression": "CALCULATETABLE(DISTINCT('Mentoring Event'[ContactID]), NOT(ISBLANK('Mentoring Event'[ContactID])))"
            }
          }
        ]
      },
      {
        "name": "JTG",
        "isHidden": true,
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Month",
            "dataType": "int64",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Month]"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Cases per Doctor",
            "dataType": "double",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Cases per Doctor]",
            "formatString": "0.0"
          },
          {
            "type": "calculated",
            "name": "Accumulated",
            "dataType": "double",
            "isDataTypeInferred": true,
            "expression": [
              "CALCULATE(",
              "    SUM('JTG'[Cases per Doctor]),",
              "    ALL('JTG'),",
              "    FILTER('JTG',[Month]<=EARLIER([Month]))",
              ")"
            ],
            "formatString": "0.0"
          },
          {
            "type": "calculated",
            "name": "Down to 20",
            "dataType": "double",
            "isDataTypeInferred": true,
            "expression": "20-[Accumulated]",
            "formatString": "0.0"
          }
        ],
        "partitions": [
          {
            "name": "CalculatedTable 1",
            "source": {
              "type": "calculated",
              "expression": [
                "",
                "DATATABLE(",
                "\"Month\", INTEGER,",
                "\"Cases per Doctor\", DOUBLE,",
                "{",
                "    {1,1},",
                "    {2,1},",
                "    {3,1.2},",
                "    {4,1.4},",
                "    {5,1.5},",
                "    {6,1.6},",
                "    {7,1.8},",
                "    {8,2},",
                "    {9,2.2},",
                "    {10,2.2},",
                "    {11,2.2},",
                "    {12,2.2}",
                "}",
                "",
                ")"
              ]
            }
          }
        ]
      },
      {
        "name": "Event Date",
        "dataCategory": "Time",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Date",
            "dataType": "dateTime",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "isHidden": true,
            "isKey": true,
            "sourceColumn": "[Date]"
          },
          {
            "type": "calculated",
            "name": "Month Number",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "isHidden": true,
            "expression": "MONTH([Date])"
          },
          {
            "type": "calculated",
            "name": "Month Name",
            "dataType": "string",
            "isDataTypeInferred": true,
            "isHidden": true,
            "expression": [
              "SWITCH(",
              "[Month Number],",
              "1,\"January\",",
              "2,\"February\",",
              "3,\"March\",",
              "4,\"April\",",
              "5,\"May\",",
              "6,\"June\",",
              "7,\"July\",",
              "8,\"August\",",
              "9,\"September\",",
              "10,\"October\",",
              "11,\"November\",",
              "12,\"December\")"
            ],
            "sortByColumn": "Month Number"
          },
          {
            "type": "calculated",
            "name": "Month-Year Name",
            "dataType": "string",
            "isDataTypeInferred": true,
            "isHidden": true,
            "expression": [
              "SWITCH(",
              "[Month Number],",
              "1,CONCATENATE(\"Jan \",[Year]),",
              "2,CONCATENATE(\"Feb \",[Year]),",
              "3,CONCATENATE(\"Mar \",[Year]),",
              "4,CONCATENATE(\"Apr \",[Year]),",
              "5,CONCATENATE(\"May \",[Year]),",
              "6,CONCATENATE(\"Jun \",[Year]),",
              "7,CONCATENATE(\"Jul \",[Year]),",
              "8,CONCATENATE(\"Aug \",[Year]),",
              "9,CONCATENATE(\"Sep \",[Year]),",
              "10,CONCATENATE(\"Oct \",[Year]),",
              "11,CONCATENATE(\"Nov \",[Year]),",
              "12,CONCATENATE(\"Dec \",[Year])",
              ")"
            ],
            "sortByColumn": "Month Code"
          },
          {
            "type": "calculated",
            "name": "Year",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "isHidden": true,
            "expression": "YEAR([Date])",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Month Code",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "isHidden": true,
            "expression": "[Year]*100+[Month Number]",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "CalculatedTable 1",
            "source": {
              "type": "calculated",
              "expression": [
                "",
                "CALENDAR( MIN('Mentoring Event'[Event Date]), MAX('Mentoring Event'[Event Date]))",
                ""
              ]
            }
          }
        ],
        "hierarchies": [
          {
            "name": "Event Date",
            "levels": [
              {
                "name": "Year",
                "ordinal": 0,
                "column": "Year"
              },
              {
                "name": "Month",
                "ordinal": 1,
                "column": "Month-Year Name"
              },
              {
                "name": "Date",
                "ordinal": 2,
                "column": "Date"
              }
            ]
          }
        ]
      },
      {
        "name": "KPI List",
        "isHidden": true,
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "KPI",
            "dataType": "string",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[KPI]",
            "sortByColumn": "Sort Order"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Sort Order",
            "dataType": "int64",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Sort Order]"
          }
        ],
        "partitions": [
          {
            "name": "CalculatedTable 1",
            "source": {
              "type": "calculated",
              "expression": [
                "",
                "DATATABLE(",
                "\"KPI\", STRING,",
                "\"Sort Order\", INTEGER,",
                "{",
                "    {\"NR Avr. pre Cert\",10},",
                "    {\"AVR CCA +30\",21},",
                "    {\"AVR CCA +60\",22},",
                "    {\"AVR CCA +90\",23},",
                "    {\"AVR CCA +120\",24},",
                "    {\"AVR CCA +180\",25},",
                "    {\"AVR CCA +270\",26},",
                "    {\"AVR CCA +365\",27}",
                "    ",
                "}",
                ")"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Fact JTG",
            "expression": [
              "",
              "",
              "VAR curJTG=IF(HASONEVALUE('KPI List'[KPI]), VALUES('KPI List'[KPI]), BLANK())",
              "",
              "RETURN",
              "SWITCH(",
              "    curJTG,",
              "    \"AVR CCA +30\",[Avr. CCA +30],",
              "    \"AVR CCA +60\",[Avr. CCA +60],",
              "    \"AVR CCA +90\",[Avr. CCA +90],",
              "    \"AVR CCA +120\",[Avr. CCA +120],",
              "    \"AVR CCA +180\",[Avr. CCA +180],",
              "    \"AVR CCA +180\",[Avr. CCA +180],",
              "    \"AVR CCA +270\",[Avr. CCA +270],",
              "    \"AVR CCA +365\",[Avr. CCA +365],",
              "    BLANK()",
              ")",
              ""
            ]
          },
          {
            "name": "Target JTG",
            "expression": [
              "",
              "",
              "VAR curJTG=IF(HASONEVALUE('KPI List'[KPI]), VALUES('KPI List'[KPI]), BLANK())",
              "",
              "RETURN",
              "SWITCH(",
              "    curJTG,",
              "    \"AVR CCA +30\",LOOKUPVALUE('JTG'[Accumulated],JTG[Month],1),",
              "    \"AVR CCA +60\",LOOKUPVALUE('JTG'[Accumulated],JTG[Month],2),",
              "    \"AVR CCA +90\",LOOKUPVALUE('JTG'[Accumulated],JTG[Month],3),",
              "    \"AVR CCA +120\",LOOKUPVALUE('JTG'[Accumulated],JTG[Month],4),",
              "    \"AVR CCA +180\",LOOKUPVALUE('JTG'[Accumulated],JTG[Month],6),",
              "    \"AVR CCA +270\",LOOKUPVALUE('JTG'[Accumulated],JTG[Month],9),",
              "    \"AVR CCA +365\",LOOKUPVALUE('JTG'[Accumulated],JTG[Month],12),",
              "    BLANK()",
              ")",
              ""
            ]
          },
          {
            "name": "Fact JTP",
            "expression": [
              "",
              "",
              "VAR curJTP=IF(HASONEVALUE('KPI List'[KPI]), VALUES('KPI List'[KPI]), BLANK())",
              "",
              "RETURN",
              "SWITCH(",
              "    curJTP,",
              "    \"AVR CCA +30\",[Avr. CCA +30],",
              "    \"AVR CCA +60\",[Avr. CCA +60],",
              "    \"AVR CCA +90\",[Avr. CCA +90],",
              "    \"AVR CCA +120\",[Avr. CCA +120],",
              "    \"AVR CCA +180\",[Avr. CCA +180],",
              "    \"AVR CCA +270\",[Avr. CCA +270],",
              "    \"AVR CCA +365\",[Avr. CCA +365],",
              "    BLANK()",
              ")",
              ""
            ]
          },
          {
            "name": "Target JTP",
            "expression": [
              "",
              "",
              "VAR curJTP=IF(HASONEVALUE('KPI List'[KPI]), VALUES('KPI List'[KPI]), BLANK())",
              "",
              "RETURN",
              "SWITCH(",
              "    curJTP,",
              "    \"AVR CCA +30\", LOOKUPVALUE('JTP'[Cases per Doctor],JTP[Month],1),",
              "    \"AVR CCA +60\", LOOKUPVALUE('JTP'[Cases per Doctor],JTP[Month],2),",
              "    \"AVR CCA +90\", LOOKUPVALUE('JTP'[Cases per Doctor],JTP[Month],3),",
              "    \"AVR CCA +120\",LOOKUPVALUE('JTP'[Cases per Doctor],JTP[Month],4),",
              "    \"AVR CCA +180\",LOOKUPVALUE('JTP'[Cases per Doctor],JTP[Month],6),",
              "    \"AVR CCA +270\",LOOKUPVALUE('JTP'[Cases per Doctor],JTP[Month],9),",
              "    \"AVR CCA +365\",LOOKUPVALUE('JTP'[Cases per Doctor],JTP[Month],12),",
              "    BLANK()",
              ")"
            ]
          }
        ]
      },
      {
        "name": "KPI for Graphs",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Event Name",
            "dataType": "string",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "Mentoring Event[Event Name]"
          },
          {
            "type": "calculatedTableColumn",
            "name": "KPI",
            "dataType": "string",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "KPI List[KPI]",
            "sortByColumn": "Sort Order"
          },
          {
            "type": "calculated",
            "name": "Value",
            "dataType": "double",
            "isDataTypeInferred": true,
            "expression": [
              "",
              "SWITCH(",
              "    [KPI]",
              "",
              ",\"NR Avr. pre Cert\",CALCULATE([NR Avr. pre Cert], FILTER('Mentoring Event',[Event Name]=EARLIER('KPI for Graphs'[Event Name])))",
              "",
              ",\"AVR CCA +30\",CALCULATE([Avr. CCA +30], FILTER('Mentoring Event', [Registration Status]=\"Attended\" || [Registration Status]=\"Registered\"))",
              ",\"AVR CCA +60\",CALCULATE([Avr. CCA +60], FILTER('Mentoring Event', [Registration Status]=\"Attended\" || [Registration Status]=\"Registered\"))",
              ",\"AVR CCA +90\",CALCULATE([Avr. CCA +90], FILTER('Mentoring Event', [Registration Status]=\"Attended\" || [Registration Status]=\"Registered\"))",
              ",\"AVR CCA +120\",CALCULATE([Avr. CCA +120], FILTER('Mentoring Event', [Registration Status]=\"Attended\" || [Registration Status]=\"Registered\"))",
              ",\"AVR CCA +180\",CALCULATE([Avr. CCA +180], FILTER('Mentoring Event', [Registration Status]=\"Attended\" || [Registration Status]=\"Registered\"))",
              ",\"AVR CCA +270\",CALCULATE([Avr. CCA +270], FILTER('Mentoring Event', [Registration Status]=\"Attended\" || [Registration Status]=\"Registered\"))",
              ",\"AVR CCA +365\",CALCULATE([Avr. CCA +365], FILTER('Mentoring Event', [Registration Status]=\"Attended\" || [Registration Status]=\"Registered\"))",
              ",BLANK()",
              ")"
            ]
          },
          {
            "type": "calculatedTableColumn",
            "name": "Sort Order",
            "dataType": "int64",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "KPI List[Sort Order]"
          }
        ],
        "partitions": [
          {
            "name": "CalculatedTable 1",
            "source": {
              "type": "calculated",
              "expression": [
                "",
                "VAR Ev=VALUES('Mentoring Event'[Event Name])",
                "",
                "RETURN",
                "CROSSJOIN(Ev,'KPI List')"
              ]
            }
          }
        ]
      },
      {
        "name": "EventGraphLink",
        "isHidden": true,
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Event Name",
            "dataType": "string",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "Mentoring Event[Event Name]"
          }
        ],
        "partitions": [
          {
            "name": "CalculatedTable 1",
            "source": {
              "type": "calculated",
              "expression": "VALUES('Mentoring Event'[Event Name])"
            }
          }
        ]
      },
      {
        "name": "Sales Data",
        "columns": [
          {
            "name": "CustomerKey",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "CustomerKey",
            "sourceProviderType": "Integer"
          },
          {
            "name": "AccountKey",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "AccountKey",
            "sourceProviderType": "Integer"
          },
          {
            "name": "ContactKey",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "ContactKey",
            "sourceProviderType": "Integer"
          },
          {
            "name": "StatusDate",
            "dataType": "dateTime",
            "sourceColumn": "StatusDate",
            "formatString": "General Date",
            "sourceProviderType": "Date"
          },
          {
            "name": "NR",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "NR",
            "sourceProviderType": "Integer"
          },
          {
            "name": "CCA",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "CCA",
            "sourceProviderType": "Integer"
          }
        ],
        "partitions": [
          {
            "name": "Sales Data",
            "dataView": "full",
            "source": {
              "type": "query",
              "query": [
                "WITH salesdata as (",
                "SELECT",
                "\to.CustomerKey,",
                "\tacc.AccountKey,",
                "\tcont.ContactKey,",
                "\tf.StatusDate,",
                "\tSUM(",
                "\t\tCASE WHEN f.OrderStatusKey = 80 THEN f.OrderStatusCount",
                "\t\t\t\tWHEN f.OrderStatusKey = 108 AND o.AMRDate IS NOT NULL THEN -f.OrderStatusCount",
                "\t\t\t\tELSE NULL ",
                "\t\tEND",
                "\t) AS NR,",
                "\tSUM(",
                "\t\tCASE WHEN f.OrderStatusKey = 100 THEN f.OrderStatusCount\t",
                "\t\t\t\tWHEN f.OrderStatusKey = 108 AND cast(o.CCADate as date) <= cast(o.CancellationDate as date) THEN -f.OrderStatusCount",
                "\t\t\t\tELSE null ",
                "\t\tEND",
                "\t) AS  CCA",
                "FROM DM.FactOrderStatusRecurring f with (nolock)",
                "\tINNER JOIN DM.DimOrder o with (nolock) on o.OrderKey = f.OrderKey",
                "\tINNER JOIN DM.DimProduct p on p.ProductKey=f.ProductKey",
                "\tINNER JOIN DM.DimCust cust on o.CustomerKey=cust.CustomerKey",
                "\tINNER JOIN DM.DimCustAccount acc on acc.AccountKey=cust.AccountKey",
                "\tINNER JOIN Dm.DimCustContact cont on cont.ContactKey=cust.ContactKey",
                "WHERE",
                "\tf.StatusDate>='2016-01-01'",
                "\tand o.TreatmentCategory='Primary'",
                "\tand p.Level3Code='A1A1T1'",
                "GROUP BY ",
                "\tStatusDate,",
                "\to.CustomerKey,",
                "\tacc.AccountKey,",
                "\tcont.ContactKey",
                ")",
                "",
                "SELECT * FROM salesdata where (NR IS NOT NULL) OR (CCA IS NOT NULL)"
              ],
              "dataSource": "OTCDM"
            },
            "annotations": [
              {
                "name": "QueryEditorSerialization",
                "value": [
                  "<?xml version=\"1.0\" encoding=\"UTF-16\"?><Gemini xmlns=\"QueryEditorSerialization\"><AnnotationContent><![CDATA[<RSQueryCommandText>WITH salesdata as (",
                  "SELECT",
                  "\to.CustomerKey,",
                  "\tacc.AccountKey,",
                  "\tcont.ContactKey,",
                  "\tf.StatusDate,",
                  "\tSUM(",
                  "\t\tCASE WHEN f.OrderStatusKey = 80 THEN f.OrderStatusCount",
                  "\t\t\t\tWHEN f.OrderStatusKey = 108 AND o.AMRDate IS NOT NULL THEN -f.OrderStatusCount",
                  "\t\t\t\tELSE NULL ",
                  "\t\tEND",
                  "\t) AS NR,",
                  "\tSUM(",
                  "\t\tCASE WHEN f.OrderStatusKey = 100 THEN f.OrderStatusCount\t",
                  "\t\t\t\tWHEN f.OrderStatusKey = 108 AND cast(o.CCADate as date) <= cast(o.CancellationDate as date) THEN -f.OrderStatusCount",
                  "\t\t\t\tELSE null ",
                  "\t\tEND",
                  "\t) AS  CCA",
                  "FROM DM.FactOrderStatusRecurring f with (nolock)",
                  "\tINNER JOIN DM.DimOrder o with (nolock) on o.OrderKey = f.OrderKey",
                  "\tINNER JOIN DM.DimProduct p on p.ProductKey=f.ProductKey",
                  "\tINNER JOIN DM.DimCust cust on o.CustomerKey=cust.CustomerKey",
                  "\tINNER JOIN DM.DimCustAccount acc on acc.AccountKey=cust.AccountKey",
                  "\tINNER JOIN Dm.DimCustContact cont on cont.ContactKey=cust.ContactKey",
                  "WHERE",
                  "\tf.StatusDate>='2016-01-01'",
                  "\tand o.TreatmentCategory='Primary'",
                  "\tand p.Level3Code='A1A1T1'",
                  "GROUP BY ",
                  "\tStatusDate,",
                  "\to.CustomerKey,",
                  "\tacc.AccountKey,",
                  "\tcont.ContactKey",
                  ")",
                  "",
                  "SELECT * FROM salesdata where (NR IS NOT NULL) OR (CCA IS NOT NULL)</RSQueryCommandText><RSQueryCommandType>Text</RSQueryCommandType><RSQueryDesignState></RSQueryDesignState>]]></AnnotationContent></Gemini>"
                ]
              }
            ]
          }
        ],
        "measures": [
          {
            "name": "CCA Running Total",
            "expression": [
              "",
              "",
              "VAR curDate=MAX('Sales Date'[Date])",
              "VAR curEventDate=MIN('Mentoring Event'[Event Date])",
              "/*IF(HASONEVALUE('Mentoring Event'[Event Name]);VALUES('Mentoring Event'[Event Date]);BLANK())*/",
              "",
              "RETURN",
              "IF(",
              "    NOT ISBLANK(curEventDate)",
              "    ,CALCULATE(",
              "        SUM('Sales Data'[CCA]),",
              "        ALL('Sales Date'),",
              "        FILTER(ALL('Sales Date'), [Date]<=curDate && [Date]>=curEventDate)",
              "        )",
              "    ,BLANK()",
              ")",
              "",
              ""
            ]
          },
          {
            "name": "ClinCheck Accepted",
            "expression": [
              "",
              "",
              "VAR curEventDate=MIN('Mentoring Event'[Event Date])",
              "/*=IF(HASONEVALUE('Mentoring Event'[Event Name]);VALUES('Mentoring Event'[Event Date]);BLANK())*/",
              "",
              "RETURN",
              "IF(",
              "    NOT ISBLANK(curEventDate)",
              "    ,SUMX(FILTER('Sales Data', [StatusDate]>=curEventDate), [CCA])",
              "    ,BLANK()",
              ")",
              ""
            ]
          }
        ],
        "annotations": [
          {
            "name": "_TM_ExtProp_QueryDefinition",
            "value": [
              "WITH salesdata as (",
              "SELECT",
              "\to.CustomerKey,",
              "\tacc.AccountKey,",
              "\tcont.ContactKey,",
              "\tf.StatusDate,",
              "\tSUM(",
              "\t\tCASE WHEN f.OrderStatusKey = 80 THEN f.OrderStatusCount",
              "\t\t\t\tWHEN f.OrderStatusKey = 108 AND o.AMRDate IS NOT NULL THEN -f.OrderStatusCount",
              "\t\t\t\tELSE NULL ",
              "\t\tEND",
              "\t) AS NR,",
              "\tSUM(",
              "\t\tCASE WHEN f.OrderStatusKey = 100 THEN f.OrderStatusCount\t",
              "\t\t\t\tWHEN f.OrderStatusKey = 108 AND cast(o.CCADate as date) <= cast(o.CancellationDate as date) THEN -f.OrderStatusCount",
              "\t\t\t\tELSE null ",
              "\t\tEND",
              "\t) AS  CCA",
              "FROM DM.FactOrderStatusRecurring f with (nolock)",
              "\tINNER JOIN DM.DimOrder o with (nolock) on o.OrderKey = f.OrderKey",
              "\tINNER JOIN DM.DimProduct p on p.ProductKey=f.ProductKey",
              "\tINNER JOIN DM.DimCust cust on o.CustomerKey=cust.CustomerKey",
              "\tINNER JOIN DM.DimCustAccount acc on acc.AccountKey=cust.AccountKey",
              "\tINNER JOIN Dm.DimCustContact cont on cont.ContactKey=cust.ContactKey",
              "WHERE",
              "\tf.StatusDate>='2016-01-01'",
