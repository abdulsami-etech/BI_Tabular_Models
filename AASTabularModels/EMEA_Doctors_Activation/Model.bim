              "    ",
              "    RETURN ",
              "    CALCULATE( AVERAGE('Orders Status'[AMR to CCA days]), 'Orders Status'[StatusDate]>=eventDate, 'Orders Status'[AMR to CCA days]>=0)",
              "",
              ")",
              ""
            ],
            "formatString": "0.00",
