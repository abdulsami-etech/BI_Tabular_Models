          {
            "name": "Activation 4+ CCA @180",
            "expression": [
              "",
              "",
              "",
              "CALCULATE(",
              "   ",
              "    VAR allCurrentDoctors=COUNTROWS(FILTER('Mentoring Event',[Days After Event]>=180))",
              "    VAR activatedDoctors=COUNTROWS(FILTER('Mentoring Event',[Days After Event]>=180 && [CCA180]>=4))",
              "",
              "    VAR res=DIVIDE(activatedDoctors,allCurrentDoctors)",
