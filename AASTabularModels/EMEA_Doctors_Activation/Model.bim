        "tablePermissions": [
          {
            "name": "Mentoring Event",
            "filterExpression": [
              "",
              "VAR Login=RIGHT(USERNAME(),LEN(USERNAME())-SEARCH(\"\\\", USERNAME()))",
              "",
              "VAR IsFullAccess=COUNTROWS(FILTER('Full Access Users',[UserID]=Login))",
              "",
              "VAR Area\t\t='Mentoring Event'[SalesAreaIdentifier]",
              "VAR Region\t='Mentoring Event'[SalesRegionIdentifier]",
              "VAR Territory\t='Mentoring Event'[SalesTerritoryIdentifier]",
              "",
              "RETURN ",
              "IF(IsFullAccess>0,TRUE,",
              "\t\tIF(Area=Login, TRUE,",
              "\t\t\tIF( (Region=Login || Territory=Login), TRUE,FALSE)",
              "\t\t)",
              ")"
            ]
          }
        ]
