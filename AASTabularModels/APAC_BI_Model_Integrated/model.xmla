                "displayFolder": "Loyalty"
              },
              {
                "type": "calculated",
                "name": "PPID/ClinID",
                "dataType": "string",
                "isDataTypeInferred": false,
                "expression": [
                  "IF(",
                  "       [ContactCountry]=\"China\",",
                  "       IF( NOT(ISBLANK([PPID Source])) && LEFT([PPID Source],1)=\"D\" , [PPID Source], BLANK() ),",
                  "       [Doctor ClinID]",
                  ")",
                  ""
                ],
                "displayFolder": "Contact Fields"
              }
            ],
            "partitions": [
              {
                "name": "Doctor",
                "dataView": "full",
                "source": {
                  "type": "m",
                  "expression": [
                    "let",
                    "    Source = Value.NativeQuery(#\"OTCDM\", ",
                    "",
                    "\"",
                    "with apac_doctors as (",
                    "    select",
                    "        c.ContactID",
                    "    from OTCDM.DM.DimCustContact c",
                    "        left join Custom.testdoctors td on td.ClinID=c.ContactClinID",
                    "    where",
                    "        c.ContactRegionGroup='Asia Pacific' and",
                    "        c.ContactRecordType='Doctor' and",
                    "        td.ClinID IS NULL",
                    "),",
                    "",
                    "enrollments as (",
                    "    select ",
                    "        le.[Apttus_Config2__ContactId__c]                                   as ContactID,",
                    "        le.[Name]                                                           as [Enrollment Name],",
                    "        le.[Id]                                                             as [Enrollment ID],",
                    "        le.[Apttus_Config2__CustomerType__c]                                as [Customer Type],",
                    "        --ROW_NUMBER() OVER ",
                    "        --        (PARTITION BY le.[Apttus_Config2__ContactId__c]",
                    "        --         ORDER BY ",
                    "        --         CASE le.[Apttus_Config2__CustomerType__c]",
                    "        --            WHEN 'NCP' THEN 10",
                    "        --            WHEN 'ADV' THEN 20",
                    "        --            ELSE 100                                                    ",
                    "        --        END )                                                       as [Customer Type Sort],",
                    "        le.[Current_Advantage_Status__c]                                    as [Current ADV Status],",
                    "        le.[Loyalty_Code__c]                                                as [Incentive Code],",
                    "    ",
                    "        le.[Apttus_Config2__StartDate__c]                                   as [Enroll Start Date],",
                    "        le.[Apttus_Config2__EndDate__c]                                     as [Enroll End Date],",
                    "",
                    "        le.[Apttus_Config2__LoyaltyLevel__c]                                as [Tier Level],",
                    "        le.[Apttus_Config2__LoyaltyLevelEarned__c]                          as [Tier Level Earned],",
                    "        le.[Apttus_Config2__LoyaltyLevelInitial__c]                         as [Tier Level Initial],",
                    "        le.[Apttus_Config2__LoyaltyLevelOverride__c]                        as [Tier Level Override],",
                    "        le.[Apttus_Config2__OverrideDate__c]                                as [Override Date],",
                    "        le.[Apttus_Config2__OverrideReason__c]                              as [Override Reason],",
                    "",
                    "        le.[Apttus_Config2__Points__c]                                      as [Points],",
                    "        le.[Points1__c]                                                     as [points_1c],",
                    "        le.[Apttus_Config2__AdditionalPointsForNextLevel__c]                as [Points For Next Level],",
                    "        le.[Apttus_Config2__AdditionalPointsToKeepLevel__c]                 as [Points To Keep Level],",
                    "        le.[Apttus_Config2__LifetimePoints__c]                              as [LifeTime Points]",
                    "    ",
                    "     from [SFDC_Staging].[dbo].[Apttus_Config2__IncentiveLoyaltyEnrollment__c] le",
                    "        inner join apac_doctors d on d.ContactID=le.[Apttus_Config2__ContactId__c]",
                    "    where [Apttus_Config2__Active__c]='true'",
                    "),",
                    "",
                    "fin as (",
                    "select ",
                    "    c.ContactKey,",
                    "    c.ContactID,",
                    "    c.ContactClinID,",
                    "    c.ContactAccountID,",
                    "    c.ContactAccountNumber,",
                    "    c.ContactNumber,",
                    "    c.ContactOwnerID,",
                    "    c.ContactName,",
                    "    c.ContactType,",
                    "    c.ContactLineofBusiness,",
                    "    c.ContactProfessionalCategory,",
                    "    c.ContactStatus,",
                    "    c.ContactEmail,",
                    "    c.ContactCertificationDate,",
                    "    c.ContactCreatedDate,",
                    "",
                    "    c.ContactMailingCountry,",
                    "    c.ContactMailingState,",
                    "    c.ContactMailingCity,",
                    "",
                    "    c.ContactCountry,",
                    "    c.ContactCountryGroup,",
                    "    c.ContactRegionPC,",
                    "    CONCAT(a.AccountName, '(',a.AccountAddressStreet1,',',a.AccountCity,')') as [Contact Location],",
                    "    ",
                    "    c.[ContactEMEASegmentation]  as [Current Segment],",
                    "    a.AccountPrivatePracticeID as [PPID Source],",
                    "    u.UserName as [PDM Name],",
                    "",
                    "    e.[Enrollment Name],",
                    "    e.[Enrollment ID],",
                    "    e.[Customer Type],",
                    "    e.[Current ADV Status],",
                    "    e.[Incentive Code],",
                    " ",
                    "    e.[Enroll Start Date],",
                    "    e.[Enroll End Date],",
                    "",
                    "    e.[Tier Level],",
                    "    e.[Tier Level Earned],",
                    "    e.[Tier Level Initial],",
                    "    e.[Tier Level Override],",
                    "    e.[Override Date],",
                    "    e.[Override Reason],",
                    "",
                    "    e.[Points],",
                    "    e.[points_1c],",
                    "    e.[Points For Next Level],",
                    "    e.[Points To Keep Level],",
                    "    e.[LifeTime Points]",
                    "    ",
                    "from DM.DimCustContact c",
                    "     left join DM.DimUser u on c.ContactOwnerID=u.UserId",
                    "     left join DM.DimCustAccount a on c.ContactAccountNumber = a.AccountNumber",
                    "     left join enrollments e on e.ContactID=c.ContactID",
                    "     left join Custom.testdoctors td on td.ClinID=c.ContactClinID",
                    "",
                    "where  ",
                    "    c.ContactRegionGroup='Asia Pacific' and",
                    "    c.ContactRecordType='Doctor' and",
                    "    td.ClinID IS NULL",
                    ")",
                    "",
                    "select * from fin",
                    "",
                    "",
                    "\"",
                    "),",
                    "",
                    "    #\"Changed Type\" = Table.TransformColumnTypes(Source,{{\"ContactCertificationDate\", type date}, {\"ContactCreatedDate\", type date}}),",
                    "    #\"Renamed Columns\" = Table.RenameColumns(#\"Changed Type\",{{\"ContactClinID\", \"Doctor ClinID\"}, {\"ContactAccountID\", \"AccountID\"}, {\"ContactAccountNumber\", \"AccountNumber\"}, {\"ContactNumber\", \"Contact Number\"}, {\"ContactName\", \"Doctor Name\"}, {\"ContactLineofBusiness\", \"Line of Business\"}, {\"ContactProfessionalCategory\", \"Professional Category\"}, {\"ContactStatus\", \"Doctor Status\"}, {\"ContactEmail\", \"Email\"}, {\"ContactCertificationDate\", \"Certification Date\"}})",
                    "in",
                    "    #\"Renamed Columns\"",
                    "",
                    ""
                  ]
                }
              }
            ],
            "annotations": [
              {
                "name": "PBI_Id",
                "value": "6e5640ef-4b6c-45ba-bc9d-7639c214d2e0"
              },
              {
                "name": "LinkedQueryName",
                "value": "2) Doctor"
              },
              {
                "name": "PBI_NavigationStepName",
                "value": "Navigation"
              },
              {
                "name": "PBI_QueryRelationships",
                "value": "{\"columnCount\":16,\"keyColumnNames\":[],\"queryRelationships\":[],\"columnIdentities\":[\"Section1/2) Doctor/Source.{ContactKey,0}\",\"Section1/2) Doctor/Source.{ContactID,1}\",\"Section1/2) Doctor/Source.{ContactClinID,2}\",\"Section1/2) Doctor/Source.{ContactAccountID,3}\",\"Section1/2) Doctor/Source.{ContactAccountNumber,4}\",\"Section1/2) Doctor/Source.{ContactNumber,5}\",\"Section1/2) Doctor/Source.{ContactOwnerID,6}\",\"Section1/2) Doctor/Source.{ContactName,7}\",\"Section1/2) Doctor/Source.{ContactType,8}\",\"Section1/2) Doctor/Source.{ContactLineofBusiness,9}\",\"Section1/2) Doctor/Source.{ContactProfessionalCategory,10}\",\"Section1/2) Doctor/Source.{ContactStatus,11}\",\"Section1/2) Doctor/Source.{ContactEmail,12}\",\"Section1/2) Doctor/Changed Type.{ContactCertificationDate,13}\",\"Section1/2) Doctor/Changed Type.{ContactCreatedDate,14}\",\"Section1/2) Doctor/Source.{Current Segment,15}\"],\"ColumnCount\":16,\"KeyColumnNames\":[],\"ColumnIdentities\":[\"Section1/2) Doctor/Source.{ContactKey,0}\",\"Section1/2) Doctor/Source.{ContactID,1}\",\"Section1/2) Doctor/Source.{ContactClinID,2}\",\"Section1/2) Doctor/Source.{ContactAccountID,3}\",\"Section1/2) Doctor/Source.{ContactAccountNumber,4}\",\"Section1/2) Doctor/Source.{ContactNumber,5}\",\"Section1/2) Doctor/Source.{ContactOwnerID,6}\",\"Section1/2) Doctor/Source.{ContactName,7}\",\"Section1/2) Doctor/Source.{ContactType,8}\",\"Section1/2) Doctor/Source.{ContactLineofBusiness,9}\",\"Section1/2) Doctor/Source.{ContactProfessionalCategory,10}\",\"Section1/2) Doctor/Source.{ContactStatus,11}\",\"Section1/2) Doctor/Source.{ContactEmail,12}\",\"Section1/2) Doctor/Changed Type.{ContactCertificationDate,13}\",\"Section1/2) Doctor/Changed Type.{ContactCreatedDate,14}\",\"Section1/2) Doctor/Source.{Current Segment,15}\"],\"RelationshipInfo\":[]}"
              },
              {
                "name": "PBI_ResultType",
                "value": "Table"
              }
            ]
          },
          {
            "name": "0 Measures",
            "columns": [
              {
                "name": "Measures",
                "dataType": "string",
                "isHidden": true,
                "sourceColumn": "Measures",
                "summarizeBy": "none",
                "annotations": [
                  {
                    "name": "SummarizationSetBy",
                    "value": "Automatic"
                  },
                  {
                    "name": "Format",
                    "value": "<Format Format=\"Text\" />"
                  },
                  {
                    "name": "DataTypeAtRefresh",
                    "value": "String#####not a type"
                  },
                  {
                    "name": "PBI_NameAtRefresh",
                    "value": "Measures"
                  },
                  {
                    "name": "PBI_WasHiddenAtRefresh",
                    "value": "False"
                  }
                ]
              }
            ],
            "partitions": [
              {
                "name": "Measures",
                "dataView": "full",
                "source": {
                  "type": "m",
                  "expression": [
                    "let",
                    "    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"i45WCsnILFYoSUzKSVUAMhIVCnISk1Mz8nNSUosU0vKLFHJTE4tLi1KLlWJjAQ==\", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type text) meta [Serialized.Text = true]) in type table [Measures = _t]),",
                    "    #\"Changed Type\" = Table.TransformColumnTypes(Source,{{\"Measures\", type text}})",
                    "in",
                    "    #\"Changed Type\""
                  ]
                }
              }
            ],
            "measures": [
              {
                "name": "Net Receipts Base",
                "expression": "SUM('FactSales'[Net Receipts])",
                "formatString": "#,0",
                "isHidden": true,
                "displayFolder": "z_Base"
              },
              {
                "name": "NR",
                "expression": [
                  "",
                  "-- This measure counts Net Receipts using single Reporting Calendar table context",
                  "VAR dt=DISTINCT('1) Reporting Calendar'[Date])",
                  "VAR res=CALCULATE([Net Receipts Base], TREATAS(dt,'FactSales'[StatusDate]))",
                  "",
                  "RETURN res"
                ],
                "formatString": "#,0",
                "displayFolder": "1. Volume\\4 Net Receipts"
              },
              {
                "name": "Submissions Base",
                "expression": [
                  "",
                  "-- The measures counts orders submissions based on status code 40 - Order Submitted",
                  "SUM('FactSales'[Submissions])"
                ],
                "formatString": "#,0",
                "isHidden": true,
                "displayFolder": "z_Base"
              },
              {
                "name": "Submissions",
                "expression": [
                  "",
                  "--The measures calculates Orders Submissions taking single reporting calendar in context",
                  "VAR dt=DISTINCT('1) Reporting Calendar'[Date])",
                  "VAR res=CALCULATE([Submissions Base], TREATAS(dt,'FactSales'[StatusDate]))",
                  "RETURN res"
                ],
                "formatString": "#,0",
                "displayFolder": "1. Volume\\1 Submissions"
              },
              {
                "name": "CCA Base",
                "expression": "SUM('FactSales'[CCA])",
                "formatString": "#,0",
                "isHidden": true,
                "displayFolder": "z_Base"
              },
              {
                "name": "CCA",
                "expression": [
                  "",
                  "-- This measure counts CCA using single Reporting Calendar table context",
                  "VAR dt=DISTINCT('1) Reporting Calendar'[Date])",
                  "VAR res=CALCULATE([CCA Base], TREATAS(dt,'FactSales'[StatusDate]))",
                  "",
                  "RETURN res"
                ],
                "formatString": "#,0",
                "displayFolder": "1. Volume\\5 ClinCheck Accepted"
              },
              {
                "name": "AMR Base",
                "expression": [
                  "",
                  "-- The measures counts All Material Received (AMR) orders by status code 80",
                  "SUM('FactSales'[AMR])"
                ],
                "formatString": "#,0",
                "isHidden": true,
                "displayFolder": "z_Base"
              },
              {
                "name": "AMRs",
                "expression": [
                  "",
                  "-- This measure counts AMRs using single Reporting Calendar table context",
                  "VAR dt=DISTINCT('1) Reporting Calendar'[Date])",
                  "VAR res=CALCULATE([AMR Base], TREATAS(dt,'FactSales'[StatusDate]))",
                  "",
                  "RETURN res"
                ],
                "formatString": "#,0",
                "isHidden": true,
                "displayFolder": "1. Volume\\2 AMR (All Materials Received)"
              },
              {
                "name": "NR PY",
                "expression": [
                  "",
                  "-- Net Receipts same period last year",
                  "CALCULATE([NR], SAMEPERIODLASTYEAR('1) Reporting Calendar'[Date]))"
                ],
                "formatString": "#,0",
                "displayFolder": "1. Volume\\4 Net Receipts"
              },
              {
                "name": "CCA PY",
                "expression": [
                  "",
                  "-- CCA same period last year",
                  "CALCULATE([CCA], SAMEPERIODLASTYEAR('1) Reporting Calendar'[Date]))"
                ],
                "formatString": "#,0",
                "displayFolder": "1. Volume\\5 ClinCheck Accepted"
              },
              {
                "name": "AMRs PY",
                "expression": [
                  "",
                  "-- AMR same period last year",
                  "CALCULATE([AMRs], SAMEPERIODLASTYEAR('1) Reporting Calendar'[Date]))"
                ],
                "formatString": "#,0",
                "isHidden": true,
                "displayFolder": "1. Volume\\2 AMR (All Materials Received)"
              },
              {
                "name": "Submissions PY",
                "expression": [
                  "",
                  "-- Submissions same period last year",
                  "CALCULATE([Submissions], SAMEPERIODLASTYEAR('1) Reporting Calendar'[Date]))"
                ],
                "formatString": "#,0",
                "displayFolder": "1. Volume\\1 Submissions"
              },
              {
                "name": "Submissions YTD",
                "expression": [
                  "",
                  "--The measure calculates submissions as Year-To-Date running total regarding reporting dates selected context.",
                  "",
                  "TOTALYTD([Submissions],'1) Reporting Calendar'[Date])"
                ],
                "formatString": "#,0",
                "displayFolder": "1. Volume\\1 Submissions"
              },
              {
                "name": "AMRs YTD",
                "expression": [
                  "",
                  "--The measure calculates AMRs as Year-To-Date running total regarding reporting dates selected context.",
                  "",
                  "TOTALYTD([AMRs],'1) Reporting Calendar'[Date])"
                ],
                "formatString": "#,0",
                "isHidden": true,
                "displayFolder": "1. Volume\\2 AMR (All Materials Received)"
              },
              {
                "name": "NR YTD",
                "expression": [
                  "",
                  "--The measure calculates Net Receipts as Year-To-Date running total regarding reporting dates selected context.",
                  "",
                  "TOTALYTD([NR],'1) Reporting Calendar'[Date])"
                ],
                "formatString": "#,0",
                "displayFolder": "1. Volume\\4 Net Receipts"
              },
              {
                "name": "CCA YTD",
                "expression": [
                  "",
                  "--The measure calculates CCA as Year-To-Date running total regarding reporting dates selected context.",
                  "",
                  "TOTALYTD([CCA],'1) Reporting Calendar'[Date])"
                ],
                "formatString": "#,0",
                "displayFolder": "1. Volume\\5 ClinCheck Accepted"
              },
              {
                "name": "Submissions YTD PY",
                "expression": [
                  "",
                  "--The measure calculates submissions as Past Year -> Year-To-Date running total regarding reporting dates selected context.",
                  "",
                  "TOTALYTD([Submissions PY],'1) Reporting Calendar'[Date])"
                ],
                "formatString": "#,0",
                "displayFolder": "1. Volume\\1 Submissions"
              },
              {
                "name": "AMRs YTD PY",
                "expression": [
                  "",
                  "--The measure calculates AMRs as Past Year -> Year-To-Date running total regarding reporting dates selected context.",
                  "",
                  "TOTALYTD([AMRs PY],'1) Reporting Calendar'[Date])"
                ],
                "formatString": "#,0",
                "isHidden": true,
                "displayFolder": "1. Volume\\2 AMR (All Materials Received)"
              },
              {
                "name": "NR YTD PY",
                "expression": [
                  "",
                  "--The measure calculates Net Receipts as Past Year -> Year-To-Date running total regarding reporting dates selected context.",
                  "",
                  "TOTALYTD([NR PY],'1) Reporting Calendar'[Date])"
                ],
                "formatString": "#,0",
                "displayFolder": "1. Volume\\4 Net Receipts"
              },
              {
                "name": "CCA YTD PY",
                "expression": [
                  "",
                  "--The measure calculates CCA as Past Year -> Year-To-Date running total regarding reporting dates selected context.",
                  "",
                  "TOTALYTD([CCA PY],'1) Reporting Calendar'[Date])"
                ],
                "formatString": "#,0",
                "displayFolder": "1. Volume\\5 ClinCheck Accepted"
              },
              {
                "name": "CCA 12RM",
                "expression": [
                  "",
                  "--This measure calculates CCA for 12 Rolling Month starting back from the maximum date in the Reporting Calendar context",
                  "",
                  "VAR curDay=MAX('1) Reporting Calendar'[Date])",
                  "VAR DayLY=SELECTCOLUMNS(",
                  "                FILTER('1) Reporting Calendar',[Date]=curDay),",
                  "                \"Date\", NEXTDAY(SAMEPERIODLASTYEAR('1) Reporting Calendar'[Date])))",
                  "",
                  "RETURN",
                  "CALCULATE (",
                  "        [CCA],",
                  "            DATESBETWEEN (",
                  "               '1) Reporting Calendar'[Date],",
                  "                DayLY,",
                  "                curDay))"
                ],
                "formatString": "#,0",
                "displayFolder": "2. Doctors Utilization\\CCA"
              },
              {
                "name": "NR 12RM",
                "expression": [
                  "",
                  "--This measure calculates Net Receipts for 12 Rolling Month starting back from the maximum date in the Reporting Calendar context",
                  "",
                  "VAR curDay=MAX('1) Reporting Calendar'[Date])",
                  "VAR DayLY=SELECTCOLUMNS(",
                  "                FILTER('1) Reporting Calendar',[Date]=curDay),",
                  "                \"Date\", NEXTDAY(SAMEPERIODLASTYEAR('1) Reporting Calendar'[Date])))",
                  "",
                  "RETURN",
                  "CALCULATE (",
                  "        [NR],",
                  "            DATESBETWEEN (",
                  "               '1) Reporting Calendar'[Date],",
                  "                DayLY,",
                  "                curDay))"
                ],
                "formatString": "#,0",
                "displayFolder": "2. Doctors Utilization\\NR"
              },
              {
                "name": "Submissions 12RM",
                "expression": [
                  "",
                  "--This measure calculates Submissions for 12 Rolling Month starting back from the maximum date in the Reporting Calendar context",
                  "",
                  "VAR curDay=MAX('1) Reporting Calendar'[Date])",
                  "VAR DayLY=SELECTCOLUMNS(",
                  "                FILTER('1) Reporting Calendar',[Date]=curDay),",
                  "                \"Date\", NEXTDAY(SAMEPERIODLASTYEAR('1) Reporting Calendar'[Date])))",
                  "",
                  "RETURN",
                  "CALCULATE (",
                  "        [Submissions],",
                  "            DATESBETWEEN (",
                  "               '1) Reporting Calendar'[Date],",
                  "                DayLY,",
                  "                curDay))"
                ],
                "formatString": "#,0",
                "displayFolder": "2. Doctors Utilization\\Submissions"
              },
              {
                "name": "AMRs 12RM",
                "expression": [
                  "",
                  "--This measure calculates AMRs for 12 Rolling Month starting back from the maximum date in the Reporting Calendar context",
                  "",
                  "VAR curDay=MAX('1) Reporting Calendar'[Date])",
                  "VAR DayLY=SELECTCOLUMNS(",
                  "                FILTER('1) Reporting Calendar',[Date]=curDay),",
                  "                \"Date\", NEXTDAY(SAMEPERIODLASTYEAR('1) Reporting Calendar'[Date])))",
                  "",
                  "RETURN",
                  "CALCULATE (",
                  "        [AMRs],",
                  "            DATESBETWEEN (",
                  "               '1) Reporting Calendar'[Date],",
                  "                DayLY,",
                  "                curDay))"
                ],
                "formatString": "#,0",
                "isHidden": true,
                "displayFolder": "2. Doctors Utilization\\AMR"
              },
              {
                "name": "CCA Submitters 12RM",
                "expression": [
                  "",
                  "--This measure calculates number of doctors who had at least 1 CCA for 12 Rolling Month period (Starting back from Reporting Calendar date context)",
                  "-- Is used for CCA Utilization 12RM calculation",
                  "SUMX(",
                  "    VALUES('2) Doctor'[PPID/ClinID]),",
                  "    IF([CCA 12RM]>0,1,BLANK())",
                  ")"
                ],
                "formatString": "#,0",
                "displayFolder": "2. Doctors Utilization\\CCA"
              },
              {
                "name": "Submitters 12RM",
                "expression": [
                  "",
                  "--This measure calculates number of doctors who had at least 1 order submitted for 12 Rolling Month period (Starting back from Reporting Calendar date context)",
                  "-- Is used for CCA Utilization 12RM calculation",
                  "SUMX(",
                  "    VALUES('2) Doctor'[PPID/ClinID]),",
                  "    IF([Submissions 12RM]>0,1,BLANK())",
                  ")"
                ],
                "formatString": "#,0",
                "displayFolder": "2. Doctors Utilization\\Submissions"
              },
              {
                "name": "AMR Submitters 12RM",
                "expression": [
                  "",
                  "--This measure calculates number of doctors who had at least 1 AMR for 12 Rolling Month period (Starting back from Reporting Calendar date context)",
                  "-- Is used for AMR Utilization 12RM calculation",
                  "SUMX(",
                  "    VALUES('2) Doctor'[PPID/ClinID]),",
                  "    IF([AMRs 12RM]>0,1,BLANK())",
                  ")"
                ],
                "formatString": "#,0",
                "isHidden": true,
                "displayFolder": "2. Doctors Utilization\\AMR"
              },
              {
                "name": "NR Submitters 12RM",
                "expression": [
                  "",
                  "--This measure calculates number of doctors who had at least 1 NR for 12 Rolling Month period (Starting back from Reporting Calendar date context)",
                  "-- Is used for NR Utilization 12RM calculation",
                  "SUMX(",
                  "    VALUES('2) Doctor'[PPID/ClinID]),",
                  "    IF([NR 12RM]>0,1,BLANK())",
                  ")"
                ],
                "formatString": "#,0",
                "displayFolder": "2. Doctors Utilization\\NR"
              },
              {
                "name": "Utilization by Submissions 12RM",
                "expression": [
                  "",
                  "--Calculates 12 Rolling Month Doctors Utilization based on orders submissions counts",
                  "",
                  "DIVIDE([Submissions 12RM],[Submitters 12RM])"
                ],
                "formatString": "0.0",
                "displayFolder": "2. Doctors Utilization\\Submissions"
              },
              {
                "name": "Utilization by AMRs 12RM",
                "expression": [
                  "",
                  "--Calculates 12 Rolling Month Doctors Utilization based on orders AMRs counts",
                  "",
                  "DIVIDE([AMRs 12RM],[AMR Submitters 12RM])"
                ],
                "formatString": "#,0.0",
                "isHidden": true,
                "displayFolder": "2. Doctors Utilization\\AMR"
              },
              {
                "name": "Utilization by NR 12RM",
                "expression": [
                  "",
                  "--Calculates 12 Rolling Month Doctors Utilization based on orders submNRissions counts",
                  "",
                  "DIVIDE([NR 12RM],[NR Submitters 12RM])"
                ],
                "formatString": "#,0.0",
                "displayFolder": "2. Doctors Utilization\\NR"
              },
              {
                "name": "Utilization by CCA 12RM",
                "expression": [
                  "",
                  "--Calculates 12 Rolling Month Doctors Utilization based on orders CCA counts",
                  "",
                  "DIVIDE([CCA 12RM],[CCA Submitters 12RM])"
                ],
                "formatString": "#,0.0",
                "displayFolder": "2. Doctors Utilization\\CCA"
              },
              {
                "name": "Doctors Count",
                "expression": "DISTINCTCOUNT('2) Doctor'[PPID/ClinID])",
                "formatString": "#,0",
                "displayFolder": "Doctors Onboarding & Activation"
              },
              {
                "name": "Doctors Certified Count",
                "expression": [
                  "",
                  "-- This measure counts number of doctors who has certified in selected time range ",
                  "--judging by Contact Certification Date",
                  "",
                  "VAR dt=DISTINCT('1) Reporting Calendar'[Date])",
                  "VAR res=CALCULATE([Doctors Count], TREATAS(dt,'2) Doctor'[Certification Date]))",
                  "",
                  "RETURN res"
                ],
                "formatString": "#,##0",
                "displayFolder": "Doctors Onboarding & Activation\\Upcoming Events"
              },
              {
                "name": "Activation AVR CCA at #days",
                "expression": [
                  "",
                  "",
                  "VAR days=MAX('z_Activation Days Series'[Activation at #Days])",
                  "VAR DoctorsSet=FILTER('2) Doctor',[Days After Certification]>=days)",
                  "",
                  "RETURN",
                  "AVERAGEX(",
                  "    DoctorsSet,",
                  "    ",
                  "    VAR certDate=[Certification Date]",
                  "",
                  "    RETURN",
                  "    CALCULATE(  [CCA], ",
                  "                ALL('1) Reporting Calendar'),",
                  "                '1) Reporting Calendar'[Date]>=certDate &&",
                  "                '1) Reporting Calendar'[Date]<=certDate+days",
                  "            )",
                  ")",
                  "",
                  "                ",
                  ""
                ],
                "formatString": "#,##0.0",
                "displayFolder": "Doctors Onboarding & Activation"
              },
              {
                "name": "Activation Doc Count at #days",
                "expression": [
                  "VAR days=MAX('z_Activation Days Series'[Activation at #Days])",
                  "VAR cca=MAX('z_Activation CCA Series'[# of CCA])",
                  "",
                  "VAR ActivatedDoctorsSet=FILTER(",
                  "        '2) Doctor',",
                  "        [Days After Certification]>=days &&",
                  "        CALCULATE(  [CCA], ",
                  "                ALL('1) Reporting Calendar'),",
                  "                '1) Reporting Calendar'[Date]>=EARLIER([Certification Date])&&",
                  "                '1) Reporting Calendar'[Date]<=EARLIER([Certification Date])+days",
                  "            )>=cca",
                  "       )",
                  "",
                  "RETURN COUNTROWS(ActivatedDoctorsSet)",
                  ""
                ],
                "formatString": "#,##0",
                "displayFolder": "Doctors Onboarding & Activation"
              },
              {
                "name": "Activation % at #days for #CAA",
                "expression": [
                  "",
                  "",
                  "VAR days=MAX('z_Activation Days Series'[Activation at #Days])",
                  "VAR cca=MAX('z_Activation CCA Series'[# of CCA])",
                  "",
                  "VAR DoctorsSet=FILTER('2) Doctor',[Days After Certification]>=days)",
                  "",
                  "VAR ActivatedDoctorsSet=FILTER(",
                  "        '2) Doctor',",
                  "        [Days After Certification]>=days &&",
                  "        CALCULATE(  [CCA], ",
                  "                ALL('1) Reporting Calendar'),",
                  "                '1) Reporting Calendar'[Date]>=EARLIER([Certification Date])&&",
                  "                '1) Reporting Calendar'[Date]<=EARLIER([Certification Date])+days",
                  "            )>=cca",
                  "       )",
                  "",
                  "RETURN DIVIDE(",
                  "    COUNTROWS(ActivatedDoctorsSet),",
                  "    COUNTROWS(DoctorsSet)",
                  ")",
                  ""
                ],
                "formatString": "0.00%;-0.00%;0.00%",
                "displayFolder": "Doctors Onboarding & Activation"
              },
              {
                "name": "Current Orders in Pipeline",
                "expression": [
                  "",
                  "CALCULATE(        ",
                  "        COUNT('FactPipeline'[OrderKey]),",
                  "        'FactPipeline'[OrderStatusKey]>=80 && FactPipeline[OrderStatusKey]<100",
                  "             )",
                  "",
                  " "
                ],
                "displayFolder": "Pipeline"
              },
              {
                "name": "Current Orders CCAA",
                "expression": [
                  "",
                  "CALCULATE(        ",
                  "        COUNT('FactPipeline'[OrderKey]),",
                  "        'FactPipeline'[OrderStatusKey]=90 || FactPipeline[OrderStatusKey]=81",
                  "             )"
                ],
                "displayFolder": "Pipeline"
              },
              {
                "name": "CCMOD Rate",
                "expression": [
                  "",
                  "",
                  "AVERAGEX('2) Doctor',",
                  "    ",
                  "    VAR certDate=[Certification Date]",
                  "",
                  "    RETURN",
                  "    CALCULATE(",
                  "        AVERAGE('FactOrderStatistics'[CCMODS Count]),",
                  "        FILTER('4) Primary Order', [SubmitDate]>=certDate),",
                  "        'FactOrderStatistics'[CCMODS Count]>0",
                  "            )",
                  ")",
                  "",
                  "",
                  "",
                  "        ",
                  "    "
                ],
                "displayFolder": "Pipeline"
              },
              {
                "name": "Upcoming Events Count",
                "expression": "DISTINCTCOUNT('Education Upcoming Events'[Event ID])",
                "formatString": "#,##0",
                "displayFolder": "Doctors Onboarding & Activation\\Upcoming Events"
              },
              {
                "name": "Events Count",
                "expression": " DISTINCTCOUNT('Education Events'[Event Name])",
                "formatString": "0",
                "displayFolder": "Doctors Onboarding & Activation"
              },
              {
                "name": "Activation CCA at #days",
                "expression": [
                  "",
                  "",
                  "VAR days=MAX('z_Activation Days Series'[Activation at #Days])",
                  "VAR DoctorsSet=FILTER('2) Doctor',[Days After Certification]>=days)",
                  "",
                  "RETURN",
                  "SUMX(",
                  "    DoctorsSet,",
                  "    ",
                  "    VAR certDate=[Certification Date]",
                  "",
                  "    RETURN",
                  "    CALCULATE(  [CCA], ",
                  "                ALL('1) Reporting Calendar'),",
                  "                '1) Reporting Calendar'[Date]>=certDate &&",
                  "                '1) Reporting Calendar'[Date]<=certDate+days",
                  "            )",
                  ")",
                  "",
                  "                ",
                  ""
                ],
                "formatString": "#,##0.0",
                "displayFolder": "Doctors Onboarding & Activation"
              },
              {
                "name": "JTP Actual Absolute",
                "expression": [
                  "VAR certYear=VALUES('2) Doctor'[Certification Year])",
                  "",
                  "RETURN ",
                  "CALCULATE( [CCA], TREATAS(certYear,'1) Reporting Calendar'[Year]))"
                ],
                "displayFolder": "Doctors Onboarding & Activation\\JTP Absolute"
              },
              {
                "name": "JTP Actual Absolute Running",
                "expression": [
                  "VAR certYear=VALUES('2) Doctor'[Certification Year])",
                  "",
                  "RETURN ",
                  "CALCULATE( [CCA YTD], TREATAS(certYear,'1) Reporting Calendar'[Year]))"
                ],
                "displayFolder": "Doctors Onboarding & Activation\\JTP Absolute"
              },
              {
                "name": "CE Doctors Count Reporting Q",
                "expression": [
                  "     VAR dt=DISTINCT('1) Reporting Calendar'[Date])",
                  "     VAR PrevQ=DATEADD(dt,-1,QUARTER)",
                  "     VAR PrevPrevQ=DATEADD(dt,-2,QUARTER)",
                  "     VAR MaxCertDate=CALCULATE(MIN('1) Reporting Calendar'[Date]), ALL('1) Reporting Calendar'), PrevPrevQ)",
                  "",
                  "RETURN",
                  "CALCULATE(",
                  "            DISTINCTCOUNT('2) Doctor'[PPID/ClinID]),",
                  "            '2) Doctor'[Certification Date]<MaxCertDate,",
                  "            '2) Doctor'[Doctor Status]=\"Active\"",
                  "",
                  "        )"
                ],
                "formatString": "#,##0",
                "displayFolder": "Continued Education"
              },
              {
                "name": "CE Events Count (Q-1 + Q-2)",
                "expression": [
                  "--This measure calculates number of continued education events taken by doctors for Previous Q and PrevPrev Q ",
                  "--based on Reporting Calendar Q selected",
                  "",
                  "    VAR dt=DISTINCT('1) Reporting Calendar'[Date])",
                  "    VAR PrevQ=DATEADD(dt,-1,QUARTER)",
                  "    VAR PrevPrevQ=DATEADD(dt,-2,QUARTER)",
                  "    VAR TrainigPeriod=CALCULATETABLE(VALUES('1) Reporting Calendar'[Date]), UNION(PrevQ,PrevPrevQ))",
                  "    VAR NumberOfCE=CALCULATE(",
                  "                        COUNT('Continued Education Events'[Event ID]),",
                  "                        TREATAS(TrainigPeriod,'Continued Education Events'[Event Date])",
                  "    )",
                  "",
                  "RETURN NumberOfCE"
                ],
                "formatString": "#,##0",
                "displayFolder": "Continued Education"
              },
              {
                "name": "CE NR Growth (by CE Group)",
                "expression": [
                  "IF( [CE NR Reporting Q LY (by CE Group)]>0,",
                  "    DIVIDE([CE NR Reporting Q (by CE Group)],[CE NR Reporting Q LY (by CE Group)])-1,",
                  "    BLANK()",
                  ")"
                ],
                "formatString": "#,##0.0 %",
                "displayFolder": "Continued Education\\NR"
              },
              {
                "name": "CE NR Reporting Q",
                "expression": [
                  "VAR repQ=VALUES('1) Reporting Calendar'[Quarter-Year Name])",
                  "VAR docs=FILTER(VALUES('2) Doctor'[PPID/ClinID]), [CE Doctors Count Reporting Q]>0)",
                  "RETURN",
                  "CALCULATE([NR],repQ,docs)"
                ],
                "formatString": "#,##0",
                "displayFolder": "Continued Education\\NR"
              },
              {
                "name": "CE NR Reporting Q (by CE Group)",
                "expression": [
                  "    VAR SelectedDoctorGroup=",
                  "        IF(",
                  "            HASONEVALUE('Continued Education Doctor Group'[Doctor Training Group]),",
                  "            VALUES('Continued Education Doctor Group'[Doctor Training Group]),",
                  "            BLANK())",
                  "",
                  "RETURN",
                  "SWITCH( SelectedDoctorGroup,",
                  "    \"0 Trainings\",",
                  "        CALCULATE(",
                  "                [CE NR Reporting Q],",
                  "                FILTER(VALUES('2) Doctor'[PPID/ClinID]),[CE Events Count (Q-1 + Q-2)]=0 && [CE Doctors Count Reporting Q]>0)",
                  "                ),",
                  "    \"1 Training\",",
                  "        CALCULATE(",
                  "                [CE NR Reporting Q],",
                  "                FILTER(VALUES('2) Doctor'[PPID/ClinID]),[CE Events Count (Q-1 + Q-2)]=1 && [CE Doctors Count Reporting Q]>0)",
                  "                ),",
                  "    \"2+ Trainings\",",
                  "        CALCULATE(",
                  "                [CE NR Reporting Q],",
                  "                FILTER(VALUES('2) Doctor'[PPID/ClinID]),[CE Events Count (Q-1 + Q-2)]>=2 && [CE Doctors Count Reporting Q]>0)",
                  "                ),",
                  "    BLANK()",
                  ")"
                ],
                "formatString": "#,##0",
                "displayFolder": "Continued Education\\NR"
              },
              {
                "name": "CE NR Reporting Q LY",
                "expression": [
                  "VAR docs=FILTER(VALUES('2) Doctor'[PPID/ClinID]), [CE Doctors Count Reporting Q]>0)",
                  "VAR Q_LY=SAMEPERIODLASTYEAR('1) Reporting Calendar'[Date])",
                  "RETURN",
                  "CALCULATE([NR],Q_LY,docs)"
                ],
                "formatString": "#,##0",
                "displayFolder": "Continued Education\\NR"
              },
              {
                "name": "CE NR Reporting Q LY (by CE Group)",
                "expression": [
                  "    VAR SelectedDoctorGroup=",
                  "        IF(",
                  "            HASONEVALUE('Continued Education Doctor Group'[Doctor Training Group]),",
                  "            VALUES('Continued Education Doctor Group'[Doctor Training Group]),",
                  "            BLANK())",
                  "",
                  "RETURN",
                  "SWITCH( SelectedDoctorGroup,",
                  "    \"0 Trainings\",",
                  "        CALCULATE(",
                  "                [CE NR Reporting Q LY],",
                  "                FILTER(VALUES('2) Doctor'[PPID/ClinID]),[CE Events Count (Q-1 + Q-2)]=0 && [CE Doctors Count Reporting Q]>0)",
                  "                ),",
                  "    \"1 Training\",",
                  "        CALCULATE(",
                  "                [CE NR Reporting Q LY],",
                  "                FILTER(VALUES('2) Doctor'[PPID/ClinID]),[CE Events Count (Q-1 + Q-2)]=1 && [CE Doctors Count Reporting Q]>0)",
                  "                ),",
                  "    \"2+ Trainings\",",
                  "        CALCULATE(",
                  "                [CE NR Reporting Q LY],",
                  "                FILTER(VALUES('2) Doctor'[PPID/ClinID]),[CE Events Count (Q-1 + Q-2)]>=2 && [CE Doctors Count Reporting Q]>0)",
                  "                ),",
                  "    BLANK()",
                  ")"
                ],
                "formatString": "#,##0",
                "displayFolder": "Continued Education\\NR"
              },
              {
                "name": "CountOfDoctorsByCEGroup",
                "expression": [
                  "    VAR SelectedDoctorGroup=",
                  "        IF(",
                  "            HASONEVALUE('Continued Education Doctor Group'[Doctor Training Group]),",
                  "            VALUES('Continued Education Doctor Group'[Doctor Training Group]),",
                  "            BLANK())",
                  "            ",
                  "     VAR dt=DISTINCT('1) Reporting Calendar'[Date])",
                  "     VAR PrevQ=DATEADD(dt,-1,QUARTER)",
                  "     VAR PrevPrevQ=DATEADD(dt,-2,QUARTER)",
                  "     VAR MaxCertDate=CALCULATE(MIN('1) Reporting Calendar'[Date]), ALL('1) Reporting Calendar'), PrevPrevQ)",
                  "",
                  "RETURN",
                  "         SWITCH( SelectedDoctorGroup,",
                  "                \"0 Trainings\",",
                  "                     CALCULATE(",
                  "                        COUNTROWS(FILTER(VALUES('2) Doctor'[PPID/ClinID]),[CE Events Count (Q-1 + Q-2)]=0)),",
                  "                        '2) Doctor'[Doctor Status]=\"Active\",",
                  "                        '2) Doctor'[Certification Date]<MaxCertDate),",
                  "                \"1 Training\",",
                  "                       CALCULATE(",
                  "                            COUNTROWS(FILTER(VALUES('2) Doctor'[PPID/ClinID]),[CE Events Count (Q-1 + Q-2)]=1)),",
                  "                            '2) Doctor'[Doctor Status]=\"Active\",",
                  "                            '2) Doctor'[Certification Date]<MaxCertDate),",
                  "                \"2+ Trainings\",",
                  "                       CALCULATE(",
                  "                            COUNTROWS(FILTER(VALUES('2) Doctor'[PPID/ClinID]),[CE Events Count (Q-1 + Q-2)]>=2)),",
                  "                            '2) Doctor'[Doctor Status]=\"Active\",",
                  "                            '2) Doctor'[Certification Date]<MaxCertDate),",
                  "                BLANK() ",
                  "            )",
                  ""
                ],
                "formatString": "#,##0",
                "displayFolder": "Continued Education"
              },
              {
                "name": "CE CCA Growth (by CE Group)",
                "expression": [
                  "IF( [CE CCA Reporting Q LY (by CE Group)]>0,",
                  "    DIVIDE([CE CCA Reporting Q (by CE Group)],[CE CCA Reporting Q LY (by CE Group)])-1,",
                  "    BLANK()",
                  ")"
                ],
                "formatString": "#,##0.0 %",
                "displayFolder": "Continued Education\\CCA"
              },
              {
                "name": "CE CCA Reporting Q",
                "expression": [
                  "VAR repQ=VALUES('1) Reporting Calendar'[Quarter-Year Name])",
                  "VAR docs=FILTER(VALUES('2) Doctor'[PPID/ClinID]), [CE Doctors Count Reporting Q]>0)",
                  "RETURN",
                  "CALCULATE([CCA],repQ,docs)"
                ],
                "formatString": "#,##0",
                "displayFolder": "Continued Education\\CCA"
              },
              {
                "name": "CE CCA Reporting Q (by CE Group)",
                "expression": [
                  "    VAR SelectedDoctorGroup=",
                  "        IF(",
                  "            HASONEVALUE('Continued Education Doctor Group'[Doctor Training Group]),",
                  "            VALUES('Continued Education Doctor Group'[Doctor Training Group]),",
                  "            BLANK())",
                  "",
                  "RETURN",
                  "SWITCH( SelectedDoctorGroup,",
                  "    \"0 Trainings\",",
                  "        CALCULATE(",
                  "                [CE CCA Reporting Q],",
                  "                FILTER(VALUES('2) Doctor'[PPID/ClinID]),[CE Events Count (Q-1 + Q-2)]=0 && [CE Doctors Count Reporting Q]>0)",
                  "                ),",
                  "    \"1 Training\",",
                  "        CALCULATE(",
                  "                [CE CCA Reporting Q],",
                  "                FILTER(VALUES('2) Doctor'[PPID/ClinID]),[CE Events Count (Q-1 + Q-2)]=1 && [CE Doctors Count Reporting Q]>0)",
                  "                ),",
                  "    \"2+ Trainings\",",
                  "        CALCULATE(",
                  "                [CE CCA Reporting Q],",
                  "                FILTER(VALUES('2) Doctor'[PPID/ClinID]),[CE Events Count (Q-1 + Q-2)]>=2 && [CE Doctors Count Reporting Q]>0)",
                  "                ),",
                  "    BLANK()",
                  ")"
                ],
                "formatString": "#,##0",
                "displayFolder": "Continued Education\\CCA"
              },
              {
                "name": "CE CCA Reporting Q LY",
                "expression": [
                  "VAR docs=FILTER(VALUES('2) Doctor'[PPID/ClinID]), [CE Doctors Count Reporting Q]>0)",
                  "VAR Q_LY=SAMEPERIODLASTYEAR('1) Reporting Calendar'[Date])",
                  "RETURN",
                  "CALCULATE([CCA],Q_LY,docs)"
                ],
                "formatString": "#,##0",
                "displayFolder": "Continued Education\\CCA"
              },
              {
                "name": "CE CCA Reporting Q LY (by CE Group)",
                "expression": [
                  "    VAR SelectedDoctorGroup=",
                  "        IF(",
                  "            HASONEVALUE('Continued Education Doctor Group'[Doctor Training Group]),",
                  "            VALUES('Continued Education Doctor Group'[Doctor Training Group]),",
                  "            BLANK())",
                  "",
                  "RETURN",
                  "SWITCH( SelectedDoctorGroup,",
                  "    \"0 Trainings\",",
                  "        CALCULATE(",
                  "                [CE CCA Reporting Q LY],",
                  "                FILTER(VALUES('2) Doctor'[PPID/ClinID]),[CE Events Count (Q-1 + Q-2)]=0 && [CE Doctors Count Reporting Q]>0)",
                  "                ),",
                  "    \"1 Training\",",
                  "        CALCULATE(",
                  "                [CE CCA Reporting Q LY],",
                  "                FILTER(VALUES('2) Doctor'[PPID/ClinID]),[CE Events Count (Q-1 + Q-2)]=1 && [CE Doctors Count Reporting Q]>0)",
                  "                ),",
                  "    \"2+ Trainings\",",
                  "        CALCULATE(",
                  "                [CE CCA Reporting Q LY],",
                  "                FILTER(VALUES('2) Doctor'[PPID/ClinID]),[CE Events Count (Q-1 + Q-2)]>=2 && [CE Doctors Count Reporting Q]>0)",
                  "                ),",
                  "    BLANK()",
                  ")"
                ],
                "formatString": "#,##0",
                "displayFolder": "Continued Education\\CCA"
              },
              {
                "name": "CE Sales Growth (by CE Group)",
                "expression": [
                  "VAR s=IF( HASONEVALUE(z_Util_Measures_List[Code]),VALUES(z_Util_Measures_List[Code]),BLANK())",
                  "RETURN",
                  "SWITCH( s,",
                  "    \"3\",[CE NR Growth (by CE Group)],",
                  "    \"4\",[CE CCA Growth (by CE Group)],",
                  "    BLANK()",
                  ")",
                  ""
                ],
                "formatString": "#,##0.0 %",
                "displayFolder": "Continued Education\\Selection Based"
              },
              {
                "name": "CE Sales Reporting Q",
                "expression": [
                  "VAR s=IF( HASONEVALUE(z_Util_Measures_List[Code]),VALUES(z_Util_Measures_List[Code]),BLANK())",
                  "RETURN",
                  "SWITCH( s,",
                  "    \"3\",[CE NR Reporting Q],",
                  "    \"4\",[CE CCA Reporting Q],",
                  "    BLANK()",
                  ")"
                ],
                "formatString": "#,##0",
                "displayFolder": "Continued Education\\Selection Based"
              },
              {
                "name": "CE Sales Reporting Q (by CE Group)",
                "expression": [
                  "VAR s=IF( HASONEVALUE(z_Util_Measures_List[Code]),VALUES(z_Util_Measures_List[Code]),BLANK())",
                  "RETURN",
                  "SWITCH( s,",
                  "    \"3\",[CE NR Reporting Q (by CE Group)],",
                  "    \"4\",[CE CCA Reporting Q (by CE Group)],",
                  "    BLANK()",
                  ")"
                ],
                "formatString": "#,##0",
                "displayFolder": "Continued Education\\Selection Based"
              },
              {
                "name": "CE Sales Reporting Q LY",
                "expression": [
                  "VAR s=IF( HASONEVALUE(z_Util_Measures_List[Code]),VALUES(z_Util_Measures_List[Code]),BLANK())",
                  "RETURN",
                  "SWITCH( s,",
                  "    \"3\",[CE NR Reporting Q LY],",
                  "    \"4\",[CE CCA Reporting Q LY],",
                  "    BLANK()",
                  ")"
                ],
                "formatString": "#,##0",
                "displayFolder": "Continued Education\\Selection Based"
              },
              {
                "name": "CE Sales Reporting Q LY (by CE Group)",
                "expression": [
                  "VAR s=IF( HASONEVALUE(z_Util_Measures_List[Code]),VALUES(z_Util_Measures_List[Code]),BLANK())",
                  "RETURN",
                  "SWITCH( s,",
                  "    \"3\",[CE NR Reporting Q LY (by CE Group)],",
                  "    \"4\",[CE CCA Reporting Q LY (by CE Group)],",
                  "    BLANK()",
                  ")",
                  ""
                ],
                "formatString": "#,##0",
                "displayFolder": "Continued Education\\Selection Based"
              },
              {
                "name": "CE AVR CCA Reporting Q (by CE Group)",
                "expression": [
                  "    VAR SelectedDoctorGroup=",
                  "        IF(",
                  "            HASONEVALUE('Continued Education Doctor Group'[Doctor Training Group]),",
                  "            VALUES('Continued Education Doctor Group'[Doctor Training Group]),",
                  "            BLANK())",
                  "",
                  "RETURN",
                  "SWITCH( SelectedDoctorGroup,",
                  "    \"0 Trainings\",",
                  "        VAR docs=FILTER(VALUES('2) Doctor'[PPID/ClinID]),[CE Events Count (Q-1 + Q-2)]=0 && [CE Doctors Count Reporting Q]>0)",
                  "        RETURN ",
                  "            DIVIDE([CE CCA Reporting Q],COUNTROWS(docs)),",
                  "                ",
                  "    \"1 Training\",",
                  "        VAR docs=FILTER(VALUES('2) Doctor'[PPID/ClinID]),[CE Events Count (Q-1 + Q-2)]=1 && [CE Doctors Count Reporting Q]>0)",
                  "        RETURN ",
                  "            DIVIDE([CE CCA Reporting Q],COUNTROWS(docs)),",
                  "                ",
                  "    \"2+ Trainings\",",
                  "        VAR docs=FILTER(VALUES('2) Doctor'[PPID/ClinID]),[CE Events Count (Q-1 + Q-2)]>=2 && [CE Doctors Count Reporting Q]>0)",
                  "        RETURN ",
                  "            DIVIDE([CE CCA Reporting Q],COUNTROWS(docs)),",
                  "    BLANK()",
                  ")",
                  ""
                ],
                "formatString": "#,##0.0",
                "displayFolder": "Continued Education\\CCA"
              },
              {
                "name": "CE AVR CCA Reporting Q LY (by CE Group)",
                "expression": [
                  "    VAR SelectedDoctorGroup=",
                  "        IF(",
                  "            HASONEVALUE('Continued Education Doctor Group'[Doctor Training Group]),",
                  "            VALUES('Continued Education Doctor Group'[Doctor Training Group]),",
                  "            BLANK())",
                  "",
                  "RETURN",
                  "SWITCH( SelectedDoctorGroup,",
                  "\"0 Trainings\",",
                  "        VAR docs=FILTER(VALUES('2) Doctor'[PPID/ClinID]),[CE Events Count (Q-1 + Q-2)]=0 && [CE Doctors Count Reporting Q]>0)",
                  "        RETURN ",
                  "            DIVIDE([CE CCA Reporting Q LY],COUNTROWS(docs)),",
                  "                ",
                  "    \"1 Training\",",
                  "        VAR docs=FILTER(VALUES('2) Doctor'[PPID/ClinID]),[CE Events Count (Q-1 + Q-2)]=1 && [CE Doctors Count Reporting Q]>0)",
                  "        RETURN ",
                  "            DIVIDE([CE CCA Reporting Q LY],COUNTROWS(docs)),",
                  "                ",
                  "    \"2+ Trainings\",",
                  "        VAR docs=FILTER(VALUES('2) Doctor'[PPID/ClinID]),[CE Events Count (Q-1 + Q-2)]>=2 && [CE Doctors Count Reporting Q]>0)",
                  "        RETURN ",
                  "            DIVIDE([CE CCA Reporting Q LY],COUNTROWS(docs)),",
                  "    BLANK()",
                  ")",
                  ""
                ],
                "formatString": "#,##0.0",
                "displayFolder": "Continued Education\\CCA"
              },
              {
                "name": "CE AVR NR Reporting Q (by CE Group)",
                "expression": [
                  "    VAR SelectedDoctorGroup=",
                  "        IF(",
                  "            HASONEVALUE('Continued Education Doctor Group'[Doctor Training Group]),",
                  "            VALUES('Continued Education Doctor Group'[Doctor Training Group]),",
                  "            BLANK())",
                  "",
                  "RETURN",
                  "SWITCH( SelectedDoctorGroup,",
                  "    \"0 Trainings\",",
                  "        VAR docs=FILTER(VALUES('2) Doctor'[PPID/ClinID]),[CE Events Count (Q-1 + Q-2)]=0 && [CE Doctors Count Reporting Q]>0)",
                  "        RETURN ",
                  "            DIVIDE([CE NR Reporting Q],COUNTROWS(docs)),",
                  "                ",
                  "    \"1 Training\",",
                  "        VAR docs=FILTER(VALUES('2) Doctor'[PPID/ClinID]),[CE Events Count (Q-1 + Q-2)]=1 && [CE Doctors Count Reporting Q]>0)",
                  "        RETURN ",
                  "            DIVIDE([CE NR Reporting Q],COUNTROWS(docs)),",
                  "                ",
                  "    \"2+ Trainings\",",
