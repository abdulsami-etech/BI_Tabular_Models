            "partitions": [
              {
                "name": "FactOrderStatus",
                "dataView": "full",
                "source": {
                  "type": "m",
                  "expression": [
                    "let",
                    "    Source = Value.NativeQuery(#\"OTCDM\", ",
                    "\"",
                    "    with fos as (",
                    "",
                    "    select",
                    "        f.OrderKey,",
                    "        f.StatusDate,",
                    "        f.ProductKey,",
                    "",
                    "        case    when f.OrderStatusKey = 100",
                    "                        then f.OrderStatusCount ",
                    "                    when f.OrderStatusKey = 108",
                    "                    and cast(o.CCADate as date) <= cast(o.CancellationDate as date)",
                    "                        then -f.OrderStatusCount",
                    "                    else null ",
                    "        end                                                 as [CCA],",
                    "",
                    "        case    when f.OrderStatusKey = 80",
                    "                        then f.OrderStatusCount",
                    "                    when f.OrderStatusKey = 108",
                    "                    and o.AMRDate is not null",
                    "                        then -f.OrderStatusCount",
                    "                    else null ",
                    "        end                                                 as [Net Receipts],",
                    "",
                    "        case when f.OrderStatusKey = 40",
                    "                then f.OrderStatusCount ",
                    "                else null ",
                    "        end                                                 as [Submissions],",
                    "",
                    "        case when f.OrderStatusKey = 80",
                    "                    then f.OrderStatusCount",
                    "                    else null ",
                    "        end                                                 as [AMR],",
                    "",
                    "        case when f.OrderStatusKey = 80",
                    "                  and o.NewOrRestart = 'New Order'",
                    "             then f.OrderStatusCount",
                    "             else null ",
                    "        end                                                 as [GrossReceipts],",
                    "        ",
                    "        case when f.OrderStatusKey = 110",
                    "                then f.OrderStatusCount ",
                    "                else null ",
                    "        end                                                 as [Shipments],",
                    "        ",
                    "        case when f.OrderStatusKey = 108",
                    "                and o.AMRDate is not null",
                    "            then f.OrderStatusCount ",
                    "            else null ",
                    "        end as AllCancellations,",
                    "        ",
                    "        case when f.OrderStatusKey = 108",
                    "                and o.AMRDate is not null               ",
                    "            then f.OrderStatusCount ",
                    "            when f.OrderStatusKey = 80",
                    "                and o.AMRDate is not null",
                    "                and o.NewOrRestart = 'Restart'",
                    "            then -f.OrderStatusCount ",
                    "            else null ",
                    "        end as ActualCancellations,",
                    "        ",
                    "        case when f.OrderStatusKey = 80",
                    "            and o.NewOrRestart = 'Restart'",
                    "                then f.OrderStatusCount",
                    "                else null ",
                    "        end as Restarts,",
                    "        ",
                    "        a.AdvantageTierName",
                    "",
                    "    from [DM].[DimOrder] o",
                    "        inner join DM.DimCustContact c on o.ContactKey=c.ContactKey",
                    "        inner join [DSV].[FactOrderStatus] f on f.OrderKey=o.OrderKey",
                    "        left join [DM].[DimAdvantageTier] a with(nolock) on f.AdvantageTierKey = a.AdvantageTierKey",
                    "        left join Custom.testdoctors td on td.ClinID=c.ContactClinID",
                    "    where  ",
                    "         ContactRegionGroup='Asia Pacific' and ",
                    "         o.TreatmentCategory = N'Primary' and",
                    "         ISNULL(o.IsTestOrder,'')<>'Yes' and",
                    "         c.ContactRecordType='Doctor' and",
                    "         td.ClinID IS NULL",
                    ")",
                    "",
                    "select",
                    "    OrderKey,",
                    "    StatusDate,",
                    "    ProductKey,",
                    "    AdvantageTierName,",
                    "    SUM([CCA])              as [CCA],",
                    "    SUM([Net Receipts])     as [Net Receipts],",
                    "    SUM([Submissions])      as [Submissions],",
                    "    SUM([AMR])              as [AMR],",
                    "    SUM([GrossReceipts])    as [GrossReceipts],",
                    "    SUM([Shipments])        as [Shipments],",
                    "    SUM(AllCancellations)   as [All Cancellations],",
                    "    SUM(ActualCancellations) as [Actual Cancellations],",
                    "    SUM(Restarts)           as [Restarts]",
                    "    ",
                    "from fos",
                    "    where ",
                    "        ([CCA] IS NOT NULL) or",
                    "        ([Net Receipts] IS NOT NULL) or",
                    "        ([Submissions] IS NOT NULL) or",
                    "        ([AMR] IS NOT NULL) or",
                    "        ([Shipments] IS NOT NULL) or",
                    "        ([AllCancellations] IS NOT NULL) or",
                    "        ([ActualCancellations] IS NOT NULL) or",
                    "        ([Restarts] IS NOT NULL)",
                    "group by ",
                    "    OrderKey,",
                    "    StatusDate,",
                    "    ProductKey,",
                    "    AdvantageTierName",
                    "\"",
                    ")",
                    "",
                    "in",
                    "    Source"
                  ]
                }
              }
            ],
            "annotations": [
              {
                "name": "PBI_Id",
                "value": "f9d6f6de-7fca-49c4-880a-b9550633559a"
              },
              {
                "name": "LinkedQueryName",
                "value": "FactOrderStatus"
              },
