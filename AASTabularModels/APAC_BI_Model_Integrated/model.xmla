          {
            "name": "FactPipeline",
            "isHidden": true,
            "columns": [
              {
                "name": "DateKey",
                "dataType": "dateTime",
                "sourceColumn": "DateKey",
                "isAvailableInMdx": false
              },
              {
                "name": "OrderKey",
                "dataType": "int64",
                "sourceColumn": "OrderKey",
                "isAvailableInMdx": false
              },
              {
                "name": "ProductKey",
                "dataType": "int64",
                "sourceColumn": "ProductKey",
                "isAvailableInMdx": false
              },
              {
                "name": "CustomerKey",
                "dataType": "int64",
                "sourceColumn": "CustomerKey",
                "isAvailableInMdx": false
              },
              {
                "name": "OrderStatusKey",
                "dataType": "int64",
                "sourceColumn": "OrderStatusKey",
                "isAvailableInMdx": false
              },
              {
                "name": "OrderStatusName",
                "dataType": "string",
                "sourceColumn": "OrderStatusName",
                "isAvailableInMdx": false
              }
            ],
            "partitions": [
              {
                "name": "Partition",
                "dataView": "full",
                "source": {
                  "type": "m",
                  "expression": [
                    "let",
                    "    Source = Value.NativeQuery(#\"OTCDM\",",
                    "\"",
                    "declare @ld as date",
                    "select @ld=DATEADD(day,-1,max(DateKey)) from [DM].[FactPipeline];",
                    "",
                    "with d as (",
                    "select",
                    "\tf.DateKey,\t",
                    "\tf.OrderKey,",
                    "\to.ProductKey,",
                    "\to.CustomerKey,",
                    "\tf.OrderStatusKey,",
                    "\ts.OrderStatusName",
                    "from [DM].[FactPipeline] f",
                    "\tinner join TABV.PrimaryOrder o on o.OrderKey=f.OrderKey",
                    "\tinner join DM.DimOrderStatus s on f.OrderStatusKey=s.OrderStatusKey",
                    "\tinner join DM.DimProduct p on o.ProductKey=p.ProductKey",
                    "\tinner join DM.DimCust cust on cust.CustomerKey=o.CustomerKey",
                    "\tinner join DM.DimCustContact c on cust.ContactKey=c.ContactKey",
                    "where ",
                    "\tf.DateKey=@ld",
                    "\tand p.Level3Name='Treatment'",
                    "\tand f.OrderStatusKey>=40 and f.OrderStatusKey<=100",
                    "\tand c.ContactRecordType='Doctor' and ContactRegiongroup='Asia Pacific'",
                    ")",
                    "",
                    "select * from d",
                    "",
                    "\"),",
                    "    #\"Changed Type\" = Table.TransformColumnTypes(Source,{{\"DateKey\", type date}, {\"OrderStatusKey\", Int64.Type}})",
                    "",
                    "in",
                    "    #\"Changed Type\""
                  ]
                }
              }
            ]
          },
          {
            "name": "FactOrderStatistics",
            "isHidden": true,
            "columns": [
              {
                "name": "OrderKey",
                "dataType": "int64",
                "sourceColumn": "OrderKey",
                "isAvailableInMdx": false
              },
              {
                "name": "Submit to AMR days",
                "dataType": "int64",
                "sourceColumn": "Submit to AMR days",
                "isAvailableInMdx": false
              },
              {
                "name": "AMR to CCA days",
                "dataType": "int64",
                "sourceColumn": "AMR to CCA days",
                "isAvailableInMdx": false
              },
              {
                "name": "CCMODS Count",
                "dataType": "int64",
                "sourceColumn": "CCMODS Count",
                "isAvailableInMdx": false
              },
              {
                "name": "CCUD Duration",
                "dataType": "int64",
                "sourceColumn": "CCUD Duration",
                "isAvailableInMdx": false
              }
            ],
            "partitions": [
              {
                "name": "FactOrderStatistics",
                "source": {
                  "type": "m",
                  "expression": [
                    "let",
                    "    Source = Value.NativeQuery(#\"OTCDM\",",
                    "",
                    "\"",
                    "with stat_raw as (",
                    "select",
                    "        f.OrderKey,",
                    "        ",
                    "        CASE WHEN f.OrderStatusKey=80 THEN",
                    "                DATEDIFF(day,",
                    "                    MIN( CASE f.OrderStatusKey WHEN 40 THEN f.StatusDate ELSE NULL END) over (partition by f.OrderKey order by f.StatusDate, f.OrderStatusKey, f.[LastStatusDatetime]), --First Submit",
                    "                    MAX( CASE f.OrderStatusKey WHEN 80 THEN f.StatusDate ELSE NULL END) over (partition by f.OrderKey order by f.StatusDate, f.OrderStatusKey, f.[LastStatusDatetime]) --AMR",
                    "                    )",
                    "        ELSE NULL END as [Submit to AMR days],",
                    "",
                    "        CASE WHEN OrderStatusKey=100 THEN",
                    "                DATEDIFF(day,",
                    "                    MIN( CASE f.OrderStatusKey WHEN 80 THEN f.StatusDate ELSE NULL END) over (partition by f.OrderKey order by f.StatusDate, f.OrderStatusKey, f.[LastStatusDatetime]), --First AMR",
                    "                    MAX( CASE f.OrderStatusKey WHEN 100 THEN f.StatusDate ELSE NULL END) over (partition by f.OrderKey order by f.StatusDate, f.OrderStatusKey, f.[LastStatusDatetime]) --Last CCA",
                    "                    )",
                    "        ELSE NULL END as [AMR to CCA days],",
                    "",
                    "        CASE WHEN OrderStatusKey=100 THEN",
                    "                SUM(CASE f.OrderStatusKey WHEN 82 THEN 1 ELSE 0 END) over (partition by f.OrderKey order by f.StatusDate, f.OrderStatusKey, f.[LastStatusDatetime])",
                    "        ELSE NULL END as [CCMODS Count],",
                    "",
                    "        CASE WHEN OrderStatusKey=85 ",
                    "                    and ( DATEDIFF(day,StatusDate,LEAD(StatusDate,1) over (partition by f.OrderKey order by f.StatusDate, f.OrderStatusKey, f.[LastStatusDatetime])) IS NOT NULL) ",
                    "                    --day to next status",
                    "        THEN DATEDIFF(day,StatusDate,LEAD(StatusDate,1) over (partition by f.OrderKey order by f.StatusDate, f.OrderStatusKey, f.[LastStatusDatetime]))",
                    "        ELSE NULL END ",
                    "            as [CCUD Duration]",
                    "",
                    "    from [DM].[DimOrder] o",
                    "        inner join DM.DimCustContact c on o.ContactKey=c.ContactKey",
                    "        inner join [DM].[FactOrderStatusRecurring] f on f.OrderKey=o.OrderKey",
                    "    where  ",
                    "         ContactRegionGroup='Asia Pacific' and ",
                    "         o.TreatmentCategory = N'Primary' and",
                    "         ISNULL(o.IsTestOrder,'')<>'Yes' and",
                    "         c.ContactRecordType='Doctor'",
                    ")",
                    "",
                    "select ",
                    "        OrderKey,",
                    "        MAX([Submit to AMR days])   as [Submit to AMR days],",
                    "        MAX([AMR to CCA days])      as [AMR to CCA days],",
                    "        MAX([CCMODS Count])         as [CCMODS Count],",
                    "        SUM([CCUD Duration])        as [CCUD Duration]",
                    "    from stat_raw",
                    "    group by OrderKey",
                    " \")",
                    " ",
                    " in",
                    "    Source"
                  ]
                }
              }
            ]
          },
          {
            "name": "Education Upcoming Events",
            "columns": [
              {
                "name": "Event Record Type",
                "dataType": "string",
                "sourceColumn": "Event Record Type"
              },
              {
                "name": "Event ID",
                "dataType": "string",
                "sourceColumn": "Event ID"
              },
              {
                "name": "Event Name",
                "dataType": "string",
                "sourceColumn": "Event Name"
              },
              {
                "name": "RegionPC",
                "dataType": "string",
                "sourceColumn": "RegionPC"
              },
              {
                "name": "CountryGroup",
                "dataType": "string",
                "sourceColumn": "CountryGroup"
              },
              {
                "name": "Country",
                "dataType": "string",
                "sourceColumn": "Country"
              },
              {
                "name": "Event Date",
                "dataType": "dateTime",
                "sourceColumn": "Event Date",
                "formatString": "dd.MM.yyyy",
                "annotations": [
                  {
                    "name": "Format",
                    "value": "<Format Format=\"DateTimeCustom\"><DateTimes><DateTime LCID=\"1049\" Group=\"ShortDate\" FormatString=\"dd.MM.yyyy\" /></DateTimes></Format>"
                  }
                ]
              },
              {
                "name": "Event Type",
                "dataType": "string",
                "sourceColumn": "Event Type"
              },
              {
                "name": "Event Country",
                "dataType": "string",
                "sourceColumn": "Event Country"
              },
              {
                "name": "Event City",
                "dataType": "string",
                "sourceColumn": "Event City"
              },
              {
                "name": "Event Speaker",
                "dataType": "string",
                "sourceColumn": "Event Speaker"
              },
              {
                "name": "ContactID",
                "dataType": "string",
                "sourceColumn": "ContactID"
              },
              {
                "name": "LeadID",
                "dataType": "string",
                "sourceColumn": "LeadID"
              },
              {
                "name": "Member Status",
                "dataType": "string",
                "sourceColumn": "Member Status"
              },
              {
                "type": "calculated",
                "name": "SFDC Event Link",
                "dataType": "string",
                "isDataTypeInferred": false,
                "expression": "CONCATENATE(\"https://aligntech.my.salesforce.com/\",[Event ID])",
                "dataCategory": "WebUrl",
                "isDefaultLabel": true
              }
            ],
            "partitions": [
              {
                "name": "Education Upcoming Events",
                "dataView": "full",
                "source": {
                  "type": "m",
                  "expression": [
                    "let",
                    "    Source = Value.NativeQuery(#\"OTCDM\", ",
                    "\"",
                    "",
                    "SELECT ",
                    "    'Campaign'          as [Event Record Type],",
                    "    c.[CampaignID]      as [Event ID],",
                    "    c.CampaignName      as [Event Name],",
                    "    g.RegionPC,",
                    "    g.CountryGroup,",
                    "    g.Country,",
                    "    c.EventDate         as [Event Date],",
                    "    c.EventTypePicklist as [Event Type],",
                    "    c.EventCountry      as [Event Country],",
                    "    c.EventCity         as [Event City],",
                    "    sp.[ContactName]    as [Event Speaker],",
                    "    cont.ContactID,",
                    "    m.LeadID,",
                    "    m.Name as [Member Name],",
                    "    m.Status as [Member Status]",
                    "",
                    "FROM [DM].[DimCampaign] c",
                    "    INNER JOIN [DM].[DimCampaignMember] m on m.CampaignId=c.CampaignId",
                    "    INNER JOIN [Custom].[GeographyHierarchy] g on c.EventCountry=g.CountryCode",
                    "    LEFT JOIN [DM].[DimCustContact] sp on sp.ContactID=c.Speaker1",
                    "    LEFT JOIN [DM].[DimCustContact] cont on cont.ContactAccountNumber=m.DIDNumber and (cont.ContactRecordType='Doctor' or (cont.ContactClinID is not null) )",
                    "",
                    "WHERE",
                    "    (c.EventTypePicklist IN ('C1','C11'))",
                    "    and g.RegionGroup='Asia Pacific'",
                    "    and c.IsDeleted='false'",
                    "    and c.[Status] ='Planned'",
                    "    and m.IsDeleted='false'",
                    "    and c.EventDate>=datediff(day,-1,GETDATE())",
                    "    --and m.[Status] ='Attended'",
                    "",
                    "\")",
                    "",
                    "in",
                    "    Source"
                  ]
                }
              }
            ]
          },
          {
            "name": "Continued Education Events",
            "columns": [
              {
                "name": "Event Record Type",
                "dataType": "string",
                "sourceColumn": "Event Record Type"
              },
              {
                "name": "Event ID",
                "dataType": "string",
                "sourceColumn": "Event ID"
              },
              {
                "name": "Event Name",
                "dataType": "string",
                "sourceColumn": "Event Name"
              },
              {
                "name": "Event Date",
                "dataType": "dateTime",
                "sourceColumn": "Event Date"
              },
              {
                "name": "Event Type",
                "dataType": "string",
                "sourceColumn": "Event Type"
              },
              {
                "name": "Event Country",
                "dataType": "string",
                "sourceColumn": "Event Country"
              },
              {
                "name": "Event City",
                "dataType": "string",
                "sourceColumn": "Event City"
              },
              {
                "name": "Event Speaker",
                "dataType": "string",
                "sourceColumn": "Event Speaker"
              },
              {
                "name": "ContactID",
                "dataType": "string",
                "sourceColumn": "ContactID"
              },
              {
                "type": "calculated",
                "name": "Event Year",
                "dataType": "int64",
                "isDataTypeInferred": false,
                "expression": "YEAR([Event Date])",
                "formatString": "0"
              }
            ],
            "partitions": [
              {
                "name": "Partition",
                "dataView": "full",
                "source": {
                  "type": "m",
                  "expression": [
                    "let",
                    "    Source = Value.NativeQuery(#\"OTCDM\", ",
                    "",
                    "\"",
                    "WITH TrainingRecords as (",
                    "",
                    "    SELECT",
                    "        'Non-EMT'               as [Event Record Type], ",
                    "        tr.ID                   as [Event ID],",
                    "        ",
                    "        ISNULL([Event_Name__c],'City N/A')+' - '+ISNULL(convert(nvarchar,[Event_Date__c],106),'Event Date N/A') as [Event Name],",
                    "        --tr.[Name]             as [Event Name],",
                    "        tr.[Event_Date__c]      as [Event Date],",
                    "        tr.[Event_Type__c]      as [Event Type],",
                    "        tr.[Country__c]         as [Event Country],",
                    "        tr.[City__c]            as [Event City],",
                    "        tr.[Speaker__c]         as [Event Speaker],",
                    "        tr.[ContactID__c]       as ContactID",
                    "        ",
                    "    FROM [SFDC_Staging].[dbo].[Training_Records__c] tr",
                    "            left join DM.DimCustContact c on c.ContactID=tr.ContactID__c",
                    "    WHERE ",
                    "        tr.[Training_Status__c]='Attended'",
                    "        and tr.isDeleted='false'",
                    "        and c.ContactRegionGroup='Asia Pacific'",
                    "        and tr.[Event_Type__c] in ('IGOSG','INFOS','ECYAU','ECMOR','ECTAI','MAL','WMC','AST','CF','FFSG','FF4','FF3','FF2','FF1','TPDM','IMC','EP6','EP4',",
                    "                                    'EP3','EP2','EP1','ITESGO','ITE4','ITE3','ITE2','ITE1','FS3','ECNAR','NASTG','EP5','FS2','FS1','ITESG','RC','SU4','SU3',",
                    "                                    'SU2','SU1','FE6','FE5','FE4','FE3','FE2','FE1','MCL','WSG','SG','FE7','TCSG','PTCW','OC1','OC2','OC3','OC4','IIC3',",
                    "                                    'SAFEON1','SAFEON2','SAFEON3','SAFEON4','SAFEON5','SAFEON6','SAFEON7','SAFEON8')",
                    "",
                    "),",
                    "",
                    "Campaigns as (",
                    "",
                    "SELECT ",
                    "    'EMT'               as [Event Record Type],",
                    "    c.[CampaignID]      as [Event ID],",
                    "    c.CampaignName      as [Event Name],",
                    "    c.EventDate         as [Event Date],",
                    "    c.EventTypePicklist as [Event Type],",
                    "    c.EventCountry      as [Event Country],",
                    "    c.EventCity         as [Event City],",
                    "    sp.[ContactName]    as [Event Speaker],",
                    "    cont.ContactID",
                    "",
                    "FROM DM.DimCampaign c",
                    "    INNER JOIN [DM].[DimCampaignMember] m on m.CampaignId=c.CampaignId",
                    "    LEFT JOIN [DM].[DimCustContact] sp on sp.ContactID=c.Speaker1",
                    "    LEFT JOIN [DM].[DimCustContact] cont on cont.ContactAccountNumber=m.DIDNumber and (cont.ContactRecordType='Doctor' or (cont.ContactClinID is not null) )",
                    "",
                    "WHERE",
                    "    cont.ContactRegionGroup='Asia Pacific'",
                    "    and c.IsDeleted='false'",
                    "    --and c.[Status] ='Completed'",
                    "    and m.IsDeleted='false'",
                    "    and m.[Status] ='Attended'",
                    "    and (c.EventTypePicklist IN ('IGOSG','INFOS','ECYAU','ECMOR','ECTAI','MAL','WMC','AST','CF','FFSG','FF4','FF3','FF2','FF1','TPDM','IMC','EP6','EP4',",
                    "                                    'EP3','EP2','EP1','ITESGO','ITE4','ITE3','ITE2','ITE1','FS3','ECNAR','NASTG','EP5','FS2','FS1','ITESG','RC','SU4','SU3',",
                    "                                    'SU2','SU1','FE6','FE5','FE4','FE3','FE2','FE1','MCL','WSG','SG','FE7','TCSG','PTCW','OC1','OC2','OC3','OC4','IIC3',",
                    "                                    'SAFEON1','SAFEON2','SAFEON3','SAFEON4','SAFEON5','SAFEON6','SAFEON7','SAFEON8'))",
                    "),",
                    "",
                    "Training_records_wo_Campaign as ",
                    "(",
                    "    select r.*",
                    "        from TrainingRecords r",
                    "            left join Campaigns c ",
                    "            on r.ContactID=c.ContactID and r.[Event Type]=c.[Event Type] and r.[Event Date]=c.[Event Date]",
                    "    where c.[Event ID] is NULL",
                    "),",
                    "",
                    "AllEvents as (",
                    "    (select * from Campaigns",
                    "    UNION ALL",
                    "    select * from Training_records_wo_Campaign)",
                    ")",
                    "",
                    "select * from AllEvents ",
                    "\"",
                    "),",
                    "    #\"Changed Type\" = Table.TransformColumnTypes(Source,{{\"Event Date\", type date}})",
                    "    ",
                    "",
                    "in",
                    "    #\"Changed Type\""
                  ]
                }
              }
            ]
          },
