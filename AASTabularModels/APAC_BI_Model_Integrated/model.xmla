                  "expression": [
                    "let",
                    "    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"i45WCi5Nys0sLs7MzytW0lEyVIrViVZy9A0Cso3AbD8Q0xjMdHZ2BLJNlGJjAQ==\", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type text) meta [Serialized.Text = true]) in type table [#\"Measure Name\" = _t, Code = _t]),",
