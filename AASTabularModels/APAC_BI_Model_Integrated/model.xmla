            ],
            "partitions": [
              {
                "name": "7) Scanner Orders-10406d0f-d03b-4e0f-a0ff-bf1dd30308a0",
                "mode": "import",
                "queryGroup": "Entities",
                "source": {
                  "type": "m",
                  "expression": [
                    "let",
                    "    Source = Value.NativeQuery(#\"OTCDM\", ",
                    "\"",
                    "Select",
                    "    DO.OrderKey, ",
                    "    DO.ScanType, ",
                    "    DO.ScanCaseType, ",
                    "    DO.SubmitDate as 'Scan Submisson Date', ",
                    "    s.SerialIdentifier, ",
                    "    a.[Type], ",
                    "    b.BusinessPartnerTypenames, ",
                    "    b.BusinessPartnerName,",
                    "    ",
                    "    s.[ScannerVersion] as [Scanner Version],",
                    "    s.[VersionPosted]  as [Scanner Software]",
                    "FROM tab.[DimOrder] DO     ",
                    "    left join ScannersDM.dm.Scanner s on s.SerialIdentifier = DO.ScannerSN ",
                    "    left join ScannersDM.dm.BusinessPartner b on s.HolderKey=b.BusinessPartnerKey ",
                    "    left join SFDC_Staging.dbo.Account a on a.MAT_ID__c = b.BusinessPartnerKey ",
                    "where DO.[BillToAccountRegionGroup] in( 'Asia Pacific','APAC','ANZ')",
                    "",
                    "\")",
                    "",
                    "in",
                    "    Source"
                  ]
                }
              }
            ],
            "annotations": [
              {
                "name": "PBI_ResultType",
                "value": "Table"
              },
              {
                "name": "PBI_DescriptionAtRefresh"
              }
            ]
          },
