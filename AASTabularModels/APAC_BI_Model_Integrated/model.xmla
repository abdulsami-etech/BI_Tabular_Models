              {
                "type": "calculated",
                "name": "Patient Age Group",
                "dataType": "string",
                "isDataTypeInferred": true,
                "expression": [
                  "",
                  "IF(",
                  "    [Patient Age]>=6 && [Patient Age]<=12,",
                  "    \"Younger (6-12)\",",
                  "    IF( [Patient Age]>=13 && [Patient Age]<=18,",
                  "        \"Teen (7-18)\",",
                  "        IF ([Patient Age]>=19 && [Patient Age]<=80, \"Adult (>19)\",\"Unknown\")",
                  "    )",
                  ")"
                ],
                "displayFolder": "Patient",
                "summarizeBy": "none",
                "annotations": [
                  {
                    "name": "SummarizationSetBy",
                    "value": "Automatic"
                  },
                  {
                    "name": "Format",
                    "value": "<Format Format=\"Text\" />"
                  },
