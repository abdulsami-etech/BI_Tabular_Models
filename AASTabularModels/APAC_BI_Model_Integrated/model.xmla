            ],
            "partitions": [
              {
                "name": "Account",
                "dataView": "full",
                "source": {
                  "type": "m",
                  "expression": [
                    "let",
                    "    Source = Value.NativeQuery(#\"OTCDM\", ",
                    "\"",
                    "with ",
                    "TerritoryHierarchy as (",
                    "    select    Id",
                    "              ,      ParentTerritory2id",
                    "              ,      Name",
                    "              ,      DeveloperName",
                    "              ,      1 as [Level]",
                    "    from [SFDC_Staging].dbo.Territory2 with (nolock)",
                    "    where ParentTerritory2id is null",
                    "",
                    "    union all",
                    "",
                    "    select    cld.Id",
                    "              ,      cld.ParentTerritory2id",
                    "              ,      cld.Name",
                    "              ,      cld.DeveloperName",
                    "              ,      par.[Level] + 1 ",
                    "    from [SFDC_Staging].dbo.Territory2 cld with (nolock)",
                    "    inner join TerritoryHierarchy par on cld.ParentTerritory2id = par.Id",
                    "    where cld.ParentTerritory2id is not null",
                    "),",
                    "HierarchyFlattened as (",
                    "       select coalesce(L6.Id, L5.Id, L4.Id, L3.Id, L2.Id, L1.Id) as Level6ID",
                    "       from TerritoryHierarchy L1",
                    "       left join TerritoryHierarchy L2 on L1.Id = L2.parentterritory2ID",
                    "       left join TerritoryHierarchy L3 on L2.Id = L3.parentterritory2ID",
                    "       left join TerritoryHierarchy L4 on L3.Id = L4.parentterritory2ID",
                    "       left join TerritoryHierarchy L5 on L4.Id = L5.parentterritory2ID",
                    "       left join TerritoryHierarchy L6 on L5.Id = L6.parentterritory2ID",
                    "       where L1.parentterritory2ID is null",
                    "),",
                    "hdata as (",
                    "",
                    "select top (1) with ties",
                    "        convert(nvarchar(18), a.Id)             as Account",
                    "    ,   convert(nvarchar(32), tt.MasterLabel)   as TerritoryType",
                    "    ,   convert(nvarchar(18), h.Level6ID)       as Level6ID",
                    "    --, isnull(utal6.UserId, 'Unknown')         as Level6UserID",
                    "    ,   isnull(utal6.UserId, 'Unknown')         as Level6UserID",
                    "    ",
                    "from HierarchyFlattened h",
                    "inner join [SFDC_Staging].dbo.Territory2 t with (nolock) on t.Id = h.Level6ID",
                    "inner join [SFDC_Staging].dbo.Territory2Type tt with (nolock) on tt.Id = t.Territory2TypeId",
                    "inner join [SFDC_Staging].dbo.ObjectTerritory2Association oa with (nolock) on oa.Territory2Id = t.Id",
                    "inner join [SFDC_Staging].dbo.Account a with (nolock) on a.id = oa.ObjectId",
                    "left join [SFDC_Staging].dbo.UserTerritory2Association utal6  on h.Level6ID = utal6.Territory2Id",
                    "left join [SFDC_Staging].dbo.[user] u on utal6.UserId = u.Id ",
                    "where coalesce(u.IsActive,'') != 'false'",
                    "and isnull(utal6.RoleInTerritory2, '')  not in ('Delegated', 'Delegated TM', 'EMEA Einstein Visibility')",
                    "and tt.MasterLabel='Invisalign'",
                    "order by row_number() over (partition by a.Id, tt.MasterLabel order by h.Level6ID desc) --we would have only 1 hierarchy for each account and type",
                    "),",
                    "",
                    "fin as (",
                    "    select ",
                    "        a.AccountKey,",
                    "        a.AccountID,",
                    "        a.AccountNumber,",
                    "        a.AccountOwnerID,",
                    "        a.AccountName,",
                    "        a.AccountRecordType,",
                    "        a.AccountType,",
                    "        a.AccountStatus,",
                    "        a.AccountPhone,",
                    "        a.AccountPostalCode,",
                    "        a.AccountLineofBusiness,",
                    "        a.AccountLongitude,",
                    "        a.AccountLattitude,",
                    "        a.AccountCity,",
                    "        a.AccountCountry,",
                    "        a.AccountCountryGroup,",
                    "        a.AccountRegionPC,",
                    "        a.AccountRegionGroup,",
                    "        a.AccountCreatedDate,",
                    "        a.AccountTerritoryAssignmentGrouping,",
                    "        a.AccountPrivatePracticeID as AccountPPID,  ",
                    "        a.AccountSubType,",
                    "",
                    "        a.AccountTranslatedCity,",
                    "        a.AccountTranslatedName,",
                    "        a.AccountTranslatedDoctorName,",
                    "        a.AccountTranslatedState,",
                    "",
                    "        ",
                    "        u.UserName as AccountOwner,  ",
                    "        h.Level6ID as TerritoryID,",
                    "",
                    "        sfa.Pricing_Group__c,",
                    "    ",
                    "        le.Account_Pricing_Group_Tremt_Loc_Country__c  as [Pricing Group Country],",
                    "",
                    "        le.Apttus_Config2__Points__c                       as [Points],",
                    "        le.Apttus_Config2__AdditionalPointsForNextLevel__c as [Points to Next Level],",
                    "        le.Apttus_Config2__AdditionalPointsToKeepLevel__c  as [Points to Keep Level],",
                    "        le.Apttus_Config2__LifetimePoints__c               as [Points Life Time],",
                    "",
                    "",
                    "        le.Apttus_Config2__CustomerType__c as [Customer Type],",
                    "        le.Apttus_Config2__StartDate__c as [Enrollment Start Date],",
                    "        le.Apttus_Config2__EndDate__c   as [Enrollment End Date],",
                    "",
                    "        le.Apttus_Config2__LoyaltyLevel__c as [Loyalty Level],",
                    "        le.Apttus_Config2__LoyaltyLevelEarned__c as [Loyalty Level Earned],",
                    "        le.Apttus_Config2__LoyaltyLevelOverride__c as [Loyalty Level Override],",
                    "        le.Apttus_Config2__LoyaltyLevelInitial__c  as [Loyalty Level Initial],",
                    "        le.Apttus_Config2__OverrideReason__c       as [Loyalty Level Override Reason],",
                    "        le.Apttus_Config2__OverrideDate__c         as [Loyalty Level Override Date],",
                    "",
                    "        le.Current_Advantage_Status__c           as [Current Advantage Status],",
                    "        le.Loyalty_Code__c                       as [Loyalty Code],",
                    "        le.Name                                  as [Loyalty Name],",
                    "        row_number() OVER (partition by a.AccountID order by le.Apttus_Config2__OverrideDate__c desc) as rn",
                    "",
                    "    from [DM].[DimCustAccount] a",
                    "            left join hdata h on h.Account=a.AccountID",
                    "            left join DM.DimUser u on a.AccountOwnerID = u.UserId ",
                    "            left join [SFDC_Staging].dbo.Account sfa on sfa.ID=a.AccountID",
                    "            left join [SFDC_Staging].dbo.[Apttus_Config2__IncentiveLoyaltyEnrollment__c] le ",
                    "                on le.Pricing_Group__c=sfa.Pricing_Group__c",
                    "                    and le.IsDeleted='false'",
                    "                    and le.Apttus_Config2__Active__c='true'",
                    "    where AccountRegiongroup='Asia Pacific'",
                    ")",
                    "",
                    "select * from fin where rn=1",
                    "",
                    "\"),",
                    "",
                    "    #\"Changed Type\" = Table.TransformColumnTypes(Source,{{\"AccountCreatedDate\", type date}}),",
                    "    #\"Renamed Columns\" = Table.RenameColumns(#\"Changed Type\",{{\"AccountCity\", \"City\"}, {\"AccountCountry\", \"Country\"}, {\"AccountCountryGroup\", \"Country Group\"}, {\"AccountCreatedDate\", \"Created Date\"}, {\"AccountLattitude\", \"Lattitude\"}, {\"AccountLineofBusiness\", \"Account Line of Business\"}, {\"AccountLongitude\", \"Longitude\"}, {\"AccountName\", \"Account Name\"}, {\"AccountNumber\", \"Account Number\"}, {\"AccountPhone\", \"Account Phone\"}, {\"AccountPostalCode\", \"Account Postal Code\"}, {\"AccountRecordType\", \"Account Record Type\"}, {\"AccountRegionGroup\", \"Region Group\"}, {\"AccountRegionPC\", \"Region\"}, {\"AccountStatus\", \"Account Status\"}, {\"AccountType\", \"Account Type\"}})",
                    "in",
                    "    #\"Renamed Columns\""
                  ]
                }
              }
            ],
            "hierarchies": [
              {
                "name": "Ship-To Geography",
                "levels": [
                  {
                    "name": "Region Group",
                    "ordinal": 0,
                    "column": "Region Group"
                  },
                  {
                    "name": "Region",
                    "ordinal": 1,
                    "column": "Region"
                  },
                  {
                    "name": "Country Group",
                    "ordinal": 2,
                    "column": "Country Group"
                  },
                  {
                    "name": "Country",
                    "ordinal": 3,
                    "column": "Country"
                  },
                  {
                    "name": "City",
                    "ordinal": 4,
                    "column": "City"
                  }
                ]
              }
            ],
            "annotations": [
              {
                "name": "PBI_Id",
                "value": "96c5dba5-fce6-4cee-a478-b095ef60f4ad"
              },
              {
                "name": "LinkedQueryName",
                "value": "3) Account"
              },
              {
                "name": "PBI_NavigationStepName",
                "value": "Navigation"
              },
              {
                "name": "PBI_QueryRelationships",
                "value": "{\"columnCount\":21,\"keyColumnNames\":[],\"queryRelationships\":[],\"columnIdentities\":[\"Section1/3) Account/Source.{AccountKey,0}\",\"Section1/3) Account/Source.{AccountID,1}\",\"Section1/3) Account/Source.{AccountNumber,2}\",\"Section1/3) Account/Source.{AccountOwnerID,3}\",\"Section1/3) Account/Source.{AccountName,4}\",\"Section1/3) Account/Source.{AccountRecordType,5}\",\"Section1/3) Account/Source.{AccountType,6}\",\"Section1/3) Account/Source.{AccountStatus,7}\",\"Section1/3) Account/Source.{AccountPhone,8}\",\"Section1/3) Account/Source.{AccountPostalCode,9}\",\"Section1/3) Account/Source.{AccountLineofBusiness,10}\",\"Section1/3) Account/Source.{AccountLongitude,11}\",\"Section1/3) Account/Source.{AccountLattitude,12}\",\"Section1/3) Account/Source.{AccountCity,13}\",\"Section1/3) Account/Source.{AccountCountry,14}\",\"Section1/3) Account/Source.{AccountCountryGroup,15}\",\"Section1/3) Account/Source.{AccountRegionPC,16}\",\"Section1/3) Account/Source.{AccountRegionGroup,17}\",\"Section1/3) Account/Changed Type.{AccountCreatedDate,18}\",\"Section1/3) Account/Source.{AccountTerritoryAssignmentGrouping,19}\",\"Section1/3) Account/Source.{TerritoryID,20}\"],\"ColumnCount\":21,\"KeyColumnNames\":[],\"ColumnIdentities\":[\"Section1/3) Account/Source.{AccountKey,0}\",\"Section1/3) Account/Source.{AccountID,1}\",\"Section1/3) Account/Source.{AccountNumber,2}\",\"Section1/3) Account/Source.{AccountOwnerID,3}\",\"Section1/3) Account/Source.{AccountName,4}\",\"Section1/3) Account/Source.{AccountRecordType,5}\",\"Section1/3) Account/Source.{AccountType,6}\",\"Section1/3) Account/Source.{AccountStatus,7}\",\"Section1/3) Account/Source.{AccountPhone,8}\",\"Section1/3) Account/Source.{AccountPostalCode,9}\",\"Section1/3) Account/Source.{AccountLineofBusiness,10}\",\"Section1/3) Account/Source.{AccountLongitude,11}\",\"Section1/3) Account/Source.{AccountLattitude,12}\",\"Section1/3) Account/Source.{AccountCity,13}\",\"Section1/3) Account/Source.{AccountCountry,14}\",\"Section1/3) Account/Source.{AccountCountryGroup,15}\",\"Section1/3) Account/Source.{AccountRegionPC,16}\",\"Section1/3) Account/Source.{AccountRegionGroup,17}\",\"Section1/3) Account/Changed Type.{AccountCreatedDate,18}\",\"Section1/3) Account/Source.{AccountTerritoryAssignmentGrouping,19}\",\"Section1/3) Account/Source.{TerritoryID,20}\"],\"RelationshipInfo\":[]}"
