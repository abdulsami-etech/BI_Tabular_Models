                "formatString": "#,##0",
                "displayFolder": "Patient"
              },
              {
                "type": "calculated",
                "name": "Case Age Group",
                "dataType": "string",
                "isDataTypeInferred": true,
                "expression": "IF(AND('4) Primary Order'[Case Age]>=0,'4) Primary Order'[Case Age]<=10),\"00-10 Days\",IF(AND('4) Primary Order'[Case Age]>=11,'4) Primary Order'[Case Age]<=30),\"11-30 Days\",IF(AND('4) Primary Order'[Case Age]>=31,'4) Primary Order'[Case Age]<=60),\"31-60 Days\",IF('4) Primary Order'[Case Age]>60,\"60+ Days\",\"Others\"))))",
                "displayFolder": "Patient"
              },
              {
                "type": "calculated",
                "name": "Patient Age Segment",
                "dataType": "string",
                "isDataTypeInferred": true,
                "expression": [
                  "",
                  "IF( [Patient Age]<=18,",
                  "        \"Non-Adult\",",
                  "        IF ([Patient Age]>=19 && [Patient Age]<=80, \"Adult\",\"Unknown\")",
                  "    )",
                  ""
                ],
                "displayFolder": "Patient"
              },
