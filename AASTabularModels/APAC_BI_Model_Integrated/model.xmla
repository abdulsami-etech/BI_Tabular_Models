            "tablePermissions": [
              {
                "name": "6) Sales Hierarchy",
                "filterExpression": [
                  "VAR Login=LEFT(USERNAME(),SEARCH(\"@\", USERNAME())-1)",
                  "           ",
                  "           VAR RegionalVP   ='6) Sales Hierarchy'[SalesRegionalVPIdentifierInvisalign]",
                  "           VAR Area         ='6) Sales Hierarchy'[SalesAreaIdentifierInvisalign]",
                  "           VAR Region       ='6) Sales Hierarchy'[SalesRegionIdentifierInvisalign]",
                  "           VAR Territory    ='6) Sales Hierarchy'[SalesTerritoryIdentifierInvisalign]",
                  "             ",
                  "           RETURN",
                  "                IF(Area=Login, TRUE,",
                  "                    IF( (Region=Login || Territory=Login), TRUE ,FALSE)",
                  "                    )"
                ]
              }
            ]
          },
