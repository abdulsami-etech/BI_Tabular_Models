                "lineageTag": "59a6a63f-47a4-4437-90b2-afe13ec8d447"
              },
              {
                "name": "Utilization by AMRs",
                "expression": [
                  "",
                  "--Calculates 12 Rolling Month Doctors Utilization based on orders AMRs counts",
                  "",
                  "DIVIDE([AMRs],[AMR Submitters])"
                ],
                "formatString": "#,0.0",
                "isHidden": true,
                "displayFolder": "2. Doctors Utilization\\AMR"
              },
              {
                "name": "Utilization by CCA",
                "expression": [
                  "",
                  "--Calculates 12 Rolling Month Doctors Utilization based on orders CCA counts",
                  "",
                  "DIVIDE([CCA],[CCA Submitters])"
                ],
                "formatString": "#,0.0",
                "displayFolder": "2. Doctors Utilization\\CCA"
              },
              {
                "name": "Utilization by NR",
                "expression": [
                  "",
                  "--Calculates 12 Rolling Month Doctors Utilization based on orders submNRissions counts",
                  "",
                  "DIVIDE([NR],[NR Submitters])"
                ],
                "formatString": "#,0.0",
                "displayFolder": "2. Doctors Utilization\\NR"
              },
              {
                "name": "Utilization by Shipments",
                "expression": [
                  "",
                  "--Calculates 12 Rolling Month Doctors Utilization based on orders CCA counts",
                  "",
                  "DIVIDE([Shipments],[Shipments Submitters])"
                ],
                "formatString": "#,0.0",
                "displayFolder": "2. Doctors Utilization\\Shipments"
              },
              {
                "name": "Utilization by Shipments 12RM",
                "expression": [
                  "",
                  "--Calculates 12 Rolling Month Doctors Utilization based on orders CCA counts",
                  "",
                  "DIVIDE([Shipments 12RM],[Shipments Submitters 12RM])"
                ],
                "formatString": "#,0.0",
                "displayFolder": "2. Doctors Utilization\\Shipments"
              },
              {
                "name": "Utilization by Submissions",
                "expression": [
                  "",
                  "--Calculates 12 Rolling Month Doctors Utilization based on orders submissions counts",
                  "",
                  "DIVIDE([Submissions],[Submitters])"
                ],
                "formatString": "0.0",
                "displayFolder": "2. Doctors Utilization\\Submissions"
              },
              {
                "name": "Avg Days AMR to Cancellation",
                "expression": [
                  "AVERAGEX(",
                  "    FILTER(",
                  "        '4) Primary Order', ",
                  "        NOT(ISBLANK([AMRDate])) && NOT(ISBLANK([CancellationDate]))",
                  "    ),",
                  "    DATEDIFF([AMRDate],[CancellationDate],DAY)",
                  ")"
                ],
                "displayFolder": "Order Statistics",
                "lineageTag": "a9b21142-3a73-49be-9a0c-c7f3617a5583"
              },
              {
                "name": "Avg Days AMR to CCA",
                "expression": [
                  "AVERAGEX(",
                  "    FILTER(",
                  "        '4) Primary Order', ",
                  "        NOT(ISBLANK([AMRDate])) && NOT(ISBLANK([CCADate]))",
                  "    ),",
                  "    DATEDIFF([AMRDate],[CCADate],DAY)",
                  ")"
                ],
                "displayFolder": "Order Statistics",
                "lineageTag": "d9aa6234-d8cc-4518-9207-3b1cb1b0e9f4"
              },
              {
                "name": "Avg Days AMR to first CCAA",
                "expression": [
                  "AVERAGEX(",
                  "    FILTER(",
                  "        '4) Primary Order', ",
                  "        NOT(ISBLANK([AMRDate])) && NOT(ISBLANK([FirstCCAADate]))",
                  "    ),",
                  "    DATEDIFF([AMRDate],[FirstCCAADate],DAY)",
                  ")"
                ],
                "displayFolder": "Order Statistics",
                "lineageTag": "63e01ee2-a957-43da-8e2f-19f97f0054a0"
              },
              {
                "name": "Avg Days AMR to Promised CC",
                "expression": [
                  "AVERAGEX(",
                  "    FILTER(",
                  "        '4) Primary Order', ",
                  "        NOT(ISBLANK([AMRDate])) && NOT(ISBLANK([PromisedCCDate]))",
                  "    ),",
                  "    DATEDIFF([AMRDate],[PromisedCCDate],DAY)",
                  ")"
                ],
                "displayFolder": "Order Statistics",
                "lineageTag": "5f66e049-3bec-40e6-9aa9-16c95a02b734"
              },
              {
                "name": "Avg Days AMR to Ship",
                "expression": [
                  "AVERAGEX(",
                  "    FILTER(",
                  "        '4) Primary Order', ",
                  "        NOT(ISBLANK([AMRDate])) && NOT(ISBLANK([ShipDate]))",
                  "    ),",
                  "    DATEDIFF([AMRDate],[ShipDate],DAY)",
                  ")"
                ],
                "displayFolder": "Order Statistics",
                "lineageTag": "466e4099-bbf0-4da0-afc5-b88143d88536"
              },
              {
                "name": "Avg Days CCA to Ship",
                "expression": [
                  "AVERAGEX(",
                  "    FILTER(",
                  "        '4) Primary Order', ",
                  "        NOT(ISBLANK([CCADate])) && NOT(ISBLANK([ShipDate]))",
                  "    ),",
                  "    DATEDIFF([CCADate],[ShipDate],DAY)",
                  ")"
                ],
                "displayFolder": "Order Statistics",
                "lineageTag": "a6eb9945-b9dd-4081-9843-7ff2365a2ad8"
              },
              {
                "name": "Avg Days last CCAA to CCA",
                "expression": [
                  "AVERAGEX(",
                  "    FILTER(",
                  "        '4) Primary Order', ",
                  "        NOT(ISBLANK([LastCCAADate])) && NOT(ISBLANK([CCADate]))",
                  "    ),",
                  "    DATEDIFF([LastCCAADate],[CCADate],DAY)",
                  ")"
                ],
                "displayFolder": "Order Statistics",
                "lineageTag": "920cf745-c00f-4d5a-9a7f-4f00dbf14530"
              },
              {
                "name": "Avg Days Promised Ship to Ship",
                "expression": [
                  "AVERAGEX(",
                  "    FILTER(",
                  "        '4) Primary Order', ",
                  "        NOT(ISBLANK([PromisedShipDate])) && NOT(ISBLANK([ShipDate]))",
                  "    ),",
                  "    DATEDIFF([PromisedShipDate],[ShipDate],DAY)",
                  ")"
                ],
                "displayFolder": "Order Statistics",
                "lineageTag": "42b45e59-37df-4107-8bf1-c8a67707f879"
              },
              {
                "name": "Avg Days Submission To AMR",
                "expression": [
                  "AVERAGEX(",
                  "    FILTER(",
                  "        '4) Primary Order', ",
                  "        NOT(ISBLANK([SubmitDate])) && NOT(ISBLANK([AMRDate])) && [AMRDate]>=[SubmitDate]",
                  "    ),",
                  "    DATEDIFF([SubmitDate],[AMRDate],DAY)",
                  ")"
                ],
                "displayFolder": "Order Statistics",
                "lineageTag": "e2e7472f-d83a-46d4-a798-7ae1420c9917"
              },
              {
                "name": "GR",
                "expression": [
                  "",
                  "-- This measure counts Net Receipts using single Reporting Calendar table context",
                  "VAR dt=DISTINCT('1) Reporting Calendar'[Date])",
                  "VAR res=CALCULATE([Gross Receipts Base], TREATAS(dt,'FactSales'[StatusDate]))",
                  "",
                  "RETURN res"
                ],
                "formatString": "#,0",
                "displayFolder": "1. Volume\\3 Gross Receipts"
              },
              {
                "name": "GR 12RM",
                "expression": [
                  "",
                  "--This measure calculates Net Receipts for 12 Rolling Month starting back from the maximum date in the Reporting Calendar context",
                  "",
                  "VAR curDay=MAX('1) Reporting Calendar'[Date])",
                  "VAR DayLY=SELECTCOLUMNS(",
                  "                FILTER('1) Reporting Calendar',[Date]=curDay),",
                  "                \"Date\", NEXTDAY(SAMEPERIODLASTYEAR('1) Reporting Calendar'[Date])))",
                  "",
                  "RETURN",
                  "CALCULATE (",
                  "        [GR],",
                  "            DATESBETWEEN (",
                  "               '1) Reporting Calendar'[Date],",
                  "                DayLY,",
                  "                curDay))"
                ],
                "formatString": "#,0",
                "displayFolder": "2. Doctors Utilization\\GR"
              },
              {
                "name": "GR PY",
                "expression": [
                  "",
                  "-- Net Receipts same period last year",
                  "CALCULATE([GR], SAMEPERIODLASTYEAR('1) Reporting Calendar'[Date]))"
                ],
                "formatString": "#,0",
                "displayFolder": "1. Volume\\3 Gross Receipts"
              },
              {
                "name": "GR Submitters",
                "expression": [
