              {
                "name": "AMRDate",
                "dataType": "dateTime",
                "sourceColumn": "AMRDate",
                "formatString": "dd.MM.yyyy",
                "displayFolder": "1 Order Dates",
                "summarizeBy": "none",
                "annotations": [
                  {
                    "name": "SummarizationSetBy",
                    "value": "Automatic"
