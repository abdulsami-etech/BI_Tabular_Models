                "name": "PBI_NavigationStepName",
                "value": "Navigation"
              },
              {
                "name": "PBI_QueryRelationships",
                "value": "{\"columnCount\":7,\"keyColumnNames\":[],\"queryRelationships\":[],\"columnIdentities\":[\"Section1/FactOrderStatus/Source.{OrderKey,0}\",\"Section1/FactOrderStatus/Source.{StatusDate,1}\",\"Section1/FactOrderStatus/Source.{ProductKey,2}\",\"Section1/FactOrderStatus/Source.{CCA,3}\",\"Section1/FactOrderStatus/Source.{Net Receipts,4}\",\"Section1/FactOrderStatus/Source.{Submissions,5}\",\"Section1/FactOrderStatus/Source.{AMR,6}\"],\"ColumnCount\":7,\"KeyColumnNames\":[],\"ColumnIdentities\":[\"Section1/FactOrderStatus/Source.{OrderKey,0}\",\"Section1/FactOrderStatus/Source.{StatusDate,1}\",\"Section1/FactOrderStatus/Source.{ProductKey,2}\",\"Section1/FactOrderStatus/Source.{CCA,3}\",\"Section1/FactOrderStatus/Source.{Net Receipts,4}\",\"Section1/FactOrderStatus/Source.{Submissions,5}\",\"Section1/FactOrderStatus/Source.{AMR,6}\"],\"RelationshipInfo\":[]}"
              },
              {
                "name": "PBI_ResultType",
                "value": "Table"
              }
            ]
