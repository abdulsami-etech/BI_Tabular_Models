                "displayFolder": "Continued Education\\NR"
              },
              {
                "name": "CE AVR Sales Diff (by CE Group)",
                "expression": [
                  "[CE AVR Sales Reporting Q (by CE Group)]-[CE AVR Sales Reporting Q LY (by CE Group)]",
                  ""
                ],
                "formatString": "#,##0.0",
                "displayFolder": "Continued Education\\Selection Based"
              },
              {
                "name": "CE AVR Sales Reporting Q (by CE Group)",
                "expression": [
                  "VAR s=IF( HASONEVALUE(z_Util_Measures_List[Code]),VALUES(z_Util_Measures_List[Code]),BLANK())",
                  "RETURN",
                  "SWITCH( s,",
                  "    \"3\",[CE AVR NR Reporting Q (by CE Group)],",
                  "    \"4\",[CE AVR CCA Reporting Q (by CE Group)],",
                  "    BLANK()",
                  ")"
                ],
                "formatString": "#,##0.0",
                "displayFolder": "Continued Education\\Selection Based"
              },
              {
                "name": "CE AVR Sales Reporting Q LY (by CE Group)",
                "expression": [
                  "VAR s=IF( HASONEVALUE(z_Util_Measures_List[Code]),VALUES(z_Util_Measures_List[Code]),BLANK())",
                  "RETURN",
                  "SWITCH( s,",
                  "    \"3\",[CE AVR NR Reporting Q LY (by CE Group)],",
                  "    \"4\",[CE AVR CCA Reporting Q LY (by CE Group)],",
                  "    BLANK()",
                  ")"
                ],
                "formatString": "#,##0.0",
                "displayFolder": "Continued Education\\Selection Based"
              },
              {
                "name": "JTP Target Absolute Running",
                "expression": [
                  "VAR curYear=        MAX('2) Doctor'[Certification Year])",
                  "VAR curMonth=       MAX('1) Reporting Calendar'[Month Code])",
                  "",
                  "VAR Target=",
                  "SUMX( VALUES('2) Doctor'[ContactCountryGroup]),",
                  "    VAR certCountry=    CALCULATE(MAX('2) Doctor'[ContactCountryGroup]))",
                  "    ",
                  "    RETURN",
                  "    SUMX( VALUES('Education Events'[Event Type]),",
                  "        VAR eventType=      CALCULATE(MAX('Education Events'[Event Type]))",
                  "        RETURN",
                  "",
                  "        SUMX ( VALUES('2) Doctor'[Professional Category]),",
                  "            ",
                  "            VAR channel=        CALCULATE(MAX('2) Doctor'[Professional Category]))",
                  "                                    ",
                  "            RETURN",
                  "                CALCULATE ( ",
                  "                    SUM('Fact JTP Targets Absolute'[JTP Value]),",
                  "                    FILTER(  ALL('Fact JTP Targets Absolute'),",
                  "                             'Fact JTP Targets Absolute'[Country]=certCountry &&",
                  "                             'Fact JTP Targets Absolute'[Event Type]=eventType &&",
                  "                             'Fact JTP Targets Absolute'[GP_ORTHO]=channel &&",
                  "                             'Fact JTP Targets Absolute'[Year]=curYear &&",
                  "                             'Fact JTP Targets Absolute'[Month Code]<=curMonth",
                  "                           ))",
                  "         )))",
                  "",
                  "RETURN",
                  "IF (curYear=MAX('1) Reporting Calendar'[Year]), Target, BLANK())"
                ],
                "formatString": "0.0",
                "displayFolder": "Doctors Onboarding & Activation\\JTP Absolute"
              },
              {
                "name": "Activation % at #days for #CAA LY",
                "expression": [
                  "VAR days=MAX('z_Activation Days Series'[Activation at #Days])",
                  "VAR cca=MAX('z_Activation CCA Series'[# of CCA])",
                  "",
                  "VAR LYQ=DISTINCT('2) Doctor'[Certification Quarter LY])",
                  "VAR LYDoctors=CALCULATETABLE('2) Doctor', ALL('2) Doctor'[Certification Year]),INTERSECT(ALL('2) Doctor'[Certification Quarter]),LYQ))",
                  "",
                  "VAR DoctorsSet=FILTER(LYDoctors,[Days After Certification]>=days)",
                  "",
                  "VAR ActivatedDoctorsSet=FILTER(",
                  "        LYDoctors,",
                  "        [Days After Certification]>=days &&",
                  "        CALCULATE(  [CCA], ",
                  "                ALL('1) Reporting Calendar'),",
                  "                '1) Reporting Calendar'[Date]>=EARLIER([Certification Date])&&",
                  "                '1) Reporting Calendar'[Date]<=EARLIER([Certification Date])+days",
                  "            )>=cca",
                  "       )",
                  "",
                  "RETURN DIVIDE(",
                  "    COUNTROWS(ActivatedDoctorsSet),",
                  "    COUNTROWS(DoctorsSet)",
                  ")"
                ],
                "formatString": "0.00%;-0.00%;0.00%",
                "displayFolder": "Doctors Onboarding & Activation"
              },
              {
                "name": "Activation AVR CCA at #days LY",
                "expression": [
                  "",
                  "",
                  "VAR days=MAX('z_Activation Days Series'[Activation at #Days])",
                  "",
                  "VAR LYQ=DISTINCT('2) Doctor'[Certification Quarter LY])",
                  "VAR LYDoctors=CALCULATETABLE('2) Doctor', ALL('2) Doctor'[Certification Year]),INTERSECT(ALL('2) Doctor'[Certification Quarter]),LYQ))",
                  "",
                  "VAR DoctorsSet=FILTER(LYDoctors,[Days After Certification]>=days)",
                  "",
                  "RETURN",
                  "AVERAGEX(",
                  "    DoctorsSet,",
                  "    ",
                  "    VAR certDate=[Certification Date]",
                  "",
                  "    RETURN",
                  "    CALCULATE(  [CCA], ",
                  "                ALL('1) Reporting Calendar'),",
                  "                '1) Reporting Calendar'[Date]>=certDate &&",
                  "                '1) Reporting Calendar'[Date]<=certDate+days",
                  "            )",
                  ")",
                  "",
                  "                ",
                  ""
                ],
                "formatString": "#,##0.0",
                "displayFolder": "Doctors Onboarding & Activation"
              },
