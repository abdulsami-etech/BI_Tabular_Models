                "formatString": "#,0",
                "displayFolder": "2. Doctors Utilization\\GR"
              },
              {
                "name": "GR YTD",
                "expression": [
                  "",
                  "--The measure calculates Net Receipts as Year-To-Date running total regarding reporting dates selected context.",
                  "",
                  "TOTALYTD([GR],'1) Reporting Calendar'[Date])"
                ],
                "formatString": "#,0",
