              {
                "name": "Shipments",
                "expression": [
                  "-- This measure counts Shipments using single Reporting Calendar table context",
                  "VAR dt=DISTINCT('1) Reporting Calendar'[Date])",
                  "VAR res=CALCULATE([Shipments Base], TREATAS(dt,'FactSales'[StatusDate]))",
                  "",
                  "RETURN res"
                ],
                "displayFolder": "1. Volume\\6 Shipments",
                "lineageTag": "31479efe-cc32-4174-a0f6-8f80ebb5b023"
              },
              {
                "name": "Shipments Base",
                "expression": [
                  "-- The measures counts Shipments (Shipments) orders by status code 80",
