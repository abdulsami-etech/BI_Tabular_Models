              },
              {
                "type": "calculated",
                "name": "Half Year",
                "dataType": "dateTime",
                "isDataTypeInferred": true,
                "expression": [
                  "IF(",
                  "  ISBLANK('1) Reporting Calendar'[Date]),",
                  "  BLANK(),",
                  "  DATE(",
                  "    YEAR('1) Reporting Calendar'[Date]),",
                  "    1 + (INT((MONTH('1) Reporting Calendar'[Date]) - 1) / 6) * 6),",
                  "    1",
                  "  )",
                  ")"
                ],
                "formatString": "dd.MM.yyyy"
              },
              {
                "type": "calculated",
                "name": "Half Year Measure",
                "dataType": "string",
                "isDataTypeInferred": true,
                "expression": "YEAR([Date])&\" HY \"&ROUNDUP(MONTH([Date])/6,0)"
              },
              {
                "type": "calculated",
                "name": "Before Today?",
                "dataType": "string",
                "isDataTypeInferred": true,
                "expression": "if('1) Reporting Calendar'[Date]<=TODAY(),\"True\",\"False\")"
              }
