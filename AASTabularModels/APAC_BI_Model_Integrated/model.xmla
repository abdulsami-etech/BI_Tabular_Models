              {
                "name": "Approvers % Target ",
                "expression": [
                  "VAR eventType=IF(HASONEVALUE('Education Events'[Event Type]), VALUES('Education Events'[Event Type]),BLANK())",
                  "VAR curYear=MAX('2) Doctor'[Certification Year])",
                  "VAR curDays=IF(HASONEVALUE('z_Activation Days Series'[Activation at #Days]),VALUES('z_Activation Days Series'                                       [Activation at #Days]),BLANK())",
                  "VAR curCountry=IF(HASONEVALUE('2) Doctor'[ContactCountryGroup]),VALUES('2) Doctor'[ContactCountryGroup]),BLANK())",
                  "",
                  "RETURN LOOKUPVALUE('Fact Targets Activation'[Activation%],",
                  "                   [Event Type], eventType,",
                  "                    [Year], curYear,",
                  "                    [Country], curCountry,",
                  "                    [AtDays],curDays)"
                ],
                "formatString": "#,##0 %",
                "displayFolder": "Doctors Onboarding & Activation\\Targets"
              },
              {
                "name": "Avr CCA Target",
                "expression": [
                  "VAR eventType=IF(HASONEVALUE('Education Events'[Event Type]), VALUES('Education Events'[Event Type]),BLANK())",
                  "VAR curYear=MAX('2) Doctor'[Certification Year])",
                  "VAR curDays=IF(HASONEVALUE('z_Activation Days Series'[Activation at #Days]),VALUES('z_Activation Days Series'                                       [Activation at #Days]),BLANK())",
                  "VAR curCountry=IF(HASONEVALUE('2) Doctor'[ContactCountryGroup]),VALUES('2) Doctor'[ContactCountryGroup]),BLANK())",
                  "",
                  "RETURN LOOKUPVALUE('Fact Targets Activation'[AvrCCA],",
                  "                   [Event Type], eventType,",
                  "                    [Year], curYear,",
                  "                    [Country], curCountry,",
                  "                    [AtDays],curDays)"
                ],
                "formatString": "#,##0.0",
                "displayFolder": "Doctors Onboarding & Activation\\Targets"
              },
