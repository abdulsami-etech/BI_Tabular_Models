          }
        ],
        "partitions": [
          {
            "name": "cust_link",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Value.NativeQuery(#\"OTCDM\", ",
                "\"",
                "select ",
                "    l.CustomerKey,",
                "    l.AccountKey,",
                "    l.ContactKey",
                "from DM.DimCust l",
                "    inner join DM.DimCustContact c on c.ContactKey=l.ContactKey",
                "    inner join DM.DimCustAccount a on a.AccountKey=l.AccountKey",
                "    left join Custom.testdoctors td on td.ClinID=c.ContactClinID",
                "where ",
                "    a.AccountRegiongroup='Asia Pacific' and",
                "    td.ClinID IS NULL",
                "",
                "\")",
                "    ",
                "in",
                "    #\"Source\"",
                "",
                ""
              ]
            }
          }
        ]
      },
