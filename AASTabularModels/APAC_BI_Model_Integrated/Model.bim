            "dataType": "double",
            "isDataTypeInferred": true,
            "expression": "Year([Date])*100+ROUNDUP(MONTH([Date])/3, 0)",
            "formatString": "0",
            "displayFolder": "Quarter",
            "summarizeBy": "sum",
            "annotations": [
              {
                "name": "SummarizationSetBy",
