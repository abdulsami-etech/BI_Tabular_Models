        ],
        "partitions": [
          {
            "name": "Sales Hierarchy",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Value.NativeQuery(#\"OTCDM\", ",
                "\"",
                "select distinct",
                "          [SalesSuperRegionInvisalign]      as [Super Region Label]",
                "        , [InvSalesCountryGroupLable]       as [Country Group Label]",
                "        , [InvSalesRegionalVPLable]         as [VP Area Label]",
                "        , [InvSalesAreaLable]               as [Area Label]",
                "        , [InvSalesRegionLable]             as [Region Label]",
                "        , [InvSalesTerritoryLable]          as [Territory Label]",
                "        , [InvSalesPDMLable]                as [PDM Label]",
                "        , [SalesPDMIDInvisalign]            as TerritoryKey",
                "        ",
                "        ,[SalesSuperRegionInvisalign]       as [Super Region]",
                "        ,[SalesCountryGroupInvisalign]      as [Country Group]",
                "        ,[SalesRegionalVPInvisalign]        as [VP Area]",
                "        ,[SalesAreaInvisalign]              as [Area]",
                "        ,[SalesRegionInvisalign]            as [Region]",
                "        ,[SalesTerritoryInvisalign]         as [Territory]",
                "        ,[SalesPDMInvisalign]               as [PDM]",
                "",
                "",
                "        ,SalesTerritoryPersonID",
                "        ,SalesPDMIdentifierInvisalign",
                "        ,[SalesTerritoryIdentifierInvisalign]",
                "        ,[SalesRegionIdentifierInvisalign]",
                "        ,[SalesAreaIdentifierInvisalign]",
                "        ,[SalesRegionalVPIdentifierInvisalign]",
                "        ,[SalesCountryGroupIdentifierInvisalign]",
                "        ,[SalesSuperRegionIdentifierInvisalign]",
                "",
                "from DSV.DimCust as c with (nolock)",
                "where  c.SalesSuperRegionInvisalign = N'APAC'",
                "\"",
                ")",
                "",
                "in",
                "    Source"
              ]
            }
          }
        ],
