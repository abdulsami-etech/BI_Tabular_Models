            ]
          },
          {
            "type": "calculated",
            "name": "Quarter Short Name",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": "CONCATENATE(\"Q\",ROUNDUP(MONTH([Date])/3, 0))",
            "displayFolder": "Quarter",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
