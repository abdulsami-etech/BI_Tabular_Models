        "partitions": [
          {
            "name": "Cluster and Programs-f3c1a223-4e52-464f-b2df-89ddcf842b5d",
            "mode": "import",
            "queryGroup": "Entities",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source =  Value.NativeQuery(#\"OTCDM\",",
                "    ",
                "    \"",
                "    with Userlist as (",
                "    select distinct",
                "            cl.id as id,",
                "            usr.name as RSM,",
                "            usr1.name as CL1,",
                "            usr2.name as CS1,",
                "            usr3.name as CS2,",
                "            usr4.name as CS3,",
                "            usr5.name as CS4,",
                "            usr6.name as CS5,",
                "            usr7.name as CS6,",
                "            usr8.name as LastModifiedby,",
                "            usr9.name as Owner,",
                "            usr10.name as PDM10,",
                "            usr11.name as PDM11,",
                "            usr12.name as PDM12,",
                "            usr13.name as PDM13,",
                "            usr14.name as PDM14,",
                "            usr15.name as PDM15,",
                "            usr16.name as PDM1,",
                "            usr17.name as PDM2,",
                "            usr18.name as PDM3,",
                "            usr19.name as PDM4,",
                "            usr20.name as PDM5",
                "from SFDC_Staging.[dbo].[TFM_Cluster__c] cl",
                "    left join SFDC_Staging.[dbo].[User] usr on cl.Area_Sales_Manager__c = usr.ID",
                "    left join SFDC_Staging.[dbo].[User] usr1 on  cl.CL_1__c = usr1.ID",
                "    left join SFDC_Staging.[dbo].[User] usr2 on cl.CS_1__c  = usr2.ID",
                "    left join SFDC_Staging.[dbo].[User] usr3 on cl.CS_2__c  = usr3.ID",
                "    left join SFDC_Staging.[dbo].[User] usr4 on cl.CS_3__c  = usr4.ID",
                "    left join SFDC_Staging.[dbo].[User] usr5 on cl.CS_4__c  = usr5.ID",
                "    left join SFDC_Staging.[dbo].[User] usr6 on cl.CS_5__c  = usr6.ID",
                "    left join SFDC_Staging.[dbo].[User] usr7 on cl.CS_6__c  = usr7.ID",
                "    left join SFDC_Staging.[dbo].[User] usr8 on cl.LastModifiedById  = usr8.ID",
                "    left join SFDC_Staging.[dbo].[User] usr9 on cl.OwnerId  = usr9.ID",
                "    left join SFDC_Staging.[dbo].[User] usr10 on cl.TM_10__c  = usr10.ID",
                "    left join SFDC_Staging.[dbo].[User] usr11 on cl.TM_11__c  = usr11.ID",
                "    left join SFDC_Staging.[dbo].[User] usr12 on cl.TM_12__c  = usr12.ID",
                "    left join SFDC_Staging.[dbo].[User] usr13 on cl.TM_13__c  = usr13.ID",
                "    left join SFDC_Staging.[dbo].[User] usr14 on cl.TM_14__c  = usr14.ID",
                "    left join SFDC_Staging.[dbo].[User] usr15 on cl.TM_15__c  = usr15.ID",
                "    left join SFDC_Staging.[dbo].[User] usr16 on cl.TM_1__c  = usr16.ID",
                "    left join SFDC_Staging.[dbo].[User] usr17 on cl.TM_2__c  = usr17.ID",
                "    left join SFDC_Staging.[dbo].[User] usr18 on cl.TM_3__c  = usr18.ID",
                "    left join SFDC_Staging.[dbo].[User] usr19 on cl.TM_4__c  = usr19.ID",
                "    left join SFDC_Staging.[dbo].[User] usr20 on cl.TM_5__c  = usr20.ID",
                "),",
                "",
                "drcontact as(",
                "select ",
                "    c.Id,",
                "    c.name as Doctor_name,",
                "    c.Clinician_ID__c,",
                "    c.EMEA_Segmentation__c,",
                "    c.MailingCountry",
                "from SFDC_Staging.[dbo].[Contact] c)",
                "",
                "select ",
                "    cl.*,",
                "    u.*,",
                "    c.*,",
                "    dc.*",
                "from SFDC_Staging.[dbo].[TFM_Cluster_Contact__c] c",
                "    inner join SFDC_Staging.[dbo].[TFM_Cluster__c] cl on cl.id = c.TFM_Cluster__c",
                "    inner join Userlist u on cl.Id = u.id",
                "    left join SFDC_Staging.[dbo].RecordType r on cl.RecordTypeId = r.Id",
                "    left join drcontact dc on c.Contact__c = dc.Id",
                "Where",
                "r.DeveloperName like 'APAC_Segmentation' and",
                "cl.CreatedDate >= '2020-06-01'",
                "",
                "    \"),",
                "    ",
                "    #\"Renamed Columns1\" = Table.RenameColumns(Source,{{\"EMEA_Segmentation_Status__c\", \"Status\"}}),",
                "    #\"Renamed Columns\"= Table.RenameColumns(#\"Renamed Columns1\",{{\"id\", \"id.1\"}})",
                "in",
                "    #\"Renamed Columns\""
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Active Drs",
            "expression": [
              "",
              "CALCULATE(",
              "\tDISTINCTCOUNT('Cluster and Programs'[Clinician_ID__c]),",
              "\t'Cluster and Programs'[Status]",
              "\t\tIN { \"Active\" }",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "ac24719f-ecff-482d-900a-8da28d294035",
            "extendedProperties": [
              {
                "type": "json",
                "name": "MeasureTemplate",
                "value": {
