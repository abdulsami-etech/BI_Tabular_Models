      {
        "name": "Continued Education Events",
        "columns": [
          {
            "name": "Event Record Type",
            "dataType": "string",
            "sourceColumn": "Event Record Type"
          },
          {
            "name": "Event ID",
            "dataType": "string",
            "sourceColumn": "Event ID"
          },
          {
            "name": "Event Name",
            "dataType": "string",
            "sourceColumn": "Event Name"
          },
          {
            "name": "Event Date",
            "dataType": "dateTime",
            "sourceColumn": "Event Date"
          },
          {
            "name": "Event Type",
            "dataType": "string",
            "sourceColumn": "Event Type"
          },
          {
            "name": "Event Country",
            "dataType": "string",
            "sourceColumn": "Event Country"
          },
          {
            "name": "Event City",
            "dataType": "string",
            "sourceColumn": "Event City"
          },
          {
            "name": "Event Speaker",
            "dataType": "string",
            "sourceColumn": "Event Speaker"
          },
          {
            "name": "ContactID",
            "dataType": "string",
            "sourceColumn": "ContactID"
          },
          {
            "type": "calculated",
            "name": "Event Year",
            "dataType": "int64",
            "isDataTypeInferred": false,
            "expression": "YEAR([Event Date])",
            "formatString": "0"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Value.NativeQuery(#\"OTCDM\", ",
                "",
                "\"",
                "WITH TrainingRecords as (",
                "",
                "    SELECT",
                "        'Non-EMT'               as [Event Record Type], ",
                "        tr.ID                   as [Event ID],",
                "        ",
                "        ISNULL([Event_Name__c],'City N/A')+' - '+ISNULL(convert(nvarchar,[Event_Date__c],106),'Event Date N/A') as [Event Name],",
                "        --tr.[Name]             as [Event Name],",
                "        tr.[Event_Date__c]      as [Event Date],",
                "        tr.[Event_Type__c]      as [Event Type],",
                "        tr.[Country__c]         as [Event Country],",
                "        tr.[City__c]            as [Event City],",
                "        tr.[Speaker__c]         as [Event Speaker],",
                "        tr.[ContactID__c]       as ContactID",
                "        ",
                "    FROM [SFDC_Staging].[dbo].[Training_Records__c] tr",
                "            left join DM.DimCustContact c on c.ContactID=tr.ContactID__c",
                "    WHERE ",
                "        tr.[Training_Status__c]='Attended'",
                "        and tr.isDeleted='false'",
                "        and c.ContactRegionGroup='Asia Pacific'",
                "        and tr.[Event_Type__c] in ('IGOSG','INFOS','ECYAU','ECMOR','ECTAI','MAL','WMC','AST','CF','FFSG','FF4','FF3','FF2','FF1','TPDM','IMC','EP6','EP4',",
                "                                    'EP3','EP2','EP1','ITESGO','ITE4','ITE3','ITE2','ITE1','FS3','ECNAR','NASTG','EP5','FS2','FS1','ITESG','RC','SU4','SU3',",
                "                                    'SU2','SU1','FE6','FE5','FE4','FE3','FE2','FE1','MCL','WSG','SG','FE7','TCSG','PTCW','OC1','OC2','OC3','OC4','IIC3',",
                "                                    'SAFEON1','SAFEON2','SAFEON3','SAFEON4','SAFEON5','SAFEON6','SAFEON7','SAFEON8')",
                "",
                "),",
                "",
                "Campaigns as (",
                "",
                "SELECT ",
                "    'EMT'               as [Event Record Type],",
                "    c.[CampaignID]      as [Event ID],",
                "    c.CampaignName      as [Event Name],",
                "    c.EventDate         as [Event Date],",
                "    c.EventTypePicklist as [Event Type],",
                "    c.EventCountry      as [Event Country],",
                "    c.EventCity         as [Event City],",
                "    sp.[ContactName]    as [Event Speaker],",
                "    cont.ContactID",
                "",
                "FROM DM.DimCampaign c",
                "    INNER JOIN [DM].[DimCampaignMember] m on m.CampaignId=c.CampaignId",
                "    LEFT JOIN [DM].[DimCustContact] sp on sp.ContactID=c.Speaker1",
                "    LEFT JOIN [DM].[DimCustContact] cont on cont.ContactAccountNumber=m.DIDNumber and (cont.ContactRecordType='Doctor' or (cont.ContactClinID is not null) )",
                "",
                "WHERE",
                "    cont.ContactRegionGroup='Asia Pacific'",
                "    and c.IsDeleted='false'",
                "    --and c.[Status] ='Completed'",
                "    and m.IsDeleted='false'",
                "    and m.[Status] ='Attended'",
                "    and (c.EventTypePicklist IN ('IGOSG','INFOS','ECYAU','ECMOR','ECTAI','MAL','WMC','AST','CF','FFSG','FF4','FF3','FF2','FF1','TPDM','IMC','EP6','EP4',",
                "                                    'EP3','EP2','EP1','ITESGO','ITE4','ITE3','ITE2','ITE1','FS3','ECNAR','NASTG','EP5','FS2','FS1','ITESG','RC','SU4','SU3',",
                "                                    'SU2','SU1','FE6','FE5','FE4','FE3','FE2','FE1','MCL','WSG','SG','FE7','TCSG','PTCW','OC1','OC2','OC3','OC4','IIC3',",
                "                                    'SAFEON1','SAFEON2','SAFEON3','SAFEON4','SAFEON5','SAFEON6','SAFEON7','SAFEON8'))",
                "),",
                "",
                "Training_records_wo_Campaign as ",
                "(",
                "    select r.*",
                "        from TrainingRecords r",
                "            left join Campaigns c ",
                "            on r.ContactID=c.ContactID and r.[Event Type]=c.[Event Type] and r.[Event Date]=c.[Event Date]",
                "    where c.[Event ID] is NULL",
                "),",
                "",
                "AllEvents as (",
                "    (select * from Campaigns",
                "    UNION ALL",
                "    select * from Training_records_wo_Campaign)",
                ")",
                "",
                "select * from AllEvents ",
                "\"",
                "),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(Source,{{\"Event Date\", type date}})",
                "    ",
                "",
                "in",
                "    #\"Changed Type\""
              ]
            }
          }
        ]
      },
