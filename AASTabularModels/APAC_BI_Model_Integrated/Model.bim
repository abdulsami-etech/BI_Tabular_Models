          {
            "name": "PBI_QueryRelationships",
            "value": "{\"columnCount\":25,\"keyColumnNames\":[],\"queryRelationships\":[],\"columnIdentities\":[\"Section1/4) Primary Order/Source.{OrderKey,0}\",\"Section1/4) Primary Order/Source.{ContactKey,1}\",\"Section1/4) Primary Order/Source.{AccountKey,2}\",\"Section1/4) Primary Order/Source.{SFDCOrderNumber,3}\",\"Section1/4) Primary Order/Source.{IDSOrderNumber,4}\",\"Section1/4) Primary Order/Source.{SAPOrderNumber,5}\",\"Section1/4) Primary Order/Source.{CaseSetupDeliverableTypeKey,6}\",\"Section1/4) Primary Order/Source.{AlignerDeliverableTypeKey,7}\",\"Section1/4) Primary Order/Source.{CaseSetupTreatmentOptionKey,8}\",\"Section1/4) Primary Order/Source.{AlignerTreatmentOptionKey,9}\",\"Section1/4) Primary Order/Source.{NewOrRestart,10}\",\"Section1/4) Primary Order/Source.{SubmissionType,11}\",\"Section1/4) Primary Order/Changed Type.{SubmitDate,12}\",\"Section1/4) Primary Order/Changed Type.{AMRDate,13}\",\"Section1/4) Primary Order/Changed Type.{CCADate,14}\",\"Section1/4) Primary Order/Changed Type.{CancellationDate,15}\",\"Section1/4) Primary Order/Source.{UpperAlignerQty,16}\",\"Section1/4) Primary Order/Source.{LowerAlignerQty,17}\",\"Section1/4) Primary Order/Source.{OrderStages,18}\",\"Section1/4) Primary Order/Source.{CurrentOrderStatus,19}\",\"Section1/4) Primary Order/Source.{ScanType,20}\",\"Section1/4) Primary Order/Source.{IsTestOrder,21}\",\"Section1/4) Primary Order/Source.{AlignerProdHierKey,22}\",\"Section1/4) Primary Order/Source.{CaseSetupProdHierKey,23}\",\"Section1/4) Primary Order/Source.{PatientAge,24}\"],\"ColumnCount\":25,\"KeyColumnNames\":[],\"ColumnIdentities\":[\"Section1/4) Primary Order/Source.{OrderKey,0}\",\"Section1/4) Primary Order/Source.{ContactKey,1}\",\"Section1/4) Primary Order/Source.{AccountKey,2}\",\"Section1/4) Primary Order/Source.{SFDCOrderNumber,3}\",\"Section1/4) Primary Order/Source.{IDSOrderNumber,4}\",\"Section1/4) Primary Order/Source.{SAPOrderNumber,5}\",\"Section1/4) Primary Order/Source.{CaseSetupDeliverableTypeKey,6}\",\"Section1/4) Primary Order/Source.{AlignerDeliverableTypeKey,7}\",\"Section1/4) Primary Order/Source.{CaseSetupTreatmentOptionKey,8}\",\"Section1/4) Primary Order/Source.{AlignerTreatmentOptionKey,9}\",\"Section1/4) Primary Order/Source.{NewOrRestart,10}\",\"Section1/4) Primary Order/Source.{SubmissionType,11}\",\"Section1/4) Primary Order/Changed Type.{SubmitDate,12}\",\"Section1/4) Primary Order/Changed Type.{AMRDate,13}\",\"Section1/4) Primary Order/Changed Type.{CCADate,14}\",\"Section1/4) Primary Order/Changed Type.{CancellationDate,15}\",\"Section1/4) Primary Order/Source.{UpperAlignerQty,16}\",\"Section1/4) Primary Order/Source.{LowerAlignerQty,17}\",\"Section1/4) Primary Order/Source.{OrderStages,18}\",\"Section1/4) Primary Order/Source.{CurrentOrderStatus,19}\",\"Section1/4) Primary Order/Source.{ScanType,20}\",\"Section1/4) Primary Order/Source.{IsTestOrder,21}\",\"Section1/4) Primary Order/Source.{AlignerProdHierKey,22}\",\"Section1/4) Primary Order/Source.{CaseSetupProdHierKey,23}\",\"Section1/4) Primary Order/Source.{PatientAge,24}\"],\"RelationshipInfo\":[]}"
          },
