            "expression": "DIVIDE([QoQ NR Change],[NR LQ])",
            "displayFolder": "1. Volume\\4 Net Receipts",
            "lineageTag": "ef4df44d-a213-4b2a-8fd9-c2578e578b81"
          },
          {
            "name": "Upper Aligner Quantity",
            "expression": [
              "VAR dt=DISTINCT('1) Reporting Calendar'[Date])",
              "VAR o=CALCULATETABLE(VALUES('FactSales'[OrderKey]),",
              "                      FILTER('FactSales', 'FactSales'[Shipments]<>0),",
              "                      TREATAS(dt,'FactSales'[StatusDate])",
              "                     ) ",
              "",
              "RETURN",
              "CALCULATE(",
              "    SUM('4) Primary Order'[Upper Aligner Qty]), ",
              "    TREATAS(o, '4) Primary Order'[OrderKey])",
              "    --TREATAS(dt,'4) Primary Order'[ShipDate])",
              "    )"
            ],
            "displayFolder": "1. Volume\\9 Aligner Quantity",
            "lineageTag": "d061312e-ad6e-4ed8-b63f-0dfa4d68a9bd"
          },
          {
            "name": "Lower Aligner Quantity",
            "expression": [
              "VAR dt=DISTINCT('1) Reporting Calendar'[Date])",
              "VAR o=CALCULATETABLE(VALUES('FactSales'[OrderKey]),",
              "                      FILTER('FactSales', 'FactSales'[Shipments]<>0),",
              "                      TREATAS(dt,'FactSales'[StatusDate])",
              "                     ) ",
              "",
              "RETURN",
              "CALCULATE(",
              "    SUM('4) Primary Order'[Lower Aligner Qty]), ",
              "    TREATAS(o, '4) Primary Order'[OrderKey])",
              "    --TREATAS(dt,'4) Primary Order'[ShipDate])",
              "    )"
            ],
            "displayFolder": "1. Volume\\9 Aligner Quantity",
            "lineageTag": "0b3385ad-cabc-48c9-abda-4503226e9591"
          },
          {
            "name": "Total Aligner Quantity",
            "expression": [
              "VAR dt=DISTINCT('1) Reporting Calendar'[Date])",
              "VAR o=CALCULATETABLE(VALUES('FactSales'[OrderKey]),",
              "                      FILTER('FactSales', 'FactSales'[Shipments]<>0),",
              "                      TREATAS(dt,'FactSales'[StatusDate])",
              "                     ) ",
              "",
              "RETURN",
              "CALCULATE(",
              "    SUM('4) Primary Order'[Aligner Qty]), ",
              "    TREATAS(o, '4) Primary Order'[OrderKey])",
              "    --TREATAS(dt,'4) Primary Order'[ShipDate])",
              "    )",
              "//[Upper Aligner Quantity]+[Lower Aligner Quantity]"
            ],
            "displayFolder": "1. Volume\\9 Aligner Quantity",
            "lineageTag": "86dd1439-36d1-4857-8033-9a24bfd840d9"
          },
          {
            "name": "Attendance Count",
            "expression": [
              "CALCULATE(",
              "    DISTINCTCOUNT('Continued Education Campaigns'[Clin ID]),",
              "    'Continued Education Campaigns'[Member Status]=\"Attended\"",
              "    )"
            ],
            "formatString": "#,##0",
            "displayFolder": "Continued Education",
            "lineageTag": "0c7a797a-cb44-448b-9d27-7adea493d9f9"
          },
          {
            "name": "CE Hours",
            "expression": [
              "SUMX( VALUES('Continued Education Campaigns'[Campaign ID]), ",
              "      MAX('Continued Education Campaigns'[CE Hours]))"
            ],
            "formatString": "#,##0.0",
            "displayFolder": "Continued Education",
            "lineageTag": "2849c936-e4d3-426d-a099-cd53e09a3ad4"
          },
          {
            "name": "CE Doctors Count Reporting Q",
            "expression": [
              "     VAR dt=DISTINCT('1) Reporting Calendar'[Date])",
              "     VAR PrevQ=DATEADD(dt,-1,QUARTER)",
              "     VAR PrevPrevQ=DATEADD(dt,-2,QUARTER)",
              "     VAR MaxCertDate=CALCULATE(MIN('1) Reporting Calendar'[Date]), ALL('1) Reporting Calendar'), PrevPrevQ)",
              "",
              "RETURN",
              "CALCULATE(",
              "            DISTINCTCOUNT('2) Doctor'[PPID/ClinID]),",
              "            '2) Doctor'[Certification Date ClinID]<MaxCertDate,",
              "            '2) Doctor'[Doctor Status]=\"Active\"",
              "",
              "        )"
            ],
            "formatString": "#,##0",
            "displayFolder": "Continued Education"
          },
          {
            "name": "CountOfDoctorsByCEGroup",
            "expression": [
              "    VAR SelectedDoctorGroup=",
              "        IF(",
              "            HASONEVALUE('Continued Education Doctor Group'[Doctor Training Group]),",
              "            VALUES('Continued Education Doctor Group'[Doctor Training Group]),",
              "            BLANK())",
              "            ",
              "     VAR dt=DISTINCT('1) Reporting Calendar'[Date])",
              "     VAR PrevQ=DATEADD(dt,-1,QUARTER)",
              "     VAR PrevPrevQ=DATEADD(dt,-2,QUARTER)",
              "     VAR MaxCertDate=CALCULATE(MIN('1) Reporting Calendar'[Date]), ALL('1) Reporting Calendar'), PrevPrevQ)",
              "",
              "RETURN",
              "         SWITCH( SelectedDoctorGroup,",
              "                \"0 Trainings\",",
              "                     CALCULATE(",
              "                        COUNTROWS(FILTER(VALUES('2) Doctor'[PPID/ClinID]),[CE Events Count (Q-1 + Q-2)]=0)),",
              "                        '2) Doctor'[Doctor Status]=\"Active\",",
              "                        '2) Doctor'[Certification Date ClinID]<MaxCertDate),",
              "                \"1 Training\",",
              "                       CALCULATE(",
              "                            COUNTROWS(FILTER(VALUES('2) Doctor'[PPID/ClinID]),[CE Events Count (Q-1 + Q-2)]=1)),",
              "                            '2) Doctor'[Doctor Status]=\"Active\",",
              "                            '2) Doctor'[Certification Date ClinID]<MaxCertDate),",
              "                \"2+ Trainings\",",
              "                       CALCULATE(",
              "                            COUNTROWS(FILTER(VALUES('2) Doctor'[PPID/ClinID]),[CE Events Count (Q-1 + Q-2)]>=2)),",
              "                            '2) Doctor'[Doctor Status]=\"Active\",",
              "                            '2) Doctor'[Certification Date ClinID]<MaxCertDate),",
              "                BLANK() ",
              "            )",
              ""
            ],
            "formatString": "#,##0",
            "displayFolder": "Continued Education"
          },
          {
            "name": "Doctors Certified Count",
            "expression": [
              "",
              "-- This measure counts number of doctors who has certified in selected time range ",
              "--judging by Contact Certification Date",
              "",
              "VAR dt=DISTINCT('1) Reporting Calendar'[Date])",
              "VAR res=CALCULATE([Doctors Count], TREATAS(dt,'2) Doctor'[Certification Date ClinID]))",
              "",
              "RETURN res"
            ],
            "formatString": "#,##0",
            "displayFolder": "Doctors Onboarding & Activation\\Upcoming Events"
          },
          {
            "name": "AA Usage",
            "expression": [
              "VAR dt=DISTINCT('1) Reporting Calendar'[Date])",
              "",
              "RETURN",
              "CALCULATE( ",
              "    COUNTROWS('Seconday Order'), ",
              "    NOT(ISBLANK('Seconday Order'[ShipDate])),",
              "    'Seconday Order'[SAP Deliverable Type] in {\"ADDITIONAL_ALIGNERS\",\"MID_COURSE_ALIGNER\",\"REFINEMENT\",\"AUTOMATED_REFINEMENT\"},",
              "    TREATAS(dt,'Seconday Order'[ShipDate])",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "Secondary Orders\\AA Usage",
            "lineageTag": "9dac8660-461c-4c38-a840-8f561616d63a"
          },
          {
            "name": "AA Usage Rate",
            "expression": [
              "DIVIDE(",
              "[AA Usage],",
              "CALCULATE([Shipments],'5) Product Hierarchy'[Product Level3]=\"Treatment\")",
              ")"
            ],
            "formatString": "#,##0.00 %",
            "displayFolder": "Secondary Orders\\AA Usage",
            "lineageTag": "e33de813-3018-4626-989c-878b04133d06"
          },
          {
            "name": "Cohort AA Usage Rate",
            "expression": [
              "VAR StartDate =",
              "    DATE ( 2015, 07, 01 )",
              "VAR PrimaryShipDateEnd =",
              "    CALCULATE (",
              "        MAX ( '1) Reporting Calendar'[Date] ),",
              "        SAMEPERIODLASTYEAR ( '1) Reporting Calendar'[Date] )",
              "    ) ",
              "VAR SecondaryShipDateEnd =",
              "    CALCULATE ( MAX ( '1) Reporting Calendar'[Date] ) )",
              "",
              "VAR X =",
              "    CALCULATE (",
              "        [Shipments],",
              "        '1) Reporting Calendar'[Date] >= StartDate",
              "            && '1) Reporting Calendar'[Date] <= PrimaryShipDateEnd,",
              "        '4) Primary Order'[AlignerDeliverableTypeKey] in {1,2,49,55,57}",
              "    )",
              "VAR Y =",
              "    CALCULATE (",
              "        COUNTROWS('Seconday Order'),",
              "        ALL('1) Reporting Calendar'),",
              "        'Seconday Order'[SAP Deliverable Type] in {\"ADDITIONAL_ALIGNERS\",\"MID_COURSE_ALIGNER\",\"REFINEMENT\",\"AUTOMATED_REFINEMENT\"},",
              "        'Seconday Order'[PrimaryShipDate]>= StartDate",
              "            && 'Seconday Order'[PrimaryShipDate] <= PrimaryShipDateEnd,",
              "         'Seconday Order'[ShipDate]>= StartDate",
              "            && 'Seconday Order'[ShipDate] <= SecondaryShipDateEnd,",
              "        'Seconday Order'[PrimaryDeliverableTypeKey] in {1,2,49,55,57}",
              "    )",
              "RETURN",
              "",
              "  DIVIDE ( Y, X ) "
            ],
            "displayFolder": "Secondary Orders\\AA Usage",
            "lineageTag": "079c8598-bbf9-4e68-8287-384631ad71a0"
          },
          {
            "name": "Percent AA Adult",
            "expression": [
              "",
              "VAR StartDate=DATE(2015,07,01)",
              "VAR initPeriod=VALUES('1) Reporting Calendar'[Date])",
              "VAR lastDateCY=MAX('1) Reporting Calendar'[Date])",
              "VAR PYPeriod=SAMEPERIODLASTYEAR(initPeriod)",
              "VAR LastDatePY=CALCULATE(MAX('1) Reporting Calendar'[Date]), ALL('1) Reporting Calendar'), PYPeriod)",
              "",
              "",
              "VAR TotalOrders=CALCULATE(",
              "                    DISTINCTCOUNT('Seconday Order'[SAPOrderNumber]),",
              "                    ALL('1) Reporting Calendar'),",
              "                    'Seconday Order'[PrimaryShipdate]>=StartDate,",
              "                    'Seconday Order'[PrimaryShipdate]<=LastDatePY,",
              "                    'Seconday Order'[ShipDate]<=lastDateCY ",
              "                        && NOT(ISBLANK('Seconday Order'[ShipDate])),",
              "                    'Seconday Order'[PrimaryDeliverableTypeKey] in {1,2,49,55,57},",
              "                    'Seconday Order'[SAP Deliverable Type] in {\"ADDITIONAL_ALIGNERS\",\"MID_COURSE_ALIGNER\",\"REFINEMENT\",\"AUTOMATED_REFINEMENT\"}",
              "                    )",
              "                    ",
              "VAR Adult=CALCULATE(",
              "                    DISTINCTCOUNT('Seconday Order'[SAPOrderNumber]),",
              "                    ALL('1) Reporting Calendar'),",
              "                    'Seconday Order'[PrimaryShipdate]>=StartDate,",
              "                    'Seconday Order'[PrimaryShipdate]<=LastDatePY,",
              "                    'Seconday Order'[ShipDate]<=lastDateCY",
              "                        && NOT(ISBLANK('Seconday Order'[ShipDate])),",
              "                    'Seconday Order'[AgeTierAA]=\"Adult\",",
              "                    'Seconday Order'[PrimaryDeliverableTypeKey] in {1,2,49,55,57},",
              "                    'Seconday Order'[SAP Deliverable Type] in {\"ADDITIONAL_ALIGNERS\",\"MID_COURSE_ALIGNER\",\"REFINEMENT\",\"AUTOMATED_REFINEMENT\"}",
              "                    )",
              "",
              "RETURN DIVIDE(Adult,TotalOrders)"
            ],
            "formatString": "#,##0.00 %",
            "displayFolder": "Secondary Orders\\AA Usage",
            "lineageTag": "32d7da52-b758-4171-a2b0-3bb654dd1b7f"
          },
          {
            "name": "Percent AA Teen",
            "expression": [
              "",
              "VAR StartDate=DATE(2015,07,01)",
              "VAR initPeriod=VALUES('1) Reporting Calendar'[Date])",
              "VAR lastDateCY=MAX('1) Reporting Calendar'[Date])",
              "VAR PYPeriod=SAMEPERIODLASTYEAR(initPeriod)",
              "VAR LastDatePY=CALCULATE(MAX('1) Reporting Calendar'[Date]), ALL('1) Reporting Calendar'), PYPeriod)",
              "",
              "",
              "VAR TotalOrders=CALCULATE(",
              "                    DISTINCTCOUNT('Seconday Order'[SAPOrderNumber]),",
              "                    ALL('1) Reporting Calendar'),",
              "                    'Seconday Order'[PrimaryShipdate]>=StartDate,",
              "                    'Seconday Order'[PrimaryShipdate]<=LastDatePY,",
              "                    'Seconday Order'[ShipDate]<=lastDateCY ",
              "                        && NOT(ISBLANK('Seconday Order'[ShipDate])),",
              "                    'Seconday Order'[PrimaryDeliverableTypeKey] in {1,2,49,55,57},",
              "                    'Seconday Order'[SAP Deliverable Type] in {\"ADDITIONAL_ALIGNERS\",\"MID_COURSE_ALIGNER\",\"REFINEMENT\",\"AUTOMATED_REFINEMENT\"}",
              "                    )",
              "                    ",
              "VAR Teen=CALCULATE(",
              "                    DISTINCTCOUNT('Seconday Order'[SAPOrderNumber]),",
              "                    ALL('1) Reporting Calendar'),",
              "                    'Seconday Order'[PrimaryShipdate]>=StartDate,",
              "                    'Seconday Order'[PrimaryShipdate]<=LastDatePY,",
              "                    'Seconday Order'[ShipDate]<=lastDateCY",
              "                        && NOT(ISBLANK('Seconday Order'[ShipDate])),",
              "                    'Seconday Order'[AgeTierAA]=\"Teen\",",
              "                    'Seconday Order'[PrimaryDeliverableTypeKey] in {1,2,49,55,57},",
              "                    'Seconday Order'[SAP Deliverable Type] in {\"ADDITIONAL_ALIGNERS\",\"MID_COURSE_ALIGNER\",\"REFINEMENT\",\"AUTOMATED_REFINEMENT\"}",
              "                    )",
              "",
              "RETURN DIVIDE(Teen,TotalOrders)"
            ],
            "formatString": "#,##0.00 %",
            "displayFolder": "Secondary Orders\\AA Usage",
            "lineageTag": "d06bf79d-4300-4e43-8b2b-412f76321fec"
          },
          {
            "name": "Percent AA Kids",
            "expression": [
              "",
              "VAR StartDate=DATE(2015,07,01)",
              "VAR initPeriod=VALUES('1) Reporting Calendar'[Date])",
              "VAR lastDateCY=MAX('1) Reporting Calendar'[Date])",
              "VAR PYPeriod=SAMEPERIODLASTYEAR(initPeriod)",
              "VAR LastDatePY=CALCULATE(MAX('1) Reporting Calendar'[Date]), ALL('1) Reporting Calendar'), PYPeriod)",
              "",
              "",
              "VAR TotalOrders=CALCULATE(",
              "                    DISTINCTCOUNT('Seconday Order'[SAPOrderNumber]),",
              "                    ALL('1) Reporting Calendar'),",
              "                    'Seconday Order'[PrimaryShipdate]>=StartDate,",
              "                    'Seconday Order'[PrimaryShipdate]<=LastDatePY,",
              "                    'Seconday Order'[ShipDate]<=lastDateCY ",
              "                        && NOT(ISBLANK('Seconday Order'[ShipDate])),",
              "                    'Seconday Order'[PrimaryDeliverableTypeKey] in {1,2,49,55,57},",
              "                    'Seconday Order'[SAP Deliverable Type] in {\"ADDITIONAL_ALIGNERS\",\"MID_COURSE_ALIGNER\",\"REFINEMENT\",\"AUTOMATED_REFINEMENT\"}",
              "                    )",
              "                    ",
              "VAR Kids=CALCULATE(",
              "                    DISTINCTCOUNT('Seconday Order'[SAPOrderNumber]),",
              "                    ALL('1) Reporting Calendar'),",
              "                    'Seconday Order'[PrimaryShipdate]>=StartDate,",
              "                    'Seconday Order'[PrimaryShipdate]<=LastDatePY,",
              "                    'Seconday Order'[ShipDate]<=lastDateCY",
              "                        && NOT(ISBLANK('Seconday Order'[ShipDate])),",
              "                    'Seconday Order'[AgeTierAA]=\"Kids\",",
              "                    'Seconday Order'[PrimaryDeliverableTypeKey] in {1,2,49,55,57},",
              "                    'Seconday Order'[SAP Deliverable Type] in {\"ADDITIONAL_ALIGNERS\",\"MID_COURSE_ALIGNER\",\"REFINEMENT\",\"AUTOMATED_REFINEMENT\"}",
              "                    )",
              "",
              "RETURN  DIVIDE(Kids,TotalOrders)"
            ],
            "formatString": "#,##0.00 %",
            "displayFolder": "Secondary Orders\\AA Usage",
            "lineageTag": "5ea42ed7-9110-4517-892f-5a4affac265f"
          },
          {
            "name": "CCA 3RM",
            "expression": [
              "",
              "--This measure calculates CCA for 3 Rolling Month starting back from the maximum date in the Reporting Calendar context",
              "",
              "VAR curDay=MAX('1) Reporting Calendar'[Date])",
              "VAR DayLY=SELECTCOLUMNS(",
              "                FILTER('1) Reporting Calendar',[Date]=curDay),",
              "                \"Date\", NEXTDAY(DATEADD('1) Reporting Calendar'[Date],-3,month)))",
              "",
              "RETURN",
              "CALCULATE (",
              "        [CCA],",
              "            DATESBETWEEN (",
              "               '1) Reporting Calendar'[Date],",
              "                DayLY,",
              "                curDay))"
            ],
            "formatString": "#,0",
            "displayFolder": "2. Doctors Utilization\\CCA"
          },
          {
            "name": "NR 3RM",
            "expression": [
              "--This measure calculates Net Receipts for 3 Rolling Month starting back from the maximum date in the Reporting Calendar context",
