              "--This measure calculates GR for 3 Rolling Month starting back from the maximum date in the Reporting Calendar context",
              "",
              "VAR curDay=MAX('1) Reporting Calendar'[Date])",
              "VAR DayLY=SELECTCOLUMNS(",
              "                FILTER('1) Reporting Calendar',[Date]=curDay),",
