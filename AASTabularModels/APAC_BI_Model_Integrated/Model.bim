              "  '2) Doctor'[Current Segment] IN {\"Active\"},",
              "  \"e. Active\",",
              "  '2) Doctor'[Current Segment] IN {\"Multi-Disciplinary Aspirer\"},",
              "  \"f. Multi-Disciplinary Aspirer\",",
              "  '2) Doctor'[Current Segment] IN {\"Engaged\"},",
              "  \"g. Engaged\",",
              "  '2) Doctor'[Current Segment] IN {\"Multi-Disciplinary Champion\"},",
              "  \"h. Multi-Disciplinary Champion\",",
              "  '2) Doctor'[Current Segment] IN {\"Expert\"},",
              "  \"i. Expert\",",
              "  '2) Doctor'[Current Segment] IN {\"GP Expert\"},",
              "  \"j. GP Expert\",",
              "  '2) Doctor'[Current Segment]",
              ")"
            ],
            "displayFolder": "Segmentation"
          },
