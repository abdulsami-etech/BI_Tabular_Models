          },
          {
            "type": "calculated",
            "name": "SFDC Link",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": "CONCATENATE(\"https://aligntech.my.salesforce.com/\",[ContactID])",
            "displayFolder": "Contact Fields",
            "dataCategory": "WebUrl",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              },
              {
                "name": "Format",
                "value": "<Format Format=\"Text\" />"
              },
              {
                "name": "DataTypeAtRefresh",
                "value": "String#####not a type"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Days After Certification",
            "dataType": "int64",
            "isDataTypeInferred": false,
            "expression": "IF (NOT ISBLANK([Certification Date ClinID]), (TODAY()-1) - [Certification Date ClinID], BLANK())",
            "formatString": "0",
            "displayFolder": "Activation",
            "summarizeBy": "sum",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              },
              {
                "name": "Format",
                "value": "<Format Format=\"NumberWhole\" Accuracy=\"0\" />"
              },
              {
                "name": "DataTypeAtRefresh",
                "value": "Int64#####not a type"
              }
            ]
          },
          {
            "name": "ContactCountry",
            "dataType": "string",
            "sourceColumn": "ContactCountry",
            "displayFolder": "Geography"
          },
          {
            "name": "ContactCountryGroup",
            "dataType": "string",
            "sourceColumn": "ContactCountryGroup",
            "displayFolder": "Geography"
          },
          {
            "name": "ContactRegionPC",
            "dataType": "string",
            "sourceColumn": "ContactRegionPC",
            "displayFolder": "Geography"
          },
          {
            "type": "calculated",
            "name": "Certification Year",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": "YEAR([Certification Date])",
            "displayFolder": "Contact Fields\\Certification Dates",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Certification Quarter",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": "COMBINEVALUES(\" \",CONCATENATE(\"Q\",ROUNDUP(MONTH([Certification Date])/3, 0)),[Certification Year])",
            "displayFolder": "Contact Fields\\Certification Dates"
          },
          {
            "type": "calculated",
            "name": "Certification Month",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": "FORMAT([Certification Date],\"MMM YYYY\")",
            "sortByColumn": "Certification Month Code",
            "displayFolder": "Contact Fields\\Certification Dates"
          },
          {
            "type": "calculated",
            "name": "JTP Milestone Days",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": [
              "IF([Days After Certification]>=365,365,",
              "\tIF([Days After Certification]>=270,270,",
              "\t\tIF([Days After Certification]>=180,180,",
              "\t\t\tIF([Days After Certification]>=120,120,",
              "\t\t\t\tIF([Days After Certification]>=90,90,",
              "\t\t\t\t\tIF([Days After Certification]>=60,60,",
              "\t\t\t\t\t\tIF([Days After Certification]>=30,30",
              "\t\t\t\t\t\t,BLANK()",
              "\t\t\t\t\t\t)))))))"
            ],
            "displayFolder": "Activation"
          },
          {
            "name": "PDM Name",
            "dataType": "string",
            "sourceColumn": "PDM Name",
            "displayFolder": "Contact Fields"
          },
          {
            "type": "calculated",
            "name": "JTP Actual",
            "dataType": "int64",
            "isDataTypeInferred": false,
            "expression": [
              "CALCULATE(  [CCA], ",
              "                ALL('1) Reporting Calendar'),",
              "                '1) Reporting Calendar'[Date]>=EARLIER([Certification Date ClinID]) &&",
              "                '1) Reporting Calendar'[Date]<=EARLIER([Certification Date ClinID])+EARLIER([JTP Milestone Days])",
              "            )"
            ],
            "displayFolder": "Activation"
          },
          {
            "type": "calculated",
            "name": "Growth Bucket",
            "dataType": "string",
            "isDataTypeInferred": false,
            "expression": [
              "SWITCH( TRUE(),",
              "",
              "RELATED('Fact Activation'[CCA @ 90 Days])>=5, \"5+ @ 90 Days\",",
              "RELATED('Fact Activation'[CCA @ 90 Days])>=3, \"3+ @ 90 Days\",",
              "\"Others\"",
              ")"
            ],
            "displayFolder": "Activation"
          },
          {
            "type": "calculated",
            "name": "Certification Month Code",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "isHidden": true,
            "expression": "Year([Certification Date])*100+MONTH([Certification Date])",
            "displayFolder": "Contact Fields\\Certification Dates"
          },
          {
            "name": "PPID Source",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "PPID Source",
            "displayFolder": "Contact Fields"
          },
          {
            "type": "calculated",
            "name": "Certification Quarter LY",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "COMBINEVALUES(\" \",CONCATENATE(\"Q\",ROUNDUP(MONTH([Certification Date])/3, 0)),[Certification Year]-1)",
              ""
            ],
            "displayFolder": "Contact Fields\\Certification Dates"
          },
          {
            "name": "ContactMailingCountry",
            "dataType": "string",
            "sourceColumn": "ContactMailingCountry",
            "displayFolder": "Geography"
          },
          {
            "name": "ContactMailingState",
            "dataType": "string",
            "sourceColumn": "ContactMailingState",
            "displayFolder": "Geography"
          },
          {
            "name": "ContactMailingCity",
            "dataType": "string",
            "sourceColumn": "ContactMailingCity",
            "displayFolder": "Geography"
          },
          {
            "name": "Contact Location",
            "dataType": "string",
            "sourceColumn": "Contact Location",
            "displayFolder": "Geography"
          },
          {
            "type": "calculated",
            "name": "Line of Business (groups)",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "SWITCH([Line of Business],",
              "",
              "BLANK()                               ,\"N/A\",",
              "\"Cadent\"                              ,\"N/A\",",
              "\"Invisalign\"                          ,\"Invisalign\",",
              "\"Invisalign Go\"                       ,\"Invisalign Go\",",
              "\"Invisalign;Cadent\"                   ,\"Invisalign\",",
              "\"Invisalign;Invisalign Go\"            ,\"Invisalign\",",
              "\"Invisalign;iTero\"                    ,\"Invisalign\",",
              "\"Invisalign;iTero;Cadent\"             ,\"Invisalign\",",
              "\"Invisalign;iTero;Invisalign Go\"      ,\"Invisalign\",",
              "\"iTero\"                               ,\"iTero\",",
              "\"iTero;Cadent\"                        ,\"iTero\",",
              "\"iTero;Cadent;Invisalign Go\"          ,\"Invisalign Go\",",
              "\"iTero;Invisalign Go\"                 ,\"Invisalign Go\",",
              "\"N/A\")",
              "",
              "",
              "/*",
              "SWITCH(",
              "  TRUE,",
              "  ISBLANK('2) Doctor'[Line of Business]),",
              "  \"(Blank)\",",
              "  '2) Doctor'[Line of Business] IN {\"Cadent;Invisalign Go\",",
              "    \"Invisalign Go\",",
              "    \"iTero;Cadent;Invisalign Go\",",
              "    \"iTero;Cadent;Realine;Invisalign Go\",",
              "    \"iTero;Invisalign Go\"},",
              "  \"GP_iGo\",",
              "  '2) Doctor'[Line of Business] IN {\"Invisalign\",",
              "    \"Invisalign;Cadent\",",
              "    \"Invisalign;Invisalign Go\",",
              "    \"Invisalign;iTero\",",
              "    \"Invisalign;iTero;Cadent\"},",
              "  \"GP_Invisalign\",",
              "  '2) Doctor'[Line of Business] IN {\"Cadent\",",
              "    \"iTero\"},",
              "  \"Other\",",
              "  '2) Doctor'[Line of Business]",
              ")",
              "*/",
              "",
              ""
            ],
            "displayFolder": "Contact Fields"
          },
          {
            "type": "calculated",
            "name": "Current Segment (groups)",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "SWITCH(",
              "  TRUE,",
              "  ISBLANK('2) Doctor'[Current Segment]),",
              "  \"(Blank)\",",
              "  '2) Doctor'[Current Segment] IN {\"New\"},",
              "  \"a. New\",",
              "  '2) Doctor'[Current Segment] IN {\"Lapsed\"},",
              "  \"b. Lapsed\",",
