            "name": "Quarter-Year Name",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": "CONCATENATE(CONCATENATE([Quarter Short Name],\" \"),FORMAT([Date],\"yyyy\"))",
            "sortByColumn": "Quarter Code",
            "displayFolder": "Quarter",
            "summarizeBy": "none",
            "annotations": [
