        "partitions": [
          {
            "name": "Cluster Contact Plan-e05e7ea1-d037-4a89-86d7-cba1a775b7f7",
            "mode": "import",
            "queryGroup": "Entities",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Value.NativeQuery(#\"OTCDM\",",
                "\"",
                "select  cp.*",
                "from SFDC_Staging.dbo.[TFM_Cluster_Contact_Plan__c] cp",
                "    left join SFDC_Staging.[dbo].[TFM_Cluster_Contact__c] c on cp.TFM_Cluster_Contact__c = c.Id",
                "    left join SFDC_Staging.[dbo].[TFM_Cluster__c] cl on cl.id = c.TFM_Cluster__c",
                "    left join SFDC_Staging.[dbo].RecordType r on cl.RecordTypeId = r.Id",
                "where r.DeveloperName like 'APAC_Segmentation' and",
                "cl.CreatedDate >= '2020-06-01'",
                "    ",
                "    \")",
                "in",
                "    Source"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_DescriptionAtRefresh"
          },
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          },
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
