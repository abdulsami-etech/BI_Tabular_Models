                "    ,[align_agentid]",
                "    ,[Customer_Support_Ticket_id]",
                "    ,[CS_Experience_Satisfaction]",
                "    ,[align_cs_osat_comment]",
                "    ,[aligntech_customer_support_agent_osat_sc10]",
                "    ,[CustomerSupport_Willingness_to_help]",
                "    ,[CustomerSupport_Understanding_of_your_needs]",
                "    ,[CustomerSupport_Clear_communication]",
