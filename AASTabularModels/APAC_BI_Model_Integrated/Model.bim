              "        CALCULATE( [CCA], ",
              "                    ALLEXCEPT('Fact Activation','Fact Activation'[ContactID]),",
              "                    '1) Reporting Calendar'[Date]>=EARLIER([Cert Date]) && '1) Reporting Calendar'[Date]<=endday),",
              "    BLANK()",
              ")"
            ],
            "formatString": "0",
            "summarizeBy": "sum",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              },
              {
                "name": "Format",
                "value": "<Format Format=\"NumberWhole\" Accuracy=\"0\" />"
