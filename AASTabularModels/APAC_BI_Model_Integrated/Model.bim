            "dataType": "string",
            "sourceColumn": "Lead_URL_Term__c"
          },
          {
            "name": "IsCareAbout",
            "dataType": "int64",
            "sourceColumn": "IsCareAbout"
          },
          {
            "name": "pid",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "pid",
            "isAvailableInMdx": false
          }
        ],
        "partitions": [
          {
            "name": "Consumer Lead",
            "mode": "import",
            "source": {
              "type": "query",
              "query": [
                "SELECT",
                "    a.Id,",
                "    a.Country,",
                "    a.countrycode,",
                "    b.Name as [Lead Type],",
                "    --e.ContactProfessionalCategory as Channel,",
                "    --isnull(o.Contact_Id__c,e.ContactClinID) as ContactClinID,",
                "    d.AccountName,",
                "    --e.AccountLattitude,",
                "    --e.AccountLongitude,",
                "    a.Lead_Id__c as LeadID,",
                "    c.Name as [Lead Owner],",
                "    a.Status,",
                "    --a.Reason__c,",
                "    a.Consult_Type__c as [Consult Type],",
                "    --case when r.DeveloperName like ('Conversion_Call_Center_%') then 'Alorica' else 'APAC-PCS' end as 'Lead_Assigned',",
                "    case ",
                "            when a.Age__c is null then 'Unknown'",
                "            when a.Age__c<=19 then 'Teen (<19)'",
                "            else 'Adult (20+)' end ",
                "        as [Age Group],",
                "",
                "    case ",
                "            when a.Age__c is null then '6) Unknown'",
                "            when a.Age__c between 6 and 10 then '1) Young Child (6-10)'",
                "            when a.Age__c between 11 and 17 then '2) Teen/Tween (11-17)'",
                "            when a.Age__c between 18 and 24 then '3) Young Adult/Cusper (18-24)'",
                "            when a.Age__c between 25 and 34 then '4) Adult (25-34)'",
                "            else '5) Older Adult (35+)' ",
                "        end as [Age Segment],",
                "",
                "    case ",
                "            when a.Created_Date_Time__c is not null and a.First_Contact__c is not null and datediff(DAY,a.Created_Date_Time__c,a.First_Contact__c)=0 then 'a) Same Day'",
                "            when a.Created_Date_Time__c is not null and a.First_Contact__c is not null and datediff(DAY,a.Created_Date_Time__c,a.First_Contact__c) between 1 and 2 then 'b) 1-2 Days Later'",
                "            when a.Created_Date_Time__c is not null and a.First_Contact__c is not null and datediff(DAY,a.Created_Date_Time__c,a.First_Contact__c) between 3 and 7 then 'b) 3-7 Days Later'",
                "            when a.Created_Date_Time__c is not null and a.First_Contact__c is not null and datediff(DAY,a.Created_Date_Time__c,a.First_Contact__c) between 8 and 100 then 'c) 8 or More Days Later'",
                "            else 'd) N/A' ",
                "        end as [Days Between Create Contact bucket],",
                "",
                "    case ",
                "            when a.Scheduled_Date__c is not null and a.Consult_Date__c is not null and datediff(DAY,a.Scheduled_Date__c,a.Consult_Date__c) between 0 and 4 then 'a) Within 4 Days'",
                "            when a.Scheduled_Date__c is not null and a.Consult_Date__c is not null and datediff(DAY,a.Scheduled_Date__c,a.Consult_Date__c) between 4 and 30 then 'b) 4-30 Days'",
                "            when a.Scheduled_Date__c is not null and a.Consult_Date__c is not null and datediff(DAY,a.Scheduled_Date__c,a.Consult_Date__c) between 31 and 120 then 'c) More Than 30 Days'",
                "            else 'd) N/A' ",
                "        end as [Days Between Schedule Consult bucket],",
                "",
                "    case ",
                "            when a.Scheduled_Date__c is not null and a.Consult_Date__c is not null and datediff(DAY,a.Scheduled_Date__c,a.Consult_Date__c) between 0 and 120 then datediff(DAY,a.Scheduled_Date__c,a.Consult_Date__c)",
                "            else null ",
                "        end as [Days Between Schedule Consult],",
                "",
                "    case ",
                "            when a.Created_Date_Time__c is not null and a.ClinCheck_Accepted_Date__c is not null and datediff(DAY,a.Created_Date_Time__c,a.ClinCheck_Accepted_Date__c) between 0 and 300 then datediff(DAY,a.Created_Date_Time__c,a.ClinCheck_Accepted_Date__c)",
                "            else null ",
                "        end as [Days Between Create CCA],",
                "",
                "    case ",
                "            when a.LeadSource in('Smile Assessment') and a.SA_Prospect_Status__c in('I''d like to set up an appointment for a consultation') then 'Smile Assessment - I''d like to set up an appointment for a consultation'",
                "            when a.LeadSource in('Smile Assessment') and a.SA_Prospect_Status__c in('I''ve made an appointment for a consultation') then 'Smile Assessment - I''ve made an appointment for a consultation'",
                "            when a.LeadSource in('Smile Assessment') and a.SA_Prospect_Status__c in('I''ve just started my research') then 'Smile Assessment - I''ve just started my research'",
                "            when a.LeadSource in('Smile Assessment') then 'Smile Assessment - Blank'",
                "            when a.LeadSource is null then 'Blank'",
                "            when a.LeadSource='Socail Media' then 'Social Media'",
                "            else rtrim(ltrim(a.LeadSource)) ",
                "        end as [Lead Source Granular],",
                "",
                "    case ",
                "            when a.LeadSource in('Doc Locator') then 'Doc Locator'",
                "            when a.SA_Prospect_Status__c in('I''d like to set up an appointment for a consultation','I''ve made an appointment for a consultation') then 'SA - Appointment'",
                "            when a.LeadSource in('Request Appointment') then 'Request Appointment'",
                "            when a.LeadSource in('Smile Assessment') then 'SA - Research'",
                "            when a.SA_Prospect_Status__c in('I''ve just started my research') then 'SA - Research'",
                "            when a.LeadSource in('Social Media') then 'Social Media'",
                "            when a.LeadSource in('SDC') then 'SDC'",
                "            when a.LeadSource in('Web','Website') then 'Website'",
                "            when a.LeadSource in('Scan Office') then 'Scan Office'",
                "            when a.LeadSource in('Contact Us') then 'Contact Us'",
                "            when a.LeadSource in('SmileView (In Office)') then 'SmileView (In Office)'",
                "            when a.LeadSource in('SmileView_Center') then 'SmileView Center'",
                "            when a.LeadSource in('SmileView_Consumer') then 'SmileView Consumer'",
                "            when a.LeadSource in('SmileView_Popup') then 'SmileView Popup'",
                "            when a.LeadSource in('SmileView_First Step') then 'SmileView First Step' ",
                "            else 'Other' ",
                "        end as [Lead Source],",
                "    ",
                "    cast(dateadd(hour,15,a.Created_Date_Time__c) as date) as [Lead Created Date],",
                "    cast(DATEADD(DAY , 8-DATEPART(WEEKDAY,DATEADD(DAY , -1, a.Created_Date_Time__c)),DATEADD(DAY , -1, a.Created_Date_Time__c)) as date) as [Lead Created Week],",
                "    datefromparts(year(a.Created_Date_Time__c),month(a.Created_Date_Time__c),1) as [Lead Created Month],",
                "",
                "    case ",
                "            when month(a.Created_Date_Time__c) in(1,2,3) then datefromparts(year(a.Created_Date_Time__c),1,1) ",
                "            when month(a.Created_Date_Time__c) in(4,5,6) then datefromparts(year(a.Created_Date_Time__c),4,1)",
                "            when month(a.Created_Date_Time__c) in(7,8,9) then datefromparts(year(a.Created_Date_Time__c),7,1)",
                "            when month(a.Created_Date_Time__c) in(10,11,12) then datefromparts(year(a.Created_Date_Time__c),10,1) ",
                "        end as [Lead Created Quarter],",
                "",
                "    (year(getdate())-year(a.Created_Date_Time__c))*12 + (month(getdate())-month(a.Created_Date_Time__c)) as [Months Since Created Date],",
                "",
                "    case ",
                "            when a.First_Contact__c is not null then cast(a.First_Contact__c as date)",
                "            when a.Scheduled_Date__c is not null then cast(a.Created_Date_Time__c as date)",
                "            when a.Scheduled_Date__c is not null and a.First_Contact__c is null then cast(a.Scheduled_Date__c as date)",
                "            when a.Consult_Date__c is not null and a.First_Contact__c is null then cast(a.Consult_Date__c as date)",
                "            when a.Converted_Date__c is not null and a.First_Contact__c is null then cast(a.Converted_Date__c as date)",
                "            when a.ClinCheck_Accepted_Date__c is not null and a.First_Contact__c is null then cast(a.ClinCheck_Accepted_Date__c as date)",
                "            else a.First_Contact__c ",
                "        end as [First Contact Date],",
                "",
                "    cast(DATEADD(DAY , 8-DATEPART(WEEKDAY,DATEADD(DAY , -1, a.First_Contact__c)),DATEADD(DAY , -1, a.First_Contact__c)) as date) as [First Contact Week],",
                "    datefromparts(year(case ",
                "                        when a.First_Contact__c is not null then a.First_Contact__c",
                "                        when a.Scheduled_Date__c is not null then a.Created_Date_Time__c",
                "                        else a.First_Contact__c end),month(case when a.First_Contact__c is not null then a.First_Contact__c",
                "                        when a.Scheduled_Date__c is not null then a.Created_Date_Time__c",
                "                        else a.First_Contact__c end),1) ",
                "        as [First Contact Month],",
                "",
                "    case ",
                "            when month(a.First_Contact__c) in(1,2,3) then datefromparts(year(a.First_Contact__c),1,1) ",
                "            when month(a.First_Contact__c) in(4,5,6) then datefromparts(year(a.First_Contact__c),4,1)",
                "            when month(a.First_Contact__c) in(7,8,9) then datefromparts(year(a.First_Contact__c),7,1)",
                "            when month(a.First_Contact__c) in(10,11,12) then datefromparts(year(a.First_Contact__c),10,1) ",
                "        end as [First Contact Quarter],",
                "",
                "    case ",
                "            when a.First_Contact__c is null then 0",
                "            else (year(getdate())-year(",
                "                                        case ",
                "                                            when a.First_Contact__c is not null then a.First_Contact__c",
                "                                            when a.Scheduled_Date__c is not null then a.Created_Date_Time__c",
                "                                            else a.First_Contact__c end))*12 ",
                "                    + (month(getdate())-month(",
                "                                        case ",
                "                                            when a.First_Contact__c is not null then a.First_Contact__c",
                "                                            when a.Scheduled_Date__c is not null then a.Created_Date_Time__c",
                "                                            else a.First_Contact__c end)) ",
                "        end as [Months Since First Contact Date],",
                "",
                "    case ",
                "            when a.Scheduled_Date__c is not null and a.First_Contact__c is null and a.Scheduled_Date__c<a.Created_Date_Time__c then cast(a.Created_Date_Time__c as date)",
                "            when a.Scheduled_Date__c is not null and a.First_Contact__c is not null and a.Scheduled_Date__c<a.First_Contact__c then cast(a.First_Contact__c as date)",
                "            when a.Consult_Date__c is not null and a.Scheduled_Date__c is null then cast(a.Consult_Date__c as date)",
                "            when a.Converted_Date__c is not null and a.Scheduled_Date__c is null then cast(a.Converted_Date__c as date)",
                "            when a.ClinCheck_Accepted_Date__c is not null and a.Scheduled_Date__c is null then cast(a.ClinCheck_Accepted_Date__c as date)",
                "            else cast(a.Scheduled_Date__c as date) ",
                "        end as [Scheduled Date],",
                "",
                "    cast(DATEADD(DAY , 8-DATEPART(WEEKDAY,DATEADD(DAY , -1, a.Scheduled_Date__c)),DATEADD(DAY , -1, a.Scheduled_Date__c)) as date) as [Scheduled Week],",
                "    datefromparts(year(a.Scheduled_Date__c),month(a.Scheduled_Date__c),1) as [Scheduled Month],",
                "",
                "    case ",
                "            when month(a.Scheduled_Date__c) in(1,2,3) then datefromparts(year(a.Scheduled_Date__c),1,1) ",
                "            when month(a.Scheduled_Date__c) in(4,5,6) then datefromparts(year(a.Scheduled_Date__c),4,1)",
                "            when month(a.Scheduled_Date__c) in(7,8,9) then datefromparts(year(a.Scheduled_Date__c),7,1)",
                "            when month(a.Scheduled_Date__c) in(10,11,12) then datefromparts(year(a.Scheduled_Date__c),10,1) ",
                "        end as [Scheduled Quarter],",
                "",
                "    case     ",
                "            when a.Scheduled_Date__c is null then 0",
                "            else (year(getdate())-year(a.Scheduled_Date__c))*12 + (month(getdate())-month(a.Scheduled_Date__c)) ",
                "        end as [Months Since Scheduled Date],",
                "",
                "    case ",
                "            when a.Converted_Date__c is not null and a.Consult_Date__c is null then cast(a.Converted_Date__c as date)",
                "            when a.ClinCheck_Accepted_Date__c is not null and a.Consult_Date__c is null then cast(a.ClinCheck_Accepted_Date__c as date)",
                "            else cast(a.Consult_Date__c as date) ",
                "        end as [Consultation Date],",
                "",
                "    cast(DATEADD(DAY , 8-DATEPART(WEEKDAY,DATEADD(DAY , -1, a.Consult_Date__c)),DATEADD(DAY , -1, a.Consult_Date__c)) as date) as [Consult Week],",
                "    datefromparts(year(a.Consult_Date__c),month(a.Consult_Date__c),1) as [Consult Month],",
                "",
                "    case ",
                "            when month(a.Consult_Date__c) in(1,2,3) then datefromparts(year(a.Consult_Date__c),1,1) ",
                "            when month(a.Consult_Date__c) in(4,5,6) then datefromparts(year(a.Consult_Date__c),4,1)",
                "            when month(a.Consult_Date__c) in(7,8,9) then datefromparts(year(a.Consult_Date__c),7,1)",
                "            when month(a.Consult_Date__c) in(10,11,12) then datefromparts(year(a.Consult_Date__c),10,1) ",
                "        end as [Consult Quarter],",
                "",
                "    case ",
                "            when a.Consult_Date__c is null then 0",
                "            else (year(getdate())-year(a.Consult_Date__c))*12 + (month(getdate())-month(a.Consult_Date__c)) ",
                "        end as [Months Since Consult Date],",
                "",
                "    case ",
                "            when a.ClinCheck_Accepted_Date__c is not null then 1",
                "            when a.Converted_Date__c is not null then 1",
                "            when a.Consult_Date__c is not null and a.Consult_Date__c<=getdate() then 1 else 0 ",
                "        end as [Lapsed Consults],",
                "",
                "    case ",
                "            when a.ClinCheck_Accepted_Date__c is not null and a.Converted_Date__c is null then cast(a.ClinCheck_Accepted_Date__c as date)",
                "            else cast(a.Converted_Date__c as date) ",
                "        end as [Converted Date],",
                "",
                "    cast(DATEADD(DAY , 8-DATEPART(WEEKDAY,DATEADD(DAY , -1, a.Converted_Date__c)),DATEADD(DAY , -1, a.Converted_Date__c)) as date) as [Converted Week],",
                "    datefromparts(year(cast(a.Converted_Date__c as date)),month(cast(a.Converted_Date__c as date)),1) as [Converted Month],",
                "",
                "    case ",
                "            when month(a.Converted_Date__c) in(1,2,3) then datefromparts(year(a.Converted_Date__c),1,1) ",
                "            when month(a.Converted_Date__c) in(4,5,6) then datefromparts(year(a.Converted_Date__c),4,1)",
                "            when month(a.Converted_Date__c) in(7,8,9) then datefromparts(year(a.Converted_Date__c),7,1)",
                "            when month(a.Converted_Date__c) in(10,11,12) then datefromparts(year(a.Converted_Date__c),10,1) ",
                "        end as [Converted Quarter],",
                "",
                "    case ",
                "            when a.Converted_Date__c is null then 0 ",
                "            else (year(getdate())-year(a.Converted_Date__c))*12 + (month(getdate())-month(a.Converted_Date__c)) ",
                "        end as [Months Since Converted Date],",
                "",
                "    cast(a.ClinCheck_Accepted_Date__c as date) as [CCA Date],",
                "    cast(DATEADD(DAY , 8-DATEPART(WEEKDAY,DATEADD(DAY , -1, a.ClinCheck_Accepted_Date__c)),DATEADD(DAY , -1, a.ClinCheck_Accepted_Date__c)) as date) as [CCA Week],",
                "    datefromparts(year(a.ClinCheck_Accepted_Date__c),month(a.ClinCheck_Accepted_Date__c),1) as [CCA Month],",
                "",
                "    case ",
                "            when month(a.ClinCheck_Accepted_Date__c) in(1,2,3) then datefromparts(year(a.ClinCheck_Accepted_Date__c),1,1) ",
                "            when month(a.ClinCheck_Accepted_Date__c) in(4,5,6) then datefromparts(year(a.ClinCheck_Accepted_Date__c),4,1)",
                "            when month(a.ClinCheck_Accepted_Date__c) in(7,8,9) then datefromparts(year(a.ClinCheck_Accepted_Date__c),7,1)",
                "            when month(a.ClinCheck_Accepted_Date__c) in(10,11,12) then datefromparts(year(a.ClinCheck_Accepted_Date__c),10,1) ",
                "        end as [CCA Quarter],",
                "",
                "    case ",
                "            when a.ClinCheck_Accepted_Date__c is null then 0 ",
                "            else (year(getdate())-year(a.ClinCheck_Accepted_Date__c))*12 + (month(getdate())-month(a.ClinCheck_Accepted_Date__c)) ",
                "        end as [Months Since CCA Date],",
                "",
                "    a.Days_from_Check_In_to_CCA__c,",
                "    a.Days_from_Consult_Date_to_CCA_Date__c,",
                "    a.Days_from_First_Contact_to_Consult_Date__c,",
                "    a.Days_from_Scheduled_to_Consult__c,",
                "    a.Days_to_CCA_from_First_Contact__c,",
                "    a.Days_to_Close_for_Consult__c,",
                "    a.Gender__c,",
                "    a.Lead_Full_URL__c,",
                "    a.Lead_URL_Campaign__c,",
                "    a.Lead_URL_Content__c,",
                "    a.Lead_URL_Medium__c,",
                "    a.Lead_URL_Source__c,",
                "    a.Lead_URL_Term__c,",
                "    --a.Latitude,",
                "    --a.Longitude,",
                "    --p.Patient_Id__c,",
                "    --a.Patient__c,",
                "    --a.Id,",
                "    --a.Phone,",
                "    --a.MobilePhone,",
                "    --a.Product_Name__c,",
                "",
                "    --case when o.Receipt_Date__c is not null and o.Cancelled_Date1__c is null then 1 else 0 end as NR,",
                "    --case when o.CCA_Date__c is not null then 1 else 0 end as CCA,",
                "    case ",
                "            when d.[AccountName] in ('SiMaiEr Dental (HuaMao Clinic)',  'SiMaiEr Dental')",
                "            then 1",
                "            else 0",
                "        end as IsCareAbout",
                "",
                "        ,p.Id as pid",
                "from [SrcSFDC].[Lead] a",
                "inner join [SrcSFDC].[RecordType] b on a.RecordTypeId = b.Id",
                "left join  [SrcSFDC].[User] c on a.OwnerId = c.Id",
                "left join  [SrcSFDC].[UserRole] r on c.UserRoleId = r.Id",
                "left join  [DW].[DimAccount] d on a.Account__c = d.KeyAccount",
                "left join  [SrcSFDC].[Patient__c] p with(nolock) on a.Patient__c = p.Id",
                "",
                "where ",
                "a.countrycode in (select countrycode from [Custom].[GeographyHierarchy] where [RegionGroup] = 'Asia Pacific')",
                "and a.Created_Date_Time__c >= '2021-01-01'",
                "and b.Name in ('Consumer','Chinese Lead') "
              ],
              "dataSource": "DataWarehouse"
            }
          }
        ]
      },
      {
