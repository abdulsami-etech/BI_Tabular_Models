        ],
        "partitions": [
          {
            "name": "Education Events",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Value.NativeQuery(#\"OTCDM\", ",
                "\"",
                "WITH TrainingRecords as (",
                "",
                "    SELECT",
                "        'Non-EMT'               as [Event Record Type], ",
                "        tr.ID                   as [Event ID],",
                "        ",
                "        ISNULL([Country__c],'City N/A')+' - '+ISNULL(convert(nvarchar,[Event_Date__c],106),'Event Date N/A') as [Event Name],",
                "        --tr.[Name]             as [Event Name],",
                "        tr.[Event_Date__c]      as [Event Date],",
                "        tr.[Event_Type__c]      as [Event Type],",
                "        tr.[Country__c]         as [Event Country],",
                "        tr.[City__c]            as [Event City],",
                "        tr.[Speaker__c]         as [Event Speaker],",
                "        tr.[ContactID__c]       as ContactID,",
                "",
                "        2                       as TypePriority",
                "        ",
                "    FROM [SFDC_Staging].[dbo].[Training_Records__c] tr",
                "            inner join DM.DimCustContact c on c.ContactID=tr.ContactID__c",
                "    WHERE ",
                "        tr.[Training_Status__c]='Attended'",
                "        and tr.isDeleted='false'",
                "        and tr.[Event_Type__c] in ('C1','C11')",
                "        and c.ContactRegionGroup='Asia Pacific'  ",
                "",
                "),",
                "",
                "Campaigns as (",
                "",
                "SELECT ",
                "    'EMT'               as [Event Record Type],",
                "    c.[CampaignID]      as [Event ID],",
                "    c.CampaignName      as [Event Name],",
                "    c.EventDate         as [Event Date],",
                "    c.EventTypePicklist as [Event Type],",
                "    c.EventCountry      as [Event Country],",
                "    c.EventCity         as [Event City],",
                "    sp.[ContactName]    as [Event Speaker],",
                "    cont.ContactID,",
                "    1                   as TypePriority",
                "",
                "FROM [DM].[DimCampaign] c",
                "    INNER JOIN [DM].[DimCampaignMember] m on m.CampaignId=c.CampaignId",
                "    LEFT JOIN [DM].[DimCustContact] sp on sp.ContactID=c.Speaker1",
                "    LEFT JOIN [DM].[DimCustContact] cont on cont.ContactAccountNumber=m.DIDNumber and (cont.ContactRecordType='Doctor' or (cont.ContactClinID is not null) )",
                "",
                "WHERE",
                "    (c.EventTypePicklist IN ('C1','C11'))",
                "    and cont.ContactRegionGroup='Asia Pacific'",
                "    and c.IsDeleted='false'",
                "    --and c.[Status] ='Completed'",
                "    and m.IsDeleted='false'",
                "    and m.[Status] ='Attended'",
                "),",
                "",
                "AllEvents as (",
                "select",
                "    *,",
                "    row_number() over (partition by ContactID order by TypePriority, [Event Date]) as rn",
                "from ",
                "    (select * from TrainingRecords",
                "    UNION ALL",
                "    select * from Campaigns) s",
                ")",
                "",
                "select * from AllEvents where rn=1",
                "",
                "\")",
                "",
                "in",
                "    Source"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_Id",
            "value": "5458afe2-53c6-42b9-9b44-0bab2ddc79bb"
          },
          {
            "name": "LinkedQueryName",
            "value": "Education Events"
          },
          {
            "name": "PBI_QueryRelationships",
            "value": "{\"columnCount\":9,\"keyColumnNames\":[],\"queryRelationships\":[],\"columnIdentities\":[\"Section1/Education Events/Source.{Event Record Type,0}\",\"Section1/Education Events/Source.{Event ID,1}\",\"Section1/Education Events/Source.{Event Name,2}\",\"Section1/Education Events/Source.{Event Date,3}\",\"Section1/Education Events/Source.{Event Type,4}\",\"Section1/Education Events/Source.{Event Country,5}\",\"Section1/Education Events/Source.{Event City,6}\",\"Section1/Education Events/Source.{Event Speaker,7}\",\"Section1/Education Events/Source.{ContactID,8}\"],\"ColumnCount\":9,\"KeyColumnNames\":[],\"ColumnIdentities\":[\"Section1/Education Events/Source.{Event Record Type,0}\",\"Section1/Education Events/Source.{Event ID,1}\",\"Section1/Education Events/Source.{Event Name,2}\",\"Section1/Education Events/Source.{Event Date,3}\",\"Section1/Education Events/Source.{Event Type,4}\",\"Section1/Education Events/Source.{Event Country,5}\",\"Section1/Education Events/Source.{Event City,6}\",\"Section1/Education Events/Source.{Event Speaker,7}\",\"Section1/Education Events/Source.{ContactID,8}\"],\"RelationshipInfo\":[]}"
          },
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          },
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
