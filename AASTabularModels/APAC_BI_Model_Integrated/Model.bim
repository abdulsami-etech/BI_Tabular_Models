            "displayFolder": "Account Fields"
          },
          {
            "type": "calculated",
            "name": "Account Line of Business Group",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "SWITCH([Account Line of Business],",
              "",
              "BLANK()                               ,\"N/A\",",
              "\"Cadent\"                              ,\"N/A\",",
              "\"Invisalign\"                          ,\"Invisalign\",",
              "\"Invisalign Go\"                       ,\"Invisalign Go\",",
              "\"Invisalign;Cadent\"                   ,\"Invisalign\",",
              "\"Invisalign;Invisalign Go\"            ,\"Invisalign\",",
              "\"Invisalign;iTero\"                    ,\"Invisalign\",",
              "\"Invisalign;iTero;Cadent\"             ,\"Invisalign\",",
              "\"Invisalign;iTero;Invisalign Go\"      ,\"Invisalign\",",
              "\"iTero\"                               ,\"iTero\",",
              "\"iTero;Cadent\"                        ,\"iTero\",",
              "\"iTero;Cadent;Invisalign Go\"          ,\"Invisalign Go\",",
              "\"iTero;Invisalign Go\"                 ,\"Invisalign Go\",",
              "\"N/A\")",
              ""
            ],
            "displayFolder": "Account Fields"
          },
          {
            "name": "Parent Account Number",
            "dataType": "string",
            "sourceColumn": "ParentAccountNumber",
            "displayFolder": "Account Fields"
          },
          {
            "name": "Translated Address Street 1",
            "dataType": "string",
            "sourceColumn": "Translated Address Street 1",
            "displayFolder": "Account Fields\\Translated"
          },
          {
            "name": "Translated Address Street 2",
            "dataType": "string",
            "sourceColumn": "Translated Address Street 2",
            "displayFolder": "Account Fields\\Translated"
          }
        ],
        "partitions": [
          {
            "name": "Account",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Value.NativeQuery(#\"OTCDM\", ",
                "\"",
                "with",
                "acc as (",
                "    select ",
                "        a.AccountKey,",
                "        a.AccountID,",
                "        a.AccountNumber,",
                "        a.AccountOwnerID,",
                "        a.AccountName,",
                "        a.AccountRecordType,",
                "        a.AccountType,",
                "        a.AccountStatus,",
                "        a.AccountPhone,",
                "        a.AccountPostalCode,",
                "        a.AccountLineofBusiness,",
                "        a.AccountLongitude,",
                "        a.AccountLattitude,",
                "        a.AccountCity,",
                "        a.AccountCountry,",
                "        a.AccountCountryGroup,",
                "        a.AccountRegionPC,",
                "        a.AccountRegionGroup,",
                "        a.AccountCreatedDate,",
                "        a.AccountTerritoryAssignmentGrouping,",
                "        a.AccountPrivatePracticeID as AccountPPID,  ",
                "        a.AccountSubType,",
                "",
                "        a.AccountTranslatedCity,",
                "        a.AccountTranslatedName,",
                "        a.AccountTranslatedDoctorName,",
                "        a.AccountTranslatedState,",
                "",
                "        ",
                "        u.UserName as AccountOwner,  ",
                "        t.Territory2Id as TerritoryID,",
                "",
                "        sfa.Pricing_Group__c,",
                "    ",
                "        le.Apttus_Config2__Points__c                       as [Points],",
                "        le.Apttus_Config2__AdditionalPointsForNextLevel__c as [Points to Next Level],",
                "        le.Apttus_Config2__AdditionalPointsToKeepLevel__c  as [Points to Keep Level],",
                "        le.Apttus_Config2__LifetimePoints__c               as [Points Life Time],",
                "                      ",
                "        row_number() OVER (partition by a.AccountID order by le.Apttus_Config2__OverrideDate__c desc) as rn,",
                "",
                "        sfa.[City_Tier__c] as [City Tier],",
                "        sfa.[PLD__c]       as [PLID],",
                "        pg.Account_Number__c as [Pricing Group Account],",
                "        sfa.[Address_Street_1__c]+' '+sfa.[Address_Street_2__c]+', '+sfa.ShippingCity+', '+sfa.ShippingCountry as [Account Address],",
                "        par_sfa.Account_Number__c as [ParentAccountNumber],",
                "        ",
                "        sfa.[Translated_Address_Street_1__c] as [Translated Address Street 1],",
                "        sfa.[Translated_Address_Street_2__c] as [Translated Address Street 2]",
                "        ",
                "    from [DM].[DimCustAccount] a",
                "            left join [SFDC_Staging].dbo.ObjectTerritory2Association t on t.ObjectId=a.AccountID",
                "            left join DM.DimUser u on a.AccountOwnerID = u.UserId ",
                "            left join [SFDC_Staging].dbo.Account sfa on sfa.ID=a.AccountID",
                "            left join [SFDC_Staging].dbo.Account par_sfa on sfa.ParentId=par_sfa.Id",
                "            left join [SFDC_Staging].dbo.Account pg on pg.ID=sfa.Pricing_Group__c",
                "            left join [SFDC_Staging].dbo.[Apttus_Config2__IncentiveLoyaltyEnrollment__c] le ",
                "                on le.Pricing_Group__c=sfa.Pricing_Group__c",
                "                    and le.IsDeleted='false'",
                "                    and le.Apttus_Config2__Active__c='true'",
                "    where AccountRegiongroup='Asia Pacific'",
                "),",
                "",
                "acc2 as (",
                "select * from acc where rn=1",
                "),",
                "",
                "acc3 as (",
                "select",
                "    acc2.*,",
                "    le2.Account_Pricing_Group_Tremt_Loc_Country__c  as [Pricing Group Country],",
                "    le2.Apttus_Config2__CustomerType__c as [Customer Type],",
                "    le2.Apttus_Config2__StartDate__c as [Enrollment Start Date],",
                "    le2.Apttus_Config2__EndDate__c   as [Enrollment End Date],",
                "",
                "    le2.Apttus_Config2__LoyaltyLevel__c as [Loyalty Level],",
                "    le2.Apttus_Config2__LoyaltyLevelEarned__c as [Loyalty Level Earned],",
                "    le2.Apttus_Config2__LoyaltyLevelOverride__c as [Loyalty Level Override],",
                "    le2.Apttus_Config2__LoyaltyLevelInitial__c  as [Loyalty Level Initial],",
                "    le2.Apttus_Config2__OverrideReason__c       as [Loyalty Level Override Reason],",
                "    le2.Apttus_Config2__OverrideDate__c         as [Loyalty Level Override Date],",
                "",
                "    le2.Current_Advantage_Status__c           as [Current Advantage Status],",
                "    le2.Loyalty_Code__c                       as [Loyalty Code],",
                "    le2.Name                                  as [Loyalty Name],",
                "",
                "    row_number() OVER (partition by acc2.AccountID order by le2.Apttus_Config2__OverrideDate__c desc) as rn2",
                "",
                "from acc2",
                "    left join [SFDC_Staging].dbo.[Apttus_Config2__IncentiveLoyaltyEnrollment__c] le2",
                "    on ",
