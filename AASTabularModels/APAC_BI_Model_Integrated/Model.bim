          {
            "type": "calculated",
            "name": "PPID/ClinID",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "IF(",
              "       [ContactCountry]=\"China\",",
              "       IF( NOT(ISBLANK([PPID Source])) && LEFT([PPID Source],1)=\"D\" , [PPID Source], BLANK() ),",
              "       [Doctor ClinID]",
              ")",
              ""
            ],
            "displayFolder": "Contact Fields"
          },
          {
            "type": "calculated",
            "name": "Certification Date",
            "dataType": "dateTime",
            "isDataTypeInferred": true,
            "expression": [
              "CALCULATE(",
              "    MIN('2) Doctor'[Certification Date ClinID]), ",
              "    ALL('2) Doctor'), ",
              "    '2) Doctor'[PPID/ClinID]=EARLIER([PPID/ClinID])",
              "    )"
            ],
            "formatString": "dd.MM.yyyy",
            "displayFolder": "Contact Fields\\Certification Dates"
          },
          {
            "type": "calculated",
            "name": "First Ever Receipt Date",
            "dataType": "dateTime",
            "isDataTypeInferred": true,
            "expression": "CALCULATE(MIN('4) Primary Order'[Net Receipt Date]))",
            "formatString": "dd.MM.yyyy",
            "displayFolder": "Activity Dates"
          },
          {
            "type": "calculated",
            "name": "First Ever CCA Date",
            "dataType": "dateTime",
            "isDataTypeInferred": true,
            "expression": "CALCULATE(MIN('4) Primary Order'[CCADate]))",
            "formatString": "dd.MM.yyyy",
            "displayFolder": "Activity Dates"
          },
          {
            "type": "calculated",
            "name": "Last Ever Receipt Date",
            "dataType": "dateTime",
            "isDataTypeInferred": true,
            "expression": [
              "CALCULATE(MAX('4) Primary Order'[Net Receipt Date]))",
              ""
            ],
            "formatString": "dd.MM.yyyy",
            "displayFolder": "Activity Dates"
          },
          {
            "type": "calculated",
            "name": "Last Ever CCA Date",
            "dataType": "dateTime",
            "isDataTypeInferred": true,
            "expression": "CALCULATE(MAX('4) Primary Order'[CCADate]))",
            "formatString": "dd.MM.yyyy",
            "displayFolder": "Activity Dates"
          },
          {
            "type": "calculated",
            "name": "PPID First Ever Receipt Date",
            "dataType": "dateTime",
            "isDataTypeInferred": true,
            "expression": [
              "VAR ppid='2) Doctor'[PPID/ClinID]",
              "",
              "RETURN",
              "CALCULATE(",
              "    MIN('4) Primary Order'[Net Receipt Date]),",
              "    ALL('2) Doctor'),",
              "    '2) Doctor'[PPID/ClinID]=ppid",
              ")"
            ],
            "formatString": "dd.MM.yyyy",
            "displayFolder": "Activity Dates"
          },
          {
            "type": "calculated",
            "name": "PPID First Ever CCA Date",
            "dataType": "dateTime",
            "isDataTypeInferred": true,
            "expression": [
              "VAR ppid='2) Doctor'[PPID/ClinID]",
              "",
              "RETURN",
              "CALCULATE(",
              "    MIN('4) Primary Order'[CCADate]),",
              "    ALL('2) Doctor'),",
              "    '2) Doctor'[PPID/ClinID]=ppid",
              ")"
            ],
            "formatString": "dd.MM.yyyy",
            "displayFolder": "Activity Dates"
          },
          {
            "type": "calculated",
            "name": "PPID Last Ever Receipt Date",
            "dataType": "dateTime",
            "isDataTypeInferred": true,
            "expression": [
              "VAR ppid='2) Doctor'[PPID/ClinID]",
              "",
              "RETURN",
              "CALCULATE(",
              "    MAX('4) Primary Order'[Net Receipt Date]),",
              "    ALL('2) Doctor'),",
              "    '2) Doctor'[PPID/ClinID]=ppid",
              ")"
            ],
            "formatString": "dd.MM.yyyy",
            "displayFolder": "Activity Dates"
          },
          {
            "type": "calculated",
            "name": "PPID Last Ever CCA Date",
            "dataType": "dateTime",
            "isDataTypeInferred": true,
            "expression": [
              "VAR ppid='2) Doctor'[PPID/ClinID]",
              "",
              "RETURN",
              "CALCULATE(",
              "    MAX('4) Primary Order'[CCADate]),",
              "    ALL('2) Doctor'),",
              "    '2) Doctor'[PPID/ClinID]=ppid",
              ")"
            ],
            "formatString": "dd.MM.yyyy",
            "displayFolder": "Activity Dates"
          },
