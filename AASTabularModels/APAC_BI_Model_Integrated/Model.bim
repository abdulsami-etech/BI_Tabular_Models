            "dataType": "int64",
            "sourceColumn": "TreatmentKey",
            "isAvailableInMdx": false,
            "displayFolder": "Keys",
            "summarizeBy": "none"
          },
          {
            "name": "Deliverable Type Name",
            "dataType": "string",
            "sourceColumn": "Deliverable Type Name",
            "summarizeBy": "none"
          },
          {
            "name": "SAP Deliverable Type",
            "dataType": "string",
            "sourceColumn": "SAP Deliverable Type",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "SecondaryOrderLink",
            "dataType": "string",
            "isDataTypeInferred": false,
            "expression": [
              "CONCATENATE(",
              "    CONCATENATE([CustomerKey],\"|\")",
              "    ,[TreatmentKey]",
              ")"
            ],
            "displayFolder": "Keys"
          },
          {
            "name": "Usage Counter",
            "dataType": "int64",
            "sourceColumn": "Usage Counter",
            "summarizeBy": "none"
          },
          {
            "name": "PrimaryDeliverableTypeKey",
            "dataType": "int64",
            "sourceColumn": "PrimaryDeliverableTypeKey",
            "isAvailableInMdx": false,
            "displayFolder": "Keys",
            "summarizeBy": "none"
          },
          {
            "name": "PrimaryShipDate",
            "dataType": "dateTime",
            "sourceColumn": "PrimaryShipDate",
            "formatString": "dd.MM.yyyy",
            "displayFolder": "1 Order Dates"
          },
          {
            "name": "AgeTierAA",
            "dataType": "string",
            "sourceColumn": "AgeTierAA",
            "displayFolder": "Other"
          }
        ],
        "partitions": [
          {
            "name": "Secondary Order",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Value.NativeQuery(#\"OTCDM\", ",
                "\"",
                "with so as (",
                "select ",
                "    o.OrderKey,",
                "    o.TreatmentKey,",
                "    --o.ContactKey,",
                "    --o.AccountKey,",
                "    o.CustomerKey,",
                "    --o.SFDCOrderNumber,",
                "    --o.IDSOrderNumber,",
                "    o.SAPOrderNumber,",
                "    --o.CaseSetupDeliverableTypeKey,",
                "    --o.AlignerDeliverableTypeKey,",
                "    --o.CaseSetupTreatmentOptionKey,",
                "    --o.AlignerTreatmentOptionKey,",
                "    o.NewOrRestart,",
                "    o.SubmissionType,",
                "",
                "    o.SubmitDate,",
                "    o.AMRDate,",
                "    o.CCADate,",
                "    o.ShipDate,",
                "    o.PromisedCCDate,",
                "    o.PromisedShipDate,",
                "    o.FirstCCAADate,",
                "    o.FirstCCMODDate,",
                "    o.LastCCMODDate,",
                "    o.LastCCAADate,",
                "    o.LastStatusDate,",
                "    ",
                "    o.CancellationDate,",
                "    o.UpperAlignerQty,",
                "    o.LowerAlignerQty,",
                "        case when IsNull(UpperAlignerQty,0) > IsNull(LowerAlignerQty,0) then IsNull(UpperAlignerQty,0) else IsNull(LowerAlignerQty,0) end as OrderStages,",
                "    ",
                "    o.CurrentOrderStatus,",
                "    o.ScanType,",
                "    o.IsIOScan,",
                "    o.AlignerProdHierKey,",
                "    o.CaseSetupProdHierKey,",
                "    ",
                "    aad.DeliverableTypeName as [Deliverable Type Name],",
                "    aad.SAPDeliverableType as  [SAP Deliverable Type],",
                "    ",
                "    row_number() over ",
                "        (partition by o.TreatmentKey, o.AlignerTreatmentOptionKey",
                "         order by o.SAPOrderNumber) as [Usage Counter],",
                "         ",
                "    po.AlignerDeliverableTypeKey as PrimaryDeliverableTypeKey,",
                "    po.ShipDate as PrimaryShipDate,",
                "    case when o.PatientAge between 0 and 12 then 'Kids' when o.PatientAge between 13 and 19 then 'Teen' else 'Adult' end AgeTierAA",
                "      ",
                "from [DM].[DimOrder] o",
                "    inner join DM.DimCustContact c on o.ContactKey=c.ContactKey",
                "    left join Custom.testdoctors td on td.ClinID=c.ContactClinID",
                "    inner join DM.DimOrderDeliverableType aad",
                "        on aad.DeliverableTypeKey = o.AlignerDeliverableTypeKey",
                "    ",
                "    left outer join (    ",
                "            select top (1) with ties ",
                "                TreatmentKey, AlignerDeliverableTypeKey, ShipDate ",
                "            from DM.DimOrder     with (nolock)",
                "            where treatmentCategory = 'Primary'     ",
                "                and CancellationDate is null    ",
                "                and isnull([IsTestOrder], 'No')='No'  ",
                "            order by row_number() over(partition by TreatmentKey ",
                "                                    order by case when ShipDate is not null then 1 else 2 end    ",
                "                                        , SFDCOrderNumber desc)    ",
                "    ) po on o.TreatmentKey = po.TreatmentKey",
                "    ",
                "where  ",
                "     c.ContactRegionGroup='Asia Pacific' and c.ContactRecordType='Doctor' and",
                "     o.TreatmentCategory='Secondary' and",
                "     o.TreatmentKey > 1 and",
                "     ISNULL(o.IsTestOrder,'')<>'Yes' and",
                "     td.ClinID IS NULL",
                "     --and o.SubmitDate >='2011-01-01'",
                "",
                ")",
                "",
                "select * from so",
                "",
                "\"),",
                "",
                "    #\"Changed Type\" = Table.TransformColumnTypes(Source,{{\"SubmitDate\", type date}, {\"AMRDate\", type date}, {\"CCADate\", type date}, {\"CancellationDate\", type date}}),",
                "    #\"Renamed Columns\" = Table.RenameColumns(#\"Changed Type\",{{\"UpperAlignerQty\", \"Upper Aligner Qty\"}, {\"OrderStages\", \"Order Stages\"}, {\"LowerAlignerQty\", \"Lower Aligner Qty\"}, {\"CurrentOrderStatus\", \"Current Order Status\"}, {\"ScanType\", \"Order Scan Type\"}, {\"SubmissionType\", \"Order Submission Type\"}})",
                "in",
                "    #\"Renamed Columns\"",
                "",
                ""
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_Id",
            "value": "c515dbff-c1b4-42ba-9e18-ef4160b5f750"
          },
          {
            "name": "LinkedQueryName",
            "value": "4) Primary Order"
          },
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          },
          {
            "name": "PBI_QueryRelationships",
