          {
            "name": "Patient Age",
            "dataType": "int64",
            "sourceColumn": "Patient Age",
            "formatString": "0",
            "displayFolder": "Patient",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "User"
              },
              {
                "name": "Format",
                "value": "<Format Format=\"NumberWhole\" Accuracy=\"0\" />"
              },
              {
                "name": "DataTypeAtRefresh",
                "value": "Int64#####not a type"
              },
              {
                "name": "PBI_NameAtRefresh",
                "value": "Patient Age"
              },
              {
                "name": "PBI_WasHiddenAtRefresh",
                "value": "False"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Patient Age Group",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "",
              "IF( [Patient Age]>=0 && [Patient Age]<=5, \"Child(0-5)\",",
              "        IF([Patient Age]>=6 && [Patient Age]<=12,",
              "            \"Younger (6-12)\",",
              "            IF( [Patient Age]>=13 && [Patient Age]<=19,",
              "                \"Teen (13-19)\",",
              "                IF ([Patient Age]>19 && [Patient Age]<80, \"Adult (>19)\",\"Unknown\")",
              "    ",
              "              )",
              "           )",
              ")"
            ],
            "displayFolder": "Patient",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              },
              {
                "name": "Format",
                "value": "<Format Format=\"Text\" />"
              },
              {
                "name": "DataTypeAtRefresh",
                "value": "String#####not a type"
              }
            ]
          },
