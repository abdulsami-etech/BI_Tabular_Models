        ],
        "partitions": [
          {
            "name": "Primary Order",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Value.NativeQuery(#\"OTCDM\", ",
                "\"",
                "select ",
                "    o.OrderKey,",
                "    o.ContactKey,",
                "    o.AccountKey,",
                "    o.CustomerKey,",
                "    o.SFDCOrderNumber,",
                "    o.IDSOrderNumber,",
                "    o.SAPOrderNumber,",
                "    o.CaseSetupDeliverableTypeKey,",
                "    o.AlignerDeliverableTypeKey,",
                "    o.CaseSetupTreatmentOptionKey,",
                "    o.AlignerTreatmentOptionKey,",
                "    o.NewOrRestart,",
                "    o.SubmissionType,",
                "",
                "    o.SubmitDate,",
                "    o.AMRDate,",
                "    o.CCADate,",
                "    o.ShipDate,",
                "    o.PromisedCCDate,",
                "    o.PromisedShipDate,",
                "    o.FirstCCAADate,",
                "    o.FirstCCMODDate,",
                "    o.LastCCMODDate,",
                "    o.LastCCAADate,",
                "    o.LastStatusDate,",
                "    ",
                "    o.CancellationDate,",
                "    o.UpperAlignerQty,",
                "    o.LowerAlignerQty,",
                "    o.AlignerQuantity,",
                "    case when IsNull(UpperAlignerQty,0) > IsNull(LowerAlignerQty,0) then IsNull(UpperAlignerQty,0) else IsNull(LowerAlignerQty,0) end as OrderStages,",
                "    ",
                "    o.CurrentOrderStatus,",
                "    o.ScanType,",
                "    o.IsIOScan,",
                "    o.AlignerProdHierKey,",
                "    o.CaseSetupProdHierKey,",
                "    o.PatientAge,",
                "    ",
                "    o.CancelReason,",
                "",
                "    oc.IDS_Order_Status__c  as [IDS Order Status],",
                "    o.AMRDate               as [Net Receipt Date],",
                "    oc.Order_Type__c        as [Order Type],",
                "    case ",
                "        when ",
                "            IDS_Order_Status__c = '' or ",
                "            IDS_Order_Status__c is null or ",
                "            IDS_Order_Status__c = 'NA' or ",
                "            IDS_Order_Status__c  = 'MaterialsRequired' or ",
                "            IDS_Order_Status__c  = 'OrderInitiated'or ",
                "            IDS_Order_Status__c  = 'PaperFormSubmitted' or ",
                "            IDS_Order_Status__c  = 'RxFormInTranslation' or ",
                "            IDS_Order_Status__c  = 'RxFormTranslated' or ",
                "            IDS_Order_Status__c  = 'TreatmentFormSubmitted' or ",
                "            IDS_Order_Status__c  = 'ConvertOrderFromUnknown' or ",
                "            IDS_Order_Status__c  = 'OrderReleasedFromHold' ",
                "            then '1_Awaiting Patient Records' ",
                "        when ",
                "            IDS_Order_Status__c = 'AllMaterialsReceived' ",
                "            then '2_Materials Received' ",
                "        when ",
                "            IDS_Order_Status__c  = 'CCModInTranslation' or ",
                "            IDS_Order_Status__c  = 'CCModTranslated' or ",
                "            IDS_Order_Status__c  = 'ClinCheckInTranslation' or ",
                "            IDS_Order_Status__c  = 'ClinCheckModified' or ",
                "            IDS_Order_Status__c  = 'ClinCheckUnderDevelopment' or ",
                "            IDS_Order_Status__c  = 'PartialTreatmentModified' or ",
                "            IDS_Order_Status__c  = 'OrderChangeSwitch' or ",
                "            IDS_Order_Status__c  = 'MTPAcceptClinCheck' ",
                "            then '3_Modifying' ",
                "        when ",
                "            IDS_Order_Status__c = 'ClinCheckAwaitingApproval' or ",
                "            IDS_Order_Status__c  = 'RetainerAutomaticApproval' or ",
                "            IDS_Order_Status__c  = 'ClinCheckTranslated' or ",
                "            IDS_Order_Status__c  = 'GenerateMTP' ",
                "            then '5_Awaiting Approval' ",
                "        when ",
                "            IDS_Order_Status__c  = 'ClinCheckAccepted' or ",
                "            IDS_Order_Status__c  = 'ClinCheckAutoAccepted' or ",
                "            IDS_Order_Status__c  = 'ShipmentScheduled' ",
                "            then '6_Approved Awaiting Shipment' ",
                "        when ",
                "            IDS_Order_Status__c  = 'FirstSevenTreatmentPurchased' or ",
                "            IDS_Order_Status__c  = 'OrderComplete' or ",
                "            IDS_Order_Status__c  = 'ProgressScanAvailable' ",
                "            then '7_Shipped' ",
                "        when ",
                "            IDS_Order_Status__c  = 'ClinicalHold' or ",
                "            IDS_Order_Status__c  = 'CreditHold' or ",
                "            IDS_Order_Status__c  = 'UnknownOrderHold' or ",
                "            IDS_Order_Status__c  = 'CaseDoesNotQualify' ",
                "            then '8_On Hold' ",
                "        when ",
                "            IDS_Order_Status__c  = 'OrderCancelled' ",
                "            then '9_Cancelled' ",
                "        else ",
                "            IDS_Order_Status__c ",
                "        end as [PipelineStage],",
                "    case ",
                "            when ",
                "                IDS_Order_Status__c = 'ClinCheckAwaitingApproval' OR ",
                "                IDS_Order_Status__c  = 'RetainerAutomaticApproval' OR ",
                "                IDS_Order_Status__c  = 'ClinCheckTranslated' OR ",
                "                IDS_Order_Status__c  = 'GenerateMTP'  --5_Awaiting Approval ",
                "                then datediff(DAY,Clinicheck_Awaiting_Approval__c, getdate()) ",
                "            when ",
                "                IDS_Order_Status__c  = 'ClinicalHold' OR ",
                "                IDS_Order_Status__c  = 'CreditHold' OR ",
                "                IDS_Order_Status__c  = 'UnknownOrderHold' OR ",
                "                IDS_Order_Status__c  = 'CaseDoesNotQualify' --8_On Hold ",
                "                then datediff(DAY,Clinical_Hold_Date__c, getdate()) ",
                "            when ",
                "                IDS_Order_Status__c = 'AllMaterialsReceived' --2_Materials Received ",
                "                then datediff(DAY,Receipt_Date1__c,getdate()) ",
                "            when ",
                "                IDS_Order_Status__c  = 'CCModInTranslation' OR ",
                "                IDS_Order_Status__c  = 'CCModTranslated' OR ",
                "                IDS_Order_Status__c  = 'ClinCheckInTranslation' OR ",
                "                IDS_Order_Status__c  = 'ClinCheckModified' OR ",
                "                IDS_Order_Status__c  = 'ClinCheckUnderDevelopment' OR ",
                "                IDS_Order_Status__c  = 'PartialTreatmentModified' OR ",
                "                IDS_Order_Status__c  = 'OrderChangeSwitch' OR ",
                "                IDS_Order_Status__c  = 'MTPAcceptClinCheck'  --3_Modifying ",
                "                then datediff(DAY,CC_Modified_Date__c, getdate()) ",
                "            else ",
                "                -1  ",
                "        end as [Case Age],",
                "        ",
                "        o.PatientKey,",
                "        o.TreatmentKey,",
                "        oc.Patient_ID__c,",
                "        CASE p.Gender ",
                "            WHEN 'M' THEN 'Male' ",
                "            WHEN 'F' THEN 'Female' ELSE 'Unknown' ",
                "        END as [Gender],",
                "        ISNULL(age.AgeCategory,'Unknown') as [Patient Age Tier],",
                "        isnull(nullif(co.[CompanyName], N'Unknown'), N'Align Technology, Inc') as CompanyName,",
                "        o.ReClinCheckCount as [ReClinCheck Count],",
                "        ",
                "        case when calc.CCAADate is not null  ",
                "                 and o.CurrentOrderStatus = N'CCAA' ",
                "            then datediff(dd, calc.CCAADate, currday.DateKey)  ",
                "        else 10000 end as [CCAA Ageing days],",
                "",
                "        ccaa.CCAAAgeingDetail as [CCAA Ageing group]",
                "        ",
                "from [DM].[DimOrder] o",
                "    inner join DM.DimCustContact c on o.ContactKey=c.ContactKey",
                "    left join SFDC_Staging.dbo.Apttus_Config2__Order__c oc with(nolock) on o.SAPOrderNumber = oc.SAP_Order_ID__c",
                "    left join Custom.testdoctors td on td.ClinID=c.ContactClinID",
                "    left join DM.DimPatient p on p.PatientKey=o.PatientKey",
                "    left join DM.DimAge age on age.AgeKey=o.PatientAge",
                "    left join DM.DimCompany co on co.CompanyKey=o.CompanyKey",
                "    ",
                "    cross join (",
                "        select min(DateKey) as DateKey",
                "        from dsv.DimDateTime",
                "        where NASalesCurrentDay = 1",
                "    ) as currday",
                "",
                "    outer apply (",
                "    select case when convert(date, o.LastCCAADate) <= currday.DateKey",
                "                then convert(date, o.LastCCAADate) ",
                "                else convert(date, o.FirstCCAADate) ",
                "           end as CCAADate",
                "    ) as calc",
                "",
                "    left join Custom.CCAAAgingBuckets ccaa with (nolock) ",
                "        on case when calc.CCAADate is not null  ",
                "                 and o.CurrentOrderStatus = N'CCAA' ",
                "            then datediff(dd, calc.CCAADate, currday.DateKey)  ",
                "            else 10000  ",
                "       end between ccaa.RangeBegin and ccaa.RangeEnd",
                "where  ",
                "     c.ContactRegionGroup='Asia Pacific' and c.ContactRecordType in ('Doctor','Legacy')",
                "     and",
                "     o.TreatmentCategory='Primary' and",
                "     ISNULL(o.IsTestOrder,'')<>'Yes' and",
                "     td.ClinID IS NULL",
                "     and o.SubmitDate >='2011-01-01'",
                "",
                "\"),",
                "",
                "    #\"Changed Type\" = Table.TransformColumnTypes(Source,{{\"SubmitDate\", type date}, {\"AMRDate\", type date}, {\"CCADate\", type date}, {\"CancellationDate\", type date}}),",
                "    #\"Renamed Columns\" = Table.RenameColumns(#\"Changed Type\",{{\"UpperAlignerQty\", \"Upper Aligner Qty\"}, {\"OrderStages\", \"Order Stages\"}, {\"LowerAlignerQty\", \"Lower Aligner Qty\"}, {\"CurrentOrderStatus\", \"Current Order Status\"}, {\"ScanType\", \"Order Scan Type\"}, {\"SubmissionType\", \"Order Submission Type\"}, {\"PatientAge\", \"Patient Age\"}})",
                "in",
                "    #\"Renamed Columns\"",
                "",
                ""
              ]
            }
          }
        ],
        "hierarchies": [
          {
            "name": "CCAA Ageing",
            "displayFolder": "Other",
            "lineageTag": "771411b0-5b4f-4400-b76c-bd047ee72faf",
