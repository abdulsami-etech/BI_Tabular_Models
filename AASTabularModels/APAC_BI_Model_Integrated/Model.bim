          }
        ],
        "partitions": [
          {
            "name": "CE Campaigns",
            "mode": "import",
            "dataView": "full",
            "source": {
              "type": "query",
              "query": [
                "select  ",
                "                c.[Name]  as [Campaign Name]",
                "               ,c.Id        as [Campaign ID]",
                "               ,cm.Id       as [Member ID]",
                "               ,c.Program_Name__c  as [Program Name]",
                "               ,c.Event_Type_picklist__c as [Event Type PickList]",
                "               ,convert(date,c.Event_Date__c)  as [Event Date]",
                "               ,convert(date,DATEADD(day,30,c.Event_Date__c)) as [Date After 30 Days]",
                "               ,convert(date,DATEADD(day,60,c.Event_Date__c)) as [Date After 60 Days]",
                "               ,convert(date,DATEADD(day,90,c.Event_Date__c)) as [Date After 90 Days]",
                "               ,convert(date,DATEADD(day,270,c.Event_Date__c)) as [DateAfter 270 Days]",
                "               ,convert(date,DATEADD(day,360,c.Event_Date__c)) as [Date After 360 Days]",
                "               ,case when con.MailingCountry = 'China' then isnull(a.PP_ID__c, con.Clinician_ID__c) else con.Clinician_ID__c end as [Clin ID]",
                "               --,c.Sales_Region__c",
                "               --,c.Speaker__c",
                "               --,c.Speaker1__c",
                "               ,spk.[Name] as [Event Speaker]",
                "               ,case ",
                "                    when con.MailingCountry = 'China' then isnull(a.PP_ID__c,con.Clinician_ID__c)",
                "                    else con.Clinician_ID__c",
                "                end as [PPID or ClinID]",
                "               ,cm.DID_Number__c  as [DID Number]",
                "               ,cm.ContactID as [ContactID]",
                "               ,con.[Name] as [Doctor Name]",
                "               ,u.[Name] as PDM",
                "               ,con.Professional_Category__c as [Professional_Category]",
                "               ,con.EMEA_Segmentation__c as [Doctor Segment]",
                "               ,con.Line_of_Business__c as [Contact Line of Business]",
                "               ,a.Line_of_Business__c   as [Account Line of Business]",
                "               ,con.MailingCountry      as [Doctor Mailing Country]",
                "               ,rt.DeveloperName        as [Record Type]",
                "               ,c.Event_Country__c      as [Event Country]",
                "               ,cm.[Status]             as [Member Status]",
                "               ,c.Doctor_Type__c        as [Doctor Type]",
                "               ,c.Doctor_Capacity__c    as [Doctor Capacity]",
                "               ,c.Start_time__c         as [Start Time] ",
                "               ,c.End_time__c           as [End Time]",
                "               ,Event_Topic_Category__c as [Topic]",
                "               ,c.Final_Attendance__c   as [Attendance Count]",
                "               ",
                "               ,DATEDIFF(MINUTE,",
                "                        try_convert(time,start_time__c),",
                "                        try_convert(time,end_time__c)",
                "                        )/60.0  as [CE Hours]",
                "                        ",
                "          from  SrcSFDC.Campaign c with(nolock)",
                "        left join",
                "                SrcSFDC.CampaignMember cm with(nolock)",
                "            on  c.Id = cm.CampaignId",
                "        left join ",
                "                SrcSFDC.Contact con with(nolock)",
                "            on  cm.ContactId = con.Id",
                "        left join ",
                "                SrcSFDC.Account a with(nolock)",
                "            on  con.Account_Number__c = a.Account_Number__c",
                "        left join ",
                "                SrcSFDC.[User] u with(nolock)",
                "            on  u.id = a.OwnerID",
                "        inner join ",
                "                SrcSFDC.RecordType rt with(nolock)",
                "            on  rt.Id = c.RecordTypeId",
                "        left join ",
                "                SrcSFDC.Contact SPK with(nolock)",
                "            on  spk.Id = c.Speaker1__c",
                "         where  ",
                "                 c.Event_Type_picklist__c NOT LIKE 'C1%'",
                "             and c.Event_Country__c in (select CountryCode from [Custom].[GeographyHierarchy] where SecRegion = 'APAC')"
              ],
              "dataSource": "DataWarehouse"
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_DescriptionAtRefresh"
          },
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          },
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
        "name": "Continued Education Topics Filter",
        "lineageTag": "79a71009-1826-4aa7-a600-ea8fe7af8768",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Campaign ID",
            "dataType": "string",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "isHidden": true,
            "sourceColumn": "Continued Education Campaigns[Campaign ID]"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Topic Filter",
            "dataType": "string",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Topic Filter]"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Value",
            "dataType": "int64",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "isHidden": true,
            "sourceColumn": "[Value]"
          }
        ],
        "partitions": [
          {
            "name": "New Calculated Table",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "SUMMARIZE(",
                "        ADDCOLUMNS(",
                "            Filter (",
                "                Crossjoin (",
                "                    SUMMARIZE ('Continued Education Campaigns',",
                "                                'Continued Education Campaigns'[Campaign ID],",
                "                                'Continued Education Campaigns'[Topic],",
                "                                \"TopicCnt\", MAX('Continued Education Campaigns'[TopicsCount]))",
                "                    ,   ",
                "                    GENERATESERIES(1,15,1)",
                "                    ),",
                "                [Value] <= [TopicCnt]",
                "              ),",
                "            \"Topic Filter\",PATHITEM(SUBSTITUTE('Continued Education Campaigns'[Topic],\";\",\"|\"),",
                "                                   [Value])",
                "            ),",
                "    [Campaign ID],",
                "    [Topic Filter],",
                "    [Value]",
                ")",
                ""
              ]
            }
          }
        ]
      },
