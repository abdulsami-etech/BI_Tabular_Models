            "name": "CCA @ 30 Days",
            "dataType": "int64",
            "isDataTypeInferred": false,
            "expression": [
              "",
              "IF (",
              "    [Days After Cert]>=30,",
              "",
              "    VAR endday=[Cert Date]+30",
              "    RETURN",
              "        CALCULATE( [CCA],",
              "                    ALLEXCEPT('Fact Activation','Fact Activation'[ContactID]),",
              "                    '1) Reporting Calendar'[Date]>=EARLIER([Cert Date]) && '1) Reporting Calendar'[Date]<=endday),",
              "    BLANK()",
              ")"
            ],
