                "    ,[CustomerSupport_Effectiveness_to_resolve_request]",
                "    ,[Customer_Support_Issue_Description]",
                "    ,[Customer_Support_Final_Comment]",
                "    ,[Customer_Support_Final_Comment_Translated]",
                "    ,[align_rel_territorymgrname]",
                "    ,[align_cc_ordernum_text]",
                "    ,[align_cc_id_text]",
                "    ,[align_cc_version]",
                "    ,[align_cc_action_enum]",
                "    ,[cc_initial_setup_rating_enum]",
                "    ,[comments]",
                "    ,[alert_date_closed]",
                "    ,[Permission_To_Contact]",
                "    ,[align_cc_accepted_cases_12_months_integer]",
                "    ,[align_total_cc_orders_integer]",
                "    ,[align_alert_resolution_time]",
                "    ",
                "    ,c.[ProfessionalCategory]",
                "    ,c.[ClinID]",
                "    ,c.[ContactName]",
                "    ,c.[MailingCountry]",
                "    ,c.[MailingRegionPC]",
                "    ,c.[MailingRegionGroup]",
                "from md s",
                "    left join DW.DimContact c on s.[align_doctorid_text]=c.[PrimaryAccountNumber]",
                "where s.[align_doctorid_text] is not null",
                "and [MailingRegionGroup]='Asia Pacific'",
