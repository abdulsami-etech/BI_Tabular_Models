        "partitions": [
          {
            "name": "DimMeasures",
            "source": {
              "type": "query",
              "query": [
                "Select 10 as MeasureKey, 'Gross Receipts' as [Measure Name],  'Gross Receipts' as [Measure Group], 'Volume Measures' as [Measure Folder], '[Gross Receipts]' as [Measure String],'#,###' as FormatString",
                "union",
                "Select 20 as MeasureKey, 'Net Receipts' as [Measure Name],  'Net Receipts' as [Measure Group], 'Volume Measures' as [Measure Folder], '[Net Receipts]' as [Measure String],'#,###' as FormatString",
                "union",
                "Select 30 as MeasureKey, 'CCA' as [Measure Name],  'CCA' as [Measure Group], 'Volume Measures'  as [Measure Folder], '[CCA]'  as [Measure String],'#,###' as FormatString",
                "union",
                "Select 40 as MeasureKey, 'Shipments' as [Measure Name],  'Shipments'  as [Measure Group], 'Volume Measures'  as [Measure Folder], '[Shipments]'  as [Measure String],'#,###' as FormatString",
                "union ",
                "Select 50 as MeasureKey, 'Actual Cancellations' as [Measure Name],  'Actual Cancellations'  as [Measure Group], 'Volume Measures'  [Measure Folder], '[Actual Cancellations]'  as [Measure String],'#,###' as FormatString",
                "union",
                "Select 60 as MeasureKey, 'All Cancellations' as [Measure Name],  'All Cancellations'  as [Measure Group], 'Volume Measures'  [Measure Folder], '[All Cancellations]'  as [Measure String],'#,###' as FormatString",
                "union",
                "Select 70 as MeasureKey, 'ClinCheck Postings' as [Measure Name],  'ClinCheck Postings'  as [Measure Group], 'Volume Measures'  [Measure Folder], '[ClinCheck Postings]'  as [Measure String],'#,###' as FormatString",
                "union",
                "Select 80 as MeasureKey, 'Total Aligner Quantity' as [Measure Name],  'Total Aligner Quantity'  as [Measure Group], 'Volume Measures'  [Measure Folder], '[Total Aligner Quantity]'  as [Measure String],'#,###' as FormatString",
                "union",
                "Select 90 as MeasureKey, 'Total Deliverable Quantity' as [Measure Name],  'Total Deliverable Quantity'  as [Measure Group], 'Volume Measures'  [Measure Folder], '[Total Deliverable Quantity]'  as [Measure String],'#,###' as FormatString",
                "union",
                "Select 100 as MeasureKey, 'Gross Gross Receipts' as [Measure Name],  'Gross Gross Receipts' as [Measure Group], 'Volume Measures' as [Measure Folder], '[Gross Gross Receipts]' as [Measure String],'#,###' as FormatString",
                "",
                "",
                "",
                " "
              ],
              "dataSource": "ADW_DataSource"
            },
            "annotations": [
              {
