        "partitions": [
          {
            "name": "Plant",
            "source": {
              "type": "query",
              "query": [
                "select  Plant, [Plant Text] as [Plant Name],[Country Key] as CountryCode, g.Country, g.CountryGroup, g.RegionPC, g.RegionGroup, g.SecRegion ",
                "from tabsap.dimPlant p",
                "left join custom.GeographyHierarchy g on",
                "g.CountryCode= p.[Country Key]",
                "where plant in (select distinct werks from SrcSAP.LIPS where pstyv='Z001')",
                "order by 1",
                ""
              ],
              "dataSource": "ADW_DataSource"
            },
