              "                            else 'Future Years' ",
              "                            end",
              "    from DW.DimDate  dt",
              "    inner join diff on diff.KeyDate = dt.KeyDate",
              "    where skdate>='20200101'"
            ]
          },
          {
            "name": "QueryEditorSerialization",
            "value": [
              "<?xml version=\"1.0\" encoding=\"UTF-16\"?><Gemini xmlns=\"QueryEditorSerialization\"><AnnotationContent><![CDATA[<RSQueryCommandText>Declare @CurrentDateOverride date ",
