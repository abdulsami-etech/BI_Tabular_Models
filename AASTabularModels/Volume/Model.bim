        "partitions": [
          {
            "name": "LastRefreshTimeStmap",
            "dataView": "full",
            "source": {
              "type": "query",
              "query": [
                "select max(ADLSTimeStmap ) AT TIME ZONE 'UTC' AT TIME ZONE 'Pacific standard time'      as LastRefreshTime , max(ADLSTimeStmap ) AS LastRefreshTimeUTC ",
                "from (",
                " select max(ADLSTimeStamp)  ADLSTimeStmap   from SrcSAP.LIPS sfo  with (nolock)",
                " union all",
                " select max(ADLSTimeStamp)  ADLSTimeStmap from SrcMESCorp.uda_order uo  with (nolock)",
                " union all",
                " select max(ADLSTimeStamp)  ADLSTimeStmap from SrcIDS.tblPuOrderStatusHistory  with (nolock)",
                " union all",
                " select max(ADLSTimeStamp)  ADLSTimeStmap from SrcSFDC.Apttus_Config2__Order__C  with (nolock)",
                " ) ADLSTimeStmap",
                "",
                " "
              ],
              "dataSource": "ADW_DataSource"
            },
            "annotations": [
              {
                "name": "QueryEditorSerialization",
                "value": [
                  "<?xml version=\"1.0\" encoding=\"UTF-16\"?><Gemini xmlns=\"QueryEditorSerialization\"><AnnotationContent><![CDATA[<RSQueryCommandText>select min(ADLSTimeStmap ) AT TIME ZONE 'UTC' AT TIME ZONE 'Pacific standard time'      as LastRefreshTime  from (",
                  " select max(ADLSTimeStamp)  ADLSTimeStmap   from SrcSFDC.Apttus_Config2__Order__c sfo  with (nolock)",
                  " union all",
                  " select max(ADLSTimeStamp)  ADLSTimeStmap from SrcMESCorp.uda_order uo  with (nolock)",
                  " union all",
