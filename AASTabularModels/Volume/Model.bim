      {
        "name": "Time Moving",
        "isHidden": true,
        "calculationGroup": {
          "precedence": 20,
          "calculationItems": [
            {
              "name": "Current",
              "description": "Current",
              "expression": "SELECTEDMEASURE()",
              "ordinal": 0
            },
            {
              "name": "MTD",
              "expression": [
                "IF (",
                "    OR (",
                "        ISINSCOPE ( 'DimDate'[DateKey] ),",
                "        ISINSCOPE ( 'DimDate'[MonthNameNumeric] )",
                "    ),",
                "    CALCULATE ( SELECTEDMEASURE (), DATESMTD ( 'DimDate'[DateKey] ) ),",
                "    BLANK ()",
                ")"
              ],
              "ordinal": 1
            },
            {
              "name": "QTD",
              "expression": [
                "IF (",
                "    ISINSCOPE ( 'DimDate'[DateKey] ) || ISINSCOPE ( 'DimDate'[MonthNameNumeric] )",
                "        || ISINSCOPE ( 'DimDate'[QuarterNameShort] ),",
                "    //IF (",
                "    //    SELECTEDVALUE ( 'DimDate'[MonthType] ) = \"Future Months\",",
                "    //    BLANK (),",
                "    CALCULATE (",
                "        SELECTEDMEASURE (),",
                "        DATESQTD ( 'DimDate'[DateKey] )",
                "    ) //)",
                "    ,",
                "    BLANK ()",
                ")"
              ],
              "ordinal": 2
            },
            {
              "name": "YTD",
              "expression": [
                "CALCULATE (",
                "        SELECTEDMEASURE (),",
                "        DATESYTD ( 'DimDate'[DateKey] )",
                "    )"
              ],
              "ordinal": 3
            }
          ]
        },
        "columns": [
          {
            "name": "To Date",
            "dataType": "string",
            "sourceColumn": "Name",
            "sortByColumn": "Ordinal"
          },
          {
            "name": "Ordinal",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "Ordinal"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "mode": "import",
            "source": {
              "type": "calculationGroup"
            }
          }
        ]
      },
      {
        "name": "Time Compare",
        "isHidden": true,
        "calculationGroup": {
          "precedence": 10,
          "calculationItems": [
            {
              "name": "Current",
              "description": "Current",
              "expression": "SELECTEDMEASURE()",
              "ordinal": 0
            },
            {
              "name": "LY",
              "expression": "CALCULATE ( SELECTEDMEASURE (), DATEADD ( 'DimDate'[DateKey], -1, YEAR ) )",
              "ordinal": 1
            },
            {
              "name": "YoY",
              "expression": [
                "VAR CurrentMeasure =",
                "    SELECTEDMEASURE ()",
                "VAR PriorMeasure =",
                "    CALCULATE ( SELECTEDMEASURE (), 'Time Compare'[Time Compare] = \"LY\" )",
                "RETURN",
                "    IF (",
                "        CurrentMeasure = BLANK ()",
                "            || PriorMeasure = BLANK (),",
                "        BLANK (),",
                "        CurrentMeasure - PriorMeasure",
                "    )"
              ],
              "ordinal": 2
            },
            {
              "name": "YoY%",
              "expression": [
                "VAR YoY =",
                "    CALCULATE ( SELECTEDMEASURE (), 'Time Compare'[Time Compare] = \"YOY\" )",
                "VAR LY =",
                "    CALCULATE ( SELECTEDMEASURE (), 'Time Compare'[Time Compare] = \"LY\" )",
                "RETURN",
                "    DIVIDE ( YOY, LY )"
              ],
              "ordinal": 3,
              "formatStringDefinition": {
                "expression": " \"0.00%;-0.00%;0.00%\""
              }
            }
          ]
        },
        "columns": [
          {
            "name": "Time Compare",
            "dataType": "string",
            "sourceColumn": "Name",
            "sortByColumn": "Ordinal"
          },
          {
            "name": "Ordinal",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "Ordinal"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "mode": "import",
            "source": {
              "type": "calculationGroup"
            }
          }
        ]
      }
