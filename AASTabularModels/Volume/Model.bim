            "sourceColumn": "CCPostingDate",
            "formatString": "mm/dd/yyyy",
            "isAvailableInMdx": false,
            "sourceProviderType": "date"
          },
          {
            "name": "CCPostingsCount",
            "dataType": "int64",
            "isHidden": true,
