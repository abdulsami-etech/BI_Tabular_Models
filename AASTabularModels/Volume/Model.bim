        "partitions": [
          {
            "name": "Volume_CQ",
            "source": {
              "type": "query",
              "query": [
                "  Declare @StartDate Date,@EndDate Date",
                "  select top 1 @StartDate= QuarterStartDate , @EndDate = DateAdd(day,1,QuarterEndDate)",
                "  from dw.dimdatetime where QuarterType = 'Current Quarter'",
                "",
                "  select  TreatmentCategory,Convert(bigint,SAPOrderNumber) as SAPOrderNumber, SKOrderStatus, StatusDate, CountryCode, NewOrRestart, Convert(int,Plant) Plant, ProductHierarchy, TreatmentOption, DeliverableType, TotalAlignerQuantity,DeliverableQuantity,StatusCount ",
                "  from dw.factVolume",
                "  where TreatmentCategory='Primary'  and IsKeyStatus=1 and SKOrderStatus in (40,80,100,108,110,118)",
                "  and StatusDate >=@StartDate and StatusDate < @EndDate",
                ""
              ],
              "dataSource": "ADW_DataSource"
            },
            "annotations": [
              {
                "name": "TabularEditor_TableSchema",
                "value": "{\"Name\":\"DimCountry\",\"Schema\":\"DW\",\"Database\":\"pralignbidw\",\"IncludedColumns\":[\"SKCountry\",\"CountryCode\",\"CountryName\",\"CountryGroup\",\"Region\",\"RegionGroup\",\"GlobalRegion\",\"iTeroReportingRegion\",\"SKCountry\",\"CountryCode\",\"CountryName\",\"CountryGroup\",\"Region\",\"RegionGroup\",\"GlobalRegion\",\"iTeroReportingRegion\"],\"SelectAll\":true}"
              }
            ]
          },
          {
            "name": "Volume_PQ",
            "source": {
              "type": "query",
              "query": [
                "  Declare @StartDate Date,@EndDate Date",
                "  select top 1 @StartDate= QuarterStartDate , @EndDate = DateAdd(day,1,QuarterEndDate)",
                "  from dw.dimdatetime where QuarterType = 'Prior Quarter'",
                "",
                "  select  TreatmentCategory,Convert(bigint,SAPOrderNumber) as SAPOrderNumber, SKOrderStatus, StatusDate, CountryCode, NewOrRestart, Convert(int,Plant) Plant, ProductHierarchy, TreatmentOption, DeliverableType, TotalAlignerQuantity,DeliverableQuantity,StatusCount ",
                "  from dw.factVolume",
                "  where TreatmentCategory='Primary'  and IsKeyStatus=1 and SKOrderStatus in (40,80,100,108,110,118)",
                "  and StatusDate >=@StartDate and StatusDate < @EndDate",
                ""
              ],
              "dataSource": "ADW_DataSource"
            },
            "annotations": [
              {
                "name": "TabularEditor_TableSchema",
                "value": "{\"Name\":\"DimCountry\",\"Schema\":\"DW\",\"Database\":\"pralignbidw\",\"IncludedColumns\":[\"SKCountry\",\"CountryCode\",\"CountryName\",\"CountryGroup\",\"Region\",\"RegionGroup\",\"GlobalRegion\",\"iTeroReportingRegion\",\"SKCountry\",\"CountryCode\",\"CountryName\",\"CountryGroup\",\"Region\",\"RegionGroup\",\"GlobalRegion\",\"iTeroReportingRegion\"],\"SelectAll\":true}"
              }
            ]
          },
          {
            "name": "Volume_History",
            "source": {
              "type": "query",
              "query": [
                "  Declare @StartDate Date,@EndDate Date",
                "  select top 1 @StartDate= min(DateKey) , @EndDate = DateAdd(day,1,Max(DateKey))",
                "  from dw.dimdatetime where YearType = 'Prior Year'",
                "  ",
                "  ",
                "  select  TreatmentCategory,Convert(bigint,SAPOrderNumber) as SAPOrderNumber, SKOrderStatus, StatusDate, CountryCode, NewOrRestart, Convert(int,Plant) Plant, ProductHierarchy, TreatmentOption, DeliverableType, TotalAlignerQuantity,DeliverableQuantity,StatusCount ",
                "  from dw.factVolume",
                "  where TreatmentCategory='Primary'  and IsKeyStatus=1 and SKOrderStatus in (40,80,100,108,110,118)",
                "  --and StatusDate >=@LyQtrStartDate and StatusDate <@ToDate",
                "  and StatusDate >=@StartDate and StatusDate <@EndDate",
                ""
              ],
              "dataSource": "ADW_DataSource"
            },
            "annotations": [
              {
                "name": "TabularEditor_TableSchema",
                "value": "{\"Name\":\"DimCountry\",\"Schema\":\"DW\",\"Database\":\"pralignbidw\",\"IncludedColumns\":[\"SKCountry\",\"CountryCode\",\"CountryName\",\"CountryGroup\",\"Region\",\"RegionGroup\",\"GlobalRegion\",\"iTeroReportingRegion\",\"SKCountry\",\"CountryCode\",\"CountryName\",\"CountryGroup\",\"Region\",\"RegionGroup\",\"GlobalRegion\",\"iTeroReportingRegion\"],\"SelectAll\":true}"
              }
            ]
          }
        ],
        "measures": [
          {
            "name": "All Cancellations",
            "expression": [
              "VAR varAllCancellations =",
              "    CALCULATE ( SUM ( 'FactVolume'[StatusCount] ), 'FactVolume'[SKOrderStatus] = 108 )",
              "RETURN",
              "    SWITCH ( [SelectedScen], \"Actual\", varAllCancellations )"
            ],
            "formatString": "#,0",
            "displayFolder": "Measures\\Key Volume KPIs"
          },
          {
            "name": "Gross CCA",
            "expression": [
              "",
              "VAR varGrossCCA =",
              "    CALCULATE ( SUM ( 'FactVolume'[StatusCount] ), 'FactVolume'[SKOrderStatus] = 100 )",
              "RETURN",
              "    SWITCH ( [SelectedScen], \"Actual\", varGrossCCA )"
            ],
            "formatString": "#,0",
            "isHidden": true,
            "displayFolder": "Measures\\Key Volume KPIs"
          },
          {
            "name": "CCA",
            "description": "Count of ClinCheck Accepted Cases by Doctor in a given period after removing any cancellations after CCA",
            "expression": [
              "VAR varCCA = [Gross CCA] - [Restricted Cancellations]",
              "VAR varCCAFcst =",
              "    CALCULATE ( SUM ( 'Forecast'[Value] ), 'Forecast'[Measure] = \"CCA\" )",
              "RETURN",
              "    SWITCH (",
              "        [SelectedScen],",
              "        \"Actual\", varCCA,",
              "        \"Forecast\", CALCULATE ( varCCAFcst, 'Scenario'[Scenario] = \"Forecast\" ),",
              "        \"AOP\", CALCULATE ( varCCAFcst, 'Scenario'[Scenario] = \"AOP\" ),",
              "        \"LE\", CALCULATE ( varCCAFcst, 'Scenario'[Scenario] = \"LE\" )",
              "    )"
            ],
            "formatString": "#,0",
            "displayFolder": "Measures\\Key Volume KPIs"
          },
          {
            "name": "Restricted Cancellations",
            "expression": [
              "",
              "VAR varRestrictedCancellations =",
              "    CALCULATE ( SUM ( 'FactVolume'[StatusCount] ), 'FactVolume'[SKOrderStatus] = 118 )",
              "RETURN",
              "    SWITCH ( [SelectedScen], \"Actual\", varRestrictedCancellations )"
            ],
            "formatString": "#,0",
            "displayFolder": "Measures\\Key Volume KPIs"
          },
          {
            "name": "Shipments",
            "expression": [
              "",
              "VAR varShipments =",
              "    CALCULATE ( SUM ( 'FactVolume'[StatusCount] ), 'FactVolume'[SKOrderStatus] = 110 )",
              "VAR varShipmentsFcst =",
              "    CALCULATE ( SUM ( 'Forecast'[Value] ), 'Forecast'[Measure] = \"Shipments\" )",
              "RETURN",
              "    SWITCH (",
              "        [SelectedScen],",
              "        \"Actual\", varShipments,",
              "        \"Forecast\", CALCULATE ( varShipmentsFcst, 'Scenario'[Scenario] = \"Forecast\" ),",
              "        \"AOP\", CALCULATE ( varShipmentsFcst, 'Scenario'[Scenario] = \"AOP\" ),",
              "        \"LE\", CALCULATE ( varShipmentsFcst, 'Scenario'[Scenario] = \"LE\" )",
              "    )"
            ],
            "formatString": "#,0",
            "displayFolder": "Measures\\Key Volume KPIs"
          },
          {
            "name": "Net Receipts",
            "expression": [
              "VAR varNR = [Gross Gross Receipts] - [All Cancellations]",
              "VAR varNRFcst =",
              "    CALCULATE ( SUM ( 'Forecast'[Value] ), 'Forecast'[Measure] = \"Net Receipts\" )",
              "RETURN",
              "    SWITCH (",
              "        [SelectedScen],",
              "        \"Actual\", varNR,",
              "        \"Forecast\", CALCULATE ( varNRFcst, 'Scenario'[Scenario] = \"Forecast\" ),",
              "        \"AOP\", CALCULATE ( varNRFcst, 'Scenario'[Scenario] = \"AOP\" ),",
              "        \"LE\", CALCULATE ( varNRFcst, 'Scenario'[Scenario] = \"LE\" )",
              "    )"
            ],
            "formatString": "#,0",
            "displayFolder": "Measures\\Key Volume KPIs"
          },
          {
            "name": "Value",
            "description": "Use this measure along with DimMeasures Measure Name attribute to allow Measure names in slicers",
            "expression": [
              "VAR varSelectedValue =",
              "    SELECTEDVALUE ( 'DimMeasures'[MeasureKey], 10 )",
              "RETURN",
              "    ",
              "SWITCH (",
              "    varSelectedValue,",
              "    10, [Gross Receipts],",
              "    20, [Net Receipts],",
              "    30, [CCA],",
              "    40, [Shipments],",
              "    50, [Actual Cancellations],",
              "    60, [All Cancellations],",
              "    70, [ClinCheck Postings],",
              "    80, [Total Aligner Quantity],",
              "    90, [Total Deliverable Quantity],",
              "    100, [Gross Gross Receipts]",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "Measures\\Others"
          },
          {
            "name": "Restarts",
            "description": "Count of Duplicate Primary Orders for the same Patient with an AMR Date submitted after cancelling previously submitted Order with Cancellation date in the same Quarter as Duplicate order",
            "expression": [
              "VAR varRestarts =",
              "    CALCULATE (",
              "        SUM ( 'FactVolume'[StatusCount] ),",
              "        'FactVolume'[SKOrderStatus] = 80,",
              "        'FactVolume'[NewOrRestart] = \"Restart\"",
              "    )",
              "RETURN",
              "    SWITCH ( [SelectedScen], \"Actual\", varRestarts )"
            ],
            "formatString": "#,0",
            "displayFolder": "Measures\\Key Volume KPIs"
          },
          {
            "name": "Gross Receipts",
            "expression": [
              "VAR varGR = [Gross Gross Receipts] - [Restarts]",
              "VAR varGRFcst =",
              "    CALCULATE ( SUM ( 'Forecast'[Value] ), 'Forecast'[Measure] = \"Gross Receipts\" )",
              "RETURN",
              "    SWITCH (",
              "        [SelectedScen],",
              "        \"Actual\", varGR,",
              "        \"Forecast\", CALCULATE ( varGRFcst, 'Scenario'[Scenario] = \"Forecast\" ),",
              "        \"AOP\", CALCULATE ( varGRFcst, 'Scenario'[Scenario] = \"AOP\" ),",
              "        \"LE\", CALCULATE ( varGRFcst, 'Scenario'[Scenario] = \"LE\" )",
              "    )"
            ],
            "formatString": "#,0",
            "displayFolder": "Measures\\Key Volume KPIs"
          },
          {
            "name": "Gross Gross Receipts",
            "description": "Count of All Primary Orders with an AMR Date",
            "expression": [
              "",
              "VAR varGGR =",
              "    CALCULATE ( SUM ( 'FactVolume'[StatusCount] ), 'FactVolume'[SKOrderStatus] = 80 )",
              "RETURN",
              "    SWITCH ( [SelectedScen], \"Actual\", varGGR )"
            ],
            "formatString": "#,0",
            "displayFolder": "Measures\\Key Volume KPIs"
          },
          {
            "name": "Total Aligner Quantity",
            "expression": [
              "",
              "VAR varTotAlignerQty =",
              "    CALCULATE (",
              "        SUM ( 'FactVolume'[TotalAlignerQuantity] ),",
              "        'FactVolume'[SKOrderStatus] = 110",
              "    )",
              "RETURN",
              "   SWITCH ( [SelectedScen], \"Actual\", varTotAlignerQty )"
            ],
            "formatString": "#,0",
            "displayFolder": "Measures\\Key Volume KPIs"
          },
          {
            "name": "ClinCheck Postings",
            "expression": [
              "",
              "VAR varCCPostings =",
              "    SUM ( 'CCPostings'[CCPostingsCount] )",
              "RETURN",
              "    SWITCH ( [SelectedScen], \"Actual\", varCCPostings )"
            ],
            "formatString": "#,0",
            "displayFolder": "Measures\\Key Volume KPIs"
          },
          {
            "name": "Actual Cancellations",
            "expression": [
              "VAR varActCancellations = [All Cancellations] - [Restarts]",
              "RETURN",
              "    SWITCH ( [SelectedScen], \"Actual\", varActCancellations )"
            ],
            "formatString": "#,0",
            "displayFolder": "Measures\\Key Volume KPIs"
          },
          {
            "name": "Total Deliverable Quantity",
            "expression": [
              "",
              "VAR varDeliverableAlignerQty =",
              "    CALCULATE (",
              "        SUM ( 'FactVolume'[DeliverableQuantity] ),",
              "        'FactVolume'[SKOrderStatus] = 110",
              "    )",
              "RETURN",
              "    SWITCH ( [SelectedScen], \"Actual\", varDeliverableAlignerQty )"
            ],
            "formatString": "#,0",
            "displayFolder": "Measures\\Key Volume KPIs"
          },
          {
            "name": "CCALF",
            "description": "CCA Load factor",
            "expression": [
              "",
              "VAR LastDayInSelection =",
              "    LASTNONBLANK ( DimDate[DateKey], CALCULATE ( SUM ( LoadFactor[LoadFactor] ) ) )",
              "RETURN",
              "    LOOKUPVALUE (",
              "        LoadFactor[LoadFactor],",
              "        LoadFactor[Measure], \"CCA\",",
              "        LoadFactor[Date], LastDayInSelection",
              "    )"
            ],
            "formatString": "#,##0.000000000",
            "displayFolder": "Measures\\Load Factors"
          },
          {
            "name": "NRLF",
            "description": "Net Receipts Load Factor",
            "expression": [
              "",
              "VAR LastDayInSelection =",
              "    LASTNONBLANK ( DimDate[DateKey], CALCULATE ( SUM ( LoadFactor[LoadFactor] ) ) )",
              "RETURN",
              "    LOOKUPVALUE (",
              "        LoadFactor[LoadFactor],",
              "        LoadFactor[Measure], \"Net Receipts\",",
              "        LoadFactor[Date], LastDayInSelection",
              "    )"
            ],
            "formatString": "#,##0.000000000",
            "displayFolder": "Measures\\Load Factors"
          },
          {
            "name": "GRLF",
            "description": "Gross Receipts Load Factor",
            "expression": [
              "",
              "VAR LastDayInSelection =",
              "    LASTNONBLANK ( DimDate[DateKey], CALCULATE ( SUM ( LoadFactor[LoadFactor] ) ) )",
              "RETURN",
              "    LOOKUPVALUE (",
              "        LoadFactor[LoadFactor],",
              "        LoadFactor[Measure], \"Gross Receipts\",",
              "        LoadFactor[Date], LastDayInSelection",
              "    )"
            ],
            "formatString": "#,##0.000000000",
            "displayFolder": "Measures\\Load Factors"
          },
          {
            "name": "ShipLF",
            "description": "Shipments Load Factor",
            "expression": [
              "",
              "VAR LastDayInSelection =",
              "    LASTNONBLANK ( DimDate[DateKey], CALCULATE ( SUM ( LoadFactor[LoadFactor] ) ) )",
              "RETURN",
              "    LOOKUPVALUE (",
              "        LoadFactor[LoadFactor],",
              "        LoadFactor[Measure], \"Shipments\",",
              "        LoadFactor[Date], LastDayInSelection",
              "    )"
            ],
            "formatString": "#,##0.000000000",
            "displayFolder": "Measures\\Load Factors"
          },
          {
            "name": "SelectedScen",
            "expression": "SELECTEDVALUE ( 'Scenario'[Scenario], \"Actual\" )",
            "isHidden": true,
            "displayFolder": "Measures\\Others"
          }
        ]
      },
