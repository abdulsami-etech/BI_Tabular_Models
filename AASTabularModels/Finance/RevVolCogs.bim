          {
            "name": "Clear Aligner Shipments",
            "expression": [
              " CALCULATE([Volume Count],FILTER(Shipment, Shipment[Product Hierarchy] IN { \"A1A1T1C101\",\"A1A1T1C102\",\"A1A1T1C10301\",\"A1A1T1C104\",\"A1A1T1C105\",\"A1A1T1C106\",",
              "\"A1A1T1C107\",\"A1A1T1C2E101\",\"A1A1T1C2E102\",\"A1A1T1C2E103\",\"A1A1T1C2G1\",\"A1A1T1C2G2\"",
              ",\"A1A1T1C2G3\",\"A1A1T1C2L1\",\"A1A1T1C2L101\",\"A1A1T1C2L102\",\"A1A1T1C2L104\",\"A1A1T1C2M1\",\"A1A1T1C2M101\",",
              "\"A1A1T1C2N1\",\"A1A1T1C2S1\",\"A1A1T1C2S201\",\"A1A1T1C2S202\",\"A1A1T1C2S301\"}  ))"
            ],
            "isHidden": true
          },
          {
            "name": "Discount",
            "expression": " CALCULATE(SUM(Revenue[COPA Revenue]), FILTER('Cost Element', 'Cost Element'[Level 4]=\"Sales Discounts and Rebates\"))",
            "isHidden": true
          },
          {
            "name": "Discount%",
            "expression": " ([Discount]*-1/[CO-PA Revenue])*100",
            "isHidden": true
          },
          {
            "name": "PreviousShipmentYr",
            "expression": " CALCULATE([Volume Count], FILTER('Time', 'Time'[Fiscal Year]=(YEAR(TODAY())-1)))",
            "isHidden": true
          },
          {
            "name": "Revenue YTD",
            "expression": "CALCULATE(SUM(Revenue[COPA Revenue]),FILTER('Time','Time'[Date]>=DATE(YEAR(TODAY()),1,1) && 'Time'[Date]<= TODAY()))",
            "isHidden": true
          },
          {
            "name": "Shipment YTD",
            "expression": "CALCULATE(COUNT(Shipment[Delivery]),FILTER('Time','Time'[Date]>=DATE(YEAR(TODAY()),1,1) && 'Time'[Date]<= TODAY()))",
            "isHidden": true
          },
