              "AND(ISINSCOPE('Profit Center'[Level  2 S.]), ISBLANK(VALUES('Profit Center'[Level  2 S.]))), BLANK(),",
              "",
              "AND(ISINSCOPE('Profit Center'[Level 3 S.]), ISBLANK(VALUES('Profit Center'[Level 3 S.]))), BLANK(),",
              "",
              "AND(ISINSCOPE('Profit Center'[Level 4 S.]), ISBLANK(VALUES('Profit Center'[Level 4 S.]))), BLANK(),",
              "",
              "AND(ISINSCOPE('Profit Center'[Level 5 S.]), ISBLANK(VALUES('Profit Center'[Level 5 S.]))), BLANK(),",
              "",
              "AND(ISINSCOPE('Profit Center'[Level 6 S.]), ISBLANK(VALUES('Profit Center'[Level 6 S.]))), BLANK(),",
              "",
              "AND(ISINSCOPE('Profit Center'[Level 7 S.]), ISBLANK(VALUES('Profit Center'[Level 7 S.]))), BLANK(),",
              "",
              "/*Alternate Profit Center Hierarchy*/",
              "",
              "/*AND(ISINSCOPE('Profit Center'[Level 1 A]), ISBLANK(VALUES('Profit Center'[Level 1 A]))), BLANK(),*/",
              "",
              "AND(ISINSCOPE('Profit Center'[Level2A]), ISBLANK(VALUES('Profit Center'[Level2A]))), BLANK(),",
              "",
              "AND(ISINSCOPE('Profit Center'[Level3A]), ISBLANK(VALUES('Profit Center'[Level3A]))), BLANK(),",
              "",
              "AND(ISINSCOPE('Profit Center'[Level4A]), ISBLANK(VALUES('Profit Center'[Level4A]))), BLANK(),",
              "",
              "AND(ISINSCOPE('Profit Center'[Level5A]), ISBLANK(VALUES('Profit Center'[Level5A]))), BLANK(),",
              "",
              "AND(ISINSCOPE('Profit Center'[Level6A]), ISBLANK(VALUES('Profit Center'[Level6A]))), BLANK(),",
              "",
              "/*Cost Element Hierarchy*/",
              "",
              "/*AND(ISINSCOPE('Cost Element'[Level 1]), ISBLANK(VALUES('Cost Element'[Level 1]))), BLANK(),*/",
              "",
              "AND(ISINSCOPE('Cost Element'[Level 2S]), ISBLANK(VALUES('Cost Element'[Level 2S]))), BLANK(),",
              "",
              "AND(ISINSCOPE('Cost Element'[Level 3S]), ISBLANK(VALUES('Cost Element'[Level 3S]))), BLANK(),",
              "",
              "AND(ISINSCOPE('Cost Element'[Level 4S]), ISBLANK(VALUES('Cost Element'[Level 4S]))), BLANK(),",
              "",
              "AND(ISINSCOPE('Cost Element'[Level 5S]), ISBLANK(VALUES('Cost Element'[Level 5S]))), BLANK(),",
              "",
              "AND(ISINSCOPE('Cost Element'[Level 6S]), ISBLANK(VALUES('Cost Element'[Level 6S]))), BLANK(),",
              "",
              "AND(ISINSCOPE('Cost Element'[Level 7S]), ISBLANK(VALUES('Cost Element'[Level 7S]))), BLANK(),",
              "",
              "AND(ISINSCOPE('Cost Element'[Level 8S]), ISBLANK(VALUES('Cost Element'[Level 8S]))), BLANK(),",
              "",
              "/*Company Code Hierarchy*/",
              "",
              "/*AND(ISINSCOPE('Company'[Level 1]), ISBLANK(VALUES('Company'[Level 1]))), BLANK(),*/",
              "",
              "AND(ISINSCOPE('Company'[Level2]), ISBLANK(VALUES('Company'[Level2]))), BLANK(),",
              "",
              "AND(ISINSCOPE('Company'[Level3]), ISBLANK(VALUES('Company'[Level3]))), BLANK(),",
              "",
              "AND(ISINSCOPE('Company'[Level4]), ISBLANK(VALUES('Company'[Level4]))), BLANK(),",
              "",
              "AND(ISINSCOPE('Company'[Level5]), ISBLANK(VALUES('Company'[Level5]))), BLANK(),",
              "",
              "AND(ISINSCOPE('Company'[Level6]), ISBLANK(VALUES('Company'[Level6]))), BLANK(),",
              "",
              "AND(ISINSCOPE('Company'[Level7]), ISBLANK(VALUES('Company'[Level7]))), BLANK(),",
              "",
              "AND(ISINSCOPE('Company'[Level8]), ISBLANK(VALUES('Company'[Level8]))), BLANK(), SUM(Shipment[Order Quantity])",
              "",
              ")",
              ""
            ],
            "detailRowsDefinition": {
              "expression": [
                "SELECTCOLUMNS(",
                "Revenue,",
                "\"Product Hierarchy\", RELATED('Product'[Product hierarchy]),",
                "\"Sales Order\", RELATED('Sales Document'[Sales Document]),",
                "\"Sales Order Item \", RELATED('Sales Document'[Sales Document Item]),",
                "\"Cost Element\", RELATED('Cost Element'[Cost Element Text]),",
                "\"Controlling Area\", Revenue[Controlling Area],",
                "\"Plant\", RELATED(Plant[Plant Text]),",
                "\"Sales Organisation\", RELATED('Sales Organization'[Sales Organization]),",
                "\"Item Category\",RELATED('Item Category'[Item Category]),",
                "\"Value Fields\",Revenue[Value Fields],",
                "\"Document Number\", Revenue[Document number],",
                "\"Reference Item\",Revenue[Reference item],",
                "\"Record Type\",Revenue[Record Type],",
                "\"Item Number\",Revenue[Item number- COPA],",
                "\"Plan/Actual Indicator\",Revenue[Plan/Actual Indicator],",
                "\"Cancelled Item\",Revenue[Canceled item],",
                "\"Deliverable Type\",Revenue[Deliverable Type],",
                "\"Reporting Channel\",Revenue[Reporting Channel],",
                "\"No of Stages\", Revenue[No. of Stages],",
                "\"AMR Date For COPA\",Revenue[AMR Date for COPA],",
                "\"Country Key\",Revenue[Country Key],",
                "\"Future 6\",Revenue[Future 6],",
                "\"Future 7\",Revenue[Future 7],",
                "\"Future 8\",Revenue[Future 8],",
                "\"Future 9\",Revenue[Future 9],",
                "\"Future 10\",Revenue[Future 10],",
                "\"Incentive Code\",Revenue[Incentive Code],",
                "\"Itercompany Ind\",Revenue[Intercompany Ind],",
                "\"Order Reason\",Revenue[Order Reason],",
                "\"Rejection Reason\",Revenue[Rejection Reason],",
                "\"Revenue Type\",Revenue[Revenue Type],",
                "\"Sales Employee\",Revenue[Sales Employee],",
                "\"Cancelled Doc\",Revenue[Canceled doc.],",
                "\"Cust. Lifetime\",Revenue[Cust. Lifetime],",
                "\"Value Type\",Revenue[Value Type],",
                "\"Profitability Sub-segment (CO-PA)\",Revenue[Profitability Sub-segment (CO-PA)],",
                "\"Ship-to party\",RELATED('Sales Document'[ShipTo Text]),",
                "\"Sold-to party\",RELATED('Sales Document'[SoldTo Text]),",
                "\"Bill-to party\",RELATED('Sales Document'[Bill-to party text]),",
                "\"Material\",RELATED('Sales Document'[Material Text]),",
                "\"Profit Center\",RELATED('Profit Center'[Profit Center Text]),",
                "\"Treatment Category\",RELATED('Sales Document'[Treatment Category]),",
                "\"Treatment Option\",RELATED('Treatment Option'[Treatment Option]),",
                "\"Treatment ID\",RELATED('Sales Document'[TreatmentId]),",
                "\"Free/Paid\",RELATED('Sales Document'[Free Paid]),",
                "\"Age Tier\",RELATED('Sales Document'[Age Tier]),",
                "\"Treatment Location\",RELATED('Sales Document'[Treatment Location]),",
                "\"Treating Doctor\",RELATED('Sales Document'[TreatingDoctor]),",
                "\" Contact Professional Category\",RELATED('Customer Contact'[Professional Category]),",
                "\"Certification Date\",RELATED('Customer Contact'[Certification Date]),",
                "\"Treatment Location Account Type\",RELATED('Customer Treatment Location'[Account Type]),",
                "\"Dental Service Organization\",RELATED('Customer Treatment Location'[Dental Service Org]),",
                "\"Is Test Doctor\",RELATED('Customer Contact'[IsTestDoctor]),",
                "\"Treatment Location - Country\",RELATED('Customer Treatment Location'[Treatment Location – Country]),",
                "\"Treatment Loc-Country Group\",RELATED('Customer Treatment Location'[Treatment Loc-Country Group]),",
                "\"Treatment Loc-Region\",RELATED('Customer Treatment Location'[Treatment Loc-Region]),",
                "\"Treatment Loc-Region Group\",RELATED('Customer Treatment Location'[Treatment Loc-Region Group]),",
                "\"Treatment Loc-Global Region Group\",RELATED('Customer Treatment Location'[Treatment Loc-Global Region Group]),",
                "\"Order Stages\",RELATED('Sales Document'[Order Stages]),",
                "\"Stages Bucket\",RELATED('Sales Document'[Stage Bucket]),",
                "\"Compliance Indicator\",RELATED('Sales Document'[Compliance Indicator]),",
                "\"Treatment Option High Level\",RELATED('Treatment Option'[Treatment Option High Level]),",
                "\"Treatment Option Reporting Level\",RELATED('Treatment Option'[Treatment Option Reporting Level]),",
                "\"Hedged/Unhedged\",RELATED('Profit Center'[Hedged/Unhedged]),",
                "\"Allocated/Unallocated\",RELATED('Cost Element'[Allocated/Unallocate])",
                ")"
              ]
            }
          }
        ]
      },
