              "VAR NR_CCA=IF(HASONEVALUE('Activation Selection'[NR/CCA]),VALUES('Activation Selection'[NR/CCA]),BLANK())",
              "VAR isInternal=IF(HASONEVALUE('Activation Event'[Is Internal]),VALUES('Activation Event'[Is Internal]),BLANK())",
