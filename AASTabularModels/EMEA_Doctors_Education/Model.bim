              "*/",
              "",
              "VAR trainedDoctors=FILTER(DISTINCT('Activation Event Member'[Clin ID]), [Days After Activation Event]>=180)",
              "VAR activatedDoctors=FILTER(trainedDoctors, [NR @ 180]>=6)",
              "",
              "RETURN ",
              "",
              "DIVIDE(COUNTROWS(activatedDoctors),COUNTROWS(trainedDoctors))"
            ],
            "formatString": "0%;-0%;0%",
            "displayFolder": "Activation\\NR"
