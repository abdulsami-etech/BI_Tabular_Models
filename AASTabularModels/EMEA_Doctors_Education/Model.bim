      {
        "name": "Opportinities",
        "isHidden": true,
        "columns": [
          {
            "name": "Opportunity ID",
            "dataType": "string",
            "sourceColumn": "Opportunity ID",
            "sourceProviderType": "VarChar"
          },
          {
            "name": "Opportunity Name",
            "dataType": "string",
            "sourceColumn": "Opportunity Name",
            "sourceProviderType": "VarChar"
          },
          {
            "name": "Contract Signed Date",
            "dataType": "dateTime",
            "sourceColumn": "Contract Signed Date",
            "formatString": "dd.MM.yyyy",
            "sourceProviderType": "VarChar",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"DateTimeCustom\"><DateTimes><DateTime LCID=\"1049\" Group=\"ShortDate\" FormatString=\"dd.MM.yyyy\" /></DateTimes></Format>"
              }
            ]
          },
          {
            "name": "Contact ID",
            "dataType": "string",
            "sourceColumn": "Contact ID",
            "sourceProviderType": "VarChar"
          },
          {
            "name": "AccountID",
            "dataType": "string",
            "sourceColumn": "AccountID",
            "sourceProviderType": "VarChar"
          },
          {
            "type": "calculated",
            "name": "Last CE Event Date",
            "dataType": "dateTime",
            "isDataTypeInferred": true,
            "expression": [
              "",
              "VAR customers=CALCULATETABLE('Customer', 'Customer'[Account ID]=EARLIER([AccountID]))",
              "VAR CEEventLast=",
              "            CALCULATE( ",
              "                MAX('Continued Education Event'[Event Date]), ",
              "                customers,",
              "                'Continued Education Event'[Event Date]<=EARLIER([Contract Signed Date])",
              "            )",
              "",
              "VAR CertEventLast=",
              "            CALCULATE( ",
              "                MAX('Activation Event'[Event Date]), ",
              "                customers,",
              "                'Activation Event'[Event Date]<=EARLIER([Contract Signed Date])",
              "            )",
              "",
              "RETURN MAX(CertEventLast, CEEventLast)"
            ]
          },
          {
            "type": "calculated",
            "name": "Is less 90 Days",
            "dataType": "string",
            "isDataTypeInferred": false,
            "expression": [
              "",
              "IF (",
              "    NOT ISBLANK([Last CE Event Date]) && ([Contract Signed Date]-[Last CE Event Date]<90),",
              "    \"Less 90 days after last event\",",
              "    IF ( NOT ISBLANK([Last CE Event Date]) && ([Contract Signed Date]-[Last CE Event Date]>=90),    ",
              "        \"More 90 days after last event\"",
              "        ,\"Unknown\"",
              "        )",
              ")",
              ""
            ]
          }
        ],
        "partitions": [
          {
            "name": "�������������",
            "dataView": "full",
            "source": {
              "type": "query",
              "query": [
                "select ",
                "\to.Id as [Opportunity ID],",
                "\to.Name as [Opportunity Name],",
                "\tconvert(date,o.[Contract_Signed_Date__c]) as [Contract Signed Date],",
                "\to.[Contact__c] as [Contact ID],",
                "\to.AccountID",
                "from SFDC_Staging.[dbo].[Opportunity] o",
                "\tinner join (Select distinct ContactID from OTCDM.[TABV].[Customer_EMEA]) c on o.[Contact__c]=c.[ContactID]",
                "where [RecordTypeId] in ( '0120H000001QT9eQAG', '0120H000001QTSDQA4')",
                "and o.[Contract_Signed_Date__c]>='2016-01-01'"
              ],
              "dataSource": "OTCDM"
            },
            "annotations": [
              {
                "name": "QueryEditorSerialization",
                "value": [
                  "<?xml version=\"1.0\" encoding=\"UTF-16\"?><Gemini xmlns=\"QueryEditorSerialization\"><AnnotationContent><![CDATA[<RSQueryCommandText>select ",
                  "\to.Id as [Opportunity ID],",
                  "\to.Name as [Opportunity Name],",
                  "\tconvert(date,o.[Contract_Signed_Date__c]) as [Contract Signed Date],",
                  "\to.[Contact__c] as [Contact ID],",
