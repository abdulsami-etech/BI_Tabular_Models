            "expression": [
              "",
              "",
              "/* Calculates CCA for a doctor at 90 days after activation event as of reporting date selected.",
              "If less 90 days from event, then BLANK",
              "Aggregates by SUM */",
              "",
              "VAR repDate=MAX('Reporting Date'[Date])",
