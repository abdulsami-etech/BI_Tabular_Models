              "        \"180\", SWITCH(NR_CCA, \"CCA\", [CCA @ 180], \"NR\",[NR @ 180], \"Activation Days/Type NOT selected\"),",
              "        \"365\", SWITCH(NR_CCA, \"CCA\", [CCA @ 365], \"NR\",[NR @ 365], \"Activation Days/Type NOT selected\"),",
