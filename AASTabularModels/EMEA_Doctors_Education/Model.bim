              "DIVIDE(COUNTROWS(activatedDoctors),COUNTROWS(trainedDoctors))"
            ],
            "formatString": "0%;-0%;0%",
            "displayFolder": "Activation\\CCA"
          },
          {
            "name": "Activation % NR 20+ @365",
            "expression": [
              "",
              "",
              "/*Activation CCA 3+ is % of trained doctors who have 3+ CCA at @N days after event",
              "The measure should be used with proper context of Event Date filter",
              "*/",
              "",
              "VAR trainedDoctors=FILTER(DISTINCT('Activation Event Member'[Clin ID]), [Days After Activation Event]>=365)",
              "VAR activatedDoctors=FILTER(trainedDoctors, [NR @ 365]>=20)",
              "",
              "RETURN ",
              "",
              "DIVIDE(COUNTROWS(activatedDoctors),COUNTROWS(trainedDoctors))"
            ],
            "formatString": "0%;-0%;0%",
            "displayFolder": "Activation\\NR"
          },
          {
            "name": "CCA Sales12RM",
            "expression": [
              " ",
              "",
              "VAR curDay=MAX('Sales Date'[Date])",
              "VAR DayLY=SELECTCOLUMNS(",
              "                FILTER('Sales Date',[Date]=curDay),",
              "                \"Date\", NEXTDAY(SAMEPERIODLASTYEAR('Sales Date'[Date])))",
              "",
              "RETURN",
              "CALCULATE (",
              "        [CCA],",
              "            DATESBETWEEN (",
              "               'Sales Date'[Date],",
              "                DayLY,",
              "                curDay))",
              ""
            ],
            "displayFolder": "Utilization"
          },
          {
            "name": "GR",
            "expression": "SUM('Order Status'[IsGrossReceipts])"
          },
          {
            "name": "CCA Submitters12RM",
            "expression": [
              "  ",
              "",
              "VAR curDay=MAX('Sales Date'[Date])",
              "VAR DayLY=SELECTCOLUMNS(",
              "                FILTER('Sales Date',[Date]=curDay),",
              "                \"Date\", NEXTDAY(SAMEPERIODLASTYEAR('Sales Date'[Date])))",
              "",
              "VAR contacts=",
              "    CALCULATETABLE (",
              "        FILTER('Customer', [GR]>0),",
              "        DATESBETWEEN (",
              "               'Sales Date'[Date],",
              "                DayLY,",
              "                curDay))",
              "",
              "RETURN ",
              "CALCULATE(",
              "    DISTINCTCOUNT(Customer[Contact ClinID]),",
              "    contacts)",
              ""
            ],
            "displayFolder": "Utilization"
          },
          {
            "name": "CCA Utilization Rate 12RM",
            "expression": "DIVIDE([CCA Sales12RM],[CCA Submitters12RM])",
            "formatString": "0.0",
            "displayFolder": "Utilization"
          },
          {
            "name": "CCA Utilization Rate 12RM Mature Doctors",
            "expression": [
              "",
              "",
              "",
              "VAR tmp=DATEADD('Sales Date'[Date],-365,DAY)",
              "VAR matureDate=CALCULATE(MIN('Sales Date'[Date]),tmp)",
              "VAR matureCustomers=FILTER('Customer',[Contact Certification Date]<matureDate)",
              "",
              "RETURN",
              "CALCULATE([CCA Utilization Rate 12RM],matureCustomers)",
              ""
            ],
            "formatString": "0.0",
            "displayFolder": "Utilization"
          },
          {
            "name": "CCA Sales 12RM Mature Doctors",
            "expression": [
              "",
              "",
              "",
              "VAR tmp=DATEADD('Sales Date'[Date],-365,DAY)",
              "VAR matureDate=CALCULATE(MIN('Sales Date'[Date]),tmp)",
              "VAR matureCustomers=FILTER('Customer',[Contact Certification Date]<matureDate)",
              "",
              "RETURN",
              "CALCULATE([CCA Sales12RM],matureCustomers)"
            ],
            "displayFolder": "Utilization"
          },
          {
            "name": "CCA Submitters 12RM Mature Doctors",
            "expression": [
              "",
              "",
              "",
              "VAR tmp=DATEADD('Sales Date'[Date],-365,DAY)",
              "VAR matureDate=CALCULATE(MIN('Sales Date'[Date]),tmp)",
              "VAR matureCustomers=FILTER('Customer',[Contact Certification Date]<matureDate)",
              "",
              "RETURN",
              "CALCULATE([CCA Submitters12RM],matureCustomers)",
              ""
            ],
            "displayFolder": "Utilization"
          },
          {
            "name": "Activation % CCA 20+ @365 LY",
            "expression": [
              "",
              "",
              "VAR LYQ=DISTINCT('Activation Event Member'[Certification Q LY])",
              "VAR Q=INTERSECT(ALL('Activation Event Member'[Certification Q]), LYQ)",
              "",
              "RETURN CALCULATE( [Activation % CCA 20+ @365], Q)",
              ""
            ],
            "formatString": "0%;-0%;0%",
            "displayFolder": "Activation\\CCA"
          },
          {
            "name": "Activation % CCA 6+ @180 LY",
            "expression": [
              "",
              "",
              "VAR LYQ=DISTINCT('Activation Event Member'[Certification Q LY])",
              "VAR Q=INTERSECT(ALL('Activation Event Member'[Certification Q]), LYQ)",
              "",
              "RETURN CALCULATE( [Activation % CCA 6+ @180], Q)",
              "",
              "",
              "            ",
              "",
              ""
            ],
            "formatString": "0%;-0%;0%",
            "displayFolder": "Activation\\CCA"
          },
          {
            "name": "Activation % CCA 9+ @180 LY",
            "expression": [
              "",
              "",
              "VAR LYQ=DISTINCT('Activation Event Member'[Certification Q LY])",
              "VAR Q=INTERSECT(ALL('Activation Event Member'[Certification Q]), LYQ)",
              "",
              "RETURN CALCULATE( [Activation % CCA 9+ @180], Q)",
              ""
            ],
            "formatString": "0%;-0%;0%",
            "displayFolder": "Activation\\CCA"
          },
          {
            "name": "Activation % CCA 9+ @365 LY",
            "expression": [
              "",
              "",
              "VAR LYQ=DISTINCT('Activation Event Member'[Certification Q LY])",
              "VAR Q=INTERSECT(ALL('Activation Event Member'[Certification Q]), LYQ)",
              "",
              "RETURN CALCULATE( [Activation % CCA 9+ @365], Q)"
            ],
            "formatString": "0%;-0%;0%",
            "displayFolder": "Activation\\CCA"
          },
          {
            "name": "Activation % 3+ @90 Selected LY",
            "expression": [
              "",
              "",
              "VAR LYQ=DISTINCT('Activation Event Member'[Certification Q LY])",
              "VAR Q=INTERSECT(ALL('Activation Event Member'[Certification Q]), LYQ)",
              "",
              "RETURN CALCULATE( [Activation % 3+ @90 Selected], Q)"
            ],
            "formatString": "0%;-0%;0%",
            "displayFolder": "Activation\\CCA"
          },
          {
            "name": "AVR Sales per Activated 3+ LY",
            "expression": [
              "",
              "",
              "VAR LYQ=DISTINCT('Activation Event Member'[Certification Q LY])",
              "VAR Q=INTERSECT(ALL('Activation Event Member'[Certification Q]), LYQ)",
              "",
              "RETURN CALCULATE( [AVR Sales per Activated 3+], Q)"
            ],
            "formatString": "0.00",
            "displayFolder": "Averages\\General"
          },
          {
            "name": "Stickiness % Selected LY",
            "expression": [
              "",
              "",
              "VAR LYQ=DISTINCT('Activation Event Member'[Certification Q LY])",
              "VAR Q=INTERSECT(ALL('Activation Event Member'[Certification Q]), LYQ)",
              "",
              "RETURN CALCULATE( [Stickiness % Selected], Q)"
            ],
            "formatString": "0%;-0%;0%",
            "displayFolder": "Stickiness\\General"
          },
          {
            "name": "AVR Sales per Submitter Selected LY",
            "expression": [
              "",
              "",
              "VAR LYQ=DISTINCT('Activation Event Member'[Certification Q LY])",
              "VAR Q=INTERSECT(ALL('Activation Event Member'[Certification Q]), LYQ)",
              "",
              "RETURN CALCULATE( [AVR Sales per Submitter Selected], Q)"
            ],
            "formatString": "0.00",
            "displayFolder": "Averages\\General"
          },
          {
            "name": "NR @ >365",
            "expression": [
              "",
              "",
              "/* Calculates NR for a doctor at >365 days after activation event as of reporting date selected.",
              "If less 365 days from event, then BLANK",
              "Aggregates by SUM */",
              "",
              "VAR repDate=MAX('Reporting Date'[Date])",
              "",
              "RETURN",
              "",
              "            SUMX(",
              "                    GROUPBY('Activation Event Member',[Clin ID],[Certification Date]),",
              "                    ",
              "                    VAR daysAfter=CALCULATE([Days After Activation Event])",
              "                    VAR eventDate=[Certification Date]",
              "                    VAR day366=eventDate+366",
              "                 ",
              "                    RETURN   ",
              "                    IF( daysAfter<366, BLANK(),",
              "                    CALCULATE(",
              "                                [NR],",
              "                                ALL('Sales Date'), ",
              "                                FILTER('Sales Date', 'Sales Date'[Date]>=day366 )",
              "                             )",
              "                    )",
              "                )"
            ],
            "displayFolder": "NR"
          },
          {
            "name": "CCA @ >365",
            "expression": [
              "",
              "",
              "/* Calculates CCA for a doctor at >365 days after activation event as of reporting date selected.",
              "If less 365 days from event, then BLANK",
              "Aggregates by SUM */",
              "",
              "VAR repDate=MAX('Reporting Date'[Date])",
              "",
              "RETURN",
              "",
              "            SUMX(",
              "                    GROUPBY('Activation Event Member',[Clin ID],[Certification Date]),",
              "                    ",
              "                    VAR daysAfter=CALCULATE([Days After Activation Event])",
              "                    VAR eventDate=[Certification Date]",
              "                    VAR day366=eventDate+366",
              "                 ",
              "                    RETURN   ",
              "                    IF( daysAfter<366, BLANK(),",
              "                    CALCULATE(",
              "                                [CCA],",
              "                                ALL('Sales Date'), ",
              "                                FILTER('Sales Date', 'Sales Date'[Date]>=day366 )",
              "                             )",
              "                    )",
              "                )"
            ],
            "displayFolder": "CCA"
          },
          {
            "name": "AVG NR per Submitter @ >365",
            "expression": [
              "",
              "",
              "/*",
              "Average amount of NR per Submitter (1+ cases) @ >365 days",
              "*/",
              "",
              "VAR trainedDoctors=FILTER(DISTINCT('Activation Event Member'[Clin ID]), [Days After Activation Event]>365)",
              "VAR Submitters=FILTER(trainedDoctors, [NR @ >365]>=1)",
              "VAR SubmittersCount=COUNTROWS(Submitters)",
              "VAR SubmittersSales=CALCULATE([NR @ >365], Submitters)",
              "",
              "RETURN ",
              "",
              "DIVIDE(SubmittersSales,SubmittersCount)"
            ],
            "formatString": "0.00",
            "displayFolder": "Averages\\NR"
          },
          {
            "name": "AVG CCA per Submitter @ >365",
            "expression": [
              "",
              "",
              "/*",
              "Average amount of CA per Submitter (1+ cases) @ >365 days",
              "*/",
              "",
              "VAR trainedDoctors=FILTER(DISTINCT('Activation Event Member'[Clin ID]), [Days After Activation Event]>365)",
              "VAR Submitters=FILTER(trainedDoctors, [CCA @ >365]>=1)",
              "VAR SubmittersCount=COUNTROWS(Submitters)",
              "VAR SubmittersSales=CALCULATE([CCA @ >365], Submitters)",
              "",
              "RETURN ",
              "",
              "DIVIDE(SubmittersSales,SubmittersCount)"
            ],
            "displayFolder": "Averages\\CCA"
          },
          {
            "name": "Stickiness % CCA @ >365",
            "expression": [
              "",
              "",
              "/*Stickness CCA is % of trained doctors who have 1+ CCA at @N days after event. The measure should be used with proper context of Event Date filter",
              "*/",
              "",
              "VAR trainedDoctors=FILTER(DISTINCT('Activation Event Member'[Clin ID]), [Days After Activation Event]>=366)",
              "VAR stickedDoctors=FILTER(trainedDoctors, [CCA @ >365]>=1)",
              "",
              "RETURN ",
              "",
              "DIVIDE(COUNTROWS(stickedDoctors),COUNTROWS(trainedDoctors))"
            ],
            "displayFolder": "Stickiness\\CCA"
          },
          {
            "name": "Stickiness % NR @ >365",
            "expression": [
              "",
              "",
              "/*Stickness NR is % of trained doctors who have 1+ NR at @N days after event",
              "The measure should be used with proper context of Event Date filter",
              "*/",
              "",
              "VAR trainedDoctors=FILTER(DISTINCT('Activation Event Member'[Clin ID]), [Days After Activation Event]>=366)",
              "VAR stickedDoctors=FILTER(trainedDoctors, [NR @ >365]>=1)",
              "",
              "RETURN ",
              "",
              "DIVIDE(COUNTROWS(stickedDoctors),COUNTROWS(trainedDoctors))",
              ""
            ],
            "displayFolder": "Stickiness\\NR"
          }
        ]
      },
      {
        "name": "Reporting Date",
        "description": "Jeneral Calendar for calculations and slicing",
        "dataCategory": "Time",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Date",
            "dataType": "dateTime",
            "isNameInferred": false,
            "isDataTypeInferred": true,
            "description": "Sales Calendar Date",
            "isKey": true,
            "sourceColumn": "[Date]",
            "formatString": "dd.MM.yyyy",
            "displayFolder": "Date Fields",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"DateTimeCustom\"><DateTimes><DateTime LCID=\"1049\" Group=\"ShortDate\" FormatString=\"dd.MM.yyyy\" /></DateTimes></Format>"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Year",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "description": "Sales Year",
            "expression": "Year([Date])",
            "displayFolder": "Date Fields",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Quarter",
            "dataType": "string",
            "isDataTypeInferred": true,
            "description": "Sales Quarter Full Name",
            "expression": [
              "",
              "CONCATENATE([Year],CONCATENATE(\" Q\",ROUNDUP(MONTH([Date])/3, 0)))",
              ""
            ],
            "displayFolder": "Date Fields"
          },
          {
            "type": "calculated",
            "name": "Month Number",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "isHidden": true,
            "expression": "MONTH([Date])",
            "displayFolder": "Date Fields",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Month Code",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "isHidden": true,
            "expression": "[Year]*100+[Month Number]"
          },
          {
            "type": "calculated",
            "name": "Month-Year Name",
            "dataType": "string",
            "isDataTypeInferred": true,
            "description": "Month full name",
            "expression": [
              "",
              "SWITCH(",
              "[Month Number],",
              "1,CONCATENATE(\"Jan \",[Year]),",
              "2,CONCATENATE(\"Feb \",[Year]),",
              "3,CONCATENATE(\"Mar \",[Year]),",
              "4,CONCATENATE(\"Apr \",[Year]),",
              "5,CONCATENATE(\"May \",[Year]),",
              "6,CONCATENATE(\"Jun \",[Year]),",
              "7,CONCATENATE(\"Jul \",[Year]),",
              "8,CONCATENATE(\"Aug \",[Year]),",
              "9,CONCATENATE(\"Sep \",[Year]),",
              "10,CONCATENATE(\"Oct \",[Year]),",
              "11,CONCATENATE(\"Nov \",[Year]),",
              "12,CONCATENATE(\"Dec \",[Year])",
              ")"
            ],
            "sortByColumn": "Month Code",
            "displayFolder": "Date Fields"
          },
          {
            "type": "calculated",
            "name": "Month Name",
            "dataType": "string",
            "isDataTypeInferred": true,
            "description": "Month Name without Year",
            "expression": [
              "",
              "SWITCH(",
              "[Month Number],",
              "1,\"January\",",
              "2,\"February\",",
              "3,\"March\",",
              "4,\"April\",",
              "5,\"May\",",
              "6,\"June\",",
              "7,\"July\",",
              "8,\"August\",",
              "9,\"September\",",
              "10,\"October\",",
              "11,\"November\",",
              "12,\"December\")"
            ],
            "displayFolder": "Date Fields"
          },
          {
            "type": "calculated",
            "name": "Quarter Short",
            "dataType": "string",
            "isDataTypeInferred": true,
            "description": "Sales Quarter Short name",
            "expression": "CONCATENATE(\" Q\",ROUNDUP(MONTH([Date])/3, 0))",
            "displayFolder": "Date Fields"
          },
          {
            "type": "calculated",
            "name": "DayType",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "",
              "VAR curDay=MAX('DM Current Day'[DM Current Day])",
              "",
              "RETURN",
              "IF([Date]<curDay,\"Past\",IF([Date]=curDay,\"Current\",\"Future\"))",
              ""
            ],
            "displayFolder": "Date Fields"
          },
          {
            "type": "calculated",
            "name": "Quarter Code",
            "dataType": "double",
            "isDataTypeInferred": true,
            "isHidden": true,
            "expression": "[Year]*100+ROUNDUP(MONTH([Date])/3, 0)",
            "formatString": "0"
          }
        ],
        "partitions": [
          {
            "name": "CalculatedTable 1",
            "source": {
              "type": "calculated",
              "expression": [
                "",
                "CALENDAR( MIN('Order Status'[StatusDateKey]), MAX('Order Status'[StatusDateKey]))",
                "",
                "",
                ""
              ]
            }
          }
        ],
        "hierarchies": [
          {
            "name": "Date YQMD",
            "levels": [
              {
                "name": "Year",
                "ordinal": 0,
                "column": "Year"
              },
              {
                "name": "Quarter",
                "ordinal": 1,
                "column": "Quarter"
              },
              {
                "name": "Month-Year Name",
                "ordinal": 2,
                "column": "Month-Year Name"
              },
              {
                "name": "Sales Date",
                "ordinal": 3,
                "column": "Date"
              }
            ]
          }
        ]
      },
      {
        "name": "ContactLink",
        "isHidden": true,
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "ContactKey",
            "dataType": "int64",
            "isNameInferred": true,
