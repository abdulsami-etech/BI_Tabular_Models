      {
        "name": "Sales Date",
        "description": "Jeneral Calendar for calculations and slicing",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Date",
            "dataType": "dateTime",
            "isNameInferred": false,
            "isDataTypeInferred": true,
            "description": "Sales Calendar Date",
            "sourceColumn": "[Date]",
            "formatString": "dd.MM.yyyy",
            "displayFolder": "Date Fields",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"DateTimeCustom\"><DateTimes><DateTime LCID=\"1049\" Group=\"ShortDate\" FormatString=\"dd.MM.yyyy\" /></DateTimes></Format>"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Year",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "description": "Sales Year",
            "expression": "Year([Date])",
            "displayFolder": "Date Fields",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Quarter",
            "dataType": "string",
            "isDataTypeInferred": true,
            "description": "Sales Quarter Full Name",
            "expression": [
              "",
              "CONCATENATE([Year],CONCATENATE(\" Q\",ROUNDUP(MONTH([Date])/3, 0)))",
              ""
            ],
            "sortByColumn": "Quarter Code",
            "displayFolder": "Date Fields"
          },
          {
            "type": "calculated",
            "name": "Month Number",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "isHidden": true,
            "expression": "MONTH([Date])",
            "displayFolder": "Date Fields",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Month Code",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "isHidden": true,
            "expression": "[Year]*100+[Month Number]"
          },
          {
            "type": "calculated",
            "name": "Month-Year Name",
            "dataType": "string",
            "isDataTypeInferred": true,
            "description": "Month full name",
            "expression": [
              "",
              "SWITCH(",
              "[Month Number],",
              "1,CONCATENATE(\"Jan \",[Year]),",
              "2,CONCATENATE(\"Feb \",[Year]),",
              "3,CONCATENATE(\"Mar \",[Year]),",
              "4,CONCATENATE(\"Apr \",[Year]),",
              "5,CONCATENATE(\"May \",[Year]),",
              "6,CONCATENATE(\"Jun \",[Year]),",
              "7,CONCATENATE(\"Jul \",[Year]),",
              "8,CONCATENATE(\"Aug \",[Year]),",
              "9,CONCATENATE(\"Sep \",[Year]),",
              "10,CONCATENATE(\"Oct \",[Year]),",
              "11,CONCATENATE(\"Nov \",[Year]),",
              "12,CONCATENATE(\"Dec \",[Year])",
              ")"
            ],
            "sortByColumn": "Month Code",
            "displayFolder": "Date Fields"
          },
          {
            "type": "calculated",
            "name": "Month Name",
            "dataType": "string",
            "isDataTypeInferred": true,
            "description": "Month Name without Year",
            "expression": [
              "",
              "SWITCH(",
              "[Month Number],",
              "1,\"January\",",
              "2,\"February\",",
              "3,\"March\",",
              "4,\"April\",",
              "5,\"May\",",
              "6,\"June\",",
              "7,\"July\",",
              "8,\"August\",",
              "9,\"September\",",
              "10,\"October\",",
              "11,\"November\",",
              "12,\"December\")"
            ],
            "displayFolder": "Date Fields"
          },
          {
            "type": "calculated",
            "name": "Quarter Short",
            "dataType": "string",
            "isDataTypeInferred": true,
            "description": "Sales Quarter Short name",
            "expression": "CONCATENATE(\" Q\",ROUNDUP(MONTH([Date])/3, 0))",
            "displayFolder": "Date Fields"
          },
          {
            "type": "calculated",
            "name": "DayType",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "",
              "VAR curDay=MAX('DM Current Day'[DM Current Day])",
              "",
              "RETURN",
              "IF([Date]<curDay,\"Past\",IF([Date]=curDay,\"Current\",\"Future\"))",
              ""
            ],
            "displayFolder": "Date Fields"
          },
          {
            "type": "calculated",
            "name": "Quarter Code",
            "dataType": "int64",
            "isDataTypeInferred": false,
            "expression": [
              "",
              "[Year]*100+ROUNDUP(MONTH([Date])/3, 0)"
            ]
          }
        ],
        "partitions": [
          {
            "name": "CalculatedTable 1",
            "source": {
              "type": "calculated",
              "expression": [
                "",
                "CALENDAR( MIN('Order Status'[StatusDateKey]), MAX('Order Status'[StatusDateKey]))",
                "",
                "",
                ""
              ]
            }
          }
        ],
        "hierarchies": [
          {
            "name": "Date YQMD",
            "levels": [
              {
                "name": "Year",
                "ordinal": 0,
                "column": "Year"
              },
              {
                "name": "Quarter",
                "ordinal": 1,
                "column": "Quarter"
              },
              {
                "name": "Month-Year Name",
                "ordinal": 2,
                "column": "Month-Year Name"
              },
              {
                "name": "Sales Date",
                "ordinal": 3,
                "column": "Date"
              }
            ]
          }
        ]
      },
      {
        "name": "DM Current Day",
        "isHidden": true,
        "columns": [
          {
            "name": "DM Current Day",
            "dataType": "dateTime",
            "sourceColumn": "DM Current Day",
            "formatString": "dd.MM.yyyy",
            "sourceProviderType": "Date",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"DateTimeCustom\"><DateTimes><DateTime LCID=\"1049\" Group=\"ShortDate\" FormatString=\"dd.MM.yyyy\" /></DateTimes></Format>"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "DM Current Day",
            "dataView": "full",
            "source": {
              "type": "query",
              "query": "select DateKey as [DM Current Day] from [DM].[DimDateTime] where DayType='Current Day'",
              "dataSource": "OTCDM"
            },
            "annotations": [
              {
                "name": "QueryEditorSerialization",
                "value": "<?xml version=\"1.0\" encoding=\"UTF-16\"?><Gemini xmlns=\"QueryEditorSerialization\"><AnnotationContent><![CDATA[<RSQueryCommandText>select DateKey as [DM Current Day] from [DM].[DimDateTime] where DayType='Current Day'</RSQueryCommandText><RSQueryCommandType>Text</RSQueryCommandType><RSQueryDesignState></RSQueryDesignState>]]></AnnotationContent></Gemini>"
              }
            ]
          }
        ],
        "annotations": [
          {
            "name": "_TM_ExtProp_QueryDefinition",
            "value": "select DateKey as [DM Current Day] from [DM].[DimDateTime] where DayType='Current Day'"
          },
          {
            "name": "_TM_ExtProp_DbTableName",
            "value": "DM Current Day"
          },
          {
            "name": "QueryEditorSerialization",
            "value": "<?xml version=\"1.0\" encoding=\"UTF-16\"?><Gemini xmlns=\"QueryEditorSerialization\"><AnnotationContent><![CDATA[<RSQueryCommandText>select DateKey as [DM Current Day] from [DM].[DimDateTime] where DayType='Current Day'</RSQueryCommandText><RSQueryCommandType>Text</RSQueryCommandType><RSQueryDesignState></RSQueryDesignState>]]></AnnotationContent></Gemini>"
          }
        ]
      },
      {
        "name": "Model Measures",
        "isHidden": true,
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Measures",
            "dataType": "int64",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "isHidden": true,
            "sourceColumn": "[Measures]"
          },
          {
            "type": "calculatedTableColumn",
            "name": "2",
            "dataType": "int64",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "isHidden": true,
            "sourceColumn": "[2]"
          },
          {
            "type": "calculatedTableColumn",
            "name": "3",
            "dataType": "int64",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "isHidden": true,
            "sourceColumn": "[3]"
          },
          {
            "type": "calculatedTableColumn",
            "name": "4",
            "dataType": "int64",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "isHidden": true,
            "sourceColumn": "[4]"
          },
          {
            "type": "calculated",
            "name": "5",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "CalculatedTable 1",
            "source": {
              "type": "calculated",
              "expression": "ROW(\"Measures\",1, \"2\",2,\"3\",3,\"4\",4)"
            }
          }
        ],
        "measures": [
          {
            "name": "Doctors Trained",
            "description": "The measure calculates number of attended doctors to activation events during selected reporting period",
            "expression": [
              " ",
              "",
              "/* The measure calculates number of attended doctors to activation events during selected Events period*/ ",
              "",
              "DISTINCTCOUNT('Activation Event Member'[Clin ID])",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "Doctors Trained"
          },
          {
            "name": "NR",
            "expression": [
              "",
              "/* Net Receipts over period in Sales Date table context*/",
              "",
              "SUM('Order Status'[IsNetReceipts])"
            ],
            "formatString": "#,0",
            "displayFolder": "NR"
          },
          {
            "name": "CCA",
            "description": "ClinCheck Accepted over period in Sales Date table context",
            "expression": [
              "",
              "/* ClinCheck Accepted over period in Sales Date table context*/",
              "",
              "SUM('Order Status'[IsCCA])"
            ],
            "formatString": "#,0",
            "displayFolder": "CCA"
          },
          {
            "name": "Days After Activation Event",
            "description": "Days passed from Activation Event date as of Reporting date selected ",
            "expression": [
              "",
              "",
              "/* Days passed from doctors certification date as of Reporting date selected ",
              "When multiple doctors are in context the measures is of Average aggregation",
              "*/",
              "",
              "VAR repDate=IF(",
              "        ISCROSSFILTERED('Reporting Date'),",
              "        MAX('Reporting Date'[Date]),",
              "        TODAY()-1",
              ")",
              "",
              "RETURN",
              "    AVERAGEX(",
              "             'Activation Event Member',",
              "             IF(",
              "                NOT(ISBLANK([Certification Date])) && [Certification Date]<=repDate,",
              "                DATEDIFF([Certification Date],repDate,DAY)",
              "                )",
              "            )",
              "",
              "",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "Other"
          },
          {
            "name": "NR @ 30",
            "expression": [
              "",
              "",
              "/* Calculates NR for a doctor at 30 days after activation event as of reporting date selected.",
              "If less 30 days from event, then BLANK",
              "Aggregates by SUM */",
              "",
              "VAR repDate=MAX('Reporting Date'[Date])",
              "RETURN",
              "",
              "            SUMX(",
              "                    GROUPBY('Activation Event Member',[Clin ID],[Certification Date]),",
              "                    ",
              "                    VAR daysAfter=CALCULATE([Days After Activation Event])",
              "                    VAR eventDate=[Certification Date]",
              "                    VAR day30=eventDate+30",
              "                 ",
              "                    RETURN   ",
              "                    IF( daysAfter<=30, BLANK(),",
              "                    CALCULATE(",
              "                                [NR],",
              "                                ALL('Sales Date'), ",
              "                                FILTER('Sales Date', 'Sales Date'[Date]>=eventDate && 'Sales Date'[Date]<=day30  )",
              "                             )",
              "                    )",
              "                )"
            ],
            "formatString": "#,0",
            "displayFolder": "NR"
          },
          {
            "name": "NR @ 60",
            "expression": [
              "",
              "",
              "/* Calculates NR for a doctor at 60 days after activation event as of reporting date selected.",
              "If less 60 days from event, then BLANK",
              "Aggregates by SUM */",
              "",
              "VAR repDate=MAX('Reporting Date'[Date])",
              "",
              "RETURN",
              "",
              "            SUMX(",
              "                    GROUPBY('Activation Event Member',[Clin ID],[Certification Date]),",
              "                    ",
              "                    VAR daysAfter=CALCULATE([Days After Activation Event])",
              "                    VAR eventDate=[Certification Date]",
              "                    VAR day60=eventDate+60",
              "                 ",
              "                    RETURN   ",
              "                    IF( daysAfter<=60, BLANK(),",
              "                    CALCULATE(",
              "                                [NR],",
              "                                ALL('Sales Date'), ",
              "                                FILTER('Sales Date', 'Sales Date'[Date]>=eventDate && 'Sales Date'[Date]<=day60  )",
              "                             )",
              "                    )",
              "                )"
            ],
            "formatString": "#,0",
            "displayFolder": "NR"
          },
          {
            "name": "NR @ 90",
            "expression": [
              "",
              "",
              "/* Calculates NR for a doctor at 90 days after activation event as of reporting date selected.",
              "If less 90 days from event, then BLANK",
              "Aggregates by SUM */",
              "",
              "VAR repDate=MAX('Reporting Date'[Date])",
              "",
              "RETURN",
              "",
              "            SUMX(",
              "                    GROUPBY('Activation Event Member',[Clin ID],[Certification Date]),",
              "                    ",
              "                    VAR daysAfter=CALCULATE([Days After Activation Event])",
              "                    VAR eventDate=[Certification Date]",
              "                    VAR day90=eventDate+90",
              "                 ",
              "                    RETURN   ",
              "                    IF( daysAfter<=90, BLANK(),",
              "                    CALCULATE(",
              "                                [NR],",
              "                                ALL('Sales Date'), ",
              "                                FILTER('Sales Date', 'Sales Date'[Date]>=eventDate && 'Sales Date'[Date]<=day90  )",
              "                             )",
              "                    )",
              "                )"
            ],
            "formatString": "#,0",
            "displayFolder": "NR"
          },
          {
            "name": "NR @ 120",
            "expression": [
              "",
              "",
              "/* Calculates NR for a doctor at 120 days after activation event as of reporting date selected.",
              "If less 120 days from event, then BLANK",
              "Aggregates by SUM */",
              "",
              "VAR repDate=MAX('Reporting Date'[Date])",
              "",
              "RETURN",
              "",
              "            SUMX(",
              "                    GROUPBY('Activation Event Member',[Clin ID],[Certification Date]),",
              "                    ",
              "                    VAR daysAfter=CALCULATE([Days After Activation Event])",
              "                    VAR eventDate=[Certification Date]",
              "                    VAR day120=eventDate+120",
              "                 ",
              "                    RETURN   ",
              "                    IF( daysAfter<=120, BLANK(),",
              "                    CALCULATE(",
              "                                [NR],",
              "                                ALL('Sales Date'), ",
              "                                FILTER('Sales Date', 'Sales Date'[Date]>=eventDate && 'Sales Date'[Date]<=day120  )",
              "                             )",
              "                    )",
              "                )"
            ],
            "formatString": "#,0",
            "displayFolder": "NR"
          },
          {
            "name": "NR @ 180",
            "expression": [
              "",
              "",
              "/* Calculates NR for a doctor at 180 days after activation event as of reporting date selected.",
              "If less 180 days from event, then BLANK",
              "Aggregates by SUM */",
              "",
              "VAR repDate=MAX('Reporting Date'[Date])",
              "",
              "RETURN",
              "",
              "            SUMX(",
              "                    GROUPBY('Activation Event Member',[Clin ID],[Certification Date]),",
              "                    ",
              "                    VAR daysAfter=CALCULATE([Days After Activation Event])",
              "                    VAR eventDate=[Certification Date]",
