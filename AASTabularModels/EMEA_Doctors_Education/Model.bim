          {
            "name": "Activation % 4+ Selected",
            "expression": [
              "",
              "",
              "VAR days=IF(HASONEVALUE('Activation Selection'[Activation Days Caption]),",
              "                 VALUES('Activation Selection'[Activation Days Caption]),",
              "                 BLANK())",
              "VAR NR_CCA=IF(HASONEVALUE('Activation Selection'[NR/CCA]),",
              "                 VALUES('Activation Selection'[NR/CCA]),",
              "                 BLANK())",
              "",
              "VAR ret=",
              "    SWITCH(",
              "        days,",
              "        \"30\",  SWITCH(NR_CCA, \"CCA\", [Activation % CCA 4+ @30],  \"NR\",[Activation % NR 4+ @30],  \"Activation Days/Type NOT selected\"),",
              "        \"60\",  SWITCH(NR_CCA, \"CCA\", [Activation % CCA 4+ @60],  \"NR\",[Activation % NR 4+ @60],  \"Activation Days/Type NOT selected\"),",
              "        \"90\",  SWITCH(NR_CCA, \"CCA\", [Activation % CCA 4+ @90],  \"NR\",[Activation % NR 4+ @90],  \"Activation Days/Type NOT selected\"),",
              "        \"120\", SWITCH(NR_CCA, \"CCA\", [Activation % CCA 4+ @120], \"NR\",[Activation % NR 4+ @120], \"Activation Days/Type NOT selected\"),",
              "        \"180\", SWITCH(NR_CCA, \"CCA\", [Activation % CCA 4+ @180], \"NR\",[Activation % NR 4+ @180], \"Activation Days/Type NOT selected\"),",
              "        \"365\", SWITCH(NR_CCA, \"CCA\", [Activation % CCA 4+ @365], \"NR\",[Activation % NR 4+ @365], \"Activation Days/Type NOT selected\"),",
              "        \"Activation Days/Type NOT selected\"",
              ")",
              "",
              "RETURN ret",
              "",
              ""
            ],
            "formatString": "0%;-0%;0%",
            "displayFolder": "Activation\\General"
          },
          {
