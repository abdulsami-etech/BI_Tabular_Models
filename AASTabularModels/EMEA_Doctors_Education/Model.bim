                  "\t,[ContactLineofBusinessType]\t\t\t\t\t\tas [Contact Line of Business Type]",
                  "\t,[ContactProfessionalCategory]\t\t\t\t\t\tas [Contact Professional Category]",
                  "\t,[ContactStatus]\t\t\t\t\t\t\t\t\tas [Contact Status]",
                  "\t,[ContactCertificationDate]\t\t\t\t\t\t\tas [Contact Certification Date]",
                  "\t,[ContactClinID]\t\t\t\t\t\t\t\t\tas [Contact ClinID]",
                  "",
                  "\t,[AccountKey]",
                  "\t,[AccountID]\t\t\t\t\t\t\t\t\t\tas [Account ID]",
                  "\t,[AccountNumber]\t\t\t\t\t\t\t\t\tas\t[Account Number]",
                  "\t,[AccountOwnerID]\t\t\t\t\t\t\t\t\tas [Account Owner ID]",
