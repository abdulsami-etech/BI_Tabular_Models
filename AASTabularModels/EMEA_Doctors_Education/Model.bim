              "IF ",
              "([Contact Professional Category]=\"GP\" && SEARCH(\"Invisalign Go\",[Contact Line of Business],1,0)>0, ",
              "\"GP Invisalign Go\",\"Full Portfolio\")"
            ]
          },
          {
            "type": "calculated",
            "name": "Portfolio 2019",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "",
              "IF ",
              "(",
              "    [Contact Professional Category]=\"GP\" && SEARCH(\"Invisalign Go\",[Contact Line of Business],1,0)>0, ",
              "    \"GP iGo\",",
              "    IF ([Contact Professional Category]=\"GP\" && SEARCH(\"Invisalign Go\",[Contact Line of Business],1,0)<=0,",
              "        \"GP Full\",\"Ortho\")",
              ")"
            ]
          }
