              "        \"60\",  SWITCH(NR_CCA, \"CCA\", [CCA @ 60],  \"NR\",[NR @ 60],  \"Activation Days/Type NOT selected\"),",
              "        \"90\",  SWITCH(NR_CCA, \"CCA\", [CCA @ 90],  \"NR\",[NR @ 90],  \"Activation Days/Type NOT selected\"),",
