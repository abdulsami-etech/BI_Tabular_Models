            "sourceColumn": "[Activation Days Sort]",
            "summarizeBy": "none"
          },
          {
            "type": "calculatedTableColumn",
            "name": "NR/CCA",
            "dataType": "string",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[NR/CCA]"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Activation Days Caption",
            "dataType": "string",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Activation Days Caption]",
            "sortByColumn": "Activation Days Sort"
          }
        ],
        "partitions": [
          {
            "name": "CalculatedTable 1",
            "source": {
              "type": "calculated",
              "expression": [
                "",
                "DATATABLE (",
                "    ",
                "    \"NR/CCA\", STRING,",
                "    \"Activation Days\", INTEGER,",
                "    \"Activation Days Caption\", STRING,",
                "    \"Activation Days Sort\", INTEGER,",
                "    ",
                "    { ",
                "        {\"NR\",30,\"30\", 30},",
                "        {\"NR\",60,\"60\", 60},",
                "        {\"NR\",90,\"90\", 90},",
                "        {\"NR\",120,\"120\", 120},",
                "        {\"NR\",180,\"180\", 180},",
                "        {\"NR\",365,\"365\", 365},",
                "        {\"NR\",366,\">365\", 366},",
                "        {\"CCA\",30,\"30\", 30},",
                "        {\"CCA\",60,\"60\", 60},",
                "        {\"CCA\",90,\"90\", 90},",
                "        {\"CCA\",120,\"120\", 120},",
                "        {\"CCA\",180,\"180\", 180},",
                "        {\"CCA\",365,\"365\", 365},",
                "        {\"CCA\",366,\">365\", 366}",
                "    } ",
                ")"
              ]
            }
          }
        ]
      },
      {
        "name": "Targets",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "KPI Name",
            "dataType": "string",
