        "partitions": [
          {
            "name": "Continued Education Event",
            "dataView": "full",
            "source": {
              "type": "query",
              "query": [
                "SELECT ",
                "       c.[Event ID]",
                "      ,c.[Event Name]",
                "      ,c.[Event Date]",
                "      ,c.[Event Region]",
                "      ,c.[Event Country]",
                "      ,c.[Event City]",
                "      ,c.[Event Doctor Type]",
                "      ,c.[Event Type]",
                "      ,c.[Event SubType]",
                "      ,c.[Event Speaker]",
                "      ,s.Program_Name__c as [Program Name]",
                "  FROM [TABV].[ContinuedEducation_Event] c",
                "\tLEFT JOIN [SFDC_Staging].dbo.Campaign s ON c.[Event ID]=s.ID",
                "WHERE [Event Region]<>'Unknown'"
              ],
              "dataSource": "OTCDM"
            },
            "annotations": [
              {
                "name": "QueryEditorSerialization",
                "value": [
                  "<?xml version=\"1.0\" encoding=\"UTF-16\"?><Gemini xmlns=\"QueryEditorSerialization\"><AnnotationContent><![CDATA[<RSQueryCommandText>SELECT ",
