              "                FILTER('Sales Date', [Quarter]=ReportingQValue),",
              "                FILTER('Customer',[Contact Certification Date]<certDayEnd && [_cust Count Doctors Training Events]=0)",
              "                ),",
              "    ",
              "    \"1 Training\",",
              "       CALCULATE(",
              "                [CCA],",
              "                FILTER('Sales Date', [Quarter]=ReportingQValue),",
              "                FILTER('Customer',[Contact Certification Date]<certDayEnd && [_cust Count Doctors Training Events]=1)",
              "                ),",
              "",
              "    \"2+ Trainings\",",
              "       CALCULATE(",
              "                [CCA],",
              "                FILTER('Sales Date', [Quarter]=ReportingQValue),",
              "                FILTER('Customer',[Contact Certification Date]<certDayEnd && [_cust Count Doctors Training Events]>=2)",
              "                ),",
              "",
              "    BLANK()",
              ")",
              "",
              "",
              "",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "Continued Education"
          },
          {
            "name": "_cust Certified Doctors CCA LY",
            "expression": [
              "",
              "",
              "VAR Params=VALUES('Reporting Date'[Quarter])",
              "",
              "VAR ReportingQSelected=CALCULATETABLE('Reporting Date', Params)",
              "VAR ReportingPrevQ     =CALCULATETABLE('Reporting Date', DATEADD( CALCULATETABLE( VALUES('Reporting Date'[Date]), ReportingQSelected), -1, quarter))",
              "VAR ReportingPrevPrevQ =CALCULATETABLE('Reporting Date', DATEADD( CALCULATETABLE( VALUES('Reporting Date'[Date]), ReportingQSelected), -2, quarter))",
              "VAR ReportingQLY =CALCULATETABLE('Reporting Date', DATEADD( CALCULATETABLE( VALUES('Reporting Date'[Date]), ReportingQSelected), -1, year))",
              "",
              "VAR ReportingQValue=CALCULATE(VALUES('Reporting Date'[Quarter]), ALL('Reporting Date'), ReportingQSelected)",
              "VAR ReportingPrevQValue=CALCULATE(VALUES('Reporting Date'[Quarter]), ALL('Reporting Date'), ReportingPrevQ)",
              "VAR ReportingPrevPrevQValue=CALCULATE(VALUES('Reporting Date'[Quarter]), ALL('Reporting Date'), ReportingPrevPrevQ)",
              "VAR ReportingQLYValue=CALCULATE(VALUES('Reporting Date'[Quarter]), ALL('Reporting Date'), ReportingQLY)",
              "",
              "VAR SelectedDoctorGroup=IF(HASONEVALUE('Continued Education Doctor Group'[Doctor Training Group]),VALUES('Continued Education Doctor Group'[Doctor Training Group]),BLANK())",
              "VAR minSalesDate=CALCULATE(MIN('Reporting Date'[Date]), 'Reporting Date'[Quarter]=ReportingQValue)",
              "VAR certDayEnd=DATE( YEAR(minSalesDate)-1, MONTH(minSalesDate),DAY(minSalesDate))",
              "",
              "RETURN ",
              "SWITCH( SelectedDoctorGroup,",
              "",
              "    \"0 Trainings\",",
              "       CALCULATE(",
              "                [CCA],",
              "                FILTER('Sales Date', [Quarter]=ReportingQLYValue),",
              "                FILTER('Customer',[Contact Certification Date]<certDayEnd && [_cust Count Doctors Training Events]=0)",
              "                ),",
              "    ",
              "    \"1 Training\",",
              "       CALCULATE(",
              "                [CCA],",
              "                FILTER('Sales Date', [Quarter]=ReportingQLYValue),",
              "                FILTER('Customer',[Contact Certification Date]<certDayEnd && [_cust Count Doctors Training Events]=1)",
              "                ),",
              "",
              "    \"2+ Trainings\",",
              "       CALCULATE(",
              "                [CCA],",
              "                FILTER('Sales Date', [Quarter]=ReportingQLYValue),",
              "                FILTER('Customer',[Contact Certification Date]<certDayEnd && [_cust Count Doctors Training Events]>=2)",
              "                ),",
              "",
              "    BLANK()",
              ")",
              "",
              "",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "Continued Education"
          },
          {
            "name": "_cust Continued Education Sales Growth",
            "expression": [
              "",
              "",
              "VAR NR_CCA =IF(HASONEVALUE('Activation Selection'[NR/CCA]),VALUES('Activation Selection'[NR/CCA]),BLANK())",
              "",
              "RETURN",
              "SWITCH(",
              "    NR_CCA,",
              "    \"NR\",   IF(",
              "                NOT(ISBLANK([_cust Certified Doctors NR CY])) && NOT(ISBLANK([_cust Certified Doctors NR LY])),",
              "                DIVIDE([_cust Certified Doctors NR CY], [_cust Certified Doctors NR LY])-1,",
              "                BLANK()),",
              "",
              "    \"CCA\",  IF(",
              "                NOT(ISBLANK([_cust Certified Doctors CCA CY])) && NOT(ISBLANK([_cust Certified Doctors CCA LY])),",
              "                DIVIDE([_cust Certified Doctors CCA CY],[_cust Certified Doctors CCA LY])-1,",
              "                BLANK()),",
              "    \"NR or CCA context is not provided\")"
            ],
            "formatString": "0%;-0%;0%",
            "displayFolder": "Continued Education"
          },
          {
            "name": "_cust Continued Education Sales CY",
            "expression": [
              "",
              "",
              "VAR NR_CCA=IF(HASONEVALUE('Activation Selection'[NR/CCA]),VALUES('Activation Selection'[NR/CCA]),BLANK())",
              "",
              "RETURN",
              "SWITCH(",
              "    NR_CCA,",
              "    \"NR\",  [_cust Certified Doctors NR CY],",
              "    \"CCA\", [_cust Certified Doctors CCA CY],",
              "    \"NR / CCA context is not selected\")",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "Continued Education"
          },
          {
            "name": "_cust Continued Education Sales LY",
            "expression": [
              "",
              "",
              "VAR NR_CCA=IF(HASONEVALUE('Activation Selection'[NR/CCA]),VALUES('Activation Selection'[NR/CCA]),BLANK())",
              "",
              "RETURN",
              "SWITCH(",
              "    NR_CCA,",
              "    \"NR\",  [_cust Certified Doctors NR LY],",
              "    \"CCA\", [_cust Certified Doctors CCA LY],",
              "    \"NR / CCA context is not selected\")"
            ],
            "formatString": "#,0",
            "displayFolder": "Continued Education"
          },
          {
            "name": "_cust Continued Education Doctors by Groups Count",
            "expression": [
              "",
              "",
              "VAR Params=VALUES('Reporting Date'[Quarter])",
              "",
              "VAR ReportingQSelected=CALCULATETABLE('Reporting Date', Params)",
              "VAR ReportingPrevQ     =CALCULATETABLE('Reporting Date', DATEADD( CALCULATETABLE( VALUES('Reporting Date'[Date]), ReportingQSelected), -1, quarter))",
              "VAR ReportingPrevPrevQ =CALCULATETABLE('Reporting Date', DATEADD( CALCULATETABLE( VALUES('Reporting Date'[Date]), ReportingQSelected), -2, quarter))",
              "VAR ReportingQLY =CALCULATETABLE('Reporting Date', DATEADD( CALCULATETABLE( VALUES('Reporting Date'[Date]), ReportingQSelected), -1, year))",
              "",
              "VAR ReportingQValue=CALCULATE(VALUES('Reporting Date'[Quarter]), ALL('Reporting Date'), ReportingQSelected)",
              "VAR ReportingPrevQValue=CALCULATE(VALUES('Reporting Date'[Quarter]), ALL('Reporting Date'), ReportingPrevQ)",
              "VAR ReportingPrevPrevQValue=CALCULATE(VALUES('Reporting Date'[Quarter]), ALL('Reporting Date'), ReportingPrevPrevQ)",
              "VAR ReportingQLYValue=CALCULATE(VALUES('Reporting Date'[Quarter]), ALL('Reporting Date'), ReportingQLY)",
              "",
              "VAR SelectedDoctorGroup=IF(HASONEVALUE('Continued Education Doctor Group'[Doctor Training Group]),VALUES('Continued Education Doctor Group'[Doctor Training Group]),BLANK())",
              "VAR minSalesDate=CALCULATE(MIN('Reporting Date'[Date]), 'Reporting Date'[Quarter]=ReportingQValue)",
              "VAR certDayEnd=DATE( YEAR(minSalesDate)-1, MONTH(minSalesDate),DAY(minSalesDate))",
              "",
              "RETURN ",
              "SWITCH( SelectedDoctorGroup,",
              "",
              "    \"0 Trainings\",",
              "           CALCULATE(",
              "            DISTINCTCOUNT('Customer'[Contact ClinID]),",
              "            FILTER('Customer',[Contact Certification Date]<certDayEnd && [_cust Count Doctors Training Events]=0 && CALCULATE([NR], 'Sales Date'[Quarter]=ReportingQValue)>0)",
              "                ),",
              "",
              "    \"1 Training\",",
              "           CALCULATE(",
              "            DISTINCTCOUNT('Customer'[Contact ClinID]),",
              "            FILTER('Customer',[Contact Certification Date]<certDayEnd && [_cust Count Doctors Training Events]=1)",
              "                ),",
              "    \"2+ Trainings\",",
              "           CALCULATE(",
              "            DISTINCTCOUNT('Customer'[Contact ClinID]),",
              "            FILTER('Customer',[Contact Certification Date]<certDayEnd && [_cust Count Doctors Training Events]>=2)",
              "                ),",
              "",
              "    BLANK()",
              "",
              ")",
              "",
              "",
              "",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "Continued Education"
          },
          {
            "name": "_cust Continued Education NR/Doc. Growth",
            "expression": [
              "",
              "",
              "VAR NR_CCA =IF(HASONEVALUE('Activation Selection'[NR/CCA]),VALUES('Activation Selection'[NR/CCA]),BLANK())",
              "",
              "RETURN",
              "SWITCH(",
              "    NR_CCA,",
              "    \"NR\",   DIVIDE(",
              "                   [_cust Certified Doctors NR CY]-[_cust Certified Doctors NR LY],",
              "                   [_cust Continued Education Doctors by Groups Count]),",
              "    \"CCA\",  ",
              "            DIVIDE(",
              "                   [_cust Certified Doctors CCA CY]-[_cust Certified Doctors CCA LY],",
              "                   [_cust Continued Education Doctors by Groups Count]),",
              "    \"NR or CCA context is not provided\")"
            ],
            "formatString": "0.00",
            "displayFolder": "Continued Education"
          },
          {
            "name": "Activation % CCA 6+ @180",
            "expression": [
              "",
              "",
              "/*Activation CCA 3+ is % of trained doctors who have 3+ CCA at @N days after event",
              "The measure should be used with proper context of Event Date filter",
              "*/",
              "",
              "VAR trainedDoctors=FILTER(DISTINCT('Activation Event Member'[Clin ID]), [Days After Activation Event]>=180)",
              "VAR activatedDoctors=FILTER(trainedDoctors, [CCA @ 180]>=6)",
              "",
              "RETURN ",
              "",
              "DIVIDE(COUNTROWS(activatedDoctors),COUNTROWS(trainedDoctors))"
            ],
            "formatString": "0%;-0%;0%",
            "displayFolder": "Activation\\CCA"
          },
          {
            "name": "Activation % NR 6+ @180",
            "expression": [
              "",
