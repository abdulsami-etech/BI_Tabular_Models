              "\t\t\t\tc.[CampaignID]      as [Event ID],",
              "\t\t\t\tc.CampaignName      as [Event Name],",
              "\t\t\t\tc.EventDate\t        as [Event Date],",
              "",
              "\t\t\t\tCASE\tWHEN c.EventCountry in ('GB', 'IE') THEN 'UKI' ",
              "\t\t\t\t\t\tWHEN c.EventCountry in ('FR') THEN 'FRANCE' ",
              "\t\t\t\t\t\tWHEN c.EventCountry in ('DE', 'AT', 'CH') THEN 'DACH' ",
              "\t\t\t\t\t\tWHEN c.EventCountry in ('ES', 'PT') THEN 'IBERIA' ",
              "\t\t\t\t\t\tWHEN c.EventCountry in ('IT', 'SM', 'MT') THEN 'ITALY' ",
              "\t\t\t\t\t\tWHEN c.EventCountry in ('PL', 'CZ', 'SK', 'LV', 'LT', 'EE', 'HU', 'RO', 'BG', 'GR', 'CY', 'SI','IL') THEN 'EE-IL' ",
              "\t\t\t\t\t\tWHEN c.EventCountry in ('NL', 'BE', 'LU') THEN 'BENELUX' ",
              "\t\t\t\t\t\tWHEN c.EventCountry in ('DK', 'SE', 'NO', 'FI') THEN 'NORDICS' ",
              "\t\t\t\t\t\tWHEN c.EventCountry in ('TR') THEN 'TURKEY'",
              "\t\t\t\t\t\tWHEN c.EventCountry in ('RU') THEN 'RUSSIA'",
              "\t\t\t\t\t\tWHEN c.EventCountry in ('AE', 'KW',  'SA', 'BH', 'QA') THEN 'MEA'",
              "\t\t\t\tELSE 'Unknown' END  as [Event Region],",
              "\t\t\t\tc.EventCountry      as [Event Country],",
              "\t\t\t\tc.EventCity         as [Event City],",
              "\t\t\t\tc.DoctorType        as [Event Doctor Type],",
              "\t\t\t\tc.EventTypePicklist as [Event Type],",
              "\t\t\t\tc.EventSubType\t\tas [Event SubType],",
              "",
              "\t\t\t\tsp.[ContactName]    as [Event Speaker],",
              "\t\t\t\tc.[Status]",
              "",
              "\t\t\tFROM [DM].[DimCampaign] c",
              "\t\t\t\tLEFT JOIN [DM].[DimCustContact] sp on sp.ContactID=c.Speaker1",
              "\t\t\tWHERE",
              "\t\t\t\t(c.EventTypePicklist IN ('C1','C11','ETCA','ETC1','MD 1','DSO MD1','MDU1','TCA','TC 1','Bridging programme'))",
              "",
              "\t\t\t\tand c.IsDeleted='false'",
              "\t\t\t\tand (c.[Status]='Completed'  OR c.EventSubType='Fully online')",
              "\t\t\t\t",
              "\t\t\t)",
              "SELECT [Event ID]",
              "      ,[Event Name]",
              "      ,[Event Date]",
              "      ,[Status]",
              "      ,[Event Region]",
              "      ,[Event Country]",
              "      ,[Event City]",
              "      ,[Event Doctor Type]",
              "      ,[Event Type]",
              "      ,[Event SubType]",
              "      ,[Event Speaker]",
              "  FROM events",
              "WHERE [Event Region]<>'Unknown'"
            ]
          },
          {
            "name": "_TM_ExtProp_DbTableName",
            "value": "Activation Event"
          },
