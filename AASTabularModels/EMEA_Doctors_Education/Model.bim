            "description": "Stickiness is % of trained doctors who have 1+ NR or CCA at @N days after event. The measure should be used with proper context of Event Date filter",
            "expression": [
              "",
              "",
              "VAR days=IF(HASONEVALUE('Activation Selection'[Activation Days]),VALUES('Activation Selection'[Activation Days]))",
