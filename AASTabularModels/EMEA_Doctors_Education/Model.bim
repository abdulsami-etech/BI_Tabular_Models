            "sourceColumn": "[Year]",
            "summarizeBy": "none"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Portfolio",
            "dataType": "string",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Portfolio]"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Value",
            "dataType": "double",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Value]",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "CalculatedTable 1",
            "source": {
              "type": "calculated",
              "expression": [
                "",
                "DATATABLE (",
                "    ",
                "    \"KPI Name\", STRING,",
                "    \"Year\", INTEGER,",
                "    \"Portfolio\", STRING,",
                "    \"Value\", DOUBLE,",
                "    ",
                "    { ",
                "        {\"Doctors Trained\",         2018,\"Full Portfolio\", 2200},",
                "        {\"% stickiness @ 90 days\",  2018,\"Full Portfolio\", 0.45},",
                "        {\"% stickiness @ 180 days\", 2018,\"Full Portfolio\", 0.65},",
                "        {\"% stickiness @ 365 days\", 2018,\"Full Portfolio\", 0.70},",
                "        {\"NR/Submitter @ 90 days\",  2018,\"Full Portfolio\", 3.9},",
                "        {\"NR/Submitter @ 180 days\", 2018,\"Full Portfolio\", 5.5},",
                "        {\"NR/Submitter @ 365 days\", 2018,\"Full Portfolio\", 10.2},",
                "        {\"Activation % Internal\",   2018,\"Full Portfolio\", 0.35},",
                "        {\"Activation % External\",   2018,\"Full Portfolio\", 0.68},",
                "        {\"Activation % Total\",      2018,\"Full Portfolio\", 0.45},",
                "",
                "        {\"Doctors Trained\",         2018,\"GP Invisalign Go\", 4000},",
                "        {\"% stickiness @ 30 days\",  2018,\"GP Invisalign Go\", 0.60},",
                "        {\"NR/Submitter @ 30 days\",  2018,\"GP Invisalign Go\", 1.0},",
                "        {\"NR/Submitter @ 90 days\",  2018,\"GP Invisalign Go\", 2.7},",
                "        {\"NR/Submitter @ 180 days\", 2018,\"GP Invisalign Go\", 3.5},",
                "        {\"NR/Submitter @ 365 days\", 2018,\"GP Invisalign Go\", 5.0},",
                "        {\"Activation % Total\",      2018,\"GP Invisalign Go\", 0.45},",
                "",
                "        {\"Doctors Trained\",         2018,\"GP Full\", 800},",
                "        {\"Doctors Trained\",         2018,\"GP iGO\", 4000},",
                "        {\"Doctors Trained\",         2018,\"Ortho\", 1400},        ",
                "",
                "        {\"Doctors Trained\",         2019,\"GP Full\", 1000},",
                "        {\"Doctors Trained\",         2019,\"GP iGO\", 4000},",
                "        {\"Doctors Trained\",         2019,\"Ortho\", 1500},",
                "",
                "        {\"Activation Overall\",         2019,\"GP Full\", 0.2},",
                "        {\"Activation Overall\",         2019,\"GP iGO\", 0.2},",
                "        {\"Activation Overall\",         2019,\"Ortho\", 0.32},",
                "",
                "        {\"Activation Internal\",         2019,\"GP Full\", 0.30},",
                "        {\"Activation Internal\",         2019,\"GP iGO\", BLANK()},",
                "        {\"Activation Internal\",         2019,\"Ortho\", 0.35},",
                "",
                "        {\"Activation External\",         2019,\"GP Full\", BLANK()},",
                "        {\"Activation External\",         2019,\"GP iGO\", BLANK()},",
                "        {\"Activation External\",         2019,\"Ortho\", 0.28},",
                "",
                "        {\"Approvers 1+ at 90\",          2019,\"GP Full\", 0.55},",
                "        {\"Approvers 1+ at 90\",          2019,\"GP iGO\", 0.55},",
                "        {\"Approvers 1+ at 90\",          2019,\"Ortho\", 0.65},",
                "",
