            "source": {
              "type": "query",
              "query": [
                "WITH Customer_EMEA as  (",
                "",
                "SELECT",
                "\t[CustomerKey],",
                "",
                "\t--Contact Attributes",
                "\tContactKey,",
                "\tContactID,",
                "\tContactNumber,",
                "\tContactName,",
                "\tContactOwnerID,",
                "\tContactRecordType,",
                "\tContactLineofBusiness,",
                "\tcase when ContactLineofBusiness like '%Invisalign Go%' then 'iGo' else 'Non-iGo' end as ContactLineofBusinessType,",
                "\tContactProfessionalCategory,",
                "\tContactStatus,",
                "\tContactCertificationDate,",
                "\tContactClinID,",
                "",
                "",
                "\t--Account Attributes",
                "\tAccountKey,",
                "\tAccountID,",
                "\tAccountNumber,",
                "\tAccountOwnerID,",
                "\tAccountName,",
                "\tAccountRecordType,",
                "\tAccountStatus,",
                "\tAccountLineofBusiness,",
                "\tcase when AccountLineofBusiness like '%Invisalign Go%' then 'iGo' else 'Non-iGo' end as AccountLineofBusinessType,",
                "\tAccountCountry,",
                "\tAccountCountryGroup,",
                "\tAccountRegionPC,",
                "\tAccountRegionGroup,",
                "\tAccountCity,",
                "",
                "\t--Invisalign Sales Hierarchy (Territory - lowest level)",
                "\tSalesTerritoryID",
                "",
                "",
                "FROM TABV.Customer",
                "",
                "WHERE ",
                "\t[AccountRegionGroup]='EMEA'",
                ")",
                "",
                "",
                "",
                "SELECT",
                "\t [CustomerKey]\t\t\t\t\t\t\t\t\t\tas [Customer Key]",
                "\t,[ContactKey]",
                "\t,[ContactID]\t\t\t\t\t\t\t\t\t\tas [Contact ID]",
                "\t,[ContactNumber]\t\t\t\t\t\t\t\t\tas [Contact Number]",
                "\t,[ContactName]\t\t\t\t\t\t\t\t\t\tas [Contact Name]",
                "\t,[ContactOwnerID]\t\t\t\t\t\t\t\t\tas [Contact Owner ID]",
                "\t,[ContactRecordType]\t\t\t\t\t\t\t\tas [Contact Record Type]",
                "\t,[ContactLineofBusiness]\t\t\t\t\t\t\tas [Contact Line of Business]",
                "\t,[ContactLineofBusinessType]\t\t\t\t\t\tas [Contact Line of Business Type]",
                "\t,[ContactProfessionalCategory]\t\t\t\t\t\tas [Contact Professional Category]",
                "\t,[ContactStatus]\t\t\t\t\t\t\t\t\tas [Contact Status]",
                "\t,[ContactCertificationDate]\t\t\t\t\t\t\tas [Contact Certification Date]",
                "\t,[ContactClinID]\t\t\t\t\t\t\t\t\tas [Contact ClinID]",
                "",
                "\t,[AccountKey]",
                "\t,[AccountID]\t\t\t\t\t\t\t\t\t\tas [Account ID]",
                "\t,[AccountNumber]\t\t\t\t\t\t\t\t\tas\t[Account Number]",
                "\t,[AccountOwnerID]\t\t\t\t\t\t\t\t\tas [Account Owner ID]",
                "\t,[AccountName]\t\t\t\t\t\t\t\t\t\tas [Account Name]",
                "\t,[AccountRecordType]\t\t\t\t\t\t\t\tas [Account Record Type]",
                "\t,[AccountStatus]\t\t\t\t\t\t\t\t\tas [Account Status]",
                "\t,[AccountLineofBusiness]\t\t\t\t\t\t\tas [Account Line of Business]",
                "\t,[AccountLineofBusinessType]\t\t\t\t\t\tas [Account Line of Business Type]",
                "\t,[AccountCountry]\t\t\t\t\t\t\t\t\tas [Account Country]",
                "\t,[AccountCountryGroup]\t\t\t\t\t\t\t\tas[Account Country Group]",
                "\t,[AccountRegionPC]\t\t\t\t\t\t\t\t\tas [Account RegionPC]",
                "\t,[AccountRegionGroup]\t\t\t\t\t\t\t\tas [Account Region Group]",
                "\t,[SalesTerritoryID]\t\t\t\t\t\t\t\t\tas [SalesTerritoryID]",
                "",
                "FROM Customer_EMEA"
              ],
              "dataSource": "OTCDM"
            },
            "annotations": [
              {
                "name": "QueryEditorSerialization",
                "value": [
                  "<?xml version=\"1.0\" encoding=\"UTF-16\"?><Gemini xmlns=\"QueryEditorSerialization\"><AnnotationContent><![CDATA[<RSQueryCommandText>WITH Customer_EMEA as  (",
                  "",
                  "SELECT",
                  "\t[CustomerKey],",
                  "",
