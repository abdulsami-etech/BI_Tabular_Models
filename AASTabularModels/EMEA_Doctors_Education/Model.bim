          {
            "name": "_cust % stickiness LY",
            "expression": [
              " ",
              "",
              "VAR days=IF(HASONEVALUE('Activation Selection'[Activation Days]),VALUES('Activation Selection'[Activation Days]),BLANK())",
              "",
              "VAR period30  = DATEADD(DATEADD('Reporting Date'[Date],-1,QUARTER),-1,YEAR)",
              "VAR period90  = DATEADD(DATEADD('Reporting Date'[Date],-1,QUARTER),-1,YEAR)",
              "VAR period180 = DATEADD(DATEADD('Reporting Date'[Date],-2,QUARTER),-1,YEAR)",
              "VAR period365 = DATEADD(DATEADD('Reporting Date'[Date],-4,QUARTER),-1,YEAR)",
              "",
              "VAR calcQCode30  = CALCULATE(MAX('Reporting Date'[Quarter Code]),Period30)",
              "VAR calcQCode90  = CALCULATE(MAX('Reporting Date'[Quarter Code]),Period90)",
              "VAR calcQCode180 = CALCULATE(MAX('Reporting Date'[Quarter Code]),Period180)",
              "VAR calcQCode365 = CALCULATE(MAX('Reporting Date'[Quarter Code]),Period365)",
              "",
              "",
              "RETURN",
              "SWITCH( days,",
              "",
              "    30,  CALCULATE([Stickiness % Selected], 'Activation Selection'[Activation Days]=30,  FILTER('Activation Event',[Event Quarter Code]=calcQCode30)),",
              "    90,  CALCULATE([Stickiness % Selected], 'Activation Selection'[Activation Days]=90,  FILTER('Activation Event',[Event Quarter Code]=calcQCode90)),",
              "    180, CALCULATE([Stickiness % Selected], 'Activation Selection'[Activation Days]=180, FILTER('Activation Event',[Event Quarter Code]=calcQCode180)),",
              "    365, CALCULATE([Stickiness % Selected], 'Activation Selection'[Activation Days]=365, FILTER('Activation Event',[Event Quarter Code]=calcQCode365)),",
              "",
              "BLANK())"
            ],
            "formatString": "0%;-0%;0%",
            "displayFolder": "Stickiness\\General"
          },
          {
            "name": "_cust % stickiness CY",
            "expression": [
              " ",
              "",
              "VAR days=IF(HASONEVALUE('Activation Selection'[Activation Days]),VALUES('Activation Selection'[Activation Days]),BLANK())",
              "",
              "VAR period30  = DATEADD('Reporting Date'[Date],-1,QUARTER)",
              "VAR period90  = DATEADD('Reporting Date'[Date],-1,QUARTER)",
              "VAR period180 = DATEADD('Reporting Date'[Date],-2,QUARTER)",
              "VAR period365 = DATEADD('Reporting Date'[Date],-4,QUARTER)",
              "",
              "VAR calcQCode30  = CALCULATE(MAX('Reporting Date'[Quarter Code]),Period30)",
              "VAR calcQCode90  = CALCULATE(MAX('Reporting Date'[Quarter Code]),Period90)",
              "VAR calcQCode180 = CALCULATE(MAX('Reporting Date'[Quarter Code]),Period180)",
              "VAR calcQCode365 = CALCULATE(MAX('Reporting Date'[Quarter Code]),Period365)",
              "",
              "",
              "RETURN",
              "SWITCH( days,",
              "    ",
              "    30,  CALCULATE([Stickiness % Selected], 'Activation Selection'[Activation Days]=30,  FILTER('Activation Event',[Event Quarter Code]=calcQCode30)),",
              "    90,  CALCULATE([Stickiness % Selected], 'Activation Selection'[Activation Days]=90,  FILTER('Activation Event',[Event Quarter Code]=calcQCode90)),",
              "    180, CALCULATE([Stickiness % Selected], 'Activation Selection'[Activation Days]=180, FILTER('Activation Event',[Event Quarter Code]=calcQCode180)),",
              "    365, CALCULATE([Stickiness % Selected], 'Activation Selection'[Activation Days]=365, FILTER('Activation Event',[Event Quarter Code]=calcQCode365)),",
              "",
              "BLANK())"
            ],
            "formatString": "0%;-0%;0%",
            "displayFolder": "Stickiness\\General"
          },
