            "displayFolder": "Averages\\General"
          },
          {
            "name": "_cust Activation 3+ % CY",
            "expression": [
              " ",
              "",
              "VAR period90 = DATEADD('Reporting Date'[Date],-1,QUARTER)",
              "VAR calcQCode90 = CALCULATE(MAX('Reporting Date'[Quarter Code]),period90)",
              "",
              "RETURN",
              "    CALCULATE([Activation % 3+ @90 Selected], FILTER('Activation Event',[Event Quarter Code]=calcQCode90))"
            ],
            "formatString": "0%;-0%;0%",
            "displayFolder": "Activation\\General"
          },
          {
            "name": "_cust Activation 3+ % LY",
            "expression": [
              " ",
              "",
              "VAR period90 = DATEADD(DATEADD('Reporting Date'[Date],-1,QUARTER),-1,YEAR)",
              "VAR calcQCode90 = CALCULATE(MAX('Reporting Date'[Quarter Code]),Period90)",
              "",
              "RETURN",
              "    CALCULATE([Activation % 3+ @90 Selected], FILTER('Activation Event',[Event Quarter Code]=calcQCode90))"
            ],
            "formatString": "0%;-0%;0%",
            "displayFolder": "Activation\\General"
          },
          {
            "name": "_cust Activation 3+ % Target Total iGO",
            "expression": [
              " ",
              "",
              "VAR reportYear=MAX('Reporting Date'[Year])",
              "VAR portfolio=IF(HASONEVALUE('Customer'[Portfolio]),VALUES('Customer'[Portfolio]),BLANK())",
              "VAR NR_CCA=IF(HASONEVALUE('Activation Selection'[NR/CCA]),VALUES('Activation Selection'[NR/CCA]),BLANK())",
              "",
              "RETURN",
              "IF (portfolio=\"GP Invisalign Go\" && NR_CCA=\"NR\",",
              "    CALCULATE(MAX('Targets'[Value]),Targets[Year]=reportYear,'Targets'[Portfolio]=\"GP Invisalign Go\", 'Targets'[KPI Name]=\"Activation % Total\")",
              "    ,BLANK()",
              ")"
            ],
            "formatString": "0%;-0%;0%",
            "displayFolder": "Targets"
          },
          {
            "name": "_cust Doctors Trained Target iGO",
            "expression": [
              " ",
              "",
              "VAR reportYear=MAX('Reporting Date'[Year])",
              "VAR portfolio=IF(HASONEVALUE('Customer'[Portfolio]),VALUES('Customer'[Portfolio]),BLANK())",
              "",
              "RETURN",
              "IF (portfolio=\"GP Invisalign Go\",",
              "    CALCULATE(MAX('Targets'[Value]),Targets[Year]=reportYear,'Targets'[Portfolio]=\"GP Invisalign Go\", 'Targets'[KPI Name]=\"Doctors Trained\"),",
              "    BLANK()",
              ")"
            ],
            "formatString": "0",
            "displayFolder": "Targets"
          },
          {
            "name": "_cust % stickiness Target iGO",
            "expression": [
              " ",
              "",
              "VAR days=IF(HASONEVALUE('Activation Selection'[Activation Days]),VALUES('Activation Selection'[Activation Days]),BLANK())",
              "",
              "VAR reportYear=MAX('Reporting Date'[Year])",
              "VAR portfolio=IF(HASONEVALUE('Customer'[Portfolio]),VALUES('Customer'[Portfolio]),BLANK())",
              "VAR NR_CCA=IF(HASONEVALUE('Activation Selection'[NR/CCA]),VALUES('Activation Selection'[NR/CCA]),BLANK())",
              "",
              "RETURN",
              "IF (portfolio=\"GP Invisalign Go\" && NR_CCA=\"NR\",",
              "    SWITCH( days,",
              "            30,  CALCULATE(MAX('Targets'[Value]),Targets[Year]=reportYear,'Targets'[Portfolio]=\"GP Invisalign Go\", 'Targets'[KPI Name]=\"% stickiness @ 30 days\"),",
              "    BLANK()",
              ")",
              ")"
            ],
            "formatString": "0%;-0%;0%",
            "displayFolder": "Targets"
          },
          {
            "name": "_cust NR/Submitter Target iGO",
            "expression": [
              " ",
              "",
              "VAR days=IF(HASONEVALUE('Activation Selection'[Activation Days]),VALUES('Activation Selection'[Activation Days]),BLANK())",
              "",
              "VAR reportYear=MAX('Reporting Date'[Year])",
              "VAR portfolio=IF(HASONEVALUE('Customer'[Portfolio]),VALUES('Customer'[Portfolio]),BLANK())",
              "VAR NR_CCA=IF(HASONEVALUE('Activation Selection'[NR/CCA]),VALUES('Activation Selection'[NR/CCA]),BLANK())",
              "",
              "RETURN",
              "IF (portfolio=\"GP Invisalign Go\" && NR_CCA=\"NR\",",
              "    SWITCH( days,",
              "            30,  CALCULATE(MAX('Targets'[Value]),Targets[Year]=reportYear,'Targets'[Portfolio]=\"GP Invisalign Go\", 'Targets'[KPI Name]=\"NR/Submitter @ 30 days\"),",
              "            90,  CALCULATE(MAX('Targets'[Value]),Targets[Year]=reportYear,'Targets'[Portfolio]=\"GP Invisalign Go\", 'Targets'[KPI Name]=\"NR/Submitter @ 90 days\"),",
              "            180, CALCULATE(MAX('Targets'[Value]),Targets[Year]=reportYear,'Targets'[Portfolio]=\"GP Invisalign Go\", 'Targets'[KPI Name]=\"NR/Submitter @ 180 days\"),",
              "            365, CALCULATE(MAX('Targets'[Value]),Targets[Year]=reportYear,'Targets'[Portfolio]=\"GP Invisalign Go\", 'Targets'[KPI Name]=\"NR/Submitter @ 365 days\"),",
              "    BLANK()",
              ")",
              ")"
            ],
            "formatString": "0.00",
            "displayFolder": "Targets"
          },
          {
            "name": "_cust Certified Doctors NR CY",
            "expression": [
              "",
              "",
              "VAR Params=VALUES('Reporting Date'[Quarter])",
              "",
              "VAR ReportingQSelected=CALCULATETABLE('Reporting Date', Params)",
              "VAR ReportingPrevQ     =CALCULATETABLE('Reporting Date', DATEADD( CALCULATETABLE( VALUES('Reporting Date'[Date]), ReportingQSelected), -1, quarter))",
              "VAR ReportingPrevPrevQ =CALCULATETABLE('Reporting Date', DATEADD( CALCULATETABLE( VALUES('Reporting Date'[Date]), ReportingQSelected), -2, quarter))",
              "VAR ReportingQLY =CALCULATETABLE('Reporting Date', DATEADD( CALCULATETABLE( VALUES('Reporting Date'[Date]), ReportingQSelected), -1, year))",
              "",
              "VAR ReportingQValue=CALCULATE(VALUES('Reporting Date'[Quarter]), ALL('Reporting Date'), ReportingQSelected)",
              "VAR ReportingPrevQValue=CALCULATE(VALUES('Reporting Date'[Quarter]), ALL('Reporting Date'), ReportingPrevQ)",
              "VAR ReportingPrevPrevQValue=CALCULATE(VALUES('Reporting Date'[Quarter]), ALL('Reporting Date'), ReportingPrevPrevQ)",
              "VAR ReportingQLYValue=CALCULATE(VALUES('Reporting Date'[Quarter]), ALL('Reporting Date'), ReportingQLY)",
              "",
              "VAR SelectedDoctorGroup=IF(HASONEVALUE('Continued Education Doctor Group'[Doctor Training Group]),VALUES('Continued Education Doctor Group'[Doctor Training Group]),BLANK())",
              "VAR minSalesDate=CALCULATE(MIN('Reporting Date'[Date]), 'Reporting Date'[Quarter]=ReportingQValue)",
              "VAR certDayEnd=DATE( YEAR(minSalesDate)-1, MONTH(minSalesDate),DAY(minSalesDate))",
              "",
              "RETURN ",
              "SWITCH( SelectedDoctorGroup,",
              "",
              "    \"0 Trainings\",",
              "       CALCULATE(",
              "                [NR],",
              "                FILTER('Sales Date', [Quarter]=ReportingQValue),",
              "                FILTER('Customer',[Contact Certification Date]<certDayEnd && [_cust Count Doctors Training Events]=0)",
              "                ),",
              "    ",
              "    \"1 Training\",",
              "       CALCULATE(",
              "                [NR],",
              "                FILTER('Sales Date', [Quarter]=ReportingQValue),",
              "                FILTER('Customer',[Contact Certification Date]<certDayEnd && [_cust Count Doctors Training Events]=1)",
              "                ),",
              "",
              "    \"2+ Trainings\",",
              "       CALCULATE(",
              "                [NR],",
              "                FILTER('Sales Date', [Quarter]=ReportingQValue),",
              "                FILTER('Customer',[Contact Certification Date]<certDayEnd && [_cust Count Doctors Training Events]>=2)",
              "                ),",
              "",
              "    BLANK()",
              ")",
              "",
              "",
              "",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "Continued Education"
          },
          {
            "name": "_cust Certified Doctors NR LY",
            "expression": [
              "",
              "",
              "VAR Params=VALUES('Reporting Date'[Quarter])",
              "",
              "VAR ReportingQSelected=CALCULATETABLE('Reporting Date', Params)",
              "VAR ReportingPrevQ     =CALCULATETABLE('Reporting Date', DATEADD( CALCULATETABLE( VALUES('Reporting Date'[Date]), ReportingQSelected), -1, quarter))",
              "VAR ReportingPrevPrevQ =CALCULATETABLE('Reporting Date', DATEADD( CALCULATETABLE( VALUES('Reporting Date'[Date]), ReportingQSelected), -2, quarter))",
              "VAR ReportingQLY =CALCULATETABLE('Reporting Date', DATEADD( CALCULATETABLE( VALUES('Reporting Date'[Date]), ReportingQSelected), -1, year))",
              "",
              "VAR ReportingQValue=CALCULATE(VALUES('Reporting Date'[Quarter]), ALL('Reporting Date'), ReportingQSelected)",
              "VAR ReportingPrevQValue=CALCULATE(VALUES('Reporting Date'[Quarter]), ALL('Reporting Date'), ReportingPrevQ)",
              "VAR ReportingPrevPrevQValue=CALCULATE(VALUES('Reporting Date'[Quarter]), ALL('Reporting Date'), ReportingPrevPrevQ)",
              "VAR ReportingQLYValue=CALCULATE(VALUES('Reporting Date'[Quarter]), ALL('Reporting Date'), ReportingQLY)",
              "",
              "VAR SelectedDoctorGroup=IF(HASONEVALUE('Continued Education Doctor Group'[Doctor Training Group]),VALUES('Continued Education Doctor Group'[Doctor Training Group]),BLANK())",
              "VAR minSalesDate=CALCULATE(MIN('Reporting Date'[Date]), 'Reporting Date'[Quarter]=ReportingQValue)",
              "VAR certDayEnd=DATE( YEAR(minSalesDate)-1, MONTH(minSalesDate),DAY(minSalesDate))",
              "",
              "RETURN ",
              "SWITCH( SelectedDoctorGroup,",
              "",
              "    \"0 Trainings\",",
              "       CALCULATE(",
              "                [NR],",
              "                FILTER('Sales Date', [Quarter]=ReportingQLYValue),",
              "                FILTER('Customer',[Contact Certification Date]<certDayEnd && [_cust Count Doctors Training Events]=0)",
              "                ),",
              "    ",
              "    \"1 Training\",",
              "       CALCULATE(",
              "                [NR],",
              "                FILTER('Sales Date', [Quarter]=ReportingQLYValue),",
              "                FILTER('Customer',[Contact Certification Date]<certDayEnd && [_cust Count Doctors Training Events]=1)",
              "                ),",
              "",
              "    \"2+ Trainings\",",
              "       CALCULATE(",
              "                [NR],",
              "                FILTER('Sales Date', [Quarter]=ReportingQLYValue),",
              "                FILTER('Customer',[Contact Certification Date]<certDayEnd && [_cust Count Doctors Training Events]>=2)",
              "                ),",
              "",
              "    BLANK()",
              ")",
              "",
              "",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "Continued Education"
          },
          {
            "name": "_cust Count Doctors Training Events",
            "expression": [
              "",
              "VAR Params=VALUES('Reporting Date'[Quarter Code])",
              "",
              "VAR ReportingQSelected=CALCULATETABLE('Reporting Date', Params)",
              "VAR ReportingPrevQ     =CALCULATETABLE('Reporting Date', DATEADD( CALCULATETABLE( VALUES('Reporting Date'[Date]), ReportingQSelected), -1, quarter))",
              "VAR ReportingPrevPrevQ =CALCULATETABLE('Reporting Date', DATEADD( CALCULATETABLE( VALUES('Reporting Date'[Date]), ReportingQSelected), -2, quarter))",
              "VAR ReportingQLY =CALCULATETABLE('Reporting Date', DATEADD( CALCULATETABLE( VALUES('Reporting Date'[Date]), ReportingQSelected), -1, year))",
              "",
              "VAR ReportingQValue=CALCULATE(VALUES('Reporting Date'[Quarter Code]), ALL('Reporting Date'), ReportingQSelected)",
              "VAR ReportingPrevQValue=CALCULATE(VALUES('Reporting Date'[Quarter Code]), ALL('Reporting Date'), ReportingPrevQ)",
              "VAR ReportingPrevPrevQValue=CALCULATE(VALUES('Reporting Date'[Quarter Code]), ALL('Reporting Date'), ReportingPrevPrevQ)",
              "VAR ReportingQLYValue=CALCULATE(VALUES('Reporting Date'[Quarter Code]), ALL('Reporting Date'), ReportingQLY)",
              "",
              "RETURN",
              "CALCULATE(",
              "    COUNTROWS('Continued Education Event'),",
              "    FILTER('Continued Education Event', [Event Quarter]>ReportingQLYValue && [Event Quarter]<ReportingQValue)",
              "        )",
              ""
            ],
            "displayFolder": "Continued Education"
          },
          {
            "name": "_cust Certified Doctors CCA CY",
            "expression": [
              "",
              "",
              "VAR Params=VALUES('Reporting Date'[Quarter])",
              "",
              "VAR ReportingQSelected=CALCULATETABLE('Reporting Date', Params)",
              "VAR ReportingPrevQ     =CALCULATETABLE('Reporting Date', DATEADD( CALCULATETABLE( VALUES('Reporting Date'[Date]), ReportingQSelected), -1, quarter))",
              "VAR ReportingPrevPrevQ =CALCULATETABLE('Reporting Date', DATEADD( CALCULATETABLE( VALUES('Reporting Date'[Date]), ReportingQSelected), -2, quarter))",
              "VAR ReportingQLY =CALCULATETABLE('Reporting Date', DATEADD( CALCULATETABLE( VALUES('Reporting Date'[Date]), ReportingQSelected), -1, year))",
              "",
              "VAR ReportingQValue=CALCULATE(VALUES('Reporting Date'[Quarter]), ALL('Reporting Date'), ReportingQSelected)",
              "VAR ReportingPrevQValue=CALCULATE(VALUES('Reporting Date'[Quarter]), ALL('Reporting Date'), ReportingPrevQ)",
              "VAR ReportingPrevPrevQValue=CALCULATE(VALUES('Reporting Date'[Quarter]), ALL('Reporting Date'), ReportingPrevPrevQ)",
              "VAR ReportingQLYValue=CALCULATE(VALUES('Reporting Date'[Quarter]), ALL('Reporting Date'), ReportingQLY)",
              "",
              "VAR SelectedDoctorGroup=IF(HASONEVALUE('Continued Education Doctor Group'[Doctor Training Group]),VALUES('Continued Education Doctor Group'[Doctor Training Group]),BLANK())",
              "VAR minSalesDate=CALCULATE(MIN('Reporting Date'[Date]), 'Reporting Date'[Quarter]=ReportingQValue)",
              "VAR certDayEnd=DATE( YEAR(minSalesDate)-1, MONTH(minSalesDate),DAY(minSalesDate))",
              "",
              "RETURN ",
