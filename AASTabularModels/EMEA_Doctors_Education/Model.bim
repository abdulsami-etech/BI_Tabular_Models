{
  "name": "Doctors Education Tabular",
  "compatibilityLevel": 1550,
  "model": {
    "culture": "en-US",
    "dataSources": [
      {
        "name": "OTCDM",
        "connectionString": "Provider=SQLOLEDB.1;Data Source=prdus2bidbasql2;Persist Security Info=True;User ID=SAPBOBJSQL;Initial Catalog=OTCDM",
        "impersonationMode": "impersonateServiceAccount",
        "maxConnections": 1,
        "annotations": [
          {
            "name": "ConnectionEditUISource",
            "value": "SqlServer"
          }
        ]
      }
    ],
    "tables": [
      {
        "name": "Activation Event",
        "columns": [
          {
            "name": "Event ID",
            "dataType": "string",
            "isHidden": true,
            "isUnique": true,
            "isKey": true,
            "isNullable": false,
            "sourceColumn": "Event ID",
            "sourceProviderType": "VarChar"
          },
          {
            "name": "Event Name",
            "dataType": "string",
            "sourceColumn": "Event Name",
            "sourceProviderType": "VarChar"
          },
          {
            "name": "Event Date",
            "dataType": "dateTime",
            "sourceColumn": "Event Date",
            "formatString": "dd.MM.yyyy",
            "sourceProviderType": "Date",
            "displayFolder": "Event Date Hierarchy",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"DateTimeCustom\"><DateTimes><DateTime LCID=\"1049\" Group=\"ShortDate\" FormatString=\"dd.MM.yyyy\" /></DateTimes></Format>"
              }
            ]
          },
          {
            "name": "Event Region",
            "dataType": "string",
            "sourceColumn": "Event Region",
            "sourceProviderType": "VarChar"
          },
          {
            "name": "Event Country",
            "dataType": "string",
            "sourceColumn": "Event Country",
            "sourceProviderType": "VarChar"
          },
          {
            "name": "Event City",
            "dataType": "string",
            "sourceColumn": "Event City",
            "sourceProviderType": "VarChar"
          },
          {
            "name": "Event Doctor Type",
            "dataType": "string",
            "sourceColumn": "Event Doctor Type",
            "sourceProviderType": "VarChar"
          },
          {
            "name": "Event Type",
            "dataType": "string",
            "sourceColumn": "Event Type",
            "sourceProviderType": "VarChar"
          },
          {
            "name": "Event SubType",
            "dataType": "string",
            "sourceColumn": "Event SubType",
            "sourceProviderType": "VarChar"
          },
          {
            "name": "Event Speaker",
            "dataType": "string",
            "sourceColumn": "Event Speaker",
            "sourceProviderType": "VarChar"
          },
          {
            "type": "calculated",
            "name": "Is Internal",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "IF (",
              "    [Event Type] = \"ETC1\" || [Event Type]=\"ETCA\", \"External\",",
              "    IF( [Event Type]=\"Bridging programme\",\"Bridging programme\",\"Internal\")",
              ")"
            ]
          },
          {
            "type": "calculated",
            "name": "Event Year",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": "Year([Event Date])",
            "formatString": "0",
            "displayFolder": "Event Date Hierarchy",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Event Quarter",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "",
              "CONCATENATE([Event Year],CONCATENATE(\" Q\",ROUNDUP(MONTH([Event Date])/3, 0)))"
            ],
            "sortByColumn": "Event Quarter Code",
            "displayFolder": "Event Date Hierarchy"
          },
          {
            "type": "calculated",
            "name": "Event Quarter Code",
            "dataType": "double",
            "isDataTypeInferred": true,
            "isHidden": true,
            "expression": [
              "",
              "[Event Year]*100+ROUNDUP(MONTH([Event Date])/3, 0)"
            ],
            "displayFolder": "Event Date Hierarchy"
          },
          {
            "type": "calculated",
            "name": "Event Month Number",
            "dataType": "int64",
            "isDataTypeInferred": false,
            "expression": "MONTH([Event Date])",
            "formatString": "0",
            "displayFolder": "Event Date Hierarchy",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Event Month Code",
            "dataType": "int64",
            "isDataTypeInferred": false,
            "expression": [
              "[Event Year]*100+[Event Month Number]",
              ""
            ],
            "formatString": "0",
            "displayFolder": "Event Date Hierarchy",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Event Month",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "",
              "SWITCH(",
              "[Event Month Number],",
              "1,CONCATENATE(\"Jan \",[Event Year]),",
              "2,CONCATENATE(\"Feb \",[Event Year]),",
              "3,CONCATENATE(\"Mar \",[Event Year]),",
              "4,CONCATENATE(\"Apr \",[Event Year]),",
              "5,CONCATENATE(\"May \",[Event Year]),",
              "6,CONCATENATE(\"Jun \",[Event Year]),",
              "7,CONCATENATE(\"Jul \",[Event Year]),",
              "8,CONCATENATE(\"Aug \",[Event Year]),",
              "9,CONCATENATE(\"Sep \",[Event Year]),",
              "10,CONCATENATE(\"Oct \",[Event Year]),",
              "11,CONCATENATE(\"Nov \",[Event Year]),",
              "12,CONCATENATE(\"Dec \",[Event Year])",
              ")"
            ],
            "sortByColumn": "Event Month Code",
            "displayFolder": "Event Date Hierarchy"
          },
          {
            "type": "calculated",
            "name": "Event Group",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "SWITCH(",
              "[Event Type],",
              "\"MD 1\",\"Mentoring\",",
              "\"MDU1\",\"Mentoring\",",
              "\"ETC1\",\"External\"",
              ",\"Other\")"
            ]
          },
          {
            "type": "calculated",
            "name": "Event SubType iGO",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "",
              "SWITCH(",
              "    [Event SubType],",
              "    \"Blended program\",          \"Blended Program\",",
              "    \"Blended transitional\",     \"Blended Program\",",
              "    ",
              "    \"Webinars\",                 \"Webinar Certification\",",
              "    \"Webinars Blended program\", \"Webinar Certification\",",
              "    ",
              "    \"External-in-house\",        \"In-House Training\",",
              "    \"In-House Training\",        \"In-House Training\",",
              "",
              "    \"Express AC\",               \"Express Certification\",",
              "    \"TCA IDS\",                  \"Express Certification\",",
              "    ",
              "    \"TCA External\",             \"External\",",
              "    \"Aligner Consulting\",       \"External\",",
              "",
              "    \"Fully online\",             \"E-certification\",",
              "    \"Online self-training\",      \"E-certification\",",
              "",
              "    [Event SubType]",
              "    ",
              ")"
            ]
          },
          {
            "type": "calculated",
            "name": "Event Quarter LY",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": "CONCATENATE([Event Year]-1,CONCATENATE(\" Q\",ROUNDUP(MONTH([Event Date])/3, 0)))",
            "displayFolder": "Event Date Hierarchy"
          },
          {
            "name": "Status",
            "dataType": "string",
            "sourceColumn": "Status"
          }
        ],
        "partitions": [
          {
            "name": "Activation Event",
            "dataView": "full",
            "source": {
              "type": "query",
              "query": [
                "WITH events as (",
                "",
                "            SELECT ",
                "                c.[CampaignID]      as [Event ID],",
                "                c.CampaignName      as [Event Name],",
                "                c.EventDate         as [Event Date],",
                "",
                "                CASE    WHEN c.EventCountry in ('GB', 'IE') THEN 'UKI' ",
                "                        WHEN c.EventCountry in ('FR') THEN 'FRANCE' ",
                "                        WHEN c.EventCountry in ('DE', 'AT', 'CH') THEN 'DACH' ",
                "                        WHEN c.EventCountry in ('ES', 'PT') THEN 'IBERIA' ",
                "                        WHEN c.EventCountry in ('IT', 'SM', 'MT') THEN 'ITALY' ",
                "                        WHEN c.EventCountry in ('CZ', 'SK', 'LV', 'LT', 'EE', 'HU', 'RO', 'BG', 'GR', 'CY', 'SI','IL') THEN 'CEBI' ",
                "                        WHEN c.EventCountry in ('PL') THEN 'Poland'",
                "                        WHEN c.EventCountry in ('NL', 'BE', 'LU') THEN 'BENELUX' ",
                "                        WHEN c.EventCountry in ('DK', 'SE', 'NO', 'FI', 'IS') THEN 'NORDICS' ",
                "                        WHEN c.EventCountry in ('TR') THEN 'TURKEY'",
                "                        WHEN c.EventCountry in ('RU') THEN 'RUSSIA'",
                "                        WHEN c.EventCountry in ('AE','KW','SA','BH','QA','MA','ZA','DZ','GH','KE','NG','TN') THEN 'MEA'",
                "                ELSE 'Unknown' END  as [Event Region],",
                "                c.EventCountry      as [Event Country],",
                "                c.EventCity         as [Event City],",
                "                c.DoctorType        as [Event Doctor Type],",
                "                c.EventTypePicklist as [Event Type],",
                "                c.EventSubType      as [Event SubType],",
                "",
                "                sp.[ContactName]    as [Event Speaker],",
                "                c.[Status]",
                "",
                "            FROM [DM].[DimCampaign] c",
                "                LEFT JOIN [DM].[DimCustContact] sp on sp.ContactID=c.Speaker1",
                "            WHERE",
                "                (c.EventTypePicklist IN ('C1','C11','ETCA','ETC1','MD 1','DSO MD1','MDU1','TCA','TC 1','Bridging programme'))",
                "",
                "                and c.IsDeleted='false'",
                "                and (c.[Status]='Completed'  OR c.EventSubType='Fully online'   ",
                "                                             OR c.EventSubType='On demand (Self-paced)')",
                "                ",
                "            )",
                "SELECT [Event ID]",
                "      ,[Event Name]",
                "      ,[Event Date]",
                "      ,[Status]",
                "      ,[Event Region]",
                "      ,[Event Country]",
                "      ,[Event City]",
                "      ,[Event Doctor Type]",
                "      ,[Event Type]",
                "      ,[Event SubType]",
                "      ,[Event Speaker]",
                "  FROM events",
                "--WHERE [Event Region]<>'Unknown'"
              ],
              "dataSource": "OTCDM"
            },
            "annotations": [
              {
                "name": "QueryEditorSerialization",
                "value": [
                  "<?xml version=\"1.0\" encoding=\"UTF-16\"?><Gemini xmlns=\"QueryEditorSerialization\"><AnnotationContent><![CDATA[<RSQueryCommandText>WITH events as (",
                  "",
                  "\t\t\tSELECT ",
                  "\t\t\t\tc.[CampaignID]      as [Event ID],",
                  "\t\t\t\tc.CampaignName      as [Event Name],",
                  "\t\t\t\tc.EventDate\t        as [Event Date],",
                  "",
                  "\t\t\t\tCASE\tWHEN c.EventCountry in ('GB', 'IE') THEN 'UKI' ",
                  "\t\t\t\t\t\tWHEN c.EventCountry in ('FR') THEN 'FRANCE' ",
                  "\t\t\t\t\t\tWHEN c.EventCountry in ('DE', 'AT', 'CH') THEN 'DACH' ",
                  "\t\t\t\t\t\tWHEN c.EventCountry in ('ES', 'PT') THEN 'IBERIA' ",
                  "\t\t\t\t\t\tWHEN c.EventCountry in ('IT', 'SM', 'MT') THEN 'ITALY' ",
                  "\t\t\t\t\t\tWHEN c.EventCountry in ('PL', 'CZ', 'SK', 'LV', 'LT', 'EE', 'HU', 'RO', 'BG', 'GR', 'CY', 'SI','IL') THEN 'EE-IL' ",
                  "\t\t\t\t\t\tWHEN c.EventCountry in ('NL', 'BE', 'LU') THEN 'BENELUX' ",
                  "\t\t\t\t\t\tWHEN c.EventCountry in ('DK', 'SE', 'NO', 'FI') THEN 'NORDICS' ",
                  "\t\t\t\t\t\tWHEN c.EventCountry in ('TR') THEN 'TURKEY'",
                  "\t\t\t\t\t\tWHEN c.EventCountry in ('RU') THEN 'RUSSIA'",
                  "\t\t\t\t\t\tWHEN c.EventCountry in ('AE', 'KW',  'SA', 'BH', 'QA') THEN 'MEA'",
                  "\t\t\t\tELSE 'Unknown' END  as [Event Region],",
                  "\t\t\t\tc.EventCountry      as [Event Country],",
                  "\t\t\t\tc.EventCity         as [Event City],",
                  "\t\t\t\tc.DoctorType        as [Event Doctor Type],",
                  "\t\t\t\tc.EventTypePicklist as [Event Type],",
                  "\t\t\t\tc.EventSubType\t\tas [Event SubType],",
                  "",
                  "\t\t\t\tsp.[ContactName]    as [Event Speaker],",
                  "\t\t\t\tc.[Status]",
                  "",
                  "\t\t\tFROM [DM].[DimCampaign] c",
                  "\t\t\t\tLEFT JOIN [DM].[DimCustContact] sp on sp.ContactID=c.Speaker1",
                  "\t\t\tWHERE",
                  "\t\t\t\t(c.EventTypePicklist IN ('C1','C11','ETCA','ETC1','MD 1','DSO MD1','MDU1','TCA','TC 1','Bridging programme'))",
                  "",
                  "\t\t\t\tand c.IsDeleted='false'",
                  "\t\t\t\tand (c.[Status]='Completed'  OR c.EventSubType='Fully online')",
                  "\t\t\t\t",
                  "\t\t\t)",
                  "SELECT [Event ID]",
                  "      ,[Event Name]",
                  "      ,[Event Date]",
                  "      ,[Status]",
                  "      ,[Event Region]",
                  "      ,[Event Country]",
                  "      ,[Event City]",
                  "      ,[Event Doctor Type]",
                  "      ,[Event Type]",
                  "      ,[Event SubType]",
                  "      ,[Event Speaker]",
                  "  FROM events",
                  "WHERE [Event Region]<>'Unknown'</RSQueryCommandText><RSQueryCommandType>Text</RSQueryCommandType><RSQueryDesignState></RSQueryDesignState>]]></AnnotationContent></Gemini>"
                ]
              }
            ]
          }
        ],
        "hierarchies": [
          {
            "name": "Event Y-Q-M-D",
            "displayFolder": "Event Date Hierarchy",
            "levels": [
              {
                "name": "Event Year",
                "ordinal": 0,
                "column": "Event Year"
              },
              {
                "name": "Event Quarter",
                "ordinal": 1,
                "column": "Event Quarter"
              },
              {
                "name": "Event Month",
                "ordinal": 2,
                "column": "Event Month"
              },
              {
                "name": "Event Date",
                "ordinal": 3,
                "column": "Event Date"
              }
            ]
          }
        ],
        "annotations": [
          {
            "name": "_TM_ExtProp_QueryDefinition",
            "value": [
              "WITH events as (",
