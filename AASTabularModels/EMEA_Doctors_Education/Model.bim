          },
          {
            "name": "AccountID",
            "dataType": "string",
            "sourceColumn": "AccountID",
            "sourceProviderType": "VarChar"
          },
          {
            "name": "AccountNumber",
            "dataType": "string",
            "sourceColumn": "AccountNumber",
            "sourceProviderType": "VarChar"
          },
          {
            "name": "Owner User Name",
            "dataType": "string",
            "sourceColumn": "Owner User Name",
            "sourceProviderType": "VarChar"
          },
          {
            "type": "calculated",
            "name": "iTero Contract Date",
            "dataType": "dateTime",
            "isDataTypeInferred": true,
            "expression": [
              "",
              "CALCULATE(",
              "    MIN('Opportinities'[Contract Signed Date]),",
              "    'Opportinities'[Contact ID]=EARLIER([ContactID])",
              ")",
              "",
              "",
              "",
              ""
            ],
            "formatString": "dd.MM.yyyy",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"DateTimeCustom\"><DateTimes><DateTime LCID=\"1049\" Group=\"ShortDate\" FormatString=\"dd.MM.yyyy\" /></DateTimes></Format>"
              }
            ]
          },
          {
            "name": "Account Source",
            "dataType": "string",
            "sourceColumn": "Account Source",
            "sortByColumn": "Account Source Sort"
          },
          {
            "name": "Account Source Sort",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "Account Source Sort"
          },
          {
            "name": "Certification Date",
            "dataType": "dateTime",
            "sourceColumn": "Certification Date",
            "formatString": "dd.MM.yyyy",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"DateTimeCustom\"><DateTimes><DateTime LCID=\"1049\" Group=\"ShortDate\" FormatString=\"dd.MM.yyyy\" /></DateTimes></Format>"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Is Online",
            "dataType": "boolean",
            "isDataTypeInferred": true,
            "expression": [
              "",
              "VAR SubType=LOOKUPVALUE('Activation Event'[Event SubType],'Activation Event'[Event ID],[CampaignId])",
              "VAR CampaignType=LOOKUPVALUE('Activation Event'[Event Type],'Activation Event'[Event ID],[CampaignId])",
              "",
              "RETURN",
              "IF(SubType=\"Fully Online\" && CampaignType=\"TCA\", True, False)"
            ],
            "formatString": "\"TRUE\";\"TRUE\";\"FALSE\""
          },
          {
            "type": "calculated",
            "name": "Certification Q",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "CONCATENATE(YEAR([Certification Date]),CONCATENATE(\" Q\",ROUNDUP(MONTH([Certification Date])/3, 0)))",
              ""
            ]
          },
          {
            "type": "calculated",
            "name": "Certification Q LY",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": "CONCATENATE(YEAR([Certification Date])-1,CONCATENATE(\" Q\",ROUNDUP(MONTH([Certification Date])/3, 0)))"
          }
        ],
        "partitions": [
          {
            "name": "Activation Event Member",
            "dataView": "full",
            "source": {
              "type": "query",
              "query": [
                "WITH Activation_Event as (",
                "            SELECT ",
                "                c.[CampaignID]      as [Event ID],",
                "                c.CampaignName      as [Event Name],",
                "                c.EventDate         as [Event Date],",
                "",
                "                CASE    WHEN c.EventCountry in ('GB', 'IE') THEN 'UKI' ",
                "                        WHEN c.EventCountry in ('FR') THEN 'FRANCE' ",
                "                        WHEN c.EventCountry in ('DE', 'AT', 'CH') THEN 'DACH' ",
                "                        WHEN c.EventCountry in ('ES', 'PT') THEN 'IBERIA' ",
                "                        WHEN c.EventCountry in ('IT', 'SM', 'MT') THEN 'ITALY' ",
                "                        WHEN c.EventCountry in ('PL', 'CZ', 'SK', 'LV', 'LT', 'EE', 'HU', 'RO', 'BG', 'GR', 'CY', 'SI','IL') THEN 'EE-IL' ",
                "                        WHEN c.EventCountry in ('NL', 'BE', 'LU') THEN 'BENELUX' ",
                "                        WHEN c.EventCountry in ('DK', 'SE', 'NO', 'FI', 'IS') THEN 'NORDICS' ",
                "                        WHEN c.EventCountry in ('TR') THEN 'TURKEY'",
                "                        WHEN c.EventCountry in ('RU') THEN 'RUSSIA'",
                "                        WHEN c.EventCountry in ('AE','KW','SA','BH','QA','MA','ZA','DZ','GH','KE','NG','TN') THEN 'MEA'",
                "                ELSE 'Unknown' END  as [Event Region],",
                "                c.EventCountry      as [Event Country],",
                "                c.EventCity         as [Event City],",
                "                c.DoctorType        as [Event Doctor Type],",
                "                c.EventTypePicklist as [Event Type],",
                "                c.EventSubType      as [Event SubType],",
                "",
                "                sp.[ContactName]    as [Event Speaker],",
                "                c.[Status],",
                "                c.Speaker1",
                "",
                "            FROM [DM].[DimCampaign] c",
                "                LEFT JOIN [DM].[DimCustContact] sp on sp.ContactID=c.Speaker1",
                "            WHERE",
                "                (c.EventTypePicklist IN ('C1','C11','ETCA','ETC1','MD 1','DSO MD1','MDU1','TCA','TC 1','Bridging programme'))",
                "",
                "                and c.IsDeleted='false'",
                "                and (c.[Status]='Completed'  OR c.EventSubType='Fully online'   ",
                "                                             OR c.EventSubType='On demand (Self-paced)')",
                "),",
                "",
                "Activation_Event_Member AS (",
                "",
                "        SELECT ",
                "            m.CampaignMemberID as MemberID,",
                "            m.CampaignId,",
                "            m.LeadId as LeadId,",
                "            m.[LeadOrContactId],",
                "            m.[Name]           as [Doctor Name],",
                "            CASE WHEN m.LeadID IS NOT NULL THEN  'New Doctor' ELSE 'Retrain' END as [Is Retraining],",
                "            m.[Status]         as [Registration Status],",
                "            m.[LeadSource]     as [Lead Source],",
                "            m.[FirstRespondedDate] as [Registration Date],",
                "            m.[OriginalType],",
                "            m.[Type],",
                "    ",
                "            cont.[ContactClinID] as [Clin ID],",
                "            cont.ContactKey,",
                "            cont.ContactID,",
                "",
                "            acc.[AccountKey],",
                "            acc.[AccountID],",
                "            acc.[AccountNumber],",
                "",
                "            u.UserName as [Owner User Name]",
                "",
                "        FROM Activation_Event c",
                "            INNER JOIN [DM].[DimCampaignMember] m on m.CampaignId=c.[Event ID]",
                "            LEFT JOIN [DM].[DimCustContact] sp on sp.ContactID=c.Speaker1",
                "            LEFT JOIN [DM].[DimCustContact] cont on cont.ContactAccountNumber=m.DIDNumber and (cont.ContactRecordType='Doctor' or (cont.ContactClinID is not null) )",
                "            LEFT JOIN [DM].[DimLead] lead on lead.LeadID=m.LeadID",
                "            LEFT JOIN [DM].[DimUser] u on u.UserID=ISNULL(cont.ContactOwnerID,lead.OwnerID)",
                "            LEFT JOIN [DM].[DimCustAccount] acc on acc.AccountNumber=m.DIDNumber",
                "",
                "        WHERE",
                "                m.IsDeleted='false'",
                "            and m.[Status] in ('Attended')",
                "            and c.[Event Region]<>'Unknown'",
                "    )",
                "",
                "SELECT m.[MemberID]",
                "      ,m.[CampaignId]",
                "      ,m.[LeadId]",
                "      ,m.[LeadOrContactId]",
                "      ,m.[Doctor Name]",
                "      ,CASE ",
                "            WHEN YEAR(c.Event_Date__c)<2019 THEN m.[Is Retraining] ",
                "            ELSE ",
                "                CASE WHEN ISNUMERIC(con.EMEA_Segmentation__c)=1 THEN 'Segment '+con.EMEA_Segmentation__c ELSE con.EMEA_Segmentation__c END ",
                "       END AS [Is Retraining]",
                "      ,m.[Registration Status]",
                "      ,m.[Lead Source]",
                "      ,m.[Registration Date]",
                "      ,m.[OriginalType]",
                "      ,m.[Type]",
                "      ,m.[Clin ID]",
                "      ,m.[ContactKey]",
                "      ,m.[ContactID]",
                "      ,m.[AccountKey]",
                "      ,m.[AccountID]",
                "      ,m.[AccountNumber]",
                "      ,m.[Owner User Name]",
                "      ,CASE ",
                "        WHEN acc.AccountSource in ('External Referral','Referral - Peer','Word of mouth','Referral - Lab','Referral - Doc') THEN 'External Referral'",
                "        WHEN acc.AccountSource in ('Referral - Invisalign Sales Rep','Contacted by Align','Referral - TM') THEN 'Internal Referral'",
                "        WHEN acc.AccountSource in ('Trade Show','snapADDY','Congress','Invisalign Summit','Public Relations','Study Clubs') THEN 'Trade Show or Align Event'",
                "        WHEN acc.AccountSource like 'Cold%' THEN 'Cold Visit or Call'",
                "        WHEN acc.AccountSource in ('Marketing Activity','Advertisement') THEN 'Marketing Activity or Advertisement'",
                "        ELSE acc.AccountSource",
                "        END as [Account Source]",
                "      ,CASE ",
                "        WHEN acc.AccountSource='Web' THEN 10",
                "        WHEN acc.AccountSource='Global D Lead' THEN 20",
                "        WHEN acc.AccountSource in ('External Referral','Referral - Peer','Word of mouth','Referral - Lab','Referral - Doc') THEN 30",
                "        WHEN acc.AccountSource in ('Referral - Invisalign Sales Rep','Contacted by Align','Referral - TM') THEN 40",
                "        WHEN acc.AccountSource in ('Trade Show','snapADDY','Congress','Invisalign Summit','Public Relations','Study Clubs') THEN 50",
                "        WHEN acc.AccountSource like 'Cold%' THEN 60",
                "        WHEN acc.AccountSource in ('Marketing Activity','Advertisement') THEN 70",
                "        WHEN acc.AccountSource='API' THEN 80",
                "        WHEN acc.AccountSource='Partner' THEN 90",
                "        WHEN acc.AccountSource='Other' THEN 100",
                "        WHEN acc.AccountSource='Batch' THEN 110",
                "        ELSE 10000",
                "        END as [Account Source Sort]",
                "    ,convert(date,con.Certification_Date__c) as [Certification Date]",
                "",
                "  FROM Activation_Event_Member m",
                "    left hash join [SFDC_Staging].dbo.Campaign c on m.CampaignId=c.id",
                "    left hash join [SFDC_Staging].dbo.Contact con on m.ContactID=con.ID",
                "    left hash join [SFDC_Staging].dbo.Account acc on m.AccountID=acc.ID"
              ],
              "dataSource": "OTCDM"
            },
            "annotations": [
              {
                "name": "QueryEditorSerialization",
                "value": [
                  "<?xml version=\"1.0\" encoding=\"UTF-16\"?><Gemini xmlns=\"QueryEditorSerialization\"><AnnotationContent><![CDATA[<RSQueryCommandText>WITH Activation_Event as (",
                  "\t\t\tSELECT ",
                  "\t\t\t\tc.[CampaignID]      as [Event ID],",
                  "\t\t\t\tc.CampaignName      as [Event Name],",
                  "\t\t\t\tc.EventDate\t        as [Event Date],",
                  "",
                  "\t\t\t\tCASE\tWHEN c.EventCountry in ('GB', 'IE') THEN 'UKI' ",
                  "\t\t\t\t\t\tWHEN c.EventCountry in ('FR') THEN 'FRANCE' ",
                  "\t\t\t\t\t\tWHEN c.EventCountry in ('DE', 'AT', 'CH') THEN 'DACH' ",
                  "\t\t\t\t\t\tWHEN c.EventCountry in ('ES', 'PT') THEN 'IBERIA' ",
                  "\t\t\t\t\t\tWHEN c.EventCountry in ('IT', 'SM', 'MT') THEN 'ITALY' ",
                  "\t\t\t\t\t\tWHEN c.EventCountry in ('PL', 'CZ', 'SK', 'LV', 'LT', 'EE', 'HU', 'RO', 'BG', 'GR', 'CY', 'SI','IL') THEN 'EE-IL' ",
                  "\t\t\t\t\t\tWHEN c.EventCountry in ('NL', 'BE', 'LU') THEN 'BENELUX' ",
                  "\t\t\t\t\t\tWHEN c.EventCountry in ('DK', 'SE', 'NO', 'FI') THEN 'NORDICS' ",
                  "\t\t\t\t\t\tWHEN c.EventCountry in ('TR') THEN 'TURKEY'",
                  "\t\t\t\t\t\tWHEN c.EventCountry in ('RU') THEN 'RUSSIA'",
                  "\t\t\t\t\t\tWHEN c.EventCountry in ('AE', 'KW',  'SA', 'BH', 'QA') THEN 'MEA'",
                  "\t\t\t\tELSE 'Unknown' END  as [Event Region],",
                  "\t\t\t\tc.EventCountry      as [Event Country],",
                  "\t\t\t\tc.EventCity         as [Event City],",
                  "\t\t\t\tc.DoctorType        as [Event Doctor Type],",
                  "\t\t\t\tc.EventTypePicklist as [Event Type],",
                  "\t\t\t\tc.EventSubType\t\tas [Event SubType],",
                  "",
                  "\t\t\t\tsp.[ContactName]    as [Event Speaker],",
                  "\t\t\t\tc.[Status],",
                  "\t\t\t\tc.Speaker1",
                  "",
                  "\t\t\tFROM [DM].[DimCampaign] c",
                  "\t\t\t\tLEFT JOIN [DM].[DimCustContact] sp on sp.ContactID=c.Speaker1",
                  "\t\t\tWHERE",
                  "\t\t\t\t(c.EventTypePicklist IN ('C1','C11','ETCA','ETC1','MD 1','DSO MD1','MDU1','TCA','TC 1','Bridging programme'))",
                  "",
                  "\t\t\t\tand c.IsDeleted='false'",
                  "\t\t\t\tand ",
                  "\t\t\t\t(  c.[Status] ='Completed'  OR",
                  "\t\t\t\t   (c.[Status]<>'Completed' and c.EventSubType='Fully online')",
                  "\t\t\t\t)",
                  "),",
                  "",
                  "Activation_Event_Member AS (",
                  "",
                  "\t\tSELECT ",
                  "\t\t\tm.CampaignMemberID as MemberID,",
                  "\t\t\tm.CampaignId,",
                  "\t\t\tm.LeadId as LeadId,",
                  "\t\t\tm.[LeadOrContactId],",
                  "\t\t\tm.[Name]           as [Doctor Name],",
                  "\t\t\tCASE WHEN m.LeadID IS NOT NULL THEN  'New Doctor' ELSE 'Retrain' END as [Is Retraining],",
                  "\t\t\tm.[Status]         as [Registration Status],",
                  "\t\t\tm.[LeadSource]     as [Lead Source],",
                  "\t\t\tm.[FirstRespondedDate] as [Registration Date],",
                  "\t\t\tm.[OriginalType],",
                  "\t\t\tm.[Type],",
                  "\t",
                  "\t\t\tcont.[ContactClinID] as [Clin ID],",
                  "\t\t\tcont.ContactKey,",
                  "\t\t\tcont.ContactID,",
                  "",
                  "\t\t\tacc.[AccountKey],",
                  "\t\t\tacc.[AccountID],",
                  "\t\t\tacc.[AccountNumber],",
                  "",
                  "\t\t\tu.UserName as [Owner User Name]",
                  "",
                  "\t\tFROM Activation_Event c",
                  "\t\t\tINNER JOIN [DM].[DimCampaignMember] m on m.CampaignId=c.[Event ID]",
                  "\t\t\tLEFT JOIN [DM].[DimCustContact] sp on sp.ContactID=c.Speaker1",
                  "\t\t\tLEFT JOIN [DM].[DimCustContact] cont on cont.ContactAccountNumber=m.DIDNumber and (cont.ContactRecordType='Doctor' or (cont.ContactClinID is not null) )",
                  "\t\t\tLEFT JOIN [DM].[DimLead] lead on lead.LeadID=m.LeadID",
                  "\t\t\tLEFT JOIN [DM].[DimUser] u on u.UserID=ISNULL(cont.ContactOwnerID,lead.OwnerID)",
                  "\t\t\tLEFT JOIN [DM].[DimCustAccount] acc on acc.AccountNumber=m.DIDNumber",
                  "",
                  "\t\tWHERE",
                  "\t\t\t\tm.IsDeleted='false'",
                  "\t\t\tand m.[Status] in ('Attended')",
                  "\t\t\tand c.[Event Region]<>'Unknown'",
                  "\t)",
                  "",
                  "SELECT m.[MemberID]",
                  "      ,m.[CampaignId]",
                  "      ,m.[LeadId]",
                  "      ,m.[LeadOrContactId]",
                  "      ,m.[Doctor Name]",
                  "\t  ,CASE ",
                  "\t\t\tWHEN YEAR(c.Event_Date__c)<2019 THEN m.[Is Retraining] ",
                  "\t\t\tELSE ",
                  "\t\t\t\tCASE WHEN ISNUMERIC(con.EMEA_Segmentation__c)=1 THEN 'Segment '+con.EMEA_Segmentation__c ELSE con.EMEA_Segmentation__c END ",
                  "       END AS [Is Retraining]",
                  "      ,m.[Registration Status]",
                  "      ,m.[Lead Source]",
                  "      ,m.[Registration Date]",
                  "      ,m.[OriginalType]",
                  "      ,m.[Type]",
                  "      ,m.[Clin ID]",
                  "      ,m.[ContactKey]",
                  "      ,m.[ContactID]",
                  "      ,m.[AccountKey]",
                  "      ,m.[AccountID]",
                  "      ,m.[AccountNumber]",
                  "      ,m.[Owner User Name]",
                  "\t  ,CASE ",
                  "\t\tWHEN acc.AccountSource in ('External Referral','Referral - Peer','Word of mouth','Referral - Lab','Referral - Doc') THEN 'External Referral'",
                  "\t\tWHEN acc.AccountSource in ('Referral - Invisalign Sales Rep','Contacted by Align','Referral - TM') THEN 'Internal Referral'",
                  "\t\tWHEN acc.AccountSource in ('Trade Show','snapADDY','Congress','Invisalign Summit','Public Relations','Study Clubs') THEN 'Trade Show or Align Event'",
                  "\t\tWHEN acc.AccountSource like 'Cold%' THEN 'Cold Visit or Call'",
                  "\t\tWHEN acc.AccountSource in ('Marketing Activity','Advertisement') THEN 'Marketing Activity or Advertisement'",
                  "\t\tELSE acc.AccountSource",
                  "\t\tEND as [Account Source]",
                  "\t  ,CASE ",
                  "\t\tWHEN acc.AccountSource='Web' THEN 10",
                  "\t\tWHEN acc.AccountSource='Global D Lead' THEN 20",
                  "\t\tWHEN acc.AccountSource in ('External Referral','Referral - Peer','Word of mouth','Referral - Lab','Referral - Doc') THEN 30",
                  "\t\tWHEN acc.AccountSource in ('Referral - Invisalign Sales Rep','Contacted by Align','Referral - TM') THEN 40",
                  "\t\tWHEN acc.AccountSource in ('Trade Show','snapADDY','Congress','Invisalign Summit','Public Relations','Study Clubs') THEN 50",
                  "\t\tWHEN acc.AccountSource like 'Cold%' THEN 60",
                  "\t\tWHEN acc.AccountSource in ('Marketing Activity','Advertisement') THEN 70",
                  "\t\tWHEN acc.AccountSource='API' THEN 80",
                  "\t\tWHEN acc.AccountSource='Partner' THEN 90",
                  "\t\tWHEN acc.AccountSource='Other' THEN 100",
                  "\t\tWHEN acc.AccountSource='Batch' THEN 110",
                  "\t\tELSE 10000",
                  "\t\tEND as [Account Source Sort]",
                  "\t,convert(date,con.Certification_Date__c) as [Certification Date]",
                  "",
                  "  FROM Activation_Event_Member m",
                  "\tleft hash join [SFDC_Staging].dbo.Campaign c on m.CampaignId=c.id",
                  "\tleft hash join [SFDC_Staging].dbo.Contact con on m.ContactID=con.ID",
                  "\tleft hash join [SFDC_Staging].dbo.Account acc on m.AccountID=acc.ID</RSQueryCommandText><RSQueryCommandType>Text</RSQueryCommandType><RSQueryDesignState></RSQueryDesignState>]]></AnnotationContent></Gemini>"
                ]
              }
            ]
          }
        ],
        "annotations": [
          {
            "name": "_TM_ExtProp_QueryDefinition",
            "value": [
              "WITH Activation_Event as (",
              "\t\t\tSELECT ",
              "\t\t\t\tc.[CampaignID]      as [Event ID],",
              "\t\t\t\tc.CampaignName      as [Event Name],",
              "\t\t\t\tc.EventDate\t        as [Event Date],",
              "",
              "\t\t\t\tCASE\tWHEN c.EventCountry in ('GB', 'IE') THEN 'UKI' ",
              "\t\t\t\t\t\tWHEN c.EventCountry in ('FR') THEN 'FRANCE' ",
              "\t\t\t\t\t\tWHEN c.EventCountry in ('DE', 'AT', 'CH') THEN 'DACH' ",
              "\t\t\t\t\t\tWHEN c.EventCountry in ('ES', 'PT') THEN 'IBERIA' ",
              "\t\t\t\t\t\tWHEN c.EventCountry in ('IT', 'SM', 'MT') THEN 'ITALY' ",
              "\t\t\t\t\t\tWHEN c.EventCountry in ('PL', 'CZ', 'SK', 'LV', 'LT', 'EE', 'HU', 'RO', 'BG', 'GR', 'CY', 'SI','IL') THEN 'EE-IL' ",
              "\t\t\t\t\t\tWHEN c.EventCountry in ('NL', 'BE', 'LU') THEN 'BENELUX' ",
              "\t\t\t\t\t\tWHEN c.EventCountry in ('DK', 'SE', 'NO', 'FI') THEN 'NORDICS' ",
              "\t\t\t\t\t\tWHEN c.EventCountry in ('TR') THEN 'TURKEY'",
              "\t\t\t\t\t\tWHEN c.EventCountry in ('RU') THEN 'RUSSIA'",
              "\t\t\t\t\t\tWHEN c.EventCountry in ('AE', 'KW',  'SA', 'BH', 'QA') THEN 'MEA'",
              "\t\t\t\tELSE 'Unknown' END  as [Event Region],",
              "\t\t\t\tc.EventCountry      as [Event Country],",
              "\t\t\t\tc.EventCity         as [Event City],",
              "\t\t\t\tc.DoctorType        as [Event Doctor Type],",
              "\t\t\t\tc.EventTypePicklist as [Event Type],",
              "\t\t\t\tc.EventSubType\t\tas [Event SubType],",
              "",
              "\t\t\t\tsp.[ContactName]    as [Event Speaker],",
              "\t\t\t\tc.[Status],",
              "\t\t\t\tc.Speaker1",
              "",
              "\t\t\tFROM [DM].[DimCampaign] c",
              "\t\t\t\tLEFT JOIN [DM].[DimCustContact] sp on sp.ContactID=c.Speaker1",
              "\t\t\tWHERE",
              "\t\t\t\t(c.EventTypePicklist IN ('C1','C11','ETCA','ETC1','MD 1','DSO MD1','MDU1','TCA','TC 1','Bridging programme'))",
              "",
              "DSO MD1",
              "\t\t\t\tand c.IsDeleted='false'",
              "\t\t\t\tand ",
              "\t\t\t\t(  c.[Status] ='Completed'  OR",
              "\t\t\t\t   (c.[Status]<>'Completed' and c.EventSubType='Fully online')",
              "\t\t\t\t)",
              "),",
              "",
              "Activation_Event_Member AS (",
              "",
              "\t\tSELECT ",
              "\t\t\tm.CampaignMemberID as MemberID,",
              "\t\t\tm.CampaignId,",
              "\t\t\tm.LeadId as LeadId,",
              "\t\t\tm.[LeadOrContactId],",
              "\t\t\tm.[Name]           as [Doctor Name],",
              "\t\t\tCASE WHEN m.LeadID IS NOT NULL THEN  'New Doctor' ELSE 'Retrain' END as [Is Retraining],",
              "\t\t\tm.[Status]         as [Registration Status],",
              "\t\t\tm.[LeadSource]     as [Lead Source],",
              "\t\t\tm.[FirstRespondedDate] as [Registration Date],",
              "\t\t\tm.[OriginalType],",
              "\t\t\tm.[Type],",
              "\t",
              "\t\t\tcont.[ContactClinID] as [Clin ID],",
              "\t\t\tcont.ContactKey,",
              "\t\t\tcont.ContactID,",
              "",
              "\t\t\tacc.[AccountKey],",
              "\t\t\tacc.[AccountID],",
              "\t\t\tacc.[AccountNumber],",
              "",
              "\t\t\tu.UserName as [Owner User Name]",
              "",
              "\t\tFROM Activation_Event c",
              "\t\t\tINNER JOIN [DM].[DimCampaignMember] m on m.CampaignId=c.[Event ID]",
              "\t\t\tLEFT JOIN [DM].[DimCustContact] sp on sp.ContactID=c.Speaker1",
              "\t\t\tLEFT JOIN [DM].[DimCustContact] cont on cont.ContactAccountNumber=m.DIDNumber and (cont.ContactRecordType='Doctor' or (cont.ContactClinID is not null) )",
              "\t\t\tLEFT JOIN [DM].[DimLead] lead on lead.LeadID=m.LeadID",
              "\t\t\tLEFT JOIN [DM].[DimUser] u on u.UserID=ISNULL(cont.ContactOwnerID,lead.OwnerID)",
              "\t\t\tLEFT JOIN [DM].[DimCustAccount] acc on acc.AccountNumber=m.DIDNumber",
              "",
              "\t\tWHERE",
              "\t\t\t\tm.IsDeleted='false'",
              "\t\t\tand m.[Status] in ('Attended')",
              "\t\t\tand c.[Event Region]<>'Unknown'",
              "\t)",
              "",
              "SELECT m.[MemberID]",
              "      ,m.[CampaignId]",
              "      ,m.[LeadId]",
              "      ,m.[LeadOrContactId]",
              "      ,m.[Doctor Name]",
              "\t  ,CASE ",
              "\t\t\tWHEN YEAR(c.Event_Date__c)<2019 THEN m.[Is Retraining] ",
              "\t\t\tELSE ",
              "\t\t\t\tCASE WHEN ISNUMERIC(con.EMEA_Segmentation__c)=1 THEN 'Segment '+con.EMEA_Segmentation__c ELSE con.EMEA_Segmentation__c END ",
              "       END AS [Is Retraining]",
              "      ,m.[Registration Status]",
              "      ,m.[Lead Source]",
              "      ,m.[Registration Date]",
              "      ,m.[OriginalType]",
              "      ,m.[Type]",
              "      ,m.[Clin ID]",
              "      ,m.[ContactKey]",
              "      ,m.[ContactID]",
              "      ,m.[AccountKey]",
              "      ,m.[AccountID]",
              "      ,m.[AccountNumber]",
              "      ,m.[Owner User Name]",
              "\t  ,CASE ",
              "\t\tWHEN acc.AccountSource in ('External Referral','Referral - Peer','Word of mouth','Referral - Lab','Referral - Doc') THEN 'External Referral'",
              "\t\tWHEN acc.AccountSource in ('Referral - Invisalign Sales Rep','Contacted by Align','Referral - TM') THEN 'Internal Referral'",
              "\t\tWHEN acc.AccountSource in ('Trade Show','snapADDY','Congress','Invisalign Summit','Public Relations','Study Clubs') THEN 'Trade Show or Align Event'",
              "\t\tWHEN acc.AccountSource like 'Cold%' THEN 'Cold Visit or Call'",
              "\t\tWHEN acc.AccountSource in ('Marketing Activity','Advertisement') THEN 'Marketing Activity or Advertisement'",
              "\t\tELSE acc.AccountSource",
              "\t\tEND as [Account Source]",
              "\t  ,CASE ",
              "\t\tWHEN acc.AccountSource='Web' THEN 10",
              "\t\tWHEN acc.AccountSource='Global D Lead' THEN 20",
              "\t\tWHEN acc.AccountSource in ('External Referral','Referral - Peer','Word of mouth','Referral - Lab','Referral - Doc') THEN 30",
              "\t\tWHEN acc.AccountSource in ('Referral - Invisalign Sales Rep','Contacted by Align','Referral - TM') THEN 40",
              "\t\tWHEN acc.AccountSource in ('Trade Show','snapADDY','Congress','Invisalign Summit','Public Relations','Study Clubs') THEN 50",
              "\t\tWHEN acc.AccountSource like 'Cold%' THEN 60",
              "\t\tWHEN acc.AccountSource in ('Marketing Activity','Advertisement') THEN 70",
              "\t\tWHEN acc.AccountSource='API' THEN 80",
              "\t\tWHEN acc.AccountSource='Partner' THEN 90",
              "\t\tWHEN acc.AccountSource='Other' THEN 100",
              "\t\tWHEN acc.AccountSource='Batch' THEN 110",
              "\t\tELSE 10000",
              "\t\tEND as [Account Source Sort]",
              "\t,convert(date,con.Certification_Date__c) as [Certification Date]",
              "",
              "  FROM Activation_Event_Member m",
              "\tleft hash join [SFDC_Staging].dbo.Campaign c on m.CampaignId=c.id",
              "\tleft hash join [SFDC_Staging].dbo.Contact con on m.ContactID=con.ID",
              "\tleft hash join [SFDC_Staging].dbo.Account acc on m.AccountID=acc.ID"
            ]
          },
          {
            "name": "_TM_ExtProp_DbTableName",
            "value": "Activation Event Member"
          },
          {
            "name": "QueryEditorSerialization",
            "value": [
              "<?xml version=\"1.0\" encoding=\"UTF-16\"?><Gemini xmlns=\"QueryEditorSerialization\"><AnnotationContent><![CDATA[<RSQueryCommandText>WITH Activation_Event as (",
              "\t\t\tSELECT ",
              "\t\t\t\tc.[CampaignID]      as [Event ID],",
              "\t\t\t\tc.CampaignName      as [Event Name],",
              "\t\t\t\tc.EventDate\t        as [Event Date],",
              "",
              "\t\t\t\tCASE\tWHEN c.EventCountry in ('GB', 'IE') THEN 'UKI' ",
              "\t\t\t\t\t\tWHEN c.EventCountry in ('FR') THEN 'FRANCE' ",
              "\t\t\t\t\t\tWHEN c.EventCountry in ('DE', 'AT', 'CH') THEN 'DACH' ",
              "\t\t\t\t\t\tWHEN c.EventCountry in ('ES', 'PT') THEN 'IBERIA' ",
              "\t\t\t\t\t\tWHEN c.EventCountry in ('IT', 'SM', 'MT') THEN 'ITALY' ",
              "\t\t\t\t\t\tWHEN c.EventCountry in ('PL', 'CZ', 'SK', 'LV', 'LT', 'EE', 'HU', 'RO', 'BG', 'GR', 'CY', 'SI','IL') THEN 'EE-IL' ",
              "\t\t\t\t\t\tWHEN c.EventCountry in ('NL', 'BE', 'LU') THEN 'BENELUX' ",
              "\t\t\t\t\t\tWHEN c.EventCountry in ('DK', 'SE', 'NO', 'FI') THEN 'NORDICS' ",
              "\t\t\t\t\t\tWHEN c.EventCountry in ('TR') THEN 'TURKEY'",
              "\t\t\t\t\t\tWHEN c.EventCountry in ('RU') THEN 'RUSSIA'",
              "\t\t\t\t\t\tWHEN c.EventCountry in ('AE', 'KW',  'SA', 'BH', 'QA') THEN 'MEA'",
              "\t\t\t\tELSE 'Unknown' END  as [Event Region],",
              "\t\t\t\tc.EventCountry      as [Event Country],",
              "\t\t\t\tc.EventCity         as [Event City],",
              "\t\t\t\tc.DoctorType        as [Event Doctor Type],",
              "\t\t\t\tc.EventTypePicklist as [Event Type],",
              "\t\t\t\tc.EventSubType\t\tas [Event SubType],",
              "",
              "\t\t\t\tsp.[ContactName]    as [Event Speaker],",
              "\t\t\t\tc.[Status],",
              "\t\t\t\tc.Speaker1",
              "",
              "\t\t\tFROM [DM].[DimCampaign] c",
              "\t\t\t\tLEFT JOIN [DM].[DimCustContact] sp on sp.ContactID=c.Speaker1",
              "\t\t\tWHERE",
              "\t\t\t\t(c.EventTypePicklist IN ('C1','C11','ETCA','ETC1','MD 1','DSO MD1','MDU1','TCA','TC 1','Bridging programme'))",
              "",
              "\t\t\t\tand c.IsDeleted='false'",
              "\t\t\t\tand ",
              "\t\t\t\t(  c.[Status] ='Completed'  OR",
              "\t\t\t\t   (c.[Status]<>'Completed' and c.EventSubType='Fully online')",
              "\t\t\t\t)",
              "),",
              "",
              "Activation_Event_Member AS (",
              "",
              "\t\tSELECT ",
              "\t\t\tm.CampaignMemberID as MemberID,",
              "\t\t\tm.CampaignId,",
              "\t\t\tm.LeadId as LeadId,",
              "\t\t\tm.[LeadOrContactId],",
              "\t\t\tm.[Name]           as [Doctor Name],",
              "\t\t\tCASE WHEN m.LeadID IS NOT NULL THEN  'New Doctor' ELSE 'Retrain' END as [Is Retraining],",
              "\t\t\tm.[Status]         as [Registration Status],",
              "\t\t\tm.[LeadSource]     as [Lead Source],",
              "\t\t\tm.[FirstRespondedDate] as [Registration Date],",
              "\t\t\tm.[OriginalType],",
              "\t\t\tm.[Type],",
              "\t",
              "\t\t\tcont.[ContactClinID] as [Clin ID],",
              "\t\t\tcont.ContactKey,",
              "\t\t\tcont.ContactID,",
              "",
              "\t\t\tacc.[AccountKey],",
              "\t\t\tacc.[AccountID],",
              "\t\t\tacc.[AccountNumber],",
              "",
              "\t\t\tu.UserName as [Owner User Name]",
              "",
              "\t\tFROM Activation_Event c",
              "\t\t\tINNER JOIN [DM].[DimCampaignMember] m on m.CampaignId=c.[Event ID]",
              "\t\t\tLEFT JOIN [DM].[DimCustContact] sp on sp.ContactID=c.Speaker1",
              "\t\t\tLEFT JOIN [DM].[DimCustContact] cont on cont.ContactAccountNumber=m.DIDNumber and (cont.ContactRecordType='Doctor' or (cont.ContactClinID is not null) )",
              "\t\t\tLEFT JOIN [DM].[DimLead] lead on lead.LeadID=m.LeadID",
              "\t\t\tLEFT JOIN [DM].[DimUser] u on u.UserID=ISNULL(cont.ContactOwnerID,lead.OwnerID)",
              "\t\t\tLEFT JOIN [DM].[DimCustAccount] acc on acc.AccountNumber=m.DIDNumber",
              "",
              "\t\tWHERE",
              "\t\t\t\tm.IsDeleted='false'",
              "\t\t\tand m.[Status] in ('Attended')",
              "\t\t\tand c.[Event Region]<>'Unknown'",
              "\t)",
              "",
              "SELECT m.[MemberID]",
              "      ,m.[CampaignId]",
              "      ,m.[LeadId]",
              "      ,m.[LeadOrContactId]",
              "      ,m.[Doctor Name]",
              "\t  ,CASE ",
              "\t\t\tWHEN YEAR(c.Event_Date__c)<2019 THEN m.[Is Retraining] ",
              "\t\t\tELSE ",
              "\t\t\t\tCASE WHEN ISNUMERIC(con.EMEA_Segmentation__c)=1 THEN 'Segment '+con.EMEA_Segmentation__c ELSE con.EMEA_Segmentation__c END ",
              "       END AS [Is Retraining]",
              "      ,m.[Registration Status]",
              "      ,m.[Lead Source]",
              "      ,m.[Registration Date]",
              "      ,m.[OriginalType]",
              "      ,m.[Type]",
              "      ,m.[Clin ID]",
              "      ,m.[ContactKey]",
              "      ,m.[ContactID]",
              "      ,m.[AccountKey]",
              "      ,m.[AccountID]",
              "      ,m.[AccountNumber]",
              "      ,m.[Owner User Name]",
              "\t  ,CASE ",
              "\t\tWHEN acc.AccountSource in ('External Referral','Referral - Peer','Word of mouth','Referral - Lab','Referral - Doc') THEN 'External Referral'",
              "\t\tWHEN acc.AccountSource in ('Referral - Invisalign Sales Rep','Contacted by Align','Referral - TM') THEN 'Internal Referral'",
              "\t\tWHEN acc.AccountSource in ('Trade Show','snapADDY','Congress','Invisalign Summit','Public Relations','Study Clubs') THEN 'Trade Show or Align Event'",
              "\t\tWHEN acc.AccountSource like 'Cold%' THEN 'Cold Visit or Call'",
              "\t\tWHEN acc.AccountSource in ('Marketing Activity','Advertisement') THEN 'Marketing Activity or Advertisement'",
              "\t\tELSE acc.AccountSource",
              "\t\tEND as [Account Source]",
              "\t  ,CASE ",
              "\t\tWHEN acc.AccountSource='Web' THEN 10",
              "\t\tWHEN acc.AccountSource='Global D Lead' THEN 20",
              "\t\tWHEN acc.AccountSource in ('External Referral','Referral - Peer','Word of mouth','Referral - Lab','Referral - Doc') THEN 30",
              "\t\tWHEN acc.AccountSource in ('Referral - Invisalign Sales Rep','Contacted by Align','Referral - TM') THEN 40",
              "\t\tWHEN acc.AccountSource in ('Trade Show','snapADDY','Congress','Invisalign Summit','Public Relations','Study Clubs') THEN 50",
              "\t\tWHEN acc.AccountSource like 'Cold%' THEN 60",
              "\t\tWHEN acc.AccountSource in ('Marketing Activity','Advertisement') THEN 70",
              "\t\tWHEN acc.AccountSource='API' THEN 80",
              "\t\tWHEN acc.AccountSource='Partner' THEN 90",
              "\t\tWHEN acc.AccountSource='Other' THEN 100",
              "\t\tWHEN acc.AccountSource='Batch' THEN 110",
              "\t\tELSE 10000",
              "\t\tEND as [Account Source Sort]",
              "\t,convert(date,con.Certification_Date__c) as [Certification Date]",
              "",
              "  FROM Activation_Event_Member m",
              "\tleft hash join [SFDC_Staging].dbo.Campaign c on m.CampaignId=c.id",
              "\tleft hash join [SFDC_Staging].dbo.Contact con on m.ContactID=con.ID",
              "\tleft hash join [SFDC_Staging].dbo.Account acc on m.AccountID=acc.ID</RSQueryCommandText><RSQueryCommandType>Text</RSQueryCommandType><RSQueryDesignState></RSQueryDesignState>]]></AnnotationContent></Gemini>"
            ]
          }
        ]
      },
