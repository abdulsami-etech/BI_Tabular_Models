      {
        "name": "Continued Education Doctor Group",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Doctor Training Group",
            "dataType": "string",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Doctor Training Group]"
          }
        ],
        "partitions": [
          {
            "name": "CalculatedTable 1",
            "source": {
              "type": "calculated",
              "expression": [
                "",
                "DATATABLE (",
                "    ",
                "    \"Doctor Training Group\", STRING,",
                "        ",
                "    { ",
                "        {\"All Doctors\"},",
                "        {\"0 Trainings\"},",
                "        {\"1 Training\"},",
                "        {\"2+ Trainings\"}",
                "       ",
                "    } ",
                ")"
              ]
            }
