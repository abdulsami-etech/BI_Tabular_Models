              "",
              "RETURN",
              "IF (portfolio=\"Full Portfolio\",",
              "    CALCULATE(MAX('Targets'[Value]),Targets[Year]=reportYear,'Targets'[Portfolio]=\"Full Portfolio\", 'Targets'[KPI Name]=\"Doctors Trained\"),",
              "    BLANK()",
              ")"
            ],
            "formatString": "0",
            "displayFolder": "Targets"
          },
          {
            "name": "_cust Doctors Trained CY",
            "expression": [
              " ",
              "",
              "VAR reportYear=MAX('Reporting Date'[Year])",
              "VAR reportQ=MAX('Reporting Date'[Quarter Code])",
              "",
              "RETURN",
              "    CALCULATE([Doctors Trained], FILTER('Activation Event',[Event Year]=reportYear && 'Activation Event'[Event Quarter Code]<=reportQ))",
              ""
            ],
            "formatString": "0",
            "displayFolder": "Doctors Trained"
          },
          {
            "name": "_cust Doctors Trained LY",
            "expression": [
              " ",
              "",
              "VAR calcPeriod=DATEADD(DATESYTD('Reporting Date'[Date]),-1,YEAR)",
              "VAR reportYear_LY=CALCULATE( MAX('Reporting Date'[Year]), calcPeriod)",
              "VAR reportQ_LY=CALCULATE( MAX('Reporting Date'[Quarter Code]), calcPeriod)",
              "",
              "",
              "RETURN",
              "    CALCULATE([Doctors Trained], FILTER('Activation Event',[Event Year]=reportYear_LY && 'Activation Event'[Event Quarter Code]<=reportQ_LY))",
              ""
            ],
            "formatString": "0",
            "displayFolder": "Doctors Trained"
          },
          {
            "name": "Activation % 3+ Selected",
            "expression": [
              "",
              "",
              "VAR days=IF(HASONEVALUE('Activation Selection'[Activation Days Caption]),",
              "                 VALUES('Activation Selection'[Activation Days Caption]),",
              "                 BLANK())",
              "VAR NR_CCA=IF(HASONEVALUE('Activation Selection'[NR/CCA]),",
              "                 VALUES('Activation Selection'[NR/CCA]),",
              "                 BLANK())",
              "",
              "VAR ret=",
              "    SWITCH(",
              "        days,",
              "        \"30\",  SWITCH(NR_CCA, \"CCA\", [Activation % CCA 3+ @30],  \"NR\",[Activation % NR 3+ @30],  \"Activation Days/Type NOT selected\"),",
              "        \"60\",  SWITCH(NR_CCA, \"CCA\", [Activation % CCA 3+ @60],  \"NR\",[Activation % NR 3+ @60],  \"Activation Days/Type NOT selected\"),",
              "        \"90\",  SWITCH(NR_CCA, \"CCA\", [Activation % CCA 3+ @90],  \"NR\",[Activation % NR 3+ @90],  \"Activation Days/Type NOT selected\"),",
              "        \"120\", SWITCH(NR_CCA, \"CCA\", [Activation % CCA 3+ @120], \"NR\",[Activation % NR 3+ @120], \"Activation Days/Type NOT selected\"),",
              "        \"180\", SWITCH(NR_CCA, \"CCA\", [Activation % CCA 3+ @180], \"NR\",[Activation % NR 3+ @180], \"Activation Days/Type NOT selected\"),",
              "        \"365\", SWITCH(NR_CCA, \"CCA\", [Activation % CCA 3+ @365], \"NR\",[Activation % NR 3+ @365], \"Activation Days/Type NOT selected\"),",
              "        \"Activation Days/Type NOT selected\"",
              ")",
              "",
              "RETURN ret",
              "",
              ""
            ],
            "formatString": "0%;-0%;0%",
            "displayFolder": "Activation\\General"
          },
          {
            "name": "Activated Doctors 3+ at #Days",
            "description": "Activation NR 4+ is % of trained doctors who have 4+ NR at @N days after event. The measure should be used with proper context of Event Date filter",
            "expression": [
              "",
              "",
              "VAR days=IF(HASONEVALUE('Activation Selection'[Activation Days]),VALUES('Activation Selection'[Activation Days]))",
              "VAR trainedDoctors=FILTER(DISTINCT('Activation Event Member'[Clin ID]), [Days After Activation Event]>=days)",
              "VAR activatedDoctors=FILTER(trainedDoctors, [Sales at #Days Selected]>=3)",
              "",
              "RETURN ",
              "COUNTROWS(activatedDoctors)",
              ""
            ],
            "formatString": "0",
            "displayFolder": "Activation\\General"
          },
          {
            "name": "Activated 3+ Sales at #Days Selected",
            "expression": [
              "",
              "",
              "VAR days=IF(HASONEVALUE('Activation Selection'[Activation Days Caption]),",
              "                 VALUES('Activation Selection'[Activation Days Caption]),",
              "                 BLANK())",
              "VAR daysN=IF(HASONEVALUE('Activation Selection'[Activation Days]),",
              "                  VALUES('Activation Selection'[Activation Days]),",
              "                  BLANK())",
              "VAR NR_CCA=IF(HASONEVALUE('Activation Selection'[NR/CCA]),",
              "                 VALUES('Activation Selection'[NR/CCA]),",
              "                 BLANK())",
              "",
              "VAR trainedDoctors=FILTER(DISTINCT('Activation Event Member'[Clin ID]), [Days After Activation Event]>=daysN)",
              "VAR activatedDoctors=FILTER(trainedDoctors, [Sales at #Days Selected]>=3)",
              "",
              "",
              "VAR ret=",
              "    SWITCH(",
              "        days,",
              "        \"30\",  SWITCH(NR_CCA, \"CCA\", CALCULATE([CCA @ 30],activatedDoctors),  \"NR\",CALCULATE([NR @ 30],activatedDoctors),  \"Activation Days/Type NOT selected\"),",
              "        \"60\",  SWITCH(NR_CCA, \"CCA\", CALCULATE([CCA @ 60],activatedDoctors),  \"NR\",CALCULATE([NR @ 60],activatedDoctors),  \"Activation Days/Type NOT selected\"),",
              "        \"90\",  SWITCH(NR_CCA, \"CCA\", CALCULATE([CCA @ 90],activatedDoctors),  \"NR\",CALCULATE([NR @ 90],activatedDoctors),  \"Activation Days/Type NOT selected\"),",
              "        \"120\", SWITCH(NR_CCA, \"CCA\", CALCULATE([CCA @ 120],activatedDoctors), \"NR\",CALCULATE([NR @ 120],activatedDoctors), \"Activation Days/Type NOT selected\"),",
              "        \"180\", SWITCH(NR_CCA, \"CCA\", CALCULATE([CCA @ 180],activatedDoctors), \"NR\",CALCULATE([NR @ 180],activatedDoctors), \"Activation Days/Type NOT selected\"),",
              "        \"365\", SWITCH(NR_CCA, \"CCA\", CALCULATE([CCA @ 365],activatedDoctors), \"NR\",CALCULATE([NR @ 365],activatedDoctors), \"Activation Days/Type NOT selected\"),",
              "        \"Activation Days/Type NOT selected\"",
              ")",
              "",
              "RETURN ret"
            ],
            "formatString": "#,0",
            "displayFolder": "Activation\\General"
          },
          {
            "name": "Activation % 3+ @90 Selected",
            "expression": [
              "",
              "",
              "VAR days=90",
              "VAR NR_CCA=IF(HASONEVALUE('Activation Selection'[NR/CCA]),",
              "                 VALUES('Activation Selection'[NR/CCA]),",
              "                 BLANK())",
              "",
              "VAR ret=",
              "    SWITCH(",
              "        days,",
              "        30,  SWITCH(NR_CCA, \"CCA\", [Activation % CCA 3+ @30],  \"NR\",[Activation % NR 3+ @30],  \"Activation Days/Type NOT selected\"),",
              "        60,  SWITCH(NR_CCA, \"CCA\", [Activation % CCA 3+ @60],  \"NR\",[Activation % NR 3+ @60],  \"Activation Days/Type NOT selected\"),",
              "        90,  SWITCH(NR_CCA, \"CCA\", [Activation % CCA 3+ @90],  \"NR\",[Activation % NR 3+ @90],  \"Activation Days/Type NOT selected\"),",
              "        120, SWITCH(NR_CCA, \"CCA\", [Activation % CCA 3+ @120], \"NR\",[Activation % NR 3+ @120], \"Activation Days/Type NOT selected\"),",
              "        180, SWITCH(NR_CCA, \"CCA\", [Activation % CCA 3+ @180], \"NR\",[Activation % NR 3+ @180], \"Activation Days/Type NOT selected\"),",
              "        365, SWITCH(NR_CCA, \"CCA\", [Activation % CCA 3+ @365], \"NR\",[Activation % NR 3+ @365], \"Activation Days/Type NOT selected\"),",
              "        \"Activation Days/Type NOT selected\"",
              ")",
              "",
              "RETURN ret",
              "",
              ""
            ],
            "formatString": "0%;-0%;0%",
            "displayFolder": "Activation\\General"
          },
          {
            "name": "AVG NR per Activated 3+ doctor @30",
            "description": "Average amount of NR per Activated 4+ @30 days doctors",
            "expression": [
              "",
              "",
              "/*",
              "Average amount of NR per Activated 3+ @30 days doctors",
              "*/",
              "",
              "VAR trainedDoctors=FILTER(DISTINCT('Activation Event Member'[Clin ID]), [Days After Activation Event]>=30)",
              "VAR activatedDoctors=FILTER(trainedDoctors, [NR @ 30]>=3)",
              "VAR activatedDoctorsCount=COUNTROWS(activatedDoctors)",
              "VAR activatedSales=CALCULATE([NR @ 30], activatedDoctors)",
              "",
              "RETURN ",
              "",
              "DIVIDE(activatedSales,activatedDoctorsCount)"
            ],
            "formatString": "0.00",
            "displayFolder": "Averages\\NR"
          },
