              "        \"60\",  SWITCH(NR_CCA, \"CCA\", [Stickiness % CCA @60],  \"NR\",[Stickiness % NR @60],  \"Stickiness Days/Type NOT selected\"),",
              "        \"90\",  SWITCH(NR_CCA, \"CCA\", [Stickiness % CCA @90],  \"NR\",[Stickiness % NR @90],  \"Stickiness Days/Type NOT selected\"),",
              "        \"120\", SWITCH(NR_CCA, \"CCA\", [Stickiness % CCA @120], \"NR\",[Stickiness % NR @120], \"Stickiness Days/Type NOT selected\"),",
              "        \"180\", SWITCH(NR_CCA, \"CCA\", [Stickiness % CCA @180], \"NR\",[Stickiness % NR @180], \"Stickiness Days/Type NOT selected\"),",
              "        \"365\", SWITCH(NR_CCA, \"CCA\", [Stickiness % CCA @365], \"NR\",[Stickiness % NR @365], \"Stickiness Days/Type NOT selected\"),",
              "        \">365\", SWITCH(NR_CCA, \"CCA\", [Stickiness % CCA @ >365], \"NR\",[Stickiness % NR @ >365], \"Stickiness Days/Type NOT selected\"),",
              "        \"Stickiness Days/Type NOT selected\"",
              ")",
              "",
              "RETURN ret",
              "",
              ""
            ],
            "formatString": "0%;-0%;0%",
            "displayFolder": "Stickiness\\General"
          },
          {
            "name": "Sticked Sales at #Days Selected",
            "expression": [
              "",
              "",
              "VAR days=IF(HASONEVALUE('Activation Selection'[Activation Days Caption]),",
              "                 VALUES('Activation Selection'[Activation Days Caption]),",
              "                 BLANK())",
              "VAR daysN=IF(HASONEVALUE('Activation Selection'[Activation Days]),",
              "                  VALUES('Activation Selection'[Activation Days]),",
              "                  BLANK())",
              "",
              "VAR NR_CCA=IF(HASONEVALUE('Activation Selection'[NR/CCA]),",
              "                 VALUES('Activation Selection'[NR/CCA]),",
              "                 BLANK())",
              "",
              "VAR trainedDoctors=FILTER(DISTINCT('Activation Event Member'[Clin ID]), [Days After Activation Event]>=daysN)",
              "VAR stickedDoctors=FILTER(trainedDoctors, [Sales at #Days Selected]>=1)",
              "",
              "",
              "VAR ret=",
              "    SWITCH(",
              "        days,",
              "        \"30\",  SWITCH(NR_CCA, \"CCA\", CALCULATE([CCA @ 30],stickedDoctors),  \"NR\",CALCULATE([NR @ 30],stickedDoctors),  \"Activation Days/Type NOT selected\"),",
              "        \"60\",  SWITCH(NR_CCA, \"CCA\", CALCULATE([CCA @ 60],stickedDoctors),  \"NR\",CALCULATE([NR @ 60],stickedDoctors),  \"Activation Days/Type NOT selected\"),",
              "        \"90\",  SWITCH(NR_CCA, \"CCA\", CALCULATE([CCA @ 90],stickedDoctors), \"NR\",CALCULATE([NR @ 90],stickedDoctors),  \"Activation Days/Type NOT selected\"),",
              "        \"120\", SWITCH(NR_CCA, \"CCA\", CALCULATE([CCA @ 120],stickedDoctors), \"NR\",CALCULATE([NR @ 120],stickedDoctors), \"Activation Days/Type NOT selected\"),",
              "        \"180\", SWITCH(NR_CCA, \"CCA\", CALCULATE([CCA @ 180],stickedDoctors), \"NR\",CALCULATE([NR @ 180],stickedDoctors), \"Activation Days/Type NOT selected\"),",
              "        \"365\", SWITCH(NR_CCA, \"CCA\", CALCULATE([CCA @ 365],stickedDoctors), \"NR\",CALCULATE([NR @ 365],stickedDoctors), \"Activation Days/Type NOT selected\"),",
              "        \">365\", SWITCH(NR_CCA, \"CCA\", CALCULATE([CCA @ >365],stickedDoctors), \"NR\",CALCULATE([NR @ >365],stickedDoctors), \"Activation Days/Type NOT selected\"),",
              "        \"Activation Days/Type NOT selected\"",
              ")",
              "",
              "RETURN ret"
            ],
            "formatString": "#,0",
            "displayFolder": "Stickiness\\General"
          },
