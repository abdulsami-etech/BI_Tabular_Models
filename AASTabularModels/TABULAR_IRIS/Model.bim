        "measures": [
          {
            "name": "_base Total Tickets Count",
            "expression": [
              "SUM('Fact Ticket'[Tickets Count])",
              "",
              "",
              "",
              ""
            ],
            "isHidden": true,
            "displayFolder": "_Base Measures\\Tickets"
          },
          {
            "name": "Tickets Opened Count",
            "description": "Calculates number of Tickets opened during selected report period context",
            "expression": [
              "",
              "/* Calculates number of Tickets opened during selected report period context*/",
              "",
              "VAR period=DISTINCT('Reporting Calendar'[Date])",
              "",
              "RETURN",
              "CALCULATE(",
              "    SUM('Fact Ticket'[Tickets Count]),",
              "    TREATAS (period,'Fact Ticket'[Ticket Open Date])",
              ")",
              "    "
            ],
            "formatString": "#,0",
            "displayFolder": "Tickets\\Counts"
          },
          {
            "name": "Tickets Closed Count",
            "description": "Calculates number of Tickets closed during selected report period context",
            "expression": [
              "",
              "/* Calculates number of Tickets closed during selected report period context*/",
              "",
              "VAR period=DISTINCT('Reporting Calendar'[Date])",
              "",
              "RETURN",
              "CALCULATE(",
              "    [_base Total Tickets Count],",
              "    TREATAS (period,'Fact Ticket'[Ticket Closed Date])",
              ")",
              "    "
            ],
            "formatString": "#,0",
            "displayFolder": "Tickets\\Counts"
          },
          {
            "name": "Ticket Avr. Net Duration Hrs.",
            "description": "Average resolution duration of closed tickets (Close Date - Open Date) in BUSINESS HOURS",
            "expression": [
              "",
              "AVERAGEX('Fact Ticket','Fact Ticket'[Ticket Net Hrs])"
            ],
            "formatString": "0",
            "displayFolder": "Tickets\\Averages"
          },
          {
            "name": "Ticket Avr. Calendar Duration Hrs.",
            "description": "Average resolution duration of closed tickets (Close Date - Open Date) in CALENDAR DAYS",
            "expression": [
              "",
              "AVERAGEX('Fact Ticket','Fact Ticket'[Ticket Calendar Hrs])"
            ],
            "formatString": "0",
            "displayFolder": "Tickets\\Averages"
          },
          {
            "name": "Ticket Avr. Net Duration by Ageing bucket",
            "description": "Tickets Net duration split by time buckets. USE WITH \"Ticket Ageing Hrs\" table",
            "expression": [
              "",
              "",
              "VAR allTickets=CALCULATE( COUNT('Fact Ticket'[SKTicket]), 'Fact Ticket'[Ticket Net Hrs]>0)",
              "",
              "VAR selectedBucket=IF(HASONEVALUE('Ticket Ageing Hrs'[ID]),VALUES('Ticket Ageing Hrs'[ID]))",
              "",
              "RETURN ",
              "SWITCH(",
              "    selectedBucket,",
              "    ",
              "    1,",
              "    VAR less24=CALCULATE( COUNT('Fact Ticket'[SKTicket]), 'Fact Ticket'[Ticket Net Hrs]>0 && 'Fact Ticket'[Ticket Net Hrs]<=24)",
              "    RETURN DIVIDE(less24,allTickets),",
              "",
              "    2,",
              "    VAR T24_48=CALCULATE( COUNT('Fact Ticket'[SKTicket]), 'Fact Ticket'[Ticket Net Hrs]>24 && 'Fact Ticket'[Ticket Net Hrs]<=48)",
              "    RETURN DIVIDE(T24_48,allTickets),",
              "",
              "    3,",
              "    VAR T48_72=CALCULATE( COUNT('Fact Ticket'[SKTicket]), 'Fact Ticket'[Ticket Net Hrs]>48 && 'Fact Ticket'[Ticket Net Hrs]<=72)",
              "    RETURN DIVIDE(T48_72,allTickets),",
              "",
              "    4,",
              "    VAR greater72=CALCULATE( COUNT('Fact Ticket'[SKTicket]), 'Fact Ticket'[Ticket Net Hrs]>72)",
              "    RETURN DIVIDE(greater72,allTickets),",
              "",
              "    1",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "displayFolder": "Tickets\\by Ageing buckets"
          },
          {
            "name": "Ticket Count by Ageing bucket",
            "description": "Tickets count split by duration time buckets. USE WITH \"Ticket Ageing Hrs\" table",
            "expression": [
              "",
              "",
              "VAR allTickets=CALCULATE( COUNT('Fact Ticket'[SKTicket]), 'Fact Ticket'[Ticket Net Hrs]>0)",
              "",
              "VAR selectedBucket=IF(HASONEVALUE('Ticket Ageing Hrs'[ID]),VALUES('Ticket Ageing Hrs'[ID]))",
              "",
              "RETURN ",
              "SWITCH(",
              "    selectedBucket,",
              "    ",
              "    1,",
              "    CALCULATE( COUNT('Fact Ticket'[SKTicket]), 'Fact Ticket'[Ticket Net Hrs]>0 && 'Fact Ticket'[Ticket Net Hrs]<=24),",
              "    ",
              "    2,",
              "    CALCULATE( COUNT('Fact Ticket'[SKTicket]), 'Fact Ticket'[Ticket Net Hrs]>24 && 'Fact Ticket'[Ticket Net Hrs]<=48),",
              "    ",
              "    3,",
              "    CALCULATE( COUNT('Fact Ticket'[SKTicket]), 'Fact Ticket'[Ticket Net Hrs]>48 && 'Fact Ticket'[Ticket Net Hrs]<=72),",
              "    ",
              "    4,",
              "    CALCULATE( COUNT('Fact Ticket'[SKTicket]), 'Fact Ticket'[Ticket Net Hrs]>72),",
              "",
              "    allTickets",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "Tickets\\by Ageing buckets"
          },
          {
            "name": "Tickets currently Open",
            "description": "Calculates number of tickets currently open (as of last data refresh time)",
            "expression": [
              "",
              "SUM('Fact Ticket'[Is Ticket Open])"
            ],
            "formatString": "#,0",
            "displayFolder": "Tickets\\Counts"
          },
          {
            "name": "Tickets currently Open (History)",
            "description": "Calculates number of tickets that are open as of reporting date context (retrospective)",
            "expression": [
              "",
              "VAR reportDate=MAX('Reporting Calendar'[Date])",
              "",
              "RETURN ",
              "SUMX(",
              "    'Ticket',",
              "    VAR ClsDate=MAX([Ticket Closed Date],[Ticket Resolved Date])",
              "",
              "    RETURN",
              "    IF(",
              "        [Ticket Open Date]<=reportDate && ",
              "        (ISBLANK(ClsDate) || (NOT ISBLANK(ClsDate) && reportDate<ClsDate)),",
              "        1,BLANK())",
              ")",
              "",
              "",
              "",
              "        "
            ],
            "formatString": "#,0",
            "displayFolder": "Tickets\\Counts"
          },
          {
            "name": "Scanners Install Base",
            "expression": [
              "",
              "",
              "VAR repDate=MAX('Reporting Calendar'[Date])",
              "",
              "VAR result=CALCULATE( COUNT('Fact Scanner Installation'[SKAsset]), 'Fact Scanner Installation'[Date]=repDate)",
              "RETURN result"
            ],
            "formatString": "#,0",
            "displayFolder": "Scanners\\Install Base"
          },
          {
            "name": "Ticket Avr. Ageing Hrs.",
            "description": "Avr. ticket age (open+closed). For open ticket Age=NOW - Open Date",
            "expression": [
              "",
              "",
              "AVERAGEX(",
              "    'Ticket',",
              "    ",
              "    VAR dt=MAX([Ticket Closed Date Time],[Ticket Resolved Date Time])",
              "    RETURN",
              "    IF(",
              "        ISBLANK(dt),",
              "        NOW()-[Ticket Open Date Time],",
              "        dt-[Ticket Open Date Time]",
              "       )",
              "",
              ")",
              "*24"
            ],
            "formatString": "0",
            "displayFolder": "Tickets\\Averages"
          },
          {
            "name": "Ticket Avr. Ageing Days",
            "description": "Avr. ticket age (open+closed). For open ticket Age=NOW - Open Date",
            "expression": [
              "",
              "",
              "AVERAGEX(",
              "    'Ticket',",
              "    ",
              "    VAR dt=MAX([Ticket Closed Date Time],[Ticket Resolved Date Time])",
              "    RETURN",
              "    IF(",
              "        ISBLANK(dt),",
              "        NOW()-[Ticket Open Date Time],",
              "        dt-[Ticket Open Date Time]",
              "       )",
              "",
              ")"
            ],
            "formatString": "0.00",
            "displayFolder": "Tickets\\Averages"
          },
          {
            "name": "Scanners IB Element",
            "expression": [
              " CALCULATE([Scanners Install Base], Asset[Asset Type] = \"iTero Element\")",
              ""
            ],
            "displayFolder": "Scanners\\Install Base"
          },
          {
            "name": "Scanners IB HD2.9",
            "expression": " CALCULATE([Scanners Install Base], Asset[Asset Type] = \"iTero HD2.9\")",
            "displayFolder": "Scanners\\Install Base"
          },
          {
            "name": "Scanners IB Legacy",
            "expression": [
              " CALCULATE([Scanners Install Base], Asset[Asset Type] = \"Other\")",
              ""
            ],
            "displayFolder": "Scanners\\Install Base"
          },
          {
            "name": "Contract Count",
            "expression": "SUM('Fact Sales Contract'[Contracts Count])",
            "displayFolder": "Sales Contracts"
          },
          {
            "name": "Audit Time (Achieved)",
            "expression": [
              "",
              "",
              "VAR allContracts=CALCULATE(COUNT('Fact Sales Contract'[SK SalesContract]), 'Fact Sales Contract'[Audit Time Elapsed]>0)",
              "",
              "VAR selectedBucket=IF(HASONEVALUE('Ticket Ageing Hrs'[ID]),VALUES('Ticket Ageing Hrs'[ID]))",
              "",
              "RETURN ",
              "SWITCH(",
              "    selectedBucket,",
              "    1,",
              "    VAR less24=CALCULATE( COUNT('Fact Sales Contract'[SK SalesContract]), 'Fact Sales Contract'[Audit Time Elapsed]>0 && 'Fact Sales Contract'[Audit Time Elapsed]<=24)",
              "    RETURN DIVIDE(less24,allContracts),",
              "1",
              ")"
            ],
            "displayFolder": "Sales Contracts"
          },
          {
            "name": "Audit Time Avr.",
            "expression": " SUM('Fact Sales Contract'[Audit Time Elapsed])/SUM('Fact Sales Contract'[Contracts Count])"
          },
          {
            "name": "RMA Items Count",
            "description": "Calculates number of Tickets opened during selected report period context",
            "expression": [
              "",
              "/* Calculates number of Tickets opened during selected report period context*/",
              "",
              "VAR period=DISTINCT('Reporting Calendar'[Date])",
              "",
              "RETURN",
              "CALCULATE(",
              "    SUM('Fact Ticket Item'[RMA Item Count]),",
              "    TREATAS (period,'Fact Ticket Item'[Created Date])",
              ")",
              "    "
            ],
            "formatString": "#,0",
            "displayFolder": "Tickets\\Counts"
          },
          {
            "name": "RMA Opened Count",
            "expression": [
              "",
              "",
              "VAR period=DISTINCT('Reporting Calendar'[Date])",
              "",
              "RETURN",
              "CALCULATE(",
              "    SUM('Fact Ticket RMA'[RMA Count]),",
              "    TREATAS (period,'Fact Ticket RMA'[Ticket Open Date])",
              ")",
              "    "
            ],
            "formatString": "#,0",
            "displayFolder": "Tickets\\RMA"
          },
          {
            "name": "Complaints Count",
            "expression": [
              "",
              "",
              "VAR period=DISTINCT('Reporting Calendar'[Date])",
