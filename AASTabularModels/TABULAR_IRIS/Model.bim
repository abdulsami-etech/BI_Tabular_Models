          },
          {
            "name": "Count of Contract Signed",
            "expression": [
              "",
              "",
              "VAR period=DISTINCT('Reporting Calendar'[Date])",
              "",
              "RETURN",
              "CALCULATE(",
              "    SUM('Fact Sales Contract'[Contracts Count]),",
              "    TREATAS (period,'Fact Sales Contract'[KeyDate ContractSigned]))",
              "    "
            ]
          },
          {
            "name": "Count of Contract Shipped",
            "expression": [
              "",
              "",
              "VAR period=DISTINCT('Reporting Calendar'[Date])",
              "",
              "RETURN",
              "CALCULATE(",
              "    SUM('Fact Sales Contract'[Contracts Count]),",
              "    TREATAS (period,'Fact Sales Contract'[KeyDate Shipping]))",
              "    "
            ]
          },
          {
            "name": "Average Age (Hours)",
            "expression": [
              "",
              "VAR period=DISTINCT('Reporting Calendar'[Date])",
              "",
              "RETURN",
              "Calculate (",
              "\tSumX(",
              "\t\tFilter(",
              "\t\t\t'Fact Ticket RMA'",
              "\t\t\t, 'Fact Ticket RMA'[RMA Count]>0",
              "\t\t)",
              "\t\t, If (",
              "\t\t\tIsBlank ('Fact Ticket RMA'[Ticket Closed Date])",
              "\t\t\t, Now()",
              "\t\t\t, 'Fact Ticket RMA'[Ticket Closed Date]",
              "\t\t)",
              "\t\t- 'Fact Ticket RMA'[Ticket Open Date]",
              "\t)",
              "\t/",
              "\tSum('Fact Ticket RMA'[RMA Count])",
              "\t, TreatAs (period,'Fact Ticket Item'[Created Date])",
              ")"
            ],
            "formatString": "#,0.0"
          },
          {
            "name": "DOA Opened Count",
            "expression": [
              "",
              "Calculate (",
              "\t[RMA Opened Count]",
              "\t, 'Ticket'[Priority] = \"5\"",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "Ticket Count % by Ageing bucket",
            "expression": [
              "",
              "",
              "VAR allTickets=CALCULATE( COUNT('Fact Ticket'[SKTicket]), 'Fact Ticket'[Ticket Net Hrs]>0)",
              "",
              "VAR selectedBucket=IF(HASONEVALUE('Ticket Ageing Hrs'[ID]),VALUES('Ticket Ageing Hrs'[ID]))",
              "",
              "RETURN ",
              "SWITCH(",
              "    selectedBucket,",
              "    ",
              "    1,",
              "    CALCULATE( COUNT('Fact Ticket'[SKTicket]), 'Fact Ticket'[Ticket Net Hrs]>0 && 'Fact Ticket'[Ticket Net Hrs]<=24)/allTickets,",
              "    ",
              "    2,",
              "    CALCULATE( COUNT('Fact Ticket'[SKTicket]), 'Fact Ticket'[Ticket Net Hrs]>24 && 'Fact Ticket'[Ticket Net Hrs]<=48)/allTickets,",
              "    ",
              "    3,",
              "    CALCULATE( COUNT('Fact Ticket'[SKTicket]), 'Fact Ticket'[Ticket Net Hrs]>48 && 'Fact Ticket'[Ticket Net Hrs]<=72)/allTickets,",
              "    ",
              "    4,",
              "    CALCULATE( COUNT('Fact Ticket'[SKTicket]), 'Fact Ticket'[Ticket Net Hrs]>72)/allTickets,",
              "",
              "    allTickets",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "Total Closed Tickets %",
            "expression": [
              "",
              "/* Calculates number of Tickets closed divided by amount of work days */",
              "",
              "VAR period=DISTINCT('Reporting Calendar'[Date])",
              "",
              "RETURN",
              "CALCULATE(",
              "    [_base Total Tickets Count],",
              "    TREATAS (period,'Fact Ticket'[Ticket Closed Date])",
              ")/CALCULATE(SUM('Reporting Calendar'[Is Week Day]),TREATAS(period,'Fact Ticket'[Ticket Closed Date]))",
              "    "
            ]
          },
          {
            "name": "Lead time issue to resolution",
            "expression": [
              "",
              "",
              "VAR period=DISTINCT('Reporting Calendar'[Date])",
              "",
              "RETURN ",
              "CALCULATE(SUM('Ticket'[Ticket Net Days]),TREATAS(period,'Fact Ticket'[Ticket Resolved Date]))"
            ]
          },
          {
            "name": "Milestone Count",
            "expression": [
              "",
              "",
              "VAR period=DISTINCT('Reporting Calendar'[Date])",
              "",
              "RETURN",
              "CALCULATE(",
              "    SUM('Fact Ticket Milestone'[Milestones Count]),",
              "    TREATAS (period,'Fact Ticket Milestone'[Key Start Date])",
              ")",
              "    "
            ]
          },
          {
            "name": "Milestone Net Hours Total",
            "expression": [
              "",
              "",
              "VAR period=DISTINCT('Reporting Calendar'[Date])",
              "",
              "RETURN",
              "CALCULATE(",
              "    SUM('Fact Ticket Milestone'[Milestone Net Hours]),",
              "    TREATAS (period,'Fact Ticket Milestone'[Key Start Date])",
              ")",
              "    "
            ]
          },
          {
            "name": "Milestone Net Hours Avg",
            "expression": [
              "",
              "",
              "IFERROR(",
              "\t[Milestone Net Hours Total] / [Milestone Count]",
              "\t, BLANK()",
              ")"
            ]
          }
        ]
      },
      {
        "name": "Ticket Ageing Hrs",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Ticket Age Hrs",
            "dataType": "string",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Ticket Age Hrs]"
          },
          {
            "type": "calculatedTableColumn",
            "name": "ID",
            "dataType": "int64",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "isHidden": true,
            "sourceColumn": "[ID]"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Sort Order",
            "dataType": "int64",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "isHidden": true,
            "sourceColumn": "[Sort Order]"
          }
        ],
        "partitions": [
          {
            "name": "CalculatedTable 1",
            "source": {
              "type": "calculated",
              "expression": [
                "",
                "DATATABLE (",
                "    ",
                "    \"Ticket Age Hrs\", STRING,",
                "    \"ID\", INTEGER,",
                "    \"Sort Order\", INTEGER,",
                "        ",
                "    { ",
                "        {\"<=24\",1,1},",
                "        {\">24 and <=48\",2,2},",
                "        {\">48 and <=72\",3,3},",
                "        {\">72\",4,4}",
                "    } ",
                ")"
              ]
            }
          }
        ]
      },
