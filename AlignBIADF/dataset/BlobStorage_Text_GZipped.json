{
	"name": "BlobStorage_Text_GZipped",
	"properties": {
		"linkedServiceName": {
			"referenceName": "BlobStorage",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"FilePath": {
				"type": "string"
			},
			"FileName": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "AzureBlob",
		"typeProperties": {
			"format": {
				"type": "TextFormat",
				"columnDelimiter": "|",
				"rowDelimiter": "",
				"escapeChar": "\\",
				"nullValue": "/N",
				"treatEmptyAsNull": false,
				"skipLineCount": 0,
				"firstRowAsHeader": true
			},
			"compression": {
				"type": "GZip",
				"level": "Optimal"
			},
			"fileName": {
				"value": "@dataset().FileName",
				"type": "Expression"
			},
			"folderPath": {
				"value": "@dataset().FilePath",
				"type": "Expression"
			}
		}
	},
	"type": "Microsoft.DataFactory/factories/datasets"
}