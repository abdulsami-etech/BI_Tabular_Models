{
	"name": "ImsFailureLog",
	"properties": {
		"linkedServiceName": {
			"referenceName": "IMSLoyaltyADLSV2",
			"type": "LinkedServiceReference",
			"parameters": {
				"AdlsContainer": {
					"value": "@dataset().AdlsContainer",
					"type": "Expression"
				}
			}
		},
		"parameters": {
			"AdlsContainer": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@concat('Failure_log_',convertFromUtc(utcnow(),'Pacific Standard Time'))",
					"type": "Expression"
				},
				"folderPath": {
					"value": "@concat(formatDateTime(utcnow(),'yyyy'),'',formatDateTime(utcnow(),'MM'),'',formatDateTime(utcnow(),'dd'))",
					"type": "Expression"
				},
				"fileSystem": "marketing/ims-loyalty/logs/adf"
			},
			"columnDelimiter": ",",
			"escapeChar": "\\",
			"firstRowAsHeader": true,
			"quoteChar": "\""
		},
		"schema": []
	}
}