{
	"name": "CaseStateCCAABatchAttributes",
	"properties": {
		"activities": [
			{
				"name": "Copy CCAA Batch Attributes",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Generate new BatchId",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlDWSource",
						"sqlReaderQuery": "SELECT [Clinid]\n      ,[Team]\n      ,[DDTbacklog]\n      ,[SSbacklog]\n      ,[DedicatedTech]\n      ,[UpcomingHoliday]\n      ,[MorningShift]\n      ,[EveningShift]\n      ,[Capacity]\n      ,[Region]\n  FROM [DWCaseMonitor].[CaseStateCCAABatchAttributes]",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "AzureSqlSink",
						"preCopyScript": "truncate table stage.ClincheckPredictionBatchAttributes",
						"disableMetricsCollection": false
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "SQLDW",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "SQLDBCaseState",
						"type": "DatasetReference",
						"parameters": {
							"TableName": "stage.ClincheckPredictionBatchAttributes"
						}
					}
				]
			},
			{
				"name": "Generate new BatchId",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlSource",
						"sqlReaderStoredProcedureName": "[CTRL].[ETLBatchLogUpdate]",
						"storedProcedureParameters": {
							"SourceSystem": {
								"type": "string",
								"value": {
									"value": "@pipeline().parameters.SourceSystem",
									"type": "Expression"
								}
							}
						},
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "SQLDBConfig",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "Procedure to Populate Main Table",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Copy CCAA Batch Attributes",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[LoadClincheckPredictionBatchAttributes]"
				},
				"linkedServiceName": {
					"referenceName": "SQLDBCaseState",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "On failure - iterate through LZ Objects",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Procedure to Populate Main Table",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[CTRL].[ETLBatchLogUpdate]",
					"storedProcedureParameters": {
						"SourceSystem": {
							"value": {
								"value": "@pipeline().parameters.SourceSystem",
								"type": "Expression"
							},
							"type": "string"
						},
						"BatchID": {
							"value": {
								"value": "@activity('Generate new BatchId').output.firstRow.BatchId",
								"type": "Expression"
							},
							"type": "int32"
						},
						"ErrorMessage": {
							"value": "See ADF log",
							"type": "string"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "SQLDBConfig",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Update Batch Info",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Procedure to Populate Main Table",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[CTRL].[ETLBatchLogUpdate]",
					"storedProcedureParameters": {
						"SourceSystem": {
							"value": {
								"value": "@pipeline().parameters.SourceSystem",
								"type": "Expression"
							},
							"type": "string"
						},
						"BatchID": {
							"value": {
								"value": "@activity('Generate new BatchId').output.firstRow.BatchId",
								"type": "Expression"
							},
							"type": "int32"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "SQLDBConfig",
					"type": "LinkedServiceReference"
				}
			}
		],
		"parameters": {
			"SourceSystem": {
				"type": "string",
				"defaultValue": "CaseStateDW"
			},
			"Destination": {
				"type": "string",
				"defaultValue": "CaseStateSQL"
			}
		},
		"folder": {
			"name": "CaseState"
		},
		"annotations": []
	}
}