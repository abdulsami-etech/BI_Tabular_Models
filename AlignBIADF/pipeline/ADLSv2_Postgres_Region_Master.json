{
	"name": "ADLSv2_Postgres_Region_Master",
	"properties": {
		"activities": [
			{
				"name": "Get object list",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "Get source system properties",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlSource",
						"sqlReaderStoredProcedureName": "[CTRL].[ADLGetObjectList]",
						"storedProcedureParameters": {
							"SourceSystem": {
								"type": "string",
								"value": {
									"value": "@pipeline().parameters.SourceSystem",
									"type": "Expression"
								}
							},
							"ObjectList": {
								"type": "string",
								"value": {
									"value": "@pipeline().parameters.ObjectList",
									"type": "Expression"
								}
							}
						},
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "SQLDBConfig",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Generate new BatchID",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlSource",
						"sqlReaderStoredProcedureName": "[CTRL].[ETLBatchLogUpdate]",
						"storedProcedureParameters": {
							"SourceSystem": {
								"type": "string",
								"value": {
									"value": "@pipeline().parameters.SourceSystem",
									"type": "Expression"
								}
							}
						},
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "SQLDBConfig",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "Iterate through objects",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Get object list",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Get object list').output.value",
						"type": "Expression"
					},
					"isSequential": false,
					"activities": [
						{
							"name": "Load Object",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "ADLSv2_Postgres_Region_Internal",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"BatchID": {
										"value": "@activity('Generate new BatchID').output.firstRow.BatchID",
										"type": "Expression"
									},
									"ObjectID": {
										"value": "@{item().ObjectID}",
										"type": "Expression"
									},
									"RawFilePathWithoutContainer": {
										"value": "@join(skip(split(item().RawFilePath, '/'), 1), '/')",
										"type": "Expression"
									},
									"FileName": {
										"value": "@{item().FileName}",
										"type": "Expression"
									},
									"IsLZ": {
										"value": "@{item().IsLZ}",
										"type": "Expression"
									},
									"PredicateColumn": {
										"value": "@{item().PredicateColumn}",
										"type": "Expression"
									},
									"DataSliceStartValue": {
										"value": "@{item().DataSliceStartValue}",
										"type": "Expression"
									},
									"DataSliceEndValue": {
										"value": "@{item().DataSliceEndValue}",
										"type": "Expression"
									},
									"IsFullLoad": {
										"value": "@{item().IsFullLoad}",
										"type": "Expression"
									},
									"MaxPredicateValueQuery": {
										"value": "@{item().MaxPredicateValueQuery}",
										"type": "Expression"
									},
									"CurrentTimestamp": {
										"value": "@{item().CurrentTimestamp}",
										"type": "Expression"
									},
									"Destinations": {
										"value": "@{item().Destinations}",
										"type": "Expression"
									},
									"SourceSystemProperties": {
										"value": "@activity('Get source system properties').output.value",
										"type": "Expression"
									},
									"DataSliceValueDataType": {
										"value": "@{item().DataSliceValueDataType}",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "On failure - Load Object",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "Load Object",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"policy": {
								"timeout": "7.00:00:00",
								"retry": 1,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[CTRL].[ADLObjectUpdate]",
								"storedProcedureParameters": {
									"ObjectID": {
										"value": {
											"value": "@{item().ObjectID}",
											"type": "Expression"
										},
										"type": "int32"
									},
									"Status": {
										"value": "Failed",
										"type": "string"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "SQLDBConfig",
								"type": "LinkedServiceReference"
							}
						}
					]
				}
			},
			{
				"name": "Update Batch info",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Iterate through objects",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[CTRL].[ETLBatchLogUpdate]",
					"storedProcedureParameters": {
						"SourceSystem": {
							"value": {
								"value": "@pipeline().parameters.SourceSystem",
								"type": "Expression"
							},
							"type": "string"
						},
						"BatchID": {
							"value": {
								"value": "@activity('Generate new BatchID').output.firstRow.BatchID",
								"type": "Expression"
							},
							"type": "int32"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "SQLDBConfig",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "On failure - Get object list",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Get object list",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[CTRL].[ETLBatchLogUpdate]",
					"storedProcedureParameters": {
						"SourceSystem": {
							"value": {
								"value": "@pipeline().parameters.SourceSystem",
								"type": "Expression"
							},
							"type": "string"
						},
						"BatchID": {
							"value": {
								"value": "@activity('Generate new BatchID').output.firstRow.BatchID",
								"type": "Expression"
							},
							"type": "int32"
						},
						"ErrorMessage": {
							"value": {
								"value": "@activity('Get object list').Error.Message",
								"type": "Expression"
							},
							"type": "string"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "SQLDBConfig",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "On failure - Iterate through objects",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Iterate through objects",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[CTRL].[ETLBatchLogUpdate]",
					"storedProcedureParameters": {
						"SourceSystem": {
							"value": {
								"value": "@pipeline().parameters.SourceSystem",
								"type": "Expression"
							},
							"type": "string"
						},
						"BatchID": {
							"value": {
								"value": "@activity('Generate new BatchID').output.firstRow.BatchID",
								"type": "Expression"
							},
							"type": "int32"
						},
						"ErrorMessage": {
							"value": "See ETL log",
							"type": "string"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "SQLDBConfig",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Get source system properties",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "Generate new BatchID",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "declare @ConnStrs varchar(1000) = CTRL.GetSourceSystemProperty('@{pipeline().parameters.SourceSystem}','ConnectionStringSecretname')\n\t,\t@Regions varchar(1000) = isnull(CTRL.GetSourceSystemProperty('@{pipeline().parameters.SourceSystem}','Regions'), 'Global')\n\nselect connStrs.value as ConnectionStringSecret, regions.value as Region\nfrom (\n\tselect value, row_number() over (order by charindex(';' + value + ';', ';' + @ConnStrs + ';')) as rn\n\tfrom string_split(@ConnStrs, ';')\n) connStrs\ninner join (\n\tselect value, row_number() over (order by charindex(';' + value + ';', ';' + @Regions + ';')) as rn\n\tfrom string_split(@Regions, ';')\n) regions on regions.rn = connStrs.rn",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "SQLDBConfig",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			}
		],
		"parameters": {
			"ObjectList": {
				"type": "string"
			},
			"SourceSystem": {
				"type": "string"
			}
		},
		"folder": {
			"name": "SourceToADLSv2"
		},
		"annotations": []
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}