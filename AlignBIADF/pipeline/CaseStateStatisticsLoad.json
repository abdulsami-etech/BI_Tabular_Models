{
	"name": "CaseStateStatisticsLoad",
	"properties": {
		"activities": [
			{
				"name": "Copy Case State statistics",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "truncate CaseStateStatistics table",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlDWSource",
						"sqlReaderQuery": "SELECT \n     [SKCaseStateStatistic]\n      ,[OperationName]\n      ,[OperationType]\n      ,[Deviation1]\n      ,[Deviation2]\n      ,[Deviation3]\n      ,[SourceSystem]\n  FROM [DWCaseMonitor].[CaseStateStatistics]"
					},
					"sink": {
						"type": "AzureSqlSink",
						"disableMetricsCollection": false
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "SQLDW",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "SQLDBCaseState",
						"type": "DatasetReference",
						"parameters": {
							"TableName": "stage.CaseStateStatistics"
						}
					}
				]
			},
			{
				"name": "truncate CaseStateStatistics table",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "truncate table stage.CaseStateStatistics\nselect 1"
					},
					"dataset": {
						"referenceName": "SQLDBCaseState",
						"type": "DatasetReference",
						"parameters": {
							"TableName": "dbo.CaseStatestatistics"
						}
					}
				}
			},
			{
				"name": "CaseState Load Stage to Target",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Copy Case State statistics",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[LoadCaseStateStatistics]",
					"storedProcedureParameters": {
						"IsForceFullLoad": {
							"value": "True",
							"type": "Boolean"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "SQLDBCaseState",
					"type": "LinkedServiceReference"
				}
			}
		],
		"concurrency": 1,
		"variables": {
			"SourceSystem": {
				"type": "String",
				"defaultValue": "CaseState"
			}
		},
		"folder": {
			"name": "CaseState"
		},
		"annotations": []
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}