			{
				"name": "Get Details",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "Insert log",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlSource",
						"sqlReaderQuery": {
							"value": "\nselect\to.S3FileDestination + '/' + o.ObjectName + '/ToProcess' as ToProcessFolder\n\t,\to.ObjectName\n\t,\t'files' as Container\n\t, \tconvert(nvarchar(20),o.DataSliceStartValue) as DataSliceStartValue\n\t,\t o.PredicateExpression as FileName\n\t,\to.PredicateColumn as FileType\n        , 'files/' +o.S3FileDestination + '/' + o.ObjectName +'_' as UnzipedFileDestination\nfrom CTRL.ADLObject o\nwhere o.ObjectID = @{pipeline().parameters.ObjectID}",
							"type": "Expression"
						},
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "SQLDBConfig",
						"type": "DatasetReference"
					}
				}
			},
