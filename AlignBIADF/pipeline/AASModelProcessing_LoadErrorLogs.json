					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlDWSource",
						"sqlReaderQuery": "Update [DWSAP].[AASTableMarkers]\nSet [Marker] = Temp.[Marker]\nFrom [DWSAP].[AASTableMarkers] AS [Main]\ninner join [DWSAP].[AASTableMarkers_Temp] AS Temp ON Main.[DbName] = Temp.[DbName] AND Main.[TableName] = Temp.[TableName]\n\nIf Exists (Select 1 from [INFORMATION_SCHEMA].[TABLES] \n\t\t\twhere [TABLE_SCHEMA] = 'DWSAP' AND [TABLE_NAME] = 'AASTableMarkers_Temp')\nBegin\n\tDrop table [DWSAP].[AASTableMarkers_Temp]\nEnd\n\nSelect 'Marker value reverted back' as [MessageValue];",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "SQLDW",
						"type": "DatasetReference"
					}
				}
			}
