				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlSource",
						"sqlReaderQuery": {
							"value": "select\t'files/' + o.SourceSystem + '/' + o.ObjectName + '/ToProcess' as ToProcessFolder\n\t,\t'files/' + o.SourceSystem + '/' + o.ObjectName + '/Processed' as ProcessedFolder\n\t,\to.SourceSystem + '/' + o.ObjectName + '/ToProcess' as ToProcessShortFolder\n\t,\to.SourceSystem + '/' + o.ObjectName + '/Processed' as ProcessedShortFolder\n\t,\to.ObjectName\n\t,\to.JSONQuery\nfrom CTRL.ADLObject o\nwhere o.ObjectID = @{pipeline().parameters.ObjectID}",
							"type": "Expression"
						},
						"partitionOption": "None"
					},
