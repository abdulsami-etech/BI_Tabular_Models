{
	"name": "FDLMonthEndDataLoads",
	"properties": {
		"activities": [
			{
				"name": "Update ObjectIDs",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[CTRL].[uspUpdateMonthEndObjectIDs]"
				},
				"linkedServiceName": {
					"referenceName": "SQLDBConfig",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "For Each ObjectID",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Get ObjectIDs",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Get ObjectIDs').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Execute ADLSv2_SAP_Master",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "ADLSv2_SAP_Master",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"ObjectList": {
										"value": "@{item().ObjectID}",
										"type": "Expression"
									}
								}
							}
						}
					]
				}
			},
			{
				"name": "Get ObjectIDs",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "Update ObjectIDs",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT ObjectID FROM CTRL.ADLObject WHERE ObjectID BETWEEN '@{pipeline().parameters.firstObjectID}'\nAND '@{pipeline().parameters.lastObjectID}'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "SQLDBConfig",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			}
		],
		"parameters": {
			"firstObjectID": {
				"type": "string"
			},
			"lastObjectID": {
				"type": "string"
			}
		},
		"folder": {
			"name": "Control"
		},
		"annotations": []
	}
}