					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlSource",
						"sqlReaderQuery": {
							"value": "select\to.SourceSystem + '/' + o.ObjectName + '/ToProcess' as ToProcessFolder\n\t,\to.SourceSystem + '/' + o.ObjectName + '/Processed' as ProcessedFolder\n\t,\to.SourceSystem + '/' + o.ObjectName + '/ToProcess' as ToProcessShortFolder\n\t,\to.ObjectName\n\t,\to.JSONQuery\n\t,\to.S3Bucket\n\t,\to.S3Folder\n\t,\t'files' as Container\n\t, \tconvert(nvarchar(20),o.DataSliceStartValue) as DataSliceStartValue\n\t,\t o.S3FileDestination + '/' + o.ObjectName + '/ToProcess' as ADLSToProcessFolder\nfrom CTRL.ADLObject o\nwhere o.ObjectID = @{pipeline().parameters.ObjectID}",
							"type": "Expression"
						},
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "SQLDBConfig",
						"type": "DatasetReference"
					}
				}
			},
