{
	"name": "FDL_Finance_File_Processing_Triggers",
	"properties": {
		"description": "FDL_Finance_File_Processing_Triggers",
		"activities": [
			{
				"name": "Get object list",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "Generate new BatchID",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlSource",
						"sqlReaderStoredProcedureName": "[CTRL].[ADLGetObjectList]",
						"storedProcedureParameters": {
							"SourceSystem": {
								"type": "string",
								"value": {
									"value": "@pipeline().parameters.SourceSystem",
									"type": "Expression"
								}
							},
							"ObjectList": {
								"type": "String",
								"value": {
									"value": "@pipeline().parameters.ObjectList",
									"type": "Expression"
								}
							}
						},
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "SQLDBConfig",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Generate new BatchID",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlSource",
						"sqlReaderStoredProcedureName": "[CTRL].[ETLBatchLogUpdate]",
						"storedProcedureParameters": {
							"SourceSystem": {
								"type": "string",
								"value": {
									"value": "@pipeline().parameters.SourceSystem",
									"type": "Expression"
								}
							}
						},
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "SQLDBConfig",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "Iterate through objects",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Get object list",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Set Temp Path",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Get object list').output.value",
						"type": "Expression"
					},
					"isSequential": false,
					"activities": [
						{
							"name": "Load Object",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "ADLSv2_File_Text_FinanceInternal_EventTriggers",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"BatchID": {
										"value": "@activity('Generate new BatchID').output.firstRow.BatchID",
										"type": "Expression"
									},
									"ObjectID": {
										"value": "@{item().ObjectID}",
										"type": "Expression"
									},
									"RawFilePath": {
										"value": "@{item().RawFilePath}",
										"type": "Expression"
									},
									"IsLZ": {
										"value": "@{item().IsLZ}",
										"type": "Expression"
									},
									"TempFolder": {
										"value": "@variables('TempFolder')",
										"type": "Expression"
									},
									"CurrentTimestamp": {
										"value": "@{item().CurrentTimestamp}",
										"type": "Expression"
									},
									"Destinations": {
										"value": "@{item().Destinations}",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "On failure - Load Object",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "Load Object",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"policy": {
								"timeout": "7.00:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[CTRL].[ADLObjectUpdate]",
								"storedProcedureParameters": {
									"ObjectID": {
										"value": {
											"value": "@{item().ObjectID}",
											"type": "Expression"
										},
										"type": "int32"
									},
									"Status": {
										"value": "Failed",
										"type": "string"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "SQLDBConfig",
								"type": "LinkedServiceReference"
							}
						}
					]
				}
			},
			{
				"name": "Update Batch info",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Iterate through objects",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[CTRL].[ETLBatchLogUpdate]",
					"storedProcedureParameters": {
						"SourceSystem": {
							"value": {
								"value": "@pipeline().parameters.SourceSystem",
								"type": "Expression"
							},
							"type": "string"
						},
						"BatchID": {
							"value": {
								"value": "@activity('Generate new BatchID').output.firstRow.BatchID",
								"type": "Expression"
							},
							"type": "int32"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "SQLDBConfig",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "On failure - Get object list",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Get object list",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[CTRL].[ETLBatchLogUpdate]",
					"storedProcedureParameters": {
						"SourceSystem": {
							"value": {
								"value": "@pipeline().parameters.SourceSystem",
								"type": "Expression"
							},
							"type": "string"
						},
						"BatchID": {
							"value": {
								"value": "@activity('Generate new BatchID').output.firstRow.BatchID",
								"type": "Expression"
							},
							"type": "int32"
						},
						"ErrorMessage": {
							"value": {
								"value": "@activity('Get object list').Error.Message",
								"type": "Expression"
							},
							"type": "string"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "SQLDBConfig",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Set Temp Path",
				"type": "SetVariable",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"variableName": "TempFolder",
					"value": {
						"value": "@concat('control/Temp/', utcnow('yyyy/MM/dd/'))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "For LZ Master",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Get_URL",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Emailid",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Get object list').output.value",
						"type": "Expression"
					},
					"isSequential": false,
					"activities": [
						{
							"name": "Execute LZ Finance Master",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "LZ_Master_EventTriggers",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"SourceSystemList": "SAPFile",
									"Destination": "LZ",
									"ObjectList": {
										"value": "@item().ObjectID",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "SendMail",
							"type": "WebActivity",
							"dependsOn": [
								{
									"activity": "Execute LZ Finance Master",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "7.00:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"url": {
									"value": "@activity('Get_URL').output.firstRow.TEXT",
									"type": "Expression"
								},
								"method": "POST",
								"body": {
									"value": "{\n\t\"EmailTo\":\"@{activity('Emailid').output.firstRow.TEXT}\",\n\t\"Subject\":\"SrcSAP Table\",\n\t\"PipelineName\":\"@{pipeline().Pipeline}\",\n\t\"ObjectName\":\"@{item().ObjectName}\",\t\n\t\"Status\":\" Processed Successfully\"\n}",
									"type": "Expression"
								}
							}
						},
						{
							"name": "ExecuteDWFinanceMaster",
							"type": "ExecutePipeline",
							"dependsOn": [
								{
									"activity": "SendMail",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "DW_FinanceMaster_EventTriggers",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"SchemaName": "DWSAP",
									"ObjectName": {
										"value": "@item().ObjectName",
										"type": "Expression"
									}
								}
							}
						}
					]
				}
			},
			{
				"name": "Get_URL",
				"description": "",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "Update Batch info",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": " Select [TEXT] from [CSTM].[Values]\n where [PipelineName] = 'ADLSv2_File_Text_FinanceInternal'\n and [Type] = 'URL'",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "SQLDBConfig",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "Emailid",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "Update Batch info",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "Select [TEXT] from [CSTM].[Values]\n where [PipelineName] = 'ADLSv2_File_Text_FinanceInternal'\n and [Type] = 'Email'",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "SQLDBConfig",
						"type": "DatasetReference"
					}
				}
			}
		],
		"parameters": {
			"SourceSystem": {
				"type": "string",
				"defaultValue": "SAPFile"
			},
			"ObjectList": {
				"type": "string"
			}
		},
		"variables": {
			"TempFolder": {
				"type": "String"
			},
			"TempObjectName": {
				"type": "String"
			}
		},
		"folder": {
			"name": "Finance"
		},
		"annotations": []
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}