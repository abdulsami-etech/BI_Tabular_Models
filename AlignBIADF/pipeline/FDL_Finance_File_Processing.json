										"value": "@{item().ObjectID}",
										"type": "Expression"
									},
									"RawFilePath": {
										"value": "@{item().RawFilePath}",
										"type": "Expression"
									},
									"IsLZ": {
										"value": "@{item().IsLZ}",
										"type": "Expression"
