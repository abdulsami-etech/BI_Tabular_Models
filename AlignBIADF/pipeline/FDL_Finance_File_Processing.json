				"linkedServiceName": {
					"referenceName": "SQLDBConfig",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Set Temp Path",
				"type": "SetVariable",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"variableName": "TempFolder",
					"value": {
						"value": "@concat('control/Temp/', utcnow('yyyy/MM/dd/'))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "For LZ Master",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Get_URL",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Emailid",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Get object list').output.value",
						"type": "Expression"
					},
					"isSequential": false,
					"activities": [
						{
							"name": "Execute LZ Finance Master",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "LZ_Master",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"SourceSystemList": "SAPFile",
									"Destination": "LZ",
									"ObjectList": {
										"value": "@item().ObjectID",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "ExecuteDWFinanceMaster",
							"type": "ExecutePipeline",
							"dependsOn": [
								{
									"activity": "If Completed",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "DW_FinanceMaster",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"SchemaName": "DWSAP",
									"ObjectName": {
										"value": "@item().ObjectName",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "Check File Status",
							"type": "Lookup",
							"dependsOn": [
								{
									"activity": "Execute LZ Finance Master",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "7.00:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "Select ISNULL([Status],'NULL') AS [Status] from CTRL.ADLObjectFile\nwhere [ObjectID] = @{item().ObjectID}\n\tand [ADLSBatchID] = @{activity('Generate new BatchID').output.firstRow.BatchID}\n\tand [DateUpdated] = (Select Max([DateUpdated]) from CTRL.ADLObjectFile where [ObjectID] = @{item().ObjectID} and [ADLSBatchID] = @{activity('Generate new BatchID').output.firstRow.BatchID});",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "SQLDBConfig",
									"type": "DatasetReference"
								},
								"firstRowOnly": false
							}
						},
						{
							"name": "If Completed",
							"type": "IfCondition",
							"dependsOn": [
								{
									"activity": "Check File Status",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@equals(activity('Check File Status').output.value,'Completed')",
									"type": "Expression"
								},
								"ifTrueActivities": [
									{
										"name": "SendMail",
										"type": "WebActivity",
										"dependsOn": [],
										"policy": {
											"timeout": "7.00:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"url": {
												"value": "@activity('Get_URL').output.firstRow.TEXT",
												"type": "Expression"
											},
											"method": "POST",
											"body": {
												"value": "{\n\t\"EmailTo\":\"@{activity('Emailid').output.firstRow.TEXT}\",\n\t\"Subject\":\"SrcSAP Table\",\n\t\"PipelineName\":\"@{pipeline().Pipeline}\",\n\t\"ObjectName\":\"@{item().ObjectName}\",\t\n\t\"Status\":\" Processed Successfully\"\n}",
												"type": "Expression"
											}
										}
									}
								]
							}
						},
						{
							"name": "Check LZ File Load Status",
							"type": "Lookup",
							"dependsOn": [
								{
									"activity": "Execute LZ Finance Master",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "7.00:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": ";WITH LogCTE\nAS\n(\nSELECT LogID\n,[ObjectID]\n,[LoadStatus]\n,[ErrorMessage]\n,[SinkName]\n,ROW_NUMBER()OVER(ORDER BY LogID DESC) AS Latest\nFROM [CTRL].[ETLLog]\nWHERE ObjectID =  @{item().ObjectID}\nAND LogType='LZLoadFile'\n)\nSELECT LogID,ObjectId,LoadStatus,ErrorMessage,SinkName,Latest FROM LogCTE\nWHERE Latest=1",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "SQLDBConfig",
									"type": "DatasetReference"
								}
							}
						},
						{
							"name": "If Condition1",
							"type": "IfCondition",
							"dependsOn": [
								{
									"activity": "Check LZ File Load Status",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@equals(activity('Check LZ File Load Status').output.firstRow.LoadStatus,'Failure')",
									"type": "Expression"
								},
								"ifTrueActivities": [
									{
										"name": "Send LZ Email",
										"type": "WebActivity",
										"dependsOn": [
											{
												"activity": "Update status of faulty files",
												"dependencyConditions": [
													"Completed"
												]
											}
										],
										"policy": {
											"timeout": "7.00:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"url": {
												"value": "@activity('Get_URL').output.firstRow.TEXT",
												"type": "Expression"
											},
											"method": "POST",
											"body": {
												"value": "{\n\t\"EmailTo\":\"@{activity('Emailid').output.firstRow.TEXT}\",\n\t\"Subject\":\"@{concat(pipeline().DataFactory,' - FDL FileProcessing')} Failed\",\n\t\"PipelineName\":\"@{pipeline().Pipeline}\",\n\t\"ObjectName\":\"@{item().ObjectName}\",\n\t\"FileName\" :\"FDL File\",\n\t\"Status\":\"@{concat('File Processing failed due to junk or bad data within the file - More Details:  ',activity('Check LZ File Load Status').output.firstRow.ErrorMessage)}\"\n}",
												"type": "Expression"
											}
										}
									},
									{
										"name": "Update status of faulty files",
										"type": "Lookup",
										"dependsOn": [],
										"policy": {
											"timeout": "7.00:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "AzureSqlSource",
												"sqlReaderQuery": {
													"value": "\nupdate ctrl.ADLObjectFile\nset Status='Skipped',DateUpdated=GETUTCDATE()\nfrom ctrl.ADLObjectFile \nWHERE FileName=@{concat('''',activity('Check LZ File Load Status').output.firstRow.SinkName,'''')}\nand ObjectID= @{item().ObjectID}\nSELECT 1",
													"type": "Expression"
												},
												"queryTimeout": "02:00:00",
												"partitionOption": "None"
											},
											"dataset": {
												"referenceName": "SQLDBConfig",
												"type": "DatasetReference"
											},
											"firstRowOnly": false
										}
									}
								]
							}
						}
					]
				}
			},
			{
				"name": "Get_URL",
				"description": "",
				"type": "Lookup",
				"dependsOn": [
