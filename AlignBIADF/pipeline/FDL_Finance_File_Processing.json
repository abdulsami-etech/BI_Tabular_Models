								"storedProcedureName": "[CTRL].[ADLObjectUpdate]",
								"storedProcedureParameters": {
									"ObjectID": {
										"value": {
											"value": "@{item().ObjectID}",
											"type": "Expression"
										},
										"type": "int32"
									},
									"Status": {
										"value": "Failed",
										"type": "string"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "SQLDBConfig",
								"type": "LinkedServiceReference"
							}
						}
