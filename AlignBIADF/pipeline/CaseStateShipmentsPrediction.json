					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "select (rownum/1000)*1000  as LoopCount from [dbo].[CaseStateShipmentAttributes]\nwhere PredictedTime is null\ngroup by rownum/1000\norder by 1",
