									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "@concat('select ',concat('''',concat('{\"Inputs\": {\n\"WebServiceInput0\":',concat('''',concat('+ (SELECT \n\t   cast(DWBatchID as nvarchar) as DWBatchID\n      ,cast([SAPOrderNumber] as varchar) as [SAPOrderNumber]\n\t  ,[StartDate]\n      ,[ScanType]\n      ,[ProductType]\n      ,[Region]\n      ,[Arches]\n\t  ,cast([Backlog] as varchar) as [Backlog]\n\t  ,cast([Capacity] as varchar) as [Capacity]\n\t  ,cast([ComplianceIndicator] as varchar) as [ComplianceIndicator]\n\t  ,cast([MassFinisher] as varchar) as [MassFinisher]\n\t  ,cast([WeekNumber] as varchar) as [WeekNumber]\n\t  ,cast([DayNumberOfWeek] as varchar) as [DayNumberOfWeek]   \n\t  ,cast([Stages] as varchar) as [Stages]   \n\t  ,cast([FABMachineCount] as varchar) as [FABMachineCount]   \n\t  ,cast([Expedite] as varchar) as [Expedite]   \n\t  ,cast([FABHourCapacity] as varchar) as [FABHourCapacity]  \n\t  ,cast([AFABMachineCount] as varchar) as [AFABMachineCount]  \n\t  ,cast([Rework] as varchar) as [Rework]\n\t  ,cast(isnull(PredictedTime,0) as varchar) as PredictedTime\n\t  ,cast([ActualTime] as varchar) as [ActualTime]  \n\t  ,cast([BacklogFactor] as varchar) as [BacklogFactor]\n  FROM [dbo].[CaseStateShipmentAttributes] where rownum between ',concat(item().LoopCount,concat(' and ',concat(item().LoopCount,concat(' + 999' ,concat(variables('QueryString')\n  ))))))))))",
										"type": "Expression"
									},
