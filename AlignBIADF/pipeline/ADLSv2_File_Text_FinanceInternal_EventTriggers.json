					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlSource",
						"sqlReaderQuery": {
							"value": "select\t'finance/' + o.SourceSystem + '/' + o.ObjectName + '/Tobeprocessed' as ToProcessFolder\n\t,\t'finance/' + o.SourceSystem + '/' + o.ObjectName + '/Processed' as ProcessedFolder\n\t,\to.ObjectName\n\t,\to.ColumnList\n\t,\to.QueryFilter\n\t,\tCTRL.GetSourceSystemProperty(o.SourceSystem, 'TextColumnDelimiter') as TextColumnDelimiter\n\t,\tCTRL.GetSourceSystemProperty(o.SourceSystem, 'TextEscapeChar') as TextEscapeChar\n\t,\tCTRL.GetSourceSystemProperty(o.SourceSystem, 'TextIsFirstRowHeader') as TextIsFirstRowHeader\n\t,\tCASE WHEN o.ObjectID = 69014 THEN '\"'\n\t\t\tELSE CTRL.GetSourceSystemProperty(o.SourceSystem, 'TextQuoteChar') END as TextQuoteChar\n\t,\tCTRL.GetSourceSystemProperty(o.SourceSystem, 'TextSkipLineCount') as TextSkipLineCount\n\t,\tCTRL.GetSourceSystemProperty(o.SourceSystem, 'TextTreatEmptyAsNull') as TextTreatEmptyAsNull\n\t,\tCTRL.GetSourceSystemProperty(o.SourceSystem, 'TextRowDelimiter') as TextRowDelimiter\n\t,\tCTRL.GetSourceSystemProperty(o.SourceSystem, 'TextEncoding') as TextEncoding\nfrom CTRL.ADLObject o\nwhere o.ObjectID = @{pipeline().parameters.ObjectID}",
							"type": "Expression"
						},
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "SQLDBConfig",
						"type": "DatasetReference"
					}
				}
			},
