									"type": "PostgreSqlSource",
									"query": {
										"value": "@concat('Select ',concat('''',concat(pipeline().parameters.SourceSystemName,concat('''',concat(' as \"SourceSystemName\",\n ''PostgreSQL'' as \"SourceSystemType\", table_catalog, table_schema,\n table_name,table_type from INFORMATION_SCHEMA.TABLES')))))",
										"type": "Expression"
									}
								},
								"sink": {
									"type": "AzureSqlSink",
									"preCopyScript": "truncate table TEMP.MetaDataTables",
									"disableMetricsCollection": false
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "PostgresGenericDS",
									"type": "DatasetReference",
									"parameters": {
										"dsConnStringSecretName": {
											"value": "@pipeline().parameters.ConnectionString",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "SQLDBConfig_Temp",
									"type": "DatasetReference",
									"parameters": {
										"TableName": "Temp.MetaDataTables"
									}
								}
							]
						},
						{
							"name": "On failure - Copy Source metadata into temp table_copy1",
