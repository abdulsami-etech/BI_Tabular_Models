					{
						"activity": "Generate new BatchID",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(pipeline().parameters.SourceSystemType,'MSSQL')",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Copy Source Metadata into temp table for SQL Server",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "7.00:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "SqlServerSource",
									"sqlReaderQuery": {
										"value": "@concat('Select ',concat('''',concat(pipeline().parameters.SourceSystemName,concat('''',concat(' as SourceSystemName , ',concat(' ''MSSQL'' as SourceSystemType, table_catalog, table_schema, table_name,table_type from INFORMATION_SCHEMA.TABLES'))))))",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"sink": {
									"type": "AzureSqlSink",
									"preCopyScript": "truncate table TEMP.MetaDataTables",
									"disableMetricsCollection": false
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "SQLServer_DS",
									"type": "DatasetReference",
									"parameters": {
										"dsConnStringSecretName": {
											"value": "@pipeline().parameters.ConnectionString",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "SQLDBConfig_Temp",
									"type": "DatasetReference",
									"parameters": {
										"TableName": "TEMP.MetaDataTables"
									}
								}
							]
						},
						{
							"name": "On failure - Copy Source metadata into temp table",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "Copy Source Metadata into temp table for SQL Server",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"policy": {
								"timeout": "7.00:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[CTRL].[ETLBatchLogUpdate]",
								"storedProcedureParameters": {
									"SourceSystem": {
										"value": {
											"value": "@variables('SourceSystem')",
											"type": "Expression"
										},
										"type": "string"
									},
									"BatchID": {
										"value": {
											"value": "@activity('Generate new BatchID').output.firstRow.BatchID",
											"type": "Expression"
										},
										"type": "int32"
