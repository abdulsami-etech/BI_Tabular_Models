							"dependsOn": [
								{
									"activity": "Copy source metadata into Temp table for PostgreSQL",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"policy": {
								"timeout": "7.00:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[CTRL].[ETLBatchLogUpdate]",
								"storedProcedureParameters": {
									"SourceSystem": {
										"value": {
											"value": "@variables('SourceSystem')",
											"type": "Expression"
										},
										"type": "string"
									},
									"BatchID": {
										"value": {
											"value": "@activity('Generate new BatchID').output.firstRow.BatchID",
