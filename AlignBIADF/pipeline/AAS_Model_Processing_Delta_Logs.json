							"typeProperties": {
								"source": {
									"type": "SqlDWSource",
									"sqlReaderQuery": "If Exists (Select 1 from [INFORMATION_SCHEMA].[TABLES] \n\t\t\twhere [TABLE_SCHEMA] = 'DWSAP' AND [TABLE_NAME] = 'AASTableMarkers_Temp')\nBegin\n\tDrop table [DWSAP].[AASTableMarkers_Temp]\n\tSelect 'Temp table dropped' as [MessageValue]\nEnd\n\nElse\nSelect 'Temp table does not exist' as [MessageValue]",
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "SQLDW",
									"type": "DatasetReference"
