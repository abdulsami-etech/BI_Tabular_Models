{
	"name": "FDLRecon",
	"properties": {
		"activities": [
			{
				"name": "Generate new BatchId",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlDWSource",
						"sqlReaderQuery": "select  Case When Max(BatchID) IS NULL Then '1'\nELSE Max(BatchID) + 1\nEnd As [BatchId]\n from [TABSAP].[FDLRecon_Difference]",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "SQLDW",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "SAP Recon",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Insert Log",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[DWSAP].[DailySourceToDestinationRecon_SAP]",
					"storedProcedureParameters": {
						"BatchID": {
							"value": {
								"value": "@activity('Generate new BatchId').output.firstRow.BatchId",
								"type": "Expression"
							},
							"type": "Int32"
						},
						"LastSuccessfullDWTimestamp": {
							"value": {
								"value": "@pipeline().TriggerTime",
								"type": "Expression"
							},
							"type": "DateTime"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "SQLDW",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Recon Result to BLOB",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "SAP Recon",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlDWSource",
						"sqlReaderQuery": {
							"value": "SELECT [SQLTableName], [SAPTableName], [Period], [DWCount], [SAPCount], [Difference], [ExtractionType]\nFROM [TABSAP].[FDLRecon_Difference]\n where batchid = @{activity('Generate new BatchId').output.firstRow.BatchId}\norder by [SAPTableName], [Period]",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".csv"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "SQLDW",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "ADLSv2_SAPRecon",
						"type": "DatasetReference",
						"parameters": {
							"BatchID": {
								"value": "@{activity('Generate new BatchId').output.firstRow.BatchId}_@{pipeline().TriggerTime}",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "Send Email",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Get Email ID",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Get URL",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"url": {
						"value": "@{activity('Get URL').output.firstRow.Text}",
						"type": "Expression"
					},
					"method": "POST",
					"body": {
						"value": "{\n \"EmailTo\":\"@{activity('Get Email ID').output.firstRow.Text}\",\n \"EmailSubject\":\"ECC to DW Data Reconciliation Result\",\n \"FileName\":\"@{concat(activity('File Name').output.itemName,'.csv')}\",\n \"DataFactoryName\":\"@{pipeline().DataFactory}\",\n \"PipeLineName\":\"@{pipeline().Pipeline}\",\n \"BlobPath\":\"/files/SAPFile/SAPDataRecon/ToProcess/@{activity('File Name').output.itemName}\"\n}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "File Name",
				"type": "GetMetadata",
				"dependsOn": [
					{
						"activity": "Recon Result to BLOB",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ADLSv2_SAPRecon",
						"type": "DatasetReference",
						"parameters": {
							"BatchID": {
								"value": "@{activity('Generate new BatchId').output.firstRow.BatchId}_@{pipeline().TriggerTime}",
								"type": "Expression"
							}
						}
					},
					"fieldList": [
						"itemName",
						"size"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "Update Log",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Send Email",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[CTRL].[ETLLogUpdate]",
					"storedProcedureParameters": {
						"FileSizeInBytes": {
							"value": {
								"value": "@activity('File Name').output.size",
								"type": "Expression"
							},
							"type": "Int64"
						},
						"LogID": {
							"value": {
								"value": "@activity('Insert log').output.firstRow.LogID",
								"type": "Expression"
							},
							"type": "Int32"
						},
						"RowsInserted": {
							"value": {
								"value": "@{activity('Recon Result to BLOB').output.rowsCopied}",
								"type": "Expression"
							},
							"type": "Int32"
						},
						"SinkName": {
							"value": "ADLSv2_SAPRecon",
							"type": "String"
						},
						"SinkPathRAW": {
							"value": {
								"value": "/files/SAPFile/SAPDataRecon/ToProcess/@{activity('File Name').output.itemName}",
								"type": "Expression"
							},
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "SQLDBConfig",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "On Failure - Update ETL Log",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "SAP Recon",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[CTRL].[ETLLogUpdate]",
					"storedProcedureParameters": {
						"ErrorMessage": {
							"value": {
								"value": "@activity('SAP Recon').error.Message",
								"type": "Expression"
							},
							"type": "String"
						},
						"LogID": {
							"value": {
								"value": "@activity('Insert log').output.firstRow.LogID",
								"type": "Expression"
							},
							"type": "Int32"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "SQLDBConfig",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Get Email ID",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "File Name",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "Select Text FROM [CSTM].[VALUES] where [PipelineName] = 'FDLRecon' and [TYPE] = 'Email'",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "SQLDBConfig",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "Insert Log",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "Generate new BatchId",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderStoredProcedureName": "[CTRL].[ETLLogUpdate]",
						"storedProcedureParameters": {
							"BatchID": {
								"type": "Int32",
								"value": {
									"value": "@activity('Generate new BatchId').output.firstRow.BatchId",
									"type": "Expression"
								}
							},
							"DataSliceEndValue": {
								"type": "String",
								"value": null
							},
							"DataSliceStartValue": {
								"type": "String",
								"value": null
							},
							"ErrorMessage": {
								"type": "String",
								"value": null
							},
							"FileSizeInBytes": {
								"type": "Int64",
								"value": null
							},
							"LogID": {
								"type": "Int32",
								"value": null
							},
							"LogType": {
								"type": "String",
								"value": "FDLRecon"
							},
							"ObjectID": {
								"type": "Int32",
								"value": {
									"value": "@activity('Generate new BatchId').output.firstRow.BatchId",
									"type": "Expression"
								}
							},
							"PipelineName": {
								"type": "String",
								"value": {
									"value": "@pipeline().Pipeline",
									"type": "Expression"
								}
							},
							"PipelineTriggerType": {
								"type": "String",
								"value": {
									"value": "@pipeline().TriggerType",
									"type": "Expression"
								}
							},
							"RowsInserted": {
								"type": "Int32",
								"value": null
							},
							"RowsUpdated": {
								"type": "Int32",
								"value": null
							},
							"SinkName": {
								"type": "String",
								"value": null
							},
							"SinkPathRAW": {
								"type": "String",
								"value": null
							}
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "SQLDBConfig",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "Get URL",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "File Name",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "Select Text FROM [CSTM].[VALUES] where [PipelineName] = 'FDLRecon' AND [Type] = 'URL'",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "SQLDBConfig",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "On Failure - Update Log",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Recon Result to BLOB",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[CTRL].[ETLLogUpdate]",
					"storedProcedureParameters": {
						"ErrorMessage": {
							"value": {
								"value": "@activity('Recon Result to BLOB').error.Message",
								"type": "Expression"
							},
							"type": "String"
						},
						"LogID": {
							"value": {
								"value": "@activity('Insert log').output.firstRow.LogID",
								"type": "Expression"
							},
							"type": "Int32"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "SQLDBConfig",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Update Failure Log",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Send Email",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[CTRL].[ETLLogUpdate]",
					"storedProcedureParameters": {
						"ErrorMessage": {
							"value": {
								"value": "@activity('Send Email').error.Message",
								"type": "Expression"
							},
							"type": "String"
						},
						"LogID": {
							"value": {
								"value": "@activity('Insert log').output.firstRow.LogID",
								"type": "Expression"
							},
							"type": "Int32"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "SQLDBConfig",
					"type": "LinkedServiceReference"
				}
			}
		],
		"variables": {
			"IsRunning": {
				"type": "Boolean",
				"defaultValue": true
			},
			"ResourceGroup": {
				"type": "String"
			},
			"IsNeedToWait": {
				"type": "Boolean"
			},
			"ResourceManagementAPIVersion": {
				"type": "String",
				"defaultValue": "2020-01-01"
			},
			"ADFAPIVersion": {
				"type": "String",
				"defaultValue": "2018-06-01"
			},
			"SubscriptionName": {
				"type": "String"
			}
		},
		"folder": {
			"name": "Finance"
		},
		"annotations": [],
		"lastPublishTime": "2020-10-22T18:52:34Z"
	},
