						"LZBatchID": {
							"value": {
								"value": "@pipeline().parameters.BatchID",
								"type": "Expression"
							},
							"type": "Int32"
						},
						"PKColumns": {
							"value": {
								"value": "@activity('Get Object Details').output.FirstRow.PKColumns",
								"type": "Expression"
							},
							"type": "String"
						},
						"SourceSystem": {
							"value": {
								"value": "@activity('Get Object Details').output.FirstRow.SourceSystem",
								"type": "Expression"
							},
							"type": "String"
						},
						"PredicateColumn": {
							"value": {
								"value": "@activity('Get Object Details').output.FirstRow.PredicateColumn",
								"type": "Expression"
							},
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "SQLDW",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "On failure - Generate External View",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Generate External View",
						"dependencyConditions": [
