							},
							"type": "String"
						},
						"SessionID": {
							"value": {
								"value": "@variables('SessionID')",
								"type": "Expression"
							},
							"type": "String"
						},
						"Table": {
							"value": {
								"value": "@activity('Get Object Details').output.FirstRow.SourceTableName",
								"type": "Expression"
							},
							"type": "String"
						},
						"ADLSTimestampStr": {
							"value": {
								"value": "@pipeline().parameters.ADLSTimestamp",
