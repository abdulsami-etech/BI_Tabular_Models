{
	"name": "LZ_LoadFile_EventTriggers",
	"properties": {
		"activities": [
			{
				"name": "Get Object Details",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "Set Session ID",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlSource",
						"sqlReaderQuery": {
							"value": "select\tObjectName\n\t,\tExternalViewName\n\t,\tSourceSystem\n\t,\tDestSchema\n\t,\tSourceSchema\n\t,\tDestTableName\n\t,\tSourceTableName\n\t,\tStoreOption\n\t,\tDistributionOption\n\t,\tIsLoadAllColumns\n\t,\tSourceColumnDroppedAction\n\t,\t[Columns]\n\t,\tDatatypes\n\t,\tIsNullables\n\t,\tJoinPredicates\n\t,\tJoinPredicatesForUpdate\n\t,\tPKColumns\n\t,\tPredicateColumn\nfrom CTRL.LZGetObjectDetails(@{pipeline().parameters.LZObjectID})",
							"type": "Expression"
						},
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "SQLDBConfig",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "Insert log",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlSource",
						"sqlReaderStoredProcedureName": "[CTRL].[ETLLogUpdate]",
						"storedProcedureParameters": {
							"BatchID": {
								"type": "int32",
								"value": {
									"value": "@pipeline().parameters.BatchID",
									"type": "Expression"
								}
							},
							"PipelineName": {
								"type": "string",
								"value": {
									"value": "@pipeline().Pipeline",
									"type": "Expression"
								}
							},
							"PipelineTriggerType": {
								"type": "string",
								"value": {
									"value": "@pipeline().TriggerType",
									"type": "Expression"
								}
							},
							"LogType": {
								"type": "string",
								"value": "LZLoadFile"
							},
							"ObjectID": {
								"type": "int32",
								"value": {
									"value": "@pipeline().parameters.LZObjectID",
									"type": "Expression"
								}
							},
							"SinkPathRaw": {
								"type": "string",
								"value": {
									"value": "@pipeline().parameters.FilePath",
									"type": "Expression"
								}
							},
							"SinkName": {
								"type": "string",
								"value": {
									"value": "@pipeline().parameters.FileName",
									"type": "Expression"
								}
							},
							"FileSizeInBytes": {
								"type": "int64",
								"value": {
									"value": "@pipeline().parameters.FileSizeInBytes",
									"type": "Expression"
								}
							}
						},
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "SQLDBConfig",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "Update Log",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Update Object File",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[CTRL].[ETLLogUpdate]",
					"storedProcedureParameters": {
						"LogID": {
							"value": {
								"value": "@activity('Insert log').output.firstRow.LogID",
								"type": "Expression"
							},
							"type": "int32"
						},
						"RowsInserted": {
							"value": {
								"value": "@activity('Populate main table').output.FirstRow.RowsInserted",
								"type": "Expression"
							},
							"type": "int32"
						},
						"RowsUpdated": {
							"value": {
								"value": "@activity('Populate main table').output.FirstRow.RowsUpdated",
								"type": "Expression"
							},
							"type": "int32"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "SQLDBConfig",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Populate main table",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "Populate stage table",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlDWSource",
						"sqlReaderStoredProcedureName": "[CTRL].[LZPopulateMainTable]",
						"storedProcedureParameters": {
							"DestSchema": {
								"type": "String",
								"value": {
									"value": "@activity('Get Object Details').output.FirstRow.DestSchema",
									"type": "Expression"
								}
							},
							"DestTable": {
								"type": "String",
								"value": {
									"value": "@activity('Get Object Details').output.FirstRow.DestTableName",
									"type": "Expression"
								}
							},
							"IsFullLoad": {
								"type": "Boolean",
								"value": {
									"value": "@pipeline().parameters.IsFullLoad",
									"type": "Expression"
								}
							},
							"JoinPredicates": {
								"type": "String",
								"value": {
									"value": "@activity('Get Object Details').output.FirstRow.JoinPredicates",
									"type": "Expression"
								}
							},
							"JoinPredicatesForUpdate": {
								"type": "String",
								"value": {
									"value": "@activity('Get Object Details').output.FirstRow.JoinPredicatesForUpdate",
									"type": "Expression"
								}
							},
							"SourceSchema": {
								"type": "String",
								"value": {
									"value": "@activity('Get Object Details').output.FirstRow.SourceSchema",
									"type": "Expression"
								}
							},
							"SourceTable": {
								"type": "String",
								"value": {
									"value": "@activity('Get Object Details').output.FirstRow.SourceTableName",
									"type": "Expression"
								}
							},
							"SourceColumnDroppedAction": {
								"type": "String",
								"value": {
									"value": "@activity('Get Object Details').output.FirstRow.SourceColumnDroppedAction",
									"type": "Expression"
								}
							},
							"SessionID": {
								"type": "String",
								"value": {
									"value": "@variables('SessionID')",
									"type": "Expression"
								}
							},
							"DistributionOption": {
								"type": "String",
								"value": {
									"value": "@activity('Get Object Details').output.FirstRow.DistributionOption",
									"type": "Expression"
								}
							},
							"StoreOption": {
								"type": "String",
								"value": {
									"value": "@activity('Get Object Details').output.FirstRow.StoreOption",
									"type": "Expression"
								}
							}
						},
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "SQLDW",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "On failure - Load data to main table",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Populate main table",
						"dependencyConditions": [
							"Failed"
						]
