				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[CTRL].[ETLLogUpdate]",
					"storedProcedureParameters": {
						"LogID": {
							"value": {
								"value": "@activity('Insert log').output.firstRow.LogID",
								"type": "Expression"
							},
							"type": "int32"
						},
						"ErrorMessage": {
							"value": {
								"value": "@activity('Populate main table').Error.Message",
								"type": "Expression"
							},
							"type": "string"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "SQLDBConfig",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Update Object File",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Populate main table",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 1,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[CTRL].[ADLObjectFileUpdate]",
					"storedProcedureParameters": {
						"FileName": {
							"value": {
								"value": "@pipeline().parameters.FileName",
								"type": "Expression"
							},
							"type": "string"
						},
						"Status": {
							"value": "Completed",
							"type": "string"
						},
						"FilePath": {
							"value": {
								"value": "@pipeline().parameters.FilePath",
								"type": "Expression"
							},
							"type": "string"
						},
						"Destination": {
							"value": {
								"value": "@pipeline().parameters.Destination",
								"type": "Expression"
							},
							"type": "string"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "SQLDBConfig",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "On failure - Prepare Stage Table",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Populate stage table",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[CTRL].[ETLLogUpdate]",
					"storedProcedureParameters": {
						"LogID": {
							"value": {
								"value": "@activity('Insert log').output.firstRow.LogID",
								"type": "Expression"
							},
							"type": "int32"
						},
						"ErrorMessage": {
							"value": {
								"value": "@activity('Populate stage table').Error.Message\n",
								"type": "Expression"
							},
							"type": "string"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "SQLDBConfig",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Get Metadata",
				"type": "GetMetadata",
				"dependsOn": [
					{
						"activity": "Get Object Details",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ADLSv2",
						"type": "DatasetReference",
						"parameters": {
							"Path": {
								"value": "@pipeline().parameters.FilePath",
								"type": "Expression"
							},
							"FileName": {
								"value": "@pipeline().parameters.FileName",
								"type": "Expression"
							}
						}
					},
					"fieldList": [
						"structure"
					]
				}
			},
			{
				"name": "Generate External View",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Get Metadata",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "CTRL.LZPrepareExternalView",
					"storedProcedureParameters": {
						"JSONColumnList": {
							"value": {
								"value": "@string(activity('Get Metadata').output.structure)",
								"type": "Expression"
							},
							"type": "String"
						},
						"FullFileName": {
							"value": {
								"value": "@concat(substring(pipeline().parameters.FilePath, int(add(indexof(pipeline().parameters.FilePath, '/'), 1)), int(sub(length(pipeline().parameters.FilePath), add(indexof(pipeline().parameters.FilePath, '/'), 1)))), pipeline().parameters.FileName)",
								"type": "Expression"
							},
							"type": "String"
						},
						"ObjectName": {
							"value": {
								"value": "@activity('Get Object Details').output.FirstRow.ExternalViewName",
								"type": "Expression"
							},
							"type": "String"
						},
						"SessionID": {
							"value": {
								"value": "@variables('SessionID')",
								"type": "Expression"
							},
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "SQLDW",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Set Session ID",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Insert log",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"variableName": "SessionID",
					"value": {
						"value": "@guid()",
						"type": "Expression"
					}
				}
			},
